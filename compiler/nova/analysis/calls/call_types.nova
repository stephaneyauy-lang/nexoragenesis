module call_types;import ntasm_ast;import initializer_types;
fn same(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool{if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||(a.end-a.start)!=(b.end-b.start){return false;}let mut i:u64=0;while i<(a.end-a.start){if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;}return true;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn decl_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if n.kind==18{return child(tree,id,0);}if n.kind==9{return child(tree,id,1);}return 0;}
fn return_type_id(tree:ntasm_ast.Tree,id:u64)->u64{let d:ntasm_ast.Node=ntasm_ast.node_at(tree,id);let mut c:u64=d.first_child;while c!=0{if c>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,c);if n.kind==36{return c;}c=n.next_sibling;}return 0;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let e:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if e.kind!=35||e.aux!=0||e.first_child==0||e.first_child!=e.last_child||e.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,e.first_child);if q.kind!=91||q.first_child==0||q.first_child!=q.last_child||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn named_type(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,name:ntasm_ast.Node,before:u64)->u64{return initializer_types.visible_type_id(source,tree,fn_id,name,before);}
fn call_name_id(tree:ntasm_ast.Tree,id:u64)->u64{let qid:u64=child(tree,id,0);if qid==0{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,qid);if q.kind!=91||q.last_child==0||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn call_type(source:buf<u8>,tree:ntasm_ast.Tree,id:u64)->u64{let name_id:u64=call_name_id(tree,id);if name_id==0{return 0;}let called:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let mut d:u64=1;while d<=tree.node_count{let n:ntasm_ast.Node=ntasm_ast.node_at(tree,d);if n.kind==18||n.kind==9{let dn_id:u64=decl_name_id(tree,d);if dn_id!=0{let dn:ntasm_ast.Node=ntasm_ast.node_at(tree,dn_id);if same(source,dn,called){return return_type_id(tree,d);}}}d=d+1;}return 0;}
fn literal_status(source:buf<u8>,expected:ntasm_ast.Node,literal:ntasm_ast.Node)->u64{let t:buf<u8>="true";let f:buf<u8>="false";let is_bool:bool=word(source,literal,t)||word(source,literal,f);let b:buf<u8>="bool";if word(source,expected,b){if is_bool{return 1;}return 0;}if is_bool{return 0;}let value:u64=literal.aux;let u8_:buf<u8>="u8";if word(source,expected,u8_){if value<=255{return 1;}return 2;}let i8_:buf<u8>="i8";if word(source,expected,i8_){if value<=127{return 1;}return 2;}let u16_:buf<u8>="u16";if word(source,expected,u16_){if value<=65535{return 1;}return 2;}let i16_:buf<u8>="i16";if word(source,expected,i16_){if value<=32767{return 1;}return 2;}let u32_:buf<u8>="u32";if word(source,expected,u32_){if value<=4294967295{return 1;}return 2;}let i32_:buf<u8>="i32";if word(source,expected,i32_){if value<=2147483647{return 1;}return 2;}let u64_:buf<u8>="u64";if word(source,expected,u64_){return 1;}let i64_:buf<u8>="i64";if word(source,expected,i64_){if value<=9223372036854775807{return 1;}return 2;}return 0;}
// Kind 28 is shared by ABI clauses and call statements. Exclude only
// the known ABI shape (dashed name); malformed calls still reach error 800.
fn is_call(tree:ntasm_ast.Tree,n:ntasm_ast.Node)->bool {
    if n.kind==28 {
        if n.first_child==0 || n.first_child>tree.node_count { return true; }
        return ntasm_ast.node_at(tree,n.first_child).kind!=92;
    }
    return n.kind==35 && n.aux==1;
}
fn blank(c:u8)->bool{if c==32{return true;}if c==9{return true;}if c==10{return true;}if c==13{return true;}return false;}
fn span_word(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool{if start>end||end>len(source){return false;}if (end-start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}return true;}
// Exact ABI direction of a parameter: 1 in, 2 out, 3 inout, 0 when the span
// carries no known direction. parser.nova creates node 19 before it steps
// past the direction, so the span opens on the keyword and the direction is
// its first whitespace-delimited word. The word is compared whole, so a name
// such as outbound, input, outer or inoutbox is never read as a direction and
// a direction is never read from a longer word that starts with it.
fn direction(source:buf<u8>,parameter:ntasm_ast.Node)->u64{if parameter.start>=parameter.end||parameter.end>len(source){return 0;}let mut at:u64=parameter.start;while at<parameter.end{if blank(source[at]){at=at+1;}else{break;}}let mut stop:u64=at;while stop<parameter.end{if blank(source[stop]){break;}stop=stop+1;}let inout_:buf<u8>="inout";if span_word(source,at,stop,inout_){return 3;}let out_:buf<u8>="out";if span_word(source,at,stop,out_){return 2;}let in_:buf<u8>="in";if span_word(source,at,stop,in_){return 1;}return 0;}// Rule owner: abi.nova:78 (fn direction), which carries the same whole-word reader and the same 0-means-refusal contract. This is one of four copies (abi.nova:78, calls.nova:74, call_types.nova:21, x64_lower_nxo.nova:2056) and must change with the owner; tests_ntasm_abi.c drives all four over one forged span table and fails when they disagree.
// A parameter takes an argument unless its direction word is exactly out. A
// span carrying no known direction keeps its argument, so a parameter can
// never suppress its own check.
fn consumes(source:buf<u8>,parameter:ntasm_ast.Node)->bool{return direction(source,parameter)!=2;}
// Validate in/inout call argument types; out parameters consume no argument.
// Proofs: bounded literals, caller param/local names and nested call results.
// Success writes calls, arguments, checked and 0 to out[0..3].
// Error 354: reason 1 argument type mismatch, reason 2 argument out of
// range, reason 3 argument not proved, reason 4 too many arguments,
// reason 5 too few arguments. out[0] and out[1] carry the line and the
// column of the offending node: the argument itself for reasons 1, 2
// and 3, the first surplus argument for reason 4, the first unsatisfied
// parameter for reason 5. out[3] is the zero-based argument index for
// reasons 1, 2, 3 and 4, and the zero-based index of the missing
// argument for reason 5.
// Reasons 4 and 5 stay inside the existing 354 call-argument-mismatch
// code: a surplus or a missing argument is a disagreement between the
// call and the callee signature, so no new code is minted. calls.check
// already answers every arity mismatch with 311 and runs before this
// module in the validate pipeline, so reasons 4 and 5 are what make
// this module sound on its own. Error 800 on an invalid tree, an
// invalid span or child chain, or an output buffer shorter than four
// words, with no write to out. Neither source nor tree is released.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut calls:u64=0;let mut arguments:u64=0;let mut checked:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut bad_index:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let call:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if is_call(tree,call){calls=calls+1;let name_id:u64=call_name_id(tree,id);if name_id==0{code=800;}else{let called:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);let mut caller:u64=0;let mut callee:u64=0;let mut d:u64=1;while d<=tree.node_count{let decl:ntasm_ast.Node=ntasm_ast.node_at(tree,d);if decl.kind==18||decl.kind==9{let dn_id:u64=decl_name_id(tree,d);if dn_id!=0{let dn:ntasm_ast.Node=ntasm_ast.node_at(tree,dn_id);if same(source,dn,called){callee=d;}}if decl.kind==18&&decl.start<=call.start&&call.end<=decl.end{caller=d;}}d=d+1;}if caller==0||callee==0{code=800;}else{let qid:u64=child(tree,id,0);let q:ntasm_ast.Node=ntasm_ast.node_at(tree,qid);let mut arg_id:u64=q.next_sibling;let callee_node:ntasm_ast.Node=ntasm_ast.node_at(tree,callee);let mut param_id:u64=callee_node.first_child;let mut index:u64=0;while param_id!=0&&code==0{let parameter:ntasm_ast.Node=ntasm_ast.node_at(tree,param_id);if parameter.kind==19&&consumes(source,parameter)==true{if arg_id==0{code=354;reason=5;line=parameter.line;column=parameter.column;bad_index=index;}else if arg_id>tree.node_count{code=800;}else{arguments=arguments+1;let expected_id:u64=child(tree,param_id,1);if expected_id==0{code=800;}else{let expected:ntasm_ast.Node=ntasm_ast.node_at(tree,expected_id);let arg:ntasm_ast.Node=ntasm_ast.node_at(tree,arg_id);if arg.kind==94{let status:u64=literal_status(source,expected,arg);if status==0{code=354;reason=1;}else if status==2{code=354;reason=2;}else{checked=checked+1;}}else{let bool_:buf<u8>="bool";let true_:buf<u8>="true";let false_:buf<u8>="false";if word(source,expected,bool_)&&(word(source,arg,true_)||word(source,arg,false_)){checked=checked+1;}else{let mut actual_id:u64=0;let simple_id:u64=simple_name_id(tree,arg_id);if simple_id!=0{let simple:ntasm_ast.Node=ntasm_ast.node_at(tree,simple_id);actual_id=named_type(source,tree,caller,simple,call.start);}else if arg.kind==35&&arg.aux==1{actual_id=call_type(source,tree,arg_id);}if actual_id==0{if arg.kind==35&&simple_id==0&&arg.aux!=1{let bool_expected:buf<u8>="bool";if word(source,expected,bool_expected){let bstatus:u64=initializer_types.bool_status(source,tree,arg_id,caller,call.start,0);if bstatus==1{checked=checked+1;}else{code=354;if bstatus<200{reason=1;}else{reason=3;}}}else{let status:u64=initializer_types.integer_status(source,tree,arg_id,caller,call.start,expected);if status==1{checked=checked+1;}else{code=354;if status==0{reason=1;}else if status==2{reason=2;}else{reason=3;}}}}else{code=354;reason=3;}}else{let actual:ntasm_ast.Node=ntasm_ast.node_at(tree,actual_id);if same(source,expected,actual){checked=checked+1;}else{code=354;reason=1;}}}}if code!=0{line=arg.line;column=arg.column;bad_index=index;}}let arg:ntasm_ast.Node=ntasm_ast.node_at(tree,arg_id);arg_id=arg.next_sibling;index=index+1;}}param_id=parameter.next_sibling;}while arg_id!=0&&code==0{if arg_id>tree.node_count{code=800;}else{let extra:ntasm_ast.Node=ntasm_ast.node_at(tree,arg_id);code=354;reason=4;line=extra.line;column=extra.column;bad_index=index;}}}}}id=id+1;}if code==0{out[0]=calls;out[1]=arguments;out[2]=checked;out[3]=0;}else if code==354{out[0]=line;out[1]=column;out[2]=reason;out[3]=bad_index;}return code;}
