module condition_types;

import ntasm_ast;
import initializer_types;

fn child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64{if parent==0||parent>tree.node_count{return 0;}let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);let mut id:u64=p.first_child;let mut index:u64=0;while id!=0&&index<ordinal{if id>tree.node_count{return 0;}let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);id=n.next_sibling;index=index+1;}if id>tree.node_count{return 0;}return id;}
fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool{if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;}
fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64{if expr_id==0||expr_id>tree.node_count{return 0;}let e:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);if e.kind!=35||e.aux!=0||e.first_child==0||e.first_child!=e.last_child||e.first_child>tree.node_count{return 0;}let q:ntasm_ast.Node=ntasm_ast.node_at(tree,e.first_child);if q.kind!=91||q.first_child==0||q.first_child!=q.last_child||q.last_child>tree.node_count{return 0;}return q.last_child;}
fn owner_id(tree:ntasm_ast.Tree,branch:ntasm_ast.Node)->u64{let mut owner:u64=0;let mut id:u64=1;while id<=tree.node_count{let fn_:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if fn_.kind==18&&fn_.start<=branch.start&&branch.end<=fn_.end{owner=id;}id=id+1;}return owner;}

// Prove every if condition is boolean through the single shared proof in
// initializer_types.bool_status. Bool literals, visible bool names, bool
// returning local/import calls, feature(...), comparisons, groups, !, && and
// || are accepted. 357 reports a proved non-bool type; 358 reports an
// expression whose type is not yet proved. Success writes
// conditions,literals,names,derived expressions.
export fn check(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64{if tree.ok==false||tree.node_count==0||len(out)<4{return 800;}let mut conditions:u64=0;let mut literals:u64=0;let mut names:u64=0;let mut derived:u64=0;let mut code:u64=0;let mut line:u64=0;let mut column:u64=0;let mut reason:u64=0;let mut id:u64=1;while id<=tree.node_count&&code==0{let branch:ntasm_ast.Node=ntasm_ast.node_at(tree,id);if branch.kind==30{conditions=conditions+1;let condition_id:u64=child(tree,id,0);if condition_id==0{code=800;}else{let condition:ntasm_ast.Node=ntasm_ast.node_at(tree,condition_id);let true_:buf<u8>="true";let false_:buf<u8>="false";if word(source,condition,true_)||word(source,condition,false_){literals=literals+1;}else if condition.kind==94{code=357;reason=1;}else{let owner:u64=owner_id(tree,branch);if owner==0&&simple_name_id(tree,condition_id)!=0{code=800;}else{let status:u64=initializer_types.bool_status(source,tree,condition_id,owner,branch.start,0);if status==1{if simple_name_id(tree,condition_id)!=0{names=names+1;}else{derived=derived+1;}}else if status<200{code=357;reason=status-100;}else{code=358;reason=status-200;}}}if code!=0{line=condition.line;column=condition.column;}}}id=id+1;}if code==0{out[0]=conditions;out[1]=literals;out[2]=names;out[3]=derived;}else if code==357||code==358{out[0]=line;out[1]=column;out[2]=reason;out[3]=0;}return code;}
