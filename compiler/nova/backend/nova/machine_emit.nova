    // value in rdx; a dword load zero-extends by itself.
    let m:buf<u8>="mov"; ri_owned(e,m,2,32,0);
    mem(e,0,2,width,1,0);
    // A signed narrow element is sign-extended (the width invariant).
    normalize(e,2,width,W(e,r,10));
    return st(e,W(e,r,4),2);
}
fn emit_store(e:E,r:u64)->u64 {
    let a:u64=W(e,r,5);
    let v:u64=W(e,r,6);
    let mut width:u64=W(e,r,9);
    let literal:Immediate=immediate_operand(e,v,0);
    if W(e,r,15)!=0 {
        if literal.present {
            if literal.signed>1 { rt_free(runtime(),literal);return fail(e,E_FORM(),r); }
            width=W(e,r,15);
            let name:buf<u8>="mov"; let enc:buf<u8>=e.enc;
            let rc:u64=x64_fixed.encode_binary(name,2,3,0,0,width,2,0,0,0,5,16,1,0,0,literal.value,literal.signed,1,0,enc);
            rt_free(runtime(),name);
            if rc!=0 { rt_free(runtime(),literal);return fail(e,E_FORM(),r); }
        } else {
            if width!=W(e,r,15) { return fail(e,E_FORM(),r); }
            let source:u64=source_register(e,v,0); let computed:u64=definer(e,v);
            if source==0 && (computed==0 || K(e,computed)!=2065) { return fail(e,E_FORM(),r); }
        }
    }
    if machine_width(width)==false { return fail(e,E_FORM(),r); }
    // A store wider than the `data` it names is refused (fifth review,
    // executed: `store [b]:ptr<user,u32>,rax` wrote eight bytes into a
    // four-byte datum, a form the reference refuses with E400). The store's
    // own width comes from the annotation's pointer node, as a load's does
    // (`emit_asm`), so the width compared is the one the datum declares.
    let ad:u64=definer(e,a);
    if ad!=0 && K(e,ad)==2066 && W(e,ad,7)!=0 {
        let datum:u64=named_storage(e,W(e,ad,7));
        if datum!=0 && K(e,datum)==2060 && W(e,datum,9)!=0 && W(e,datum,9)<width { return fail(e,E_FORM(),r); }
    }
    need(e,a); if literal.present==false || literal.signed>1 { need(e,v); }
    ld(e,1,a);
    if literal.present && literal.signed<=1 { let mov:buf<u8>="mov"; ri_owned(e,mov,2,64,literal.value); }
    else { ld(e,2,v); }
