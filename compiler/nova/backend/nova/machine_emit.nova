    let mut i:u64=13;
    while i>0 { i=i-1; pop(e,saved_register(i)); }
    pop(e,5);
    let ret:buf<u8>="ret";
    return op0_owned(e,ret);
}
fn jcc_name(code:u64)->buf<u8> {
    if code==1 { return "je"; }
    if code==2 { return "jne"; }
    if code==3 { return "ja"; }
    if code==4 { return "jae"; }
    if code==5 { return "jb"; }
    if code==6 { return "jbe"; }
    if code==7 { return "jg"; }
    if code==8 { return "jge"; }
    if code==9 { return "jl"; }
    if code==10 { return "jle"; }
    if code==11 { return "js"; }
    return "jns";
