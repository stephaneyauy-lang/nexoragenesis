    while r<fend {
        let v:u64=W(e,r,4);
        if v!=0 && K(e,r)!=2058 && (K(e,r)!=2065 || W(e,r,12)!=machine_ir.CLASS_PREDICATE()) {
            if slots[v]==0 {
