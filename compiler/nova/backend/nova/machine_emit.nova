}
fn emit_unsigned_mul(e:E,r:u64)->u64 {
    let source:u64=W(e,r,5); let width:u64=W(e,r,9);
    if W(e,r,8)!=1 || machine_width(width)==false { return fail(e,E_FORM(),r); }
    let input:u64=definer(e,source);
    let reg:u64=source_register(e,source,0);
    if reg==0 && (input==0 || K(e,input)!=2067) { return fail(e,E_FORM(),r); }
    need(e,source);ld(e,1,source);mem(e,0,0,64,5,cell_frame(e,1));
    restore_flags(e);mem(e,0,2,64,5,cell_frame(e,3));
    let name:buf<u8>="mul";un_width_owned(e,name,1,width);
    mem(e,1,0,64,5,cell_frame(e,1));
    if width!=8 { mem(e,1,2,64,5,cell_frame(e,3)); }
    return capture_flags(e);
}
fn emit_signed_mul(e:E,r:u64)->u64 {
    let width:u64=W(e,r,9); let n:u64=W(e,r,8);
    if width==8 || (n!=2 && n!=3) || W(e,r,20)==0 { return fail(e,E_FORM(),r); }
    let mut source:u64=W(e,r,6);let reg:u64=source_register(e,source,0);
    let input:u64=definer(e,source);
    if reg==0 && (input==0 || K(e,input)!=2067) { return fail(e,E_FORM(),r); }
    if reg!=0 && W(e,reg,9)!=width { return fail(e,E_FORM(),r); }
    if reg==0 && W(e,input,9)!=width { return fail(e,E_FORM(),r); }
    let name:buf<u8>="imul";let enc:buf<u8>=e.enc;
