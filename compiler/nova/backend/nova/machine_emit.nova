    }
    if (e.mask&131072)!=0 {
        mem(e,0,1,64,5,cell_frame(e,17)); mem(e,1,1,64,5,negate(e.saved));
    }
    let b:buf<u8>=e.enc;
    emit_bytes(e,x64_fixed.encode_lea(4,64,5,16,1,negate(e.saved),0,1,0,b));
    let pf:buf<u8>="popfq"; op0_owned(e,pf);
