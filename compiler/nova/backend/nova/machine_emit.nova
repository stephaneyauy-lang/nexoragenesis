}

fn emit_call(e:E,r:u64)->u64 {
    let indirect:bool=K(e,r)==2087;
    let mut f:u64=0;
    if indirect { f=W(e,r,15); }else { f=callee(e,W(e,r,5)); }
    if f==0 || f>e.count || K(e,f)!=2051 { return fail(e,E_CALL(),r); }
    // The first indirect transport is EFI/ms_abi. Its argument registers never
    // include r11, which is reserved as the final call-target scratch here.
    if indirect && abi_profile(e,f)!=2 { return fail(e,E_CALL(),r); }
    if indirect { e.current=r;need(e,W(e,r,5)); }
    let mask:u64=W(e,r,23);
    let mut expected:u64=declared_mask(e,f);
    if (W(e,f,13)&machine_ir.FLAG_RESULT_TYPED())!=0 && W(e,f,15)!=0 { expected=expected|1; }
    if mask!=expected { return fail(e,E_IMAGE(),r); }
    let argc:u64=W(e,r,14);
    let mut input_count:u64=0; let mut ordinal:u64=0;
    while ordinal<W(e,f,14) {
        let p:u64=formal(e,f,ordinal);
        if p==0 || passable(e,f,p)!=0 { return fail(e,E_CALL(),r); }
        if (W(e,p,13)&machine_ir.FLAG_DIR_OUT())==0 { input_count=input_count+1; }
        ordinal=ordinal+1;
    }
    if argc!=input_count || argc>64 || W(e,r,8)>3 { return fail(e,E_CALL(),r); }
    // Every argument is materialized BEFORE any register is loaded: lowering
    // a later definition uses rax, rcx and rdx, and would overwrite an
    // argument register already filled.
    let mut k:u64=0;
    while k<argc {
        let value:u64=machine_ir.call_argument(e.words,e.count,r,k);
        e.current=r;need(e,value);ld(e,0,value);mem(e,1,0,64,5,frame(e,e.args+k));
        k=k+1;
    }
    if abi_profile(e,f)==2 {
        ordinal=4;
        while ordinal<W(e,f,14) && e.code==0 {
            let p:u64=formal(e,f,ordinal);pass_argument(e,p,e.args+ordinal);ordinal=ordinal+1;
        }
    }
    // Supply the entire physical state, then the explicit argument bindings.
    let mut family:u64=1;
    while family<=16 {
        if family!=5 && family!=6 { mem(e,0,family-1,64,5,cell_frame(e,family)); }
        family=family+1;
    }
    restore_flags(e);
    // restore_flags uses rdx as scratch; its original cell is restored too.
    mem(e,0,2,64,5,cell_frame(e,3));
    k=0;
    ordinal=0;
    while ordinal<W(e,f,14) && e.code==0 {
        let p:u64=formal(e,f,ordinal);
        if (W(e,p,13)&machine_ir.FLAG_DIR_OUT())==0 {
            if abi_profile(e,f)!=2 || ordinal<4 { pass_argument(e,p,e.args+k); }k=k+1;
        }
        ordinal=ordinal+1;
    }
    let name:buf<u8>="call";
    let b:buf<u8>=e.enc;
    if indirect {
        // need() and every argument computation ran before register setup.
        // Loading the immutable target now cannot overwrite any ABI argument.
        ld(e,11,W(e,r,5));
        emit_bytes(e,x64_fixed.encode_control(name,1,1,64,11,0,1,0,b));
    } else {
        emit_bytes(e,x64_fixed.encode_control(name,1,4,0,0,0,1,0,b));
        relocate(e,f);
    }
    rt_free(runtime(),name);
    e.last_call=r;
    family=1;
    while family<=16 {
        if family!=5 && family!=6 && (mask&(1<<(family-1)))!=0 { mem(e,1,family-1,64,5,cell_frame(e,family)); }
        family=family+1;
    }
    if (mask&131072)!=0 { capture_flags(e); }
    if W(e,r,4)!=0 {
        if (W(e,f,13)&machine_ir.FLAG_RESULT_TYPED())==0 || W(e,f,15)==0 { return fail(e,E_CALL(),r); }
        // An import's result above its width is the callee's business, not a
        // promise: the width invariant is restored here.
        normalize(e,0,W(e,r,9),W(e,r,10));
        st(e,W(e,r,4),0);
    }
