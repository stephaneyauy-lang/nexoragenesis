fn emit_cell_write(e:E,r:u64)->u64 {
    let family:u64=W(e,r,20); let width:u64=W(e,r,9);
    let offset:u64=W(e,r,21); let mut value:u64=W(e,r,4);
    if W(e,r,14)==machine_ir.OP_LOAD() { value=W(e,r,5); }
    need(e,value); ld(e,0,value);
