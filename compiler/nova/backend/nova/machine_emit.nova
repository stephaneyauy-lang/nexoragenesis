    tb(t,125);rt_free(runtime(),ab);rt_free(runtime(),bb);rt_free(runtime(),ids);
    // THE TWO RECORDS ARE OURS TOO. A `T` is a cell and the cell is not the
    // buffer it writes into: the buffers are freed above and the two cells
    // that point at them are freed here, once each.
    rt_free(runtime(),a);rt_free(runtime(),b);
    if t.bad!=0 { return E_CONTRACT(); }return code;
}
fn function_contract(e:E,t:T,f:u64,target:u64,features:u64)->u64 {
    let flags:u64=W(e,f,13);
    if (flags&machine_ir.FLAG_RESULT_TYPED())==0 { return E_CONTRACT(); }
    if abi_ok(e,f)==false { return E_CONTRACT(); }
    let s:buf<u8>=e.source;
    // EVERY LITERAL HERE IS FREED RIGHT AFTER ITS LAST USE, so a refusal in
    // the middle of the contract leaves nothing alive: the text is already in
    // the writer and the writer keeps none of the literal.
    let h1:buf<u8>="fn;target="; ts_owned(t,h1);
    tspan(t,s,W(e,target,5),W(e,target,6));
    let h2:buf<u8>=";abi=";ts_owned(t,h2);
    let nx:buf<u8>="nx64-abi-v0";let ef:buf<u8>="efi-x64-v0";
    if abi_profile(e,f)==2 { ts(t,ef); }else { ts(t,nx); }
    rt_free(runtime(),nx);rt_free(runtime(),ef);
    let feature_label:buf<u8>=";features=";ts_owned(t,feature_label);
    tdec(t,features);
    let h3:buf<u8>=";section=.text;ret="; ts_owned(t,h3);
    if declared_type_text(e,t,f)==false { return E_CONTRACT(); }
    let h4:buf<u8>=";params=("; ts_owned(t,h4);
    let mut k:u64=0;
    while k<W(e,f,14) {
        let p:u64=formal(e,f,k);
        if p==0 { return E_CONTRACT(); }
        if k>0 { tb(t,44); }
        let pf:u64=W(e,p,13);
        // A direction nobody read cannot be printed.
        if (pf&machine_ir.FLAG_DIR_UNREAD())!=0 { return E_CONTRACT(); }
        if (pf&machine_ir.FLAG_DIR_OUT())!=0 { tb(t,49); }
        else if (pf&machine_ir.FLAG_DIR_INOUT())!=0 { tb(t,50); }
        else { tb(t,48); }
        tb(t,58);
        if declared_type_text(e,t,p)==false { return E_CONTRACT(); }
        tb(t,64);
        let family:u64=W(e,p,15);
        if family==0 { let u:buf<u8>="-1/0/0"; ts_owned(t,u); }
        else {
            // MIR/1.0 carries the binding slice explicitly, including high8.
            let bits:u64=bound_width(e,f,p);
            if machine_width(bits)==false { return E_CONTRACT(); }
            tdec(t,family-1); tb(t,47); tdec(t,bits); tb(t,47);
            if W(e,p,21)==8 { tb(t,49); } else { tb(t,48); }
        }
        k=k+1;
    }
    let triple:buf<u64>=alloc(runtime(),3);
    let why:u64=effects_of(e,f,triple);
    let fl:u64=triple[0];let rd:u64=triple[1];let wr:u64=triple[2];
    rt_free(runtime(),triple);
    if why!=0 { return why; }
    let h5:buf<u8>=");effects="; ts_owned(t,h5);
    tdec(t,fl); tb(t,47); tdec(t,rd); tb(t,47); tdec(t,wr);
    let h6:buf<u8>=";clobbers="; ts_owned(t,h6);
    thex16(t,clobbers_of(e,f));
    let h7:buf<u8>=";requires=";ts_owned(t,h7);
    let req:u64=contract_clause_text(e,t,f,1);if req!=0 { return req; }
    let h8:buf<u8>=";ensures=";ts_owned(t,h8);
    let ens:u64=contract_clause_text(e,t,f,2);if ens!=0 { return ens; }
    return 0;
}
fn data_contract(e:E,t:T,d:u64,section:u64)->u64 {
    let h1:buf<u8>="data;type="; ts_owned(t,h1);
    if type_text(t,W(e,d,9),W(e,d,10),W(e,d,11))==false { return E_CONTRACT(); }
    let h2:buf<u8>=";section="; ts_owned(t,h2);
    tdec(t,section);
    return 0;
}

// ---- the object --------------------------------------------------------------
// The module name, from the unit's first `mir_symbol`, whose span is the
// module declaration: the keyword, blanks, then the dotted name up to the
// first blank, `;` or end of line.
fn module_name(e:E,t:T)->u64 {
    let mut r:u64=2;
    let mut found:u64=0;
    while r<=e.count && found==0 { if K(e,r)==2057 && W(e,r,16)==1 { found=r; } r=r+1; }
    if found==0 { return E_CONTRACT(); }
    let s:buf<u8>=e.source;
    let mut at:u64=W(e,found,5);
    let end:u64=W(e,found,6);
    if at>end || end>len(s) { return E_CONTRACT(); }
    if end-at>=7 && s[at]==109 && s[at+1]==111 && s[at+2]==100 && s[at+3]==117
       && s[at+4]==108 && s[at+5]==101 && (s[at+6]==32 || s[at+6]==9) { at=at+6; }
    while at<end && (s[at]==32 || s[at]==9) { at=at+1; }
    let begin:u64=at;
    while at<end && s[at]!=32 && s[at]!=9 && s[at]!=10 && s[at]!=13 && s[at]!=59 { at=at+1; }
    if at==begin { return E_CONTRACT(); }
    tspan(t,s,begin,at);
    return 0;
}
fn name_less(names:buf<u8>,a:u64,al:u64,b:u64,bl:u64)->u64 {
    let mut i:u64=0;
    while i<al && i<bl {
        if names[a+i]!=names[b+i] { if names[a+i]<names[b+i] { return 1; } return 2; }
        i=i+1;
    }
    if al<bl { return 1; }
    if al>bl { return 2; }
    return 0;
}

// The section bytes of every storage `data`, laid out in image order at its
// own alignment. place[] gets the offset+1, extent[] the size.
fn data_layout(e:E,rdata:buf<u8>,wdata:buf<u8>,write:bool,sizes:buf<u64>)->u64 {
    let place:buf<u64>=e.place;
    let extent:buf<u64>=e.extent;
    let mut at2:u64=0;
    let mut at3:u64=0;
    let mut r:u64=1;
    while r<=e.count {
        let flags:u64=W(e,r,13);
        if K(e,r)==2060 && W(e,r,16)==1 && (flags&(machine_ir.FLAG_RDATA()+machine_ir.FLAG_WDATA()))!=0 {
            if W(e,r,14)!=0 { return fail(e,E_FORM(),r); }
            let width:u64=W(e,r,9);
            let mut size:u64=width/8;
            if width==1 { size=1; }
            else if machine_width(width)==false { return fail(e,E_FORM(),r); }
            let mut align:u64=W(e,r,15);
            if align==0 { align=1; }
            let mut value:u64=0;
            if W(e,r,5)!=0 {
                let d:u64=definer(e,W(e,r,5));
                if d==0 || K(e,d)!=2058 { return fail(e,E_FORM(),r); }
                value=W(e,d,5);
            }
            let mut offset:u64=0;
            if (flags&machine_ir.FLAG_RDATA())!=0 {
                at2=((at2+align-1)/align)*align; offset=at2; at2=at2+size;
            } else {
                at3=((at3+align-1)/align)*align; offset=at3; at3=at3+size;
            }
            place[r]=offset+1;
            extent[r]=size;
            if write {
                let mut i:u64=0;
                while i<size {
                    let byte:u64=(value>>(8*i))&255;
                    if (flags&machine_ir.FLAG_RDATA())!=0 { rdata[offset+i]=u8(byte); }
                    else { wdata[offset+i]=u8(byte); }
                    i=i+1;
                }
            }
        }
        r=r+1;
    }
    sizes[0]=at2;sizes[1]=at3;
    return e.code;
}

// The declarations that become object symbols: every function with a body,
// every import, every storage `data`. An import is a symbol whether or not a
// call names it, as codegen.c adds one for every unresolved import: an object
// that dropped an unused import would link where the reference refuses.
fn is_symbol(e:E,r:u64)->bool {
    let kind:u64=K(e,r);
    if W(e,r,16)!=1 { return false; }
    if kind==2051 { return true; }
    if kind==2060 { return (W(e,r,13)&(machine_ir.FLAG_RDATA()+machine_ir.FLAG_WDATA()))!=0; }
    return false;
}

fn assemble(e:E,report:buf<u64>)->ntasm_nxo.WriteResult {
    let empty:buf<u8>=alloc(runtime(),0);
    // The target, as the object's target id.
    let mut target:u64=0;
    let mut r:u64=1;
    while r<=e.count && target==0 { if K(e,r)==2049 && W(e,r,16)==1 { target=r; } r=r+1; }
    let mut target_id:u64=0;
    let triple_uefi:buf<u8>="x86_64-nexora-uefi";
    let triple_none:buf<u8>="x86_64-nexora-none";
    if target!=0 && W(e,target,15)==len(triple_uefi) && W(e,target,14)==fnv_text(triple_uefi) { target_id=1; }
    if target!=0 && W(e,target,15)==len(triple_none) && W(e,target,14)==fnv_text(triple_none) { target_id=2; }
    rt_free(runtime(),triple_uefi);rt_free(runtime(),triple_none);
    if target_id==0 { fail(e,E_CONTRACT(),target); return ntasm_nxo.WriteResult{code:e.code,bytes:empty}; }
    let features:u64=W(e,1,15);
    // Sections.
    let sizes:buf<u64>=alloc(runtime(),2);
    let none:buf<u8>=alloc(runtime(),0);
    data_layout(e,none,none,false,sizes);
    let rdata:buf<u8>=alloc(runtime(),sizes[0]);
    let wdata:buf<u8>=alloc(runtime(),sizes[1]);
    data_layout(e,rdata,wdata,true,sizes);
    rt_free(runtime(),none);rt_free(runtime(),sizes);
    // Names and contracts.
    let mut n:u64=0;
    r=1;
    while r<=e.count { if is_symbol(e,r) { n=n+1; } r=r+1; }
    let names_buffer:buf<u8>=alloc(runtime(),n*600+600);
    let names:T=T{bytes:names_buffer,at:0,cap:n*600+600,bad:0};
    let contracts_buffer:buf<u8>=alloc(runtime(),n*4096+64);
    let contracts:T=T{bytes:contracts_buffer,at:0,cap:n*4096+64,bad:0};
    let prefix_bytes:buf<u8>=alloc(runtime(),600);
    let prefix:T=T{bytes:prefix_bytes,at:0,cap:600,bad:0};
    let table:buf<u64>=alloc(runtime(),n*5+5);
    if e.code==0 { let why:u64=module_name(e,prefix); if why!=0 { fail(e,why,1); } }
    let mut k:u64=0;
    r=1;
    while r<=e.count && e.code==0 {
        if is_symbol(e,r) {
            let kind:u64=K(e,r);
            let n0:u64=names.at;
            let c0:u64=contracts.at;
            let s:buf<u8>=e.source;
            let mut why:u64=0;
            // A name span outside the text is a damaged image, said as one,
            // before any byte of it is copied.
            if kind==2051 && W(e,r,5)==0 {
                let t:u64=import_target(e,r);
                if t==0 || W(e,t,5)>W(e,t,6) || W(e,t,6)>len(s) { why=E_IMAGE(); }
                else { tspan(names,s,W(e,t,5),W(e,t,6)); }
                if why==0 { why=function_contract(e,contracts,r,target,features); }
            } else if W(e,r,8)<3 || W(e,r,6)>W(e,r,7) || W(e,r,7)>len(s) {
                why=E_IMAGE();
            } else {
                let mb:buf<u8>=prefix.bytes;
                let mut i:u64=0;
                while i<prefix.at { let c:u64=mb[i]; tb(names,c); i=i+1; }
                tb(names,46);
                tspan(names,s,W(e,r,6),W(e,r,7));
                if kind==2051 { why=function_contract(e,contracts,r,target,features); }
                else {
                    let mut section:u64=3;
                    if (W(e,r,13)&machine_ir.FLAG_RDATA())!=0 { section=2; }
                    why=data_contract(e,contracts,r,section);
                }
            }
            if why!=0 { fail(e,why,r); }
            if why==0 && (names.bad!=0 || contracts.bad!=0 || names.at-n0>512 || names.at==n0) { fail(e,E_LAYOUT(),r); }
            table[k*5]=r;table[k*5+1]=n0;table[k*5+2]=names.at-n0;
            table[k*5+3]=c0;table[k*5+4]=contracts.at-c0;
            k=k+1;
        }
        r=r+1;
    }
    let order:buf<u64>=alloc(runtime(),n+1);
    let index:buf<u64>=alloc(runtime(),e.count+1);
    let mut z:u64=0;
    while z<=e.count { index[z]=0; z=z+1; }
    // Canonical name order, which nxo.validate requires strictly increasing:
    // a selection sort over the table, and an equal pair is a refusal.
    let nb:buf<u8>=names.bytes;
    let mut i:u64=0;
    while i<n { order[i]=i; i=i+1; }
    i=0;
    while i<n && e.code==0 {
        let mut best:u64=i;
        let mut j:u64=i+1;
        while j<n {
            let a:u64=order[j];let b:u64=order[best];
            if name_less(nb,table[a*5+1],table[a*5+2],table[b*5+1],table[b*5+2])==1 { best=j; }
            j=j+1;
        }
        let swap:u64=order[i];order[i]=order[best];order[best]=swap;
        if i>0 {
            let a:u64=order[i-1];let b:u64=order[i];
            if name_less(nb,table[a*5+1],table[a*5+2],table[b*5+1],table[b*5+2])!=1 { fail(e,E_LAYOUT(),table[b*5]); }
        }
        i=i+1;
    }
    // The object.
    let mut total:u64=0;
    i=0;
    while i<n { total=total+table[i*5+2]+table[i*5+4]; i=i+1; }
    let strings:buf<u8>=alloc(runtime(),total);
    let symbols:buf<u64>=alloc(runtime(),n*8);
    let cb:buf<u8>=contracts.bytes;
    let place:buf<u64>=e.place;
    let extent:buf<u64>=e.extent;
    let main_text:buf<u8>="main";
    let mut entry:u64=0;
    let mut cursor:u64=0;
    i=0;
    while i<n && e.code==0 {
        let row:u64=order[i];
        let rec:u64=table[row*5];
        index[rec]=i+1;
        let name_at:u64=cursor;
        let mut c:u64=0;
        while c<table[row*5+2] { strings[cursor]=nb[table[row*5+1]+c]; cursor=cursor+1; c=c+1; }
        let contract_at:u64=cursor;
        c=0;
        while c<table[row*5+4] { strings[cursor]=cb[table[row*5+3]+c]; cursor=cursor+1; c=c+1; }
        let kind:u64=K(e,rec);
        let mut flags:u64=0;
        let mut section:u64=0;
        let mut offset:u64=0;
        let mut size:u64=0;
        if kind==2051 && W(e,rec,5)==0 { flags=10; }
        else {
            if kind==2051 { flags=2; section=1; } else { flags=4; section=3; if (W(e,rec,13)&machine_ir.FLAG_RDATA())!=0 { section=2; } }
            if (W(e,rec,13)&machine_ir.FLAG_EXPORT())!=0 { flags=flags+1; }
            offset=place[rec]-1; size=extent[rec];
        }
        // THE ENTRY is the exported function named `main`, as object_build.c
        // chooses it; a module without one is a library and has entry 0.
        let s:buf<u8>=e.source;
        if kind==2051 && W(e,rec,5)!=0 && (flags&1)!=0 && W(e,rec,7)-W(e,rec,6)==4 {
            let at:u64=W(e,rec,6);
            if s[at]==main_text[0] && s[at+1]==main_text[1] && s[at+2]==main_text[2] && s[at+3]==main_text[3] { entry=i+1; }
        }
        symbols[i*8]=name_at;symbols[i*8+1]=table[row*5+2];symbols[i*8+2]=section;symbols[i*8+3]=flags;
        symbols[i*8+4]=offset;symbols[i*8+5]=size;symbols[i*8+6]=contract_at;symbols[i*8+7]=table[row*5+4];
        i=i+1;
    }
    // THE ENTRY'S NAME SPELLING is a literal of ours, and the loop above was
    // its last use.
    rt_free(runtime(),main_text);
    let relocations:buf<u64>=alloc(runtime(),e.rel_count*5);
    let rl:buf<u64>=e.rels;
    i=0;
    while i<e.rel_count {
        let target_index:u64=index[rl[i*2+1]];
        if target_index==0 { fail(e,E_LAYOUT(),rl[i*2+1]); }
        relocations[i*5]=1;relocations[i*5+1]=1;relocations[i*5+2]=rl[i*2];
        relocations[i*5+3]=target_index;relocations[i*5+4]=0;
        i=i+1;
    }
    let text:buf<u8>=alloc(runtime(),e.at);
    let tx:buf<u8>=e.text;
    i=0;
    while i<e.at { text[i]=tx[i]; i=i+1; }
    rt_free(runtime(),names_buffer);rt_free(runtime(),contracts_buffer);rt_free(runtime(),prefix_bytes);
    rt_free(runtime(),names);rt_free(runtime(),contracts);rt_free(runtime(),prefix);
    rt_free(runtime(),table);rt_free(runtime(),order);rt_free(runtime(),index);
    let object:ntasm_nxo.Object=ntasm_nxo.Object{target:target_id,entry:entry,text:text,rdata:rdata,
        data:wdata,symbols:symbols,relocations:relocations,strings:strings};
    if e.code!=0 {
        ntasm_nxo.release(object);
        return ntasm_nxo.WriteResult{code:e.code,bytes:empty};
    }
    // The writer validates what it writes (nxo.validate), so an object this
    // module got wrong comes back as the writer's refusal, not as bytes.
    let written:ntasm_nxo.WriteResult=ntasm_nxo.emit(object);
    ntasm_nxo.release(object);
    report[2]=e.at;report[3]=n;
    if written.code!=0 {
        let fault:buf<u8>=written.bytes;
        // THE WRITER'S OWN CODE IS TAKEN BEFORE THE WRITER'S RECORD IS FREED:
        // the record is ours here, because it is not the one this module
        // returns.
        let writer_code:u64=written.code;
        rt_free(runtime(),fault);
        rt_free(runtime(),written);
        fail(e,writer_code,0);
        return ntasm_nxo.WriteResult{code:e.code,bytes:empty};
    }
    rt_free(runtime(),empty);
    return written;
}

// The state's buffers, freed on every path out of `build`.
fn release_state(e:E)->u64 {
    let tx:buf<u8>=e.text;let en:buf<u8>=e.enc;let fz:buf<u64>=e.fixes;let rz:buf<u64>=e.rels;
    let defs:buf<u64>=e.defs;let slots:buf<u64>=e.slots;let done:buf<u64>=e.done;
    let place:buf<u64>=e.place;let extent:buf<u64>=e.extent;let used:buf<u64>=e.used;
    let funcs:buf<u64>=e.funcs;let prof_cache:buf<u64>=e.prof_cache;
    rt_free(runtime(),tx);rt_free(runtime(),en);rt_free(runtime(),fz);rt_free(runtime(),rz);
    rt_free(runtime(),defs);rt_free(runtime(),slots);rt_free(runtime(),done);rt_free(runtime(),place);
    rt_free(runtime(),extent);rt_free(runtime(),used);
    rt_free(runtime(),funcs);rt_free(runtime(),prof_cache);
    rt_free(runtime(),e);
    return 0;
}
fn finish_report(e:E,report:buf<u64>)->u64 {
    if e.code!=0 {
        report[0]=e.record;report[1]=e.code;report[2]=0;report[3]=0;
        if e.record!=0 && e.record<=e.count { report[2]=K(e,e.record); }
    } else { report[0]=e.count; }
    return 0;
}

// ===========================================================================
// build -- a verified Machine IR image in, an NXO container out.
// report[0..3]: on refusal (record, code, kind, 0); on success
// (records, 0, text bytes, symbols). The caller owns `bytes` either way.
// ===========================================================================
export fn build(words:buf<u64>,count:u64,source:buf<u8>,report:buf<u64>)->ntasm_nxo.WriteResult {
    let nothing:buf<u8>=alloc(runtime(),0);
    if len(report)<4 { return ntasm_nxo.WriteResult{code:800,bytes:nothing}; }
    report[0]=0;report[1]=0;report[2]=0;report[3]=0;
    if count==0 || len(words)<machine_ir.HEADER_WORDS()+count*machine_ir.NODE_WORDS() {
        report[1]=E_IMAGE();
        return ntasm_nxo.WriteResult{code:E_IMAGE(),bytes:nothing};
    }
    let checked:buf<u64>=alloc(runtime(),8);
    let verify_code:u64=machine_ir.verify(words,count,checked);
    if verify_code!=0 {
        report[0]=checked[3]; report[1]=E_IMAGE(); report[2]=verify_code;
        rt_free(runtime(),checked);
        return ntasm_nxo.WriteResult{code:E_IMAGE(),bytes:nothing};
    }
    rt_free(runtime(),checked);
    let values:u64=words[6];
    let text:buf<u8>=alloc(runtime(),count*256+4096);
    let defs:buf<u64>=alloc(runtime(),values+1);
    let slots:buf<u64>=alloc(runtime(),values+1);
    let done:buf<u64>=alloc(runtime(),count+1);
    let place:buf<u64>=alloc(runtime(),count+1);
    let extent:buf<u64>=alloc(runtime(),count+1);
    let used:buf<u64>=alloc(runtime(),count+1);
    let fixes:buf<u64>=alloc(runtime(),count*4+4);
    let rels:buf<u64>=alloc(runtime(),count*4+4);
    let enc:buf<u8>=alloc(runtime(),32);
    // THE TWO NEW TABLES, owned by this build like the others: the index of
    // the unit's function records, and the lazy ABI profile cache.
    let funcs:buf<u64>=alloc(runtime(),count+1);
    let prof_cache:buf<u64>=alloc(runtime(),count+1);
    let e:E=E{words:words,count:count,source:source,values:values,text:text,at:0,
        defs:defs,slots:slots,done:done,place:place,extent:extent,used:used,
        fixes:fixes,fix_count:0,rels:rels,rel_count:0,enc:enc,
        saved:0,keep:0,cells:0,args:0,mask:0,raw_mask:0,func:0,fend:0,block:0,bend:0,code:0,record:0,current:0,last_call:0,calls:0,
        unit_profile:1,funcs:funcs,func_n:0,prof_cache:prof_cache};
    let mut i:u64=0;
    while i<=values { defs[i]=0; slots[i]=0; i=i+1; }
    i=0;
    while i<=count { done[i]=0; place[i]=0; extent[i]=0; used[i]=0; prof_cache[i]=0; i=i+1; }
    // THE FUNCTION INDEX, filled in ONE PASS, in record order. `callee` used
    // to walk every record of the image to find the function records of the
    // unit; the index holds exactly those records, in the same order, so the
    // first match that wins is the one that won before.
    let mut fn_n:u64=0;
    let mut q:u64=1;
    while q<=count {
        if K(e,q)==2051 && W(e,q,16)==1 { funcs[fn_n]=q; fn_n=fn_n+1; }
        q=q+1;
    }
    e.func_n=fn_n;
    // THE UNIT PROFILE, read ONCE for this build.
    e.unit_profile=unit_profile_of(e);
    // value -> its one defining record. A `mir_vreg` DECLARES a value (a
    // `let` local, a clobbered register) and the record that computes it is
    // its definition, so a vreg yields to a computation. Two computations of
    // one value are an image this emitter cannot read, and it says so rather
    // than taking either.
    let mut r:u64=1;
    while r<=count && e.code==0 {
        let v:u64=W(e,r,4);
        if v!=0 {
            if v>values { fail(e,E_IMAGE(),r); }
            else if K(e,r)==2056 { if defs[v]==0 { defs[v]=r; } }
            else if defs[v]!=0 && K(e,defs[v])!=2056 { fail(e,E_IMAGE(),r); }
            else { defs[v]=r; }
        }
        r=r+1;
    }
    r=1;
    while r<=count && e.code==0 {
        if K(e,r)==2051 && W(e,r,16)==1 && W(e,r,5)!=0 { lower_function(e,r); }
        r=r+1;
    }
    // The block displacements, now that every block has an offset.
    i=0;
    while i<e.fix_count && e.code==0 {
        let site:u64=fixes[i*2];
        let target:u64=fixes[i*2+1];
        if target==0 || target>count || place[target]==0 { fail(e,E_IMAGE(),target); }
        else {
            let to:u64=place[target]-1;
            put32_at(e,site,(to+4294967296-site-4)&4294967295);
        }
        i=i+1;
    }
    if e.code==0 && e.at==0 { fail(e,E_IMAGE(),1); }
    if e.code==0 {
        rt_free(runtime(),nothing);
        let result:ntasm_nxo.WriteResult=assemble(e,report);
        finish_report(e,report);
        release_state(e);
        return result;
    }
    finish_report(e,report);
    let code:u64=e.code;
    release_state(e);
    return ntasm_nxo.WriteResult{code:code,bytes:nothing};
}
