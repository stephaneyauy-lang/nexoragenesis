    e.calls=0;let mut max_args:u64=2;let mut stack_args:u64=0;
    let mut c:u64=f+1;
    while c<fend {
        if K(e,c)==2076 || K(e,c)==2087 {
            e.calls=e.calls+1;let argc:u64=W(e,c,14);if argc>max_args { max_args=argc; }
            let mut target:u64=0;
            if K(e,c)==2087 { target=W(e,c,15); }else { target=callee(e,W(e,c,5)); }
            if target!=0 && abi_profile(e,target)==2 && W(e,target,14)>4 {
