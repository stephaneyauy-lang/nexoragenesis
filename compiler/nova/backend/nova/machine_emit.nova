                if K(e,r)==2086 { n=n+1; }
            }
        }
        r=r+1;
    }
    e.cells=n; e.args=n+18; n=n+17+max_args;
    e.mask=declared_mask(e,f); e.raw_mask=raw_clobbers(e,f);
    let place:buf<u64>=e.place;
