module machine_emit;

import machine_ir;
import x64_fixed;
import ntasm_nxo;
import effects;

// MACHINE IR/1.0 -> x86-64 -> NXO, common frame emitter.
// Reads a verified MIR image and declaration/name spans only: no AST, NTIR,
// source reparse, allocation fallback or C producer.
//
// Every immutable computed value has an eight-byte slot. Sixteen GPR cells
// and a flags cell are separate runtime state shared by all blocks. Register
// reads snapshot a declared slice at their execution site; 8/16-bit writes
// replace that slice, 32-bit writes zero the high half, 64-bit writes replace
// the family. Immutable IN parameter snapshots do not alias these cells;
// OUT/INOUT names read the current bound cell, according to resolved ABI flags.
//
// Incoming registers and flags are captured before scratch work. Instructions
// capture flags immediately, before normalization or partial-write mechanics.
// A boolean branch reads a value; a jcc restores the runtime flags cell.
//
// An explicit call mask is checked against the callee's MIR declaration and
// output bindings. Arguments are materialized before physical state is loaded.
// Returned physical outputs update the cells. At return, families outside
// the declared clobbers/output set are restored; declared outputs are published
// through their saved slots, and flags follow the declared preservation rule.
// rsp is aligned to sixteen bytes at calls, with thirty-two-byte home space.
//
// Image order is not dependency order: definitions later in the same block
// are needed recursively before use. Parameters and literals may be read from
// another block. Runtime cells carry register flow across joins and back edges.
// E980..985 are emitter diagnostics; report is (record, code, kind, 0).
export fn E_IMAGE()->u64 { return 980; }
export fn E_FORM()->u64 { return 981; }
export fn E_CALL()->u64 { return 982; }
export fn E_CONTRACT()->u64 { return 983; }
export fn E_LAYOUT()->u64 { return 984; }
export fn E_ENCODE()->u64 { return 985; }

struct E {
    words:buf<u64>, count:u64, source:buf<u8>, values:u64,
    text:buf<u8>, at:u64,
    defs:buf<u64>, slots:buf<u64>, done:buf<u64>, place:buf<u64>,
    extent:buf<u64>, used:buf<u64>,
    fixes:buf<u64>, fix_count:u64, rels:buf<u64>, rel_count:u64,
    enc:buf<u8>,
    saved:u64, keep:u64, cells:u64, args:u64, mask:u64, raw_mask:u64, func:u64, fend:u64, block:u64, bend:u64,
    code:u64, record:u64, current:u64, last_call:u64, calls:u64,
    // THE ABI PROFILE, SPLIT IN TWO. `unit_profile` is the profile of the
    // UNIT, read once per build; `prof_cache` holds one entry per record, the
    // profile of that function computed on first use and stored PLUS ONE, so
    // a stored zero means "not computed" and a computed zero -- an unknown
    // digest -- is stored as one. `funcs` is the index of the function records
    // of the unit, in record order, and `func_n` its length.
    unit_profile:u64, funcs:buf<u64>, func_n:u64, prof_cache:buf<u64>
}
// A growable-by-bound text: contracts and names are built into one of these
// and copied out by length.
struct T { bytes:buf<u8>, at:u64, cap:u64, bad:u64 }

// ---- the image -------------------------------------------------------------
fn W(e:E,r:u64,i:u64)->u64 {
    let w:buf<u64>=e.words;
    return w[machine_ir.HEADER_WORDS()+(r-1)*machine_ir.NODE_WORDS()+i];
}
fn K(e:E,r:u64)->u64 { return W(e,r,0); }
fn fail(e:E,code:u64,record:u64)->u64 {
    if e.code==0 { e.code=code; e.record=record; }
    return e.code;
}
// The record after the last record of the subtree rooted at r: the first
// later record whose depth is not deeper than r's. Preorder makes this exact.
fn subtree_end(e:E,r:u64)->u64 {
    let depth:u64=W(e,r,19);
    let mut n:u64=r+1;
    while n<=e.count && W(e,n,19)>depth { n=n+1; }
    return n;
}
fn same_span(e:E,a0:u64,a1:u64,b0:u64,b1:u64)->bool {
    let s:buf<u8>=e.source;
    if a0>a1 || b0>b1 || a1>len(s) || b1>len(s) { return false; }
    if a1-a0!=b1-b0 { return false; }
    let mut i:u64=0;
    while i<a1-a0 { if s[a0+i]!=s[b0+i] { return false; } i=i+1; }
    return true;
}

// ---- bytes -----------------------------------------------------------------
fn put(e:E,byte:u64)->u64 {
    let t:buf<u8>=e.text;
    if e.at>=len(t) { return fail(e,E_LAYOUT(),e.func); }
    t[e.at]=u8(byte&255);
    e.at=e.at+1;
    return 0;
}
fn put32_at(e:E,at:u64,value:u64)->u64 {
    let t:buf<u8>=e.text;
    t[at]=u8(value&255);t[at+1]=u8((value>>8)&255);
    t[at+2]=u8((value>>16)&255);t[at+3]=u8((value>>24)&255);
    return 0;
}
// THE ENCODERS ARE x64_fixed's, unchanged: out[0] is the length and out[1..]
// the bytes, and a non-zero answer is the encoder's refusal, reported as
// E_ENCODE rather than as a guess at the bytes.
fn emit_bytes(e:E,rc:u64)->u64 {
    if e.code!=0 { return e.code; }
    if rc!=0 { return fail(e,E_ENCODE(),e.func); }
    let b:buf<u8>=e.enc;
    let n:u64=b[0];
    let mut i:u64=1;
    while i<=n && e.code==0 { let byte:u64=b[i]; put(e,byte); i=i+1; }
    return e.code;
}
fn op0(e:E,name:buf<u8>)->u64 { let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode(name,0,1,0,b)); }
fn rr(e:E,name:buf<u8>,dst:u64,src:u64,width:u64)->u64 {
    let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode_rr(name,2,dst,src,width,1,0,b));
}
fn ri(e:E,name:buf<u8>,dst:u64,width:u64,imm:u64)->u64 {
    let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode_ri(name,2,dst,width,imm,0,1,0,b));
}
fn un(e:E,name:buf<u8>,reg:u64)->u64 {
    let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode_unary(name,1,reg,64,1,0,b));
}
fn shift_imm(e:E,name:buf<u8>,reg:u64,amount:u64)->u64 {
    let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode_shift_imm(name,2,reg,64,amount,1,0,b));
}
fn shift_cl(e:E,name:buf<u8>,width:u64)->u64 {
    let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode_shift_cl(name,2,0,width,1,0,1,0,b));
}
fn setcc(e:E,name:buf<u8>)->u64 {
    let b:buf<u8>=e.enc; return emit_bytes(e,x64_fixed.encode_setcc(name,1,2,8,1,0,b));
}
fn push(e:E,reg:u64)->u64 {
    let b:buf<u8>=e.enc; let name:buf<u8>="push";
    let rc:u64=emit_bytes(e,x64_fixed.encode_stack(name,1,1,64,reg,0,1,0,b));
    rt_free(runtime(),name);
    return rc;
}
fn pop(e:E,reg:u64)->u64 {
    let b:buf<u8>=e.enc; let name:buf<u8>="pop";
    let rc:u64=emit_bytes(e,x64_fixed.encode_stack(name,1,1,64,reg,0,1,0,b));
    rt_free(runtime(),name);
    return rc;
}
// THE NAME IS BORROWED BY THE ENCODER: x64_fixed reads the mnemonic and keeps
// nothing. These wrappers OWN the name they are given, because the name is a
// literal the caller created for ONE call: the encoder has answered, the
// literal is freed, and the answer is the encoder's own, whatever it was. A
// name used more than once is NOT given to them.
fn op0_owned(e:E,name:buf<u8>)->u64 { let r:u64=op0(e,name); rt_free(runtime(),name); return r; }
fn rr_owned(e:E,name:buf<u8>,dst:u64,src:u64,width:u64)->u64 { let r:u64=rr(e,name,dst,src,width); rt_free(runtime(),name); return r; }
fn ri_owned(e:E,name:buf<u8>,dst:u64,width:u64,imm:u64)->u64 { let r:u64=ri(e,name,dst,width,imm); rt_free(runtime(),name); return r; }
fn un_owned(e:E,name:buf<u8>,reg:u64)->u64 { let r:u64=un(e,name,reg); rt_free(runtime(),name); return r; }
fn shift_imm_owned(e:E,name:buf<u8>,reg:u64,amount:u64)->u64 { let r:u64=shift_imm(e,name,reg,amount); rt_free(runtime(),name); return r; }
fn shift_cl_owned(e:E,name:buf<u8>,width:u64)->u64 { let r:u64=shift_cl(e,name,width); rt_free(runtime(),name); return r; }
fn setcc_owned(e:E,name:buf<u8>)->u64 { let r:u64=setcc(e,name); rt_free(runtime(),name); return r; }
fn jump_to_owned(e:E,name:buf<u8>,conditional:bool,target_block:u64)->u64 { let r:u64=jump_to(e,name,conditional,target_block); rt_free(runtime(),name); return r; }
// mov between a register and [base+disp]; direction 0 loads, 1 stores.
fn mem(e:E,direction:u64,reg:u64,width:u64,base:u64,disp:u64)->u64 {
    let b:buf<u8>=e.enc;
    return emit_bytes(e,x64_fixed.encode_mov_memory(direction,reg,width,base,16,1,disp,0,1,0,b));
}
fn negate(value:u64)->u64 { return (~value)+1; }
// The rel32 of a near jump, call or jcc is the last four bytes of the
// instruction x64_fixed just wrote, so the site is e.at-4 after the write.
fn jump_to(e:E,name:buf<u8>,conditional:bool,target_block:u64)->u64 {
    let b:buf<u8>=e.enc;
    if conditional { emit_bytes(e,x64_fixed.encode_jcc(name,1,4,0,0,0,1,0,b)); }
    else { emit_bytes(e,x64_fixed.encode_control(name,1,4,0,0,0,1,0,b)); }
    if e.code!=0 { return e.code; }
    let f:buf<u64>=e.fixes;
    if e.fix_count*2+2>len(f) { return fail(e,E_LAYOUT(),target_block); }
    f[e.fix_count*2]=e.at-4;f[e.fix_count*2+1]=target_block;
    e.fix_count=e.fix_count+1;
    return 0;
}
// A REL32 relocation against the object symbol of a declaration record
// (a function, an import or a data). The symbol index is not known until the
// table is sorted, so the declaration record is kept and resolved at the end.
fn relocate(e:E,declaration:u64)->u64 {
    if e.code!=0 { return e.code; }
    let r:buf<u64>=e.rels;
    if e.rel_count*2+2>len(r) { return fail(e,E_LAYOUT(),declaration); }
    r[e.rel_count*2]=e.at-4;r[e.rel_count*2+1]=declaration;
    e.rel_count=e.rel_count+1;
    let used:buf<u64>=e.used;
    used[declaration]=1;
    return 0;
}

// ---- values ------------------------------------------------------------------
fn frame(e:E,slot:u64)->u64 { return negate(e.saved+8*slot); }
fn definer(e:E,value:u64)->u64 {
    let defs:buf<u64>=e.defs;
    if value==0 || value>=len(defs) { return 0; }
    return defs[value];
}
fn local_access(e:E,r:u64)->bool {
    if K(e,r)==2086 { return true; }
    if K(e,r)!=2067 { return false; }
    let d:u64=definer(e,W(e,r,5));
    return d!=0 && K(e,d)==2086;
}
// Makes sure the record defining `value` has been lowered, lowering it now
// when it is a later record of the current block. Constants need nothing.
fn need(e:E,value:u64)->u64 {
    if e.code!=0 { return e.code; }
    let d:u64=definer(e,value);
    if d==0 { return fail(e,E_IMAGE(),e.func); }
    if K(e,d)==2058 { return 0; }
    if K(e,d)==2056 && W(e,d,22)!=1 { return fail(e,E_FORM(),d); }
    if d<=e.func || d>=e.fend { return fail(e,E_FORM(),d); }
    // Cross-block immutable values require proof at the actual use site,
    // not at an auxiliary metadata record or just at emission time.
    if K(e,d)!=2054 && W(e,d,16)!=e.block {
        if machine_ir.value_available_at(e.words,e.count,e.current,value)==false { return fail(e,E_FORM(),d); }
        let seen:buf<u64>=e.done;
        if seen[d]==0 { return fail(e,E_FORM(),d); }
        return 0;
    }
    let done:buf<u64>=e.done;
    if done[d]!=0 { return 0; }
    // A memory snapshot/initialization belongs to its execution site.
    // Never pull it forward recursively while satisfying a dependency.
    if local_access(e,d) { return fail(e,E_FORM(),d); }
    if d>e.block && d<e.bend {
        let current:u64=e.current;let code:u64=lower(e,d);e.current=current;return code;
    }
    return fail(e,E_FORM(),d);
}
// Loads a value into a register. A `mir_const` is its literal, materialized
// in place; anything else is read from its slot, and `need` must have run.
fn ld(e:E,reg:u64,value:u64)->u64 {
    if e.code!=0 { return e.code; }
    let d:u64=definer(e,value);
    if d==0 { return fail(e,E_IMAGE(),e.func); }
    if K(e,d)==2058 { let mov:buf<u8>="mov"; return ri_owned(e,mov,reg,64,W(e,d,5)); }
    let done:buf<u64>=e.done;
    let slots:buf<u64>=e.slots;
    if (K(e,d)==2056 && W(e,d,22)!=1) || done[d]==0 || slots[value]==0 { return fail(e,E_FORM(),d); }
    if K(e,d)==2054 && (W(e,d,13)&(machine_ir.FLAG_DIR_OUT()+machine_ir.FLAG_DIR_INOUT()))!=0 {
        mem(e,0,reg,64,5,cell_frame(e,W(e,d,15)));
        if W(e,d,21)!=0 { let shift:buf<u8>="shr"; shift_imm_owned(e,shift,reg,W(e,d,21)); }
        return normalize(e,reg,W(e,d,9),W(e,d,10));
    }
    mem(e,0,reg,64,5,frame(e,slots[value]));
    if K(e,d)==2054 {
        if W(e,d,21)!=0 { let shift:buf<u8>="shr"; shift_imm_owned(e,shift,reg,W(e,d,21)); }
        normalize(e,reg,W(e,d,9),W(e,d,10));
    }
    return e.code;
}
fn st(e:E,value:u64,reg:u64)->u64 {
    if e.code!=0 { return e.code; }
    let slots:buf<u64>=e.slots;
    if value==0 || value>=len(slots) || slots[value]==0 { return fail(e,E_FORM(),e.func); }
    return mem(e,1,reg,64,5,frame(e,slots[value]));
}
// The width two operands are compared at: the wider of the two definitions,
// rounded up to a machine width. A literal `0` is typed at 8 bits and a
// register at 64, and comparing at 8 would drop the register's high bytes.
fn operand_width(e:E,a:u64,b:u64)->u64 {
    let mut w:u64=0;
    let da:u64=definer(e,a);
    let db:u64=definer(e,b);
    if da!=0 && W(e,da,9)>w { w=W(e,da,9); }
    if db!=0 && W(e,db,9)>w { w=W(e,db,9); }
    if w<=8 { return 8; }
    if w<=16 { return 16; }
    if w<=32 { return 32; }
    return 64;
}

// ---- operations --------------------------------------------------------------
fn arith(e:E,r:u64,op:u64,a:u64,b:u64)->u64 {
    let out:u64=W(e,r,4);
    if op==machine_ir.OP_COPY() {
        let mut src:u64=a;
        if W(e,r,8)>=2 && b!=0 { src=b; }
        let folded:Immediate=immediate_operand(e,src,0);
        if K(e,r)==2065 && folded.present && folded.signed<=1 { let mov:buf<u8>="mov"; ri_owned(e,mov,0,64,folded.value); }
        else { need(e,src);ld(e,0,src); }
        // THE IMMEDIATE IS A CELL, and its last read is the one above.
        rt_free(runtime(),folded);
        return st(e,out,0);
    }
    let predicate:bool=op>=machine_ir.OP_EQ() && op<=machine_ir.OP_GE_S();
    let width:u64=W(e,r,9);
    let folded_b:Immediate=immediate_operand(e,b,0);
    let folded_raw:bool=K(e,r)==2065 && folded_b.present && folded_b.signed<=1;
    need(e,a); if folded_raw==false { need(e,b); }
    ld(e,0,a);
    if folded_raw { let mov:buf<u8>="mov"; ri_owned(e,mov,1,64,folded_b.value); }
    else { ld(e,1,b); }
    // THE IMMEDIATE IS A CELL, and its last read is the one above.
    rt_free(runtime(),folded_b);
    if predicate==false { normalize(e,0,width,W(e,r,10)); normalize(e,1,width,W(e,r,10)); }
    // A zero-count shift preserves source flags, not flags from scratch normalization.
    if (W(e,r,22)&4)!=0 { restore_flags(e); }
    let mut result:u64=0;
    if op==machine_ir.OP_ADD() { let n:buf<u8>="add"; rr_owned(e,n,0,1,width); }
    else if op==machine_ir.OP_SUB() { let n:buf<u8>="sub"; rr_owned(e,n,0,1,width); }
    else if op==machine_ir.OP_AND() { let n:buf<u8>="and"; rr_owned(e,n,0,1,width); }
    else if op==machine_ir.OP_OR() { let n:buf<u8>="or"; rr_owned(e,n,0,1,width); }
    else if op==machine_ir.OP_XOR() { let n:buf<u8>="xor"; rr_owned(e,n,0,1,width); }
    else if op==machine_ir.OP_MUL() {
        let n:buf<u8>="imul"; let encoded:buf<u8>=e.enc;
        let mut bits:u64=width; if bits==8 { bits=64; }
        emit_bytes(e,x64_fixed.encode_imul(n,2,0,0,0,1,0,0,bits,1,1,0,bits,16,16,1,0,0,1,0,encoded));
        rt_free(runtime(),n);
    }
    else if op==machine_ir.OP_DIV() || op==machine_ir.OP_REM() {
        if W(e,r,10)==1 { let c:buf<u8>="cqo"; op0_owned(e,c); let n:buf<u8>="idiv"; un_owned(e,n,1); }
        else { let m:buf<u8>="mov"; ri_owned(e,m,2,32,0); let n:buf<u8>="div"; un_owned(e,n,1); }
        if op==machine_ir.OP_REM() { result=2; }
    }
    else if op==machine_ir.OP_SHL() { let n:buf<u8>="shl"; shift_cl_owned(e,n,width); }
    else if op==machine_ir.OP_SHR() { let n:buf<u8>="shr"; shift_cl_owned(e,n,width); }
    else if op==machine_ir.OP_SAR() { let n:buf<u8>="sar"; shift_cl_owned(e,n,width); }
    else if op>=machine_ir.OP_EQ() && op<=machine_ir.OP_GE_S() {
        // rdx is cleared BEFORE the compare: a mov does not touch the flags,
        // and setcc writes only dl, so the result is exactly 0 or 1.
        let m:buf<u8>="mov"; ri_owned(e,m,2,32,0);
        let c:buf<u8>="cmp"; rr_owned(e,c,0,1,operand_width(e,a,b));
        result=2;
        if op==machine_ir.OP_EQ() { let n:buf<u8>="sete"; setcc_owned(e,n); }
        else if op==machine_ir.OP_NE() { let n:buf<u8>="setne"; setcc_owned(e,n); }
        else if op==machine_ir.OP_LT_U() { let n:buf<u8>="setb"; setcc_owned(e,n); }
        else if op==machine_ir.OP_LT_S() { let n:buf<u8>="setl"; setcc_owned(e,n); }
        else if op==machine_ir.OP_GT_U() { let n:buf<u8>="seta"; setcc_owned(e,n); }
        else if op==machine_ir.OP_GT_S() { let n:buf<u8>="setg"; setcc_owned(e,n); }
        else if op==machine_ir.OP_LE_U() { let n:buf<u8>="setbe"; setcc_owned(e,n); }
        else if op==machine_ir.OP_LE_S() { let n:buf<u8>="setle"; setcc_owned(e,n); }
        else if op==machine_ir.OP_GE_U() { let n:buf<u8>="setae"; setcc_owned(e,n); }
        else { let n:buf<u8>="setge"; setcc_owned(e,n); }
    }
    else { return fail(e,E_FORM(),r); }
    if (W(e,r,22)&4)!=0 { capture_flags(e); }
    if predicate==false { normalize(e,result,width,W(e,r,10)); }
    return st(e,out,result);
}
fn emit_unary(e:E,r:u64)->u64 {
    let op:u64=W(e,r,14);
    let a:u64=W(e,r,5);
    // `-` and `~` below 64 bits: refused, as a narrow operation is (`exact_narrow`).
    let width:u64=W(e,r,9);
    need(e,a);ld(e,0,a);
    if op==machine_ir.OP_NEG() { let n:buf<u8>="neg"; un_width_owned(e,n,0,width); normalize(e,0,width,W(e,r,10)); return st(e,W(e,r,4),0); }
    if op==machine_ir.OP_NOT() { let n:buf<u8>="not"; un_width_owned(e,n,0,width); normalize(e,0,width,W(e,r,10)); return st(e,W(e,r,4),0); }
    if op==machine_ir.OP_LNOT() {
        let m:buf<u8>="mov"; ri_owned(e,m,2,32,0);
        let c:buf<u8>="cmp"; ri_owned(e,c,0,64,0);
        let n:buf<u8>="sete"; setcc_owned(e,n);
        return st(e,W(e,r,4),2);
    }
    return fail(e,E_FORM(),r);
}
// THE WIDTH INVARIANT for the records whose width is a DECLARATION's: a
// conversion's target, a load's element, a call's declared result. Such a
// value narrower than 64 bits is held in its slot zero-extended when unsigned
// and sign-extended when signed (word 10 is 1), so a comparison or a 64-bit
// read of the slot sees the value the type means: a signed `i32` element of -5
// is not 4294967291. Widths other than 8, 16 and 32 are left alone: 64 has
// nothing above it and a boolean is 0 or 1. Operations are NOT normalized
// after the source width operation.
fn normalize(e:E,reg:u64,width:u64,signed:u64)->u64 {
    if e.code!=0 { return e.code; }
    // A typed boolean call only guarantees its result bit. Clear the upper
    // register bits before storing/widening it, just as for narrow integers.
    if width==1 { let mask:buf<u8>="and";return ri_owned(e,mask,reg,64,1); }
    if width!=8 && width!=16 && width!=32 { return 0; }
    let l:buf<u8>="shl"; shift_imm_owned(e,l,reg,64-width);
    if signed==1 { let s:buf<u8>="sar"; return shift_imm_owned(e,s,reg,64-width); }
    let s:buf<u8>="shr"; return shift_imm_owned(e,s,reg,64-width);
}
// extend: aux is the source signedness, aux2 the bits added (coerce in
// machine_ir.nova). truncate: aux2 the bits removed. The source is widened by
// its own signedness, then the result is normalized to the target's width and
// signedness (`i8 -> u32` of -1 is 0xFFFFFFFF, not 64 one-bits).
fn emit_resize(e:E,r:u64,extend:bool)->u64 {
    let a:u64=W(e,r,5);
    let width:u64=W(e,r,9);
    need(e,a);ld(e,0,a);
    if extend {
        if W(e,r,15)>width { return fail(e,E_FORM(),r); }
        normalize(e,0,width-W(e,r,15),W(e,r,14));
    }
    normalize(e,0,width,W(e,r,10));
    return st(e,W(e,r,4),0);
