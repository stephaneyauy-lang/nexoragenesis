fn restore_flags(e:E)->u64 {
    mem(e,0,2,64,5,cell_frame(e,17)); push(e,2);
    let pf:buf<u8>="popfq"; return op0_owned(e,pf);
}
fn un_width(e:E,name:buf<u8>,reg:u64,width:u64)->u64 {
    let b:buf<u8>=e.enc;
    return emit_bytes(e,x64_fixed.encode_unary(name,1,reg,width,1,0,b));
}
fn un_width_owned(e:E,name:buf<u8>,reg:u64,width:u64)->u64 { let r:u64=un_width(e,name,reg,width); rt_free(runtime(),name); return r; }
fn emit_cell_read(e:E,r:u64)->u64 {
    mem(e,0,0,64,5,cell_frame(e,W(e,r,20)));
    if W(e,r,21)!=0 { let n:buf<u8>="shr"; shift_imm_owned(e,n,0,W(e,r,21)); }
