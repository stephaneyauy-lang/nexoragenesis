fn emit_asm(e:E,r:u64)->u64 {
    let op:u64=W(e,r,14);
    if op==machine_ir.OP_UMUL() { return emit_unsigned_mul(e,r); }
    if op==machine_ir.OP_MUL() { return emit_signed_mul(e,r); }
    immediate_legal(e,r,op); if e.code!=0 { return e.code; }
    physical_form_legal(e,r,op); if e.code!=0 { return e.code; }
    // A decomposed instruction is a marker: its meaning is in the records
    // the lowering built for it (a store's address and value records).
    if W(e,r,15)!=0 { return 0; }
    if W(e,r,4)==0 {
        // `load rbx,[x]` names the value its `mir_load` defines: requiring it
        // HERE keeps the load at the instruction's place in the program.
        let mut i:u64=0;
        while i<W(e,r,8) && i<3 { let v:u64=W(e,r,5+i); if v!=0 { need(e,v); } i=i+1; }
        // Destination and element widths are separate facts.
        if op==machine_ir.OP_LOAD() {
            let access:u64=definer(e,W(e,r,5));
            if access==0 || W(e,access,9)<W(e,r,9) { return fail(e,E_FORM(),r); }
            // The datum read must be as wide as the register written: the
            // reference refuses `load rax,[b]:ptr<user,u8>` (E400), the Nova
            // validation accepted it, and this emitter read eight bytes of a
            // one-byte datum (fourth review, executed). The `mir_load` carries
            // 64 there -- machine_ir's access_width reads the annotation's
            // pointer node, not its element -- so the width compared is the
            // one the named `data` declares.
            let lv:u64=definer(e,W(e,r,5));
            if lv!=0 && K(e,lv)==2067 {
                let ad:u64=definer(e,W(e,lv,5));
                if ad!=0 && K(e,ad)==2066 && W(e,ad,7)!=0 {
                    let datum:u64=named_storage(e,W(e,ad,7));
                    if datum!=0 && K(e,datum)==2060 && W(e,datum,9)!=0 && W(e,datum,9)<W(e,r,9) { return fail(e,E_FORM(),r); }
                }
            }
            return e.code;
        }
        if op==machine_ir.OP_NOP() { return put(e,144); }
        return fail(e,E_FORM(),r);
    }
    // A flags predicate (`cmp`, `test`) is consumed by the conditional jump
    // that names it, which recomputes it in place: flags do not survive the
    // slot traffic between here and the jump.
    if W(e,r,12)==machine_ir.CLASS_PREDICATE() {
        let literal:Immediate=immediate_operand(e,W(e,r,6),0);
        need(e,W(e,r,5)); if literal.present==false || literal.signed>1 { need(e,W(e,r,6)); }
        ld(e,0,W(e,r,5));
        if literal.present && literal.signed<=1 { let mov:buf<u8>="mov";ri_owned(e,mov,1,64,literal.value); }
        else { ld(e,1,W(e,r,6)); }
        // THE IMMEDIATE IS A CELL, and its last read is the one above.
        rt_free(runtime(),literal);
        let mut c:buf<u8>="cmp";
        if op==machine_ir.OP_TEST() { rt_free(runtime(),c);c="test"; }
        let encoded:buf<u8>=e.enc;
        emit_bytes(e,x64_fixed.encode_binary(c,2,1,0,0,W(e,r,9),1,1,0,W(e,r,9),16,16,1,0,0,0,0,1,0,encoded));
        rt_free(runtime(),c);
        return capture_flags(e);
    }
    // Explicit destination width is consumed by the physical operation.
    if machine_width(W(e,r,9))==false { return fail(e,E_FORM(),r); }
    // `div` AND `idiv` AS INSTRUCTIONS are refused (fifth review, 7 October
    // 2026, executed): machine_ir maps both to one OP_DIV, so the signedness
    // `arith` reads (word 10) is the operand's and not the mnemonic's, and the
    // two-operand `idiv rax,rcx` the reference refuses (E400) ran unsigned.
    // A division in an EXPRESSION carries its type's signedness and is kept.
    if op==machine_ir.OP_DIV() || op==machine_ir.OP_REM() { return fail(e,E_FORM(),r); }
    if op==machine_ir.OP_NEG() || op==machine_ir.OP_NOT() {
        need(e,W(e,r,5)); ld(e,0,W(e,r,5));
        let mut name:buf<u8>="neg"; if op==machine_ir.OP_NOT() { rt_free(runtime(),name);name="not"; }
        un_width_owned(e,name,0,W(e,r,9));
        if (W(e,r,22)&4)!=0 { capture_flags(e); }
        normalize(e,0,W(e,r,9),W(e,r,10)); return st(e,W(e,r,4),0);
    }
    return arith(e,r,op,W(e,r,5),W(e,r,6));
}
fn lower(e:E,r:u64)->u64 {
    if e.code!=0 { return e.code; }
    let done:buf<u64>=e.done;
    if done[r]!=0 { return 0; }
    e.current=r;done[r]=1;
    let kind:u64=K(e,r);
    if kind==2058 || kind==2057 || kind==2082 || kind==2083 || kind==2084 || kind==2063 || kind==2064 { return 0; }
    if kind==2056 && W(e,r,22)==1 { return emit_cell_read(e,r); }
    if kind==2055 || kind==2056 || kind==2062 || kind==2080 { return 0; }
    if kind==2069 || kind==2070 || kind==2071 {
        let folded:Immediate=immediate_operand(e,W(e,r,4),0);
        if folded.present && folded.signed<=1 {
            let mov:buf<u8>="mov"; ri_owned(e,mov,0,64,folded.value);
            // THE IMMEDIATE IS A CELL, and its last read is the one above.
            rt_free(runtime(),folded);
            normalize(e,0,W(e,r,9),W(e,r,10)); return st(e,W(e,r,4),0);
        }
        rt_free(runtime(),folded);
    }
    if kind==2069 { return arith(e,r,machine_ir.OP_COPY(),W(e,r,5),0); }
