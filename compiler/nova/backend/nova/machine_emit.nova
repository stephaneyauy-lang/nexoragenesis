// Same width, another signedness: the bits are the value's, the
// normalization is the new signedness's (`u32 -> i32` of 0xFFFFFFFF is -1).
fn emit_convert(e:E,r:u64)->u64 {
    let a:u64=W(e,r,5);
    need(e,a);ld(e,0,a);
    normalize(e,0,W(e,r,9),W(e,r,10));
    return st(e,W(e,r,4),0);
}
fn machine_width(width:u64)->bool { return width==8 || width==16 || width==32 || width==64; }
// The declaration a symbol names: a storage `data` first, then a function.
fn named_storage(e:E,symbol:u64)->u64 {
    if symbol==0 || symbol>e.count || K(e,symbol)!=2057 { return 0; }
    let s0:u64=W(e,symbol,5);
    let s1:u64=W(e,symbol,6);
    let mut r:u64=1;
    while r<=e.count {
        if K(e,r)==2060 && W(e,r,16)==1 && (W(e,r,13)&(machine_ir.FLAG_RDATA()+machine_ir.FLAG_WDATA()))!=0 {
            if same_span(e,s0,s1,W(e,r,6),W(e,r,7)) { return r; }
        }
        r=r+1;
    }
    return callee(e,symbol);
}
fn emit_address(e:E,r:u64)->u64 {
    let base:u64=W(e,r,5);
    let index:u64=W(e,r,6);
    let symbol:u64=W(e,r,7);
    let scale:u64=W(e,r,14);
    let disp:u64=W(e,r,15);
    if base!=0 { need(e,base); }
    if index!=0 { need(e,index); }
    if symbol!=0 {
        let target:u64=named_storage(e,symbol);
        if target==0 { return fail(e,E_FORM(),r); }
        let b:buf<u8>=e.enc;
        emit_bytes(e,x64_fixed.encode_lea(0,64,17,16,1,0,0,1,0,b));
        relocate(e,target);
    } else { let m:buf<u8>="mov"; ri_owned(e,m,0,32,0); }
    let add:buf<u8>="add";
    if base!=0 { ld(e,1,base); rr(e,add,0,1,64); }
    if index!=0 {
        ld(e,1,index);
        let l:buf<u8>="shl";
        if scale==2 { shift_imm(e,l,1,1); }
        if scale==4 { shift_imm(e,l,1,2); }
        if scale==8 { shift_imm(e,l,1,3); }
        rt_free(runtime(),l);
        rr(e,add,0,1,64);
    }
    if disp!=0 { let m:buf<u8>="mov"; ri_owned(e,m,1,64,disp); rr(e,add,0,1,64); }
    rt_free(runtime(),add);
    return st(e,W(e,r,4),0);
}
fn emit_local_cell(e:E,r:u64)->u64 {
    let value:u64=W(e,r,4);let initial:u64=W(e,r,5);
    let slots:buf<u64>=e.slots;
    if value==0 || value>=len(slots) || slots[value]==0 { return fail(e,E_FORM(),r); }
    let offset:u64=frame(e,slots[value]+1);
    need(e,initial);ld(e,2,initial);
    normalize(e,2,W(e,r,14),W(e,r,15));
    mem(e,1,2,64,5,offset);
