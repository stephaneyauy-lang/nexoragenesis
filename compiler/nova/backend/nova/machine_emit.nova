    rt_free(runtime(),name);
    return rc;
}

fn declared_mask(e:E,f:u64)->u64 {
    let mut r:u64=f+1; let end:u64=subtree_end(e,f); let mut mask:u64=0;
    while r<end {
        if K(e,r)==2064 && W(e,r,16)==f { mask=mask|W(e,r,5); }
        if K(e,r)==2054 && W(e,r,16)==f && (W(e,r,13)&(machine_ir.FLAG_DIR_OUT()+machine_ir.FLAG_DIR_INOUT()))!=0 {
            let family:u64=W(e,r,15); if family!=0 && family<=16 { mask=mask|(1<<(family-1)); }
        }
        r=r+1;
    }
    return mask;
}
// The immediate's signedness is operand semantics: positive u64 all-ones
// and literal -1 have identical bits but different encoder legality.
struct Immediate { present:bool, value:u64, signed:u64 }
fn immediate_operand(e:E,value:u64,depth:u64)->Immediate {
    let r:u64=definer(e,value);
    if r==0 || depth>64 { return Immediate{present:false,value:0,signed:0}; }
    let kind:u64=K(e,r); let op:u64=W(e,r,14);
    if kind==2058 { return Immediate{present:true,value:W(e,r,5),signed:0}; }
    if kind==2069 { return immediate_operand(e,W(e,r,5),depth+1); }
    if kind==2071 {
        let inner:Immediate=immediate_operand(e,W(e,r,5),depth+1);
        if inner.present==false { return inner; }
        if inner.signed>1 { return inner; }
        if op==machine_ir.OP_NEG() {
            if inner.signed!=0 { rt_free(runtime(),inner);return Immediate{present:true,value:0,signed:2}; }
            let mut sign:u64=0; if inner.value!=0 { sign=1; }
            // THE CHILD'S VALUE IS TAKEN BEFORE THE CHILD IS FREED.
            let negated:u64=negate(inner.value);
            rt_free(runtime(),inner);
            return Immediate{present:true,value:negated,signed:sign};
        }
        if op==machine_ir.OP_NOT() {
            let mut magnitude:u64=inner.value; if inner.signed==1 { magnitude=negate(magnitude); }
            rt_free(runtime(),inner);
            return Immediate{present:true,value:~magnitude,signed:0};
        }
        rt_free(runtime(),inner);
        return Immediate{present:true,value:0,signed:2};
    }
    if kind==2070 {
        let left:Immediate=immediate_operand(e,W(e,r,5),depth+1);
        let right:Immediate=immediate_operand(e,W(e,r,6),depth+1);
        if left.present==false || right.present==false { rt_free(runtime(),left);rt_free(runtime(),right);return Immediate{present:false,value:0,signed:0}; }
        if left.signed!=0 || right.signed!=0 { rt_free(runtime(),left);rt_free(runtime(),right);return Immediate{present:true,value:0,signed:2}; }
        // THE TWO CHILDREN'S VALUES ARE TAKEN BEFORE THE TWO CHILDREN ARE
        // FREED: the cells are ours, the values are what the caller gets.
        let x:u64=left.value; let y:u64=right.value;
        rt_free(runtime(),left);rt_free(runtime(),right);
        let mut v:u64=0; let mut sign:u64=0;
        if op==machine_ir.OP_ADD() { if x>18446744073709551615-y { return Immediate{present:true,value:0,signed:2}; } v=x+y; }
        else if op==machine_ir.OP_SUB() { v=x-y; if x<y { sign=1; } }
        else if op==machine_ir.OP_MUL() { if y!=0 && x>18446744073709551615/y { return Immediate{present:true,value:0,signed:2}; } v=x*y; }
        else if op==machine_ir.OP_DIV() { if y==0 { return Immediate{present:true,value:0,signed:2}; } v=x/y; }
        else if op==machine_ir.OP_REM() { if y==0 { return Immediate{present:true,value:0,signed:2}; } v=x%y; }
        else if op==machine_ir.OP_AND() { v=x&y; }
        else if op==machine_ir.OP_OR() { v=x|y; }
        else if op==machine_ir.OP_XOR() { v=x^y; }
        else if op==machine_ir.OP_SHL() { if y>=64 { return Immediate{present:true,value:0,signed:2}; } v=x<<y; }
        else if op==machine_ir.OP_SHR() || op==machine_ir.OP_SAR() { if y>=64 { return Immediate{present:true,value:0,signed:2}; } v=x>>y; }
        else if op==machine_ir.OP_EQ() { if x==y { v=1; } }
        else if op==machine_ir.OP_NE() { if x!=y { v=1; } }
        else if op==machine_ir.OP_LT_U() || op==machine_ir.OP_LT_S() { if x<y { v=1; } }
        else if op==machine_ir.OP_LE_U() || op==machine_ir.OP_LE_S() { if x<=y { v=1; } }
        else if op==machine_ir.OP_GT_U() || op==machine_ir.OP_GT_S() { if x>y { v=1; } }
        else if op==machine_ir.OP_GE_U() || op==machine_ir.OP_GE_S() { if x>=y { v=1; } }
        else { return Immediate{present:true,value:0,signed:2}; }
        return Immediate{present:true,value:v,signed:sign};
    }
    return Immediate{present:false,value:0,signed:0};
}
fn immediate_legal(e:E,r:u64,op:u64)->u64 {
    let mut v:u64=W(e,r,6);
    if op==machine_ir.OP_COPY() && W(e,r,8)==1 { v=W(e,r,5); }
    let imm:Immediate=immediate_operand(e,v,0);
    if imm.present==false { rt_free(runtime(),imm);return 0; }
    if imm.signed>1 { rt_free(runtime(),imm);return fail(e,E_FORM(),r); }
    // THE SPELLING IS A LITERAL AT EVERY STEP, and the one it replaces is
    // freed before it is replaced.
    let mut name:buf<u8>="";
    if op==machine_ir.OP_COPY() { rt_free(runtime(),name);name="mov"; }
    else if op==machine_ir.OP_ADD() { rt_free(runtime(),name);name="add"; }
    else if op==machine_ir.OP_SUB() { rt_free(runtime(),name);name="sub"; }
    else if op==machine_ir.OP_CMP() { rt_free(runtime(),name);name="cmp"; }
    else if op==machine_ir.OP_TEST() { rt_free(runtime(),name);name="test"; }
    else if op==machine_ir.OP_AND() { rt_free(runtime(),name);name="and"; }
    else if op==machine_ir.OP_OR() { rt_free(runtime(),name);name="or"; }
    else if op==machine_ir.OP_XOR() { rt_free(runtime(),name);name="xor"; }
    else if op==machine_ir.OP_SHL() { rt_free(runtime(),name);name="shl"; }
    else if op==machine_ir.OP_SHR() { rt_free(runtime(),name);name="shr"; }
    else if op==machine_ir.OP_SAR() { rt_free(runtime(),name);name="sar"; }
    else { rt_free(runtime(),name);return 0; }
    let b:buf<u8>=e.enc; let mut code:u64=0;
    if op==machine_ir.OP_SHL() || op==machine_ir.OP_SHR() || op==machine_ir.OP_SAR() {
        code=x64_fixed.encode_shift_imm(name,2,0,W(e,r,9),imm.value,1,0,b);
    } else {
        code=x64_fixed.encode_binary(name,2,1,0,0,W(e,r,9),2,0,0,0,16,16,1,0,0,imm.value,imm.signed,1,0,b);
    }
    // THE ENCODER HAS BORROWED THE SPELLING AND THE IMMEDIATE, and both are
    // freed now that it has answered.
    rt_free(runtime(),name);rt_free(runtime(),imm);
    // This is validation only: arith emits the physical scratch-register form.
    if code!=0 { return fail(e,E_FORM(),r); }
    return 0;
}

// Find a source register access through grouping copies. Values computed
// from locals, calls or arithmetic are deliberately not register operands.
fn source_register(e:E,value:u64,depth:u64)->u64 {
    let r:u64=definer(e,value);
    if r==0 || depth>64 { return 0; }
    if K(e,r)==2056 && W(e,r,22)==1 { return r; }
    if K(e,r)==2069 { return source_register(e,W(e,r,5),depth+1); }
    return 0;
}
fn physical_form_legal(e:E,r:u64,op:u64)->u64 {
    let mut right:u64=W(e,r,6);
    if op==machine_ir.OP_COPY() && W(e,r,8)==1 { right=W(e,r,5); }
    let source:u64=source_register(e,right,0);
    if source==0 { return 0; }
    let mut family:u64=W(e,r,20); let mut offset:u64=W(e,r,21);
    if family==0 {
        let left:u64=source_register(e,W(e,r,5),0);
        if left==0 { return 0; }
        family=W(e,left,20); offset=W(e,left,21);
    }
    // THE SPELLING IS A LITERAL AT EVERY STEP, and the one it replaces is
    // freed before it is replaced.
    let mut name:buf<u8>="";
    if op==machine_ir.OP_COPY() { rt_free(runtime(),name);name="mov"; }
    else if op==machine_ir.OP_ADD() { rt_free(runtime(),name);name="add"; }
    else if op==machine_ir.OP_SUB() { rt_free(runtime(),name);name="sub"; }
    else if op==machine_ir.OP_CMP() { rt_free(runtime(),name);name="cmp"; }
    else if op==machine_ir.OP_TEST() { rt_free(runtime(),name);name="test"; }
    else if op==machine_ir.OP_AND() { rt_free(runtime(),name);name="and"; }
    else if op==machine_ir.OP_OR() { rt_free(runtime(),name);name="or"; }
    else if op==machine_ir.OP_XOR() { rt_free(runtime(),name);name="xor"; }
    else if op==machine_ir.OP_SHL() { rt_free(runtime(),name);name="shl"; }
    else if op==machine_ir.OP_SHR() { rt_free(runtime(),name);name="shr"; }
    else if op==machine_ir.OP_SAR() { rt_free(runtime(),name);name="sar"; }
    else { rt_free(runtime(),name);return 0; }
    let enc:buf<u8>=e.enc; let mut code:u64=0;
    if op==machine_ir.OP_SHL() || op==machine_ir.OP_SHR() || op==machine_ir.OP_SAR() {
        if W(e,source,21)!=0 || W(e,source,9)!=8 { rt_free(runtime(),name);return fail(e,E_FORM(),r); }
        code=x64_fixed.encode_shift_cl(name,2,family-1,W(e,r,9),W(e,source,20)-1,offset/8,1,0,enc);
    } else {
        code=x64_fixed.encode_binary(name,2,1,family-1,offset/8,W(e,r,9),1,W(e,source,20)-1,W(e,source,21)/8,W(e,source,9),16,16,1,0,0,0,0,1,0,enc);
    }
    // THE ENCODER HAS BORROWED THE SPELLING, and it is freed now that it has
    // answered.
    rt_free(runtime(),name);
