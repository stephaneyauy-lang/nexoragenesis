    // the "Same width" arm). Its bits are the source's; in a slot it is
    // re-normalized to the new signedness (`emit_convert`).
    if kind==2073 { return emit_convert(e,r); }
    if kind==2070 { return arith(e,r,W(e,r,14),W(e,r,5),W(e,r,6)); }
    if kind==2071 { return emit_unary(e,r); }
    if kind==2074 { return emit_resize(e,r,true); }
    if kind==2075 { return emit_resize(e,r,false); }
    if kind==2086 { return emit_local_cell(e,r); }
    if kind==2066 { return emit_address(e,r); }
    if kind==2067 { return emit_load(e,r); }
    if kind==2068 { return emit_store(e,r); }
    if kind==2076 || kind==2087 { return emit_call(e,r); }
    if kind==2065 { emit_asm(e,r); if e.code==0 && (W(e,r,22)&2)!=0 && W(e,r,14)!=machine_ir.OP_UMUL() { emit_cell_write(e,r); } return e.code; }
    return fail(e,E_FORM(),r);
}

// ---- frames ------------------------------------------------------------------
// The registers every function saves, in push order. rax is pushed after them
// when the function declares no result; rsp and rbp are the frame itself.
fn saved_register(i:u64)->u64 {
    if i==0 { return 3; }
    if i==1 { return 1; }
    if i==2 { return 2; }
    if i==3 { return 6; }
    if i==4 { return 7; }
    return i+3;
}
fn epilogue(e:E)->u64 {
    let mut index:u64=0; let mut count:u64=13;
    if e.keep==1 { count=14; }
    while index<count {
        let mut reg:u64=saved_register(index); if index==13 { reg=0; }
        if (e.mask&(1<<reg))!=0 {
            mem(e,0,1,64,5,cell_frame(e,reg+1));
            let output:u64=output_formal(e,e.func,reg+1);
            let mut width:u64=64; let mut offset:u64=0;
            if (e.raw_mask&(1<<reg))==0 && output!=0 && W(e,output,9)<32 {
                width=W(e,output,9); offset=W(e,output,21)/8;
                if offset!=0 { let shift:buf<u8>="shr"; shift_imm_owned(e,shift,1,8); }
            }
            mem(e,1,1,width,5,negate(8*(index+1))+offset);
