fn raw_clobbers(e:E,f:u64)->u64 {
    let mut r:u64=f+1; let end:u64=subtree_end(e,f); let mut mask:u64=0;
    while r<end { if K(e,r)==2064 && W(e,r,16)==f { mask=mask|W(e,r,5); } r=r+1; }
    return mask;
}
fn output_formal(e:E,f:u64,family:u64)->u64 {
    let mut p:u64=0;
    while p<W(e,f,14) {
        let r:u64=formal(e,f,p);
        if r!=0 && W(e,r,15)==family && (W(e,r,13)&(machine_ir.FLAG_DIR_OUT()+machine_ir.FLAG_DIR_INOUT()))!=0 { return r; }
        p=p+1;
    }
    return 0;
}
fn pass_argument(e:E,p:u64,slot:u64)->u64 {
    let f:u64=W(e,p,16);
    if abi_profile(e,f)==2 && W(e,p,14)>=4 {
        mem(e,0,0,64,5,frame(e,slot));
