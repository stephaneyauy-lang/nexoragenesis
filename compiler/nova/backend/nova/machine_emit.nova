    rt_free(runtime(),literal);
    return mem(e,1,2,width,1,0);
}
// The function record a callee symbol names: a local function by its own name,
// an import by its local name or by its qualified target.
fn callee(e:E,symbol:u64)->u64 {
    if symbol==0 || symbol>e.count || K(e,symbol)!=2057 { return 0; }
    let s0:u64=W(e,symbol,5);
    let s1:u64=W(e,symbol,6);
    // THE FUNCTION INDEX, NOT THE WHOLE IMAGE. The records this loop used to
    // visit AND TEST -- the function records of the unit -- are exactly the
    // records the index holds, and the index holds them in the SAME ORDER, so
    // the first match that wins is the record that won before. The two spans
    // compared are the same two: the function's own name span, then the name
    // span of its import target. The symbol is still checked the same way.
    let funcs:buf<u64>=e.funcs;
    let n:u64=e.func_n;
    let mut i:u64=0;
    while i<n {
        let r:u64=funcs[i];
        if W(e,r,8)>=3 && same_span(e,s0,s1,W(e,r,6),W(e,r,7)) { return r; }
        let t:u64=import_target(e,r);
        if t!=0 && same_span(e,s0,s1,W(e,t,5),W(e,t,6)) { return r; }
        i=i+1;
    }
    return 0;
}
// MIR/0.3: an import's qualified target is its first child, a mir_symbol.
fn import_target(e:E,f:u64)->u64 {
    if W(e,f,5)!=0 || f+1>e.count { return 0; }
    if K(e,f+1)!=2057 || W(e,f+1,16)!=f { return 0; }
    return f+1;
}
// The k-th formal of a function record (0-based), or 0.
fn formal(e:E,f:u64,k:u64)->u64 {
    let end:u64=subtree_end(e,f);
    let mut r:u64=f+1;
    while r<end {
        if K(e,r)==2054 && W(e,r,16)==f && W(e,r,14)==k { return r; }
        r=r+1;
    }
    return 0;
}
// The width of the register a parameter is bound to, read off the PARAMETER:
// validation (register_widths.check, 318) has already required a bound
// register's width to equal the declared type's, so the type width IS the
// binding width. It used to be looked up through the `mir_bind` that carries
// the parameter's value, and machine_ir's binding table is module-wide: a
// second function binding the same register overwrote the first one's cell,
// so the first function's parameter looked unbound and was refused 982 for a
// binding it had (independent review, 7 October 2026). 0 when unbound.
fn bound_width(e:E,f:u64,p:u64)->u64 {
    if W(e,p,15)==0 || W(e,p,16)!=f { return 0; }
    return W(e,p,9);
}
fn implicit_family(ordinal:u64)->u64 {
    if ordinal==0 { return 2; }if ordinal==1 { return 3; }
    if ordinal==2 { return 9; }if ordinal==3 { return 10; }return 0;
}
fn formal_family(e:E,p:u64)->u64 {
    let explicit:u64=W(e,p,15);if explicit!=0 { return explicit; }
    return implicit_family(W(e,p,14));
}
fn transport_width(width:u64)->u64 { if width==1 { return 8; }return width; }
fn passable(e:E,f:u64,p:u64)->u64 {
    if (W(e,p,13)&machine_ir.FLAG_DIR_UNREAD())!=0 { return E_CALL(); }
    if machine_width(transport_width(W(e,p,9)))==false { return E_CALL(); }
    let signature:u64=signature_root(e,p);
    if signature==0 || W(e,signature,14)==2 { return E_CONTRACT(); }
    let profile:u64=abi_profile(e,f);
    if profile==0 { return E_CONTRACT(); }
    if profile==2 && W(e,p,14)>=4 {
        if W(e,p,15)!=0 || (W(e,p,13)&(machine_ir.FLAG_DIR_OUT()+machine_ir.FLAG_DIR_INOUT()))!=0 { return E_CALL(); }
        return 0;
    }
    let family:u64=formal_family(e,p);
    if family==0 || family>16 || family==5 || family==6 { return E_CALL(); }
    if profile==2 && (family!=implicit_family(W(e,p,14)) || W(e,p,21)!=0
        || (W(e,p,13)&(machine_ir.FLAG_DIR_OUT()+machine_ir.FLAG_DIR_INOUT()))!=0) { return E_CALL(); }
    return 0;
}
fn cell_frame(e:E,family:u64)->u64 { return frame(e,e.cells+family); }
fn capture_flags(e:E)->u64 {
    let pf:buf<u8>="pushfq"; op0_owned(e,pf); pop(e,2);
    return mem(e,1,2,64,5,cell_frame(e,17));
