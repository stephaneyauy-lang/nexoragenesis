        l.runtime_sig=machine_ir.native_callable(builder,decl,image,tree.node_count,l.origin);
        // THE CLOBBER MASK IS TAKEN FROM THE MIR RIGHT HERE, where the
        // signature's own records exist, and every call site publishes that
        // one answer.
        l.runtime_mask=abi_signature_mask(l);
