        abi_helper_body(l,helper);
        l.origin=l.runtime_origin;
    }
    if l.abi2!=0 && l.code==0 && builder.code==0 && is_later_batch(l) {
        // A LATER BATCH DOES NOT DEFINE THE RUNTIME SIGNATURE, and it FINDS
        // ITS RECORD: the unit walk emitted the import, and the record that
        // came from the import's own node is the one the call sites name.
        l.runtime_sig=record_of_origin(l,l.runtime_import);
