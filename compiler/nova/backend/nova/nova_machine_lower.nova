    // the visited nodes and the LIVE LITERALS. The last one is the marking's
    // own answer to "which literals belong to a reachable function", and it
    // is filled by the same walk that fills the others.
    let mut work:buf<u64>=no;let mut queue:buf<u64>=no;let mut reach:buf<u64>=no;
    let mut fnord:buf<u64>=no;let mut seen:buf<u64>=no;let mut litlive:buf<u64>=no;
    // THE BATCH'S OWN TABLES: the reachable functions in ordinal order, and
    // the ones this object defines.
    let mut batchord:buf<u64>=no;let mut batchsel:buf<u64>=no;
    let mut fnnodes:buf<u64>=no;let mut imports:buf<u64>=no;
