            // is the helper because the lower writes its declaration LAST.
            while cursor<=tree.node_count && image[ntir.HEADER_WORDS()+(cursor-1)*ntir.NODE_WORDS()]-ntir.KIND_BASE()+1!=18 { cursor=cursor+1; }
            if cursor>tree.node_count { bad(l,0,E_AST()); }else { l.helper_origin=cursor; }
        } else {
