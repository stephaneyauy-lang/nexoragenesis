    if l.code==0 { let code:u64=machine_ir.native_finish(builder,image,tree.node_count);if code!=0 { bad(l,0,code); } }
    if l.code==0 { let code:u64=machine_pipeline.finalize_native(decl,tree,words,report);if code!=0 { l.code=code; } }
    else {
        report[0]=l.node;report[1]=0;report[2]=l.code;report[3]=0;
