            // HELPER, so their nodes are the definitions the text wrote.
            while cursor<=tree.node_count && image[ntir.HEADER_WORDS()+(cursor-1)*ntir.NODE_WORDS()]-ntir.KIND_BASE()+1!=18 { cursor=cursor+1; }
            if cursor>tree.node_count { bad(l,0,E_AST()); }else { l.wrapper_origin=cursor; }
            cursor=cursor+1;
            while cursor<=tree.node_count && image[ntir.HEADER_WORDS()+(cursor-1)*ntir.NODE_WORDS()]-ntir.KIND_BASE()+1!=18 { cursor=cursor+1; }
            if cursor>tree.node_count { bad(l,0,E_AST()); }else { l.runtime_origin=cursor; }
            cursor=cursor+1;
