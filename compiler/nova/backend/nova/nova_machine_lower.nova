    }
    if l.batch!=0 { rt_free(runtime(),imports);rt_free(runtime(),batchsel);rt_free(runtime(),batchord); }
    let result:u64=l.code;rt_free(runtime(),funcidx);rt_free(runtime(),l);return result;
}
// THE MONO PROFILE. One source, one module, no spans: the core reads an
// empty multi context, and the scalar and the ABI2 mono paths keep the
// behaviour they had.
export fn lower_profile(source:buf<u8>,nodes:buf<u64>,count:u64,text_out:buf<u8>,text_length:buf<u64>,
                       words:buf<u64>,capacity:u64,report:buf<u64>,abi2:u64)->u64 {
    // THE MULTI CONTEXT IS EMPTY HERE: one source, one module and no spans. The two table slots hold the caller's own buffers, which are then never read, and no buffer is allocated for a context that will not be read.
    return lower_core(source,nodes,count,0,nodes,0,nodes,0,0,text_out,text_length,words,capacity,report,abi2,0);
}
export fn lower(source:buf<u8>,nodes:buf<u64>,count:u64,text_out:buf<u8>,text_length:buf<u64>,
                words:buf<u64>,capacity:u64,report:buf<u64>)->u64 {
    return lower_profile(source,nodes,count,text_out,text_length,words,capacity,report,0);
}
