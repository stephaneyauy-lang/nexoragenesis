    // mode they are the empty buffer, and writing into the empty buffer is
    // a write with no room.
    if closed!=0 || batch!=0 { i=0;while i<=count { reach[i]=0;fnord[i]=0;seen[i]=0;litlive[i]=0;i=i+1; } }
    if batch!=0 { i=0;while i<=count { batchsel[i]=0;imports[i]=0;i=i+1; } }
    i=1;while i<=count && l.code==0 {
