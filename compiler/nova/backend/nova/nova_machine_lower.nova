        else if len(l.many.spans)<l.many.span_count*2 { bad(l,0,E_BOUND()); }
        else if len(l.many.modules)<l.many.span_count*9 { bad(l,0,E_BOUND()); }
        else if l.many.root_idx>=l.many.span_count { bad(l,0,E_BOUND()); }
        else if l.many.program==0 || l.many.program>l.count { bad(l,0,E_AST()); }
        else {
