module nova_machine_lower;
import machine_ir;
import machine_pipeline;
import ntasm_ast;
import ntasm_parser;
import ntir;

// Only declarations travel through NTASM. Every executable instruction below
// is constructed from the resolved Nova AST, through the common MIR writer.
// Provenance: MIR node/origin IDs and line/column belong exclusively to the
// actual declaration NTIR and declaration text. Native body operations use
// the containing function declaration as a contextual origin, not as a claim
// that the executable Nova body exists in that NTIR. No Nova location is
// written into these MIR fields. Native AST refusals (phase 2) report Nova
// node/line/code/column; verifier/emitter refusals retain their own reports
// in declaration coordinates with the MIR record ID. Precise Nova locations
// for emitted records require a separate sidecar, which is not provided here.
export fn E_UNSUPPORTED()->u64 { return 970; }
export fn E_AST()->u64 { return 971; }
export fn E_BOUND()->u64 { return 972; }
// E_ROOT IS THE ROOT SELECTION'S OWN REFUSAL: the root module has no main,
// has more than one, or has its main in another module.
export fn E_ROOT()->u64 { return 973; }
struct V { id:u64, width:u64, sign:u64, class:u64, owned_next:V, length:u64 }
// THE MULTI-SOURCE CONTEXT. It is EMPTY in the mono path: that path has one
// source, one module and no spans, and the core reads both cases the same
// way. `program` is the frontend's program node, the root of every source's
// module node; `spans` is the frontend's span table (an offset and a length
// per source); `modules` is the frontend's unit table (nine words per
// source); `root_idx` is the root's SOURCE index, zero based.
struct Many { program:u64, spans:buf<u64>, span_count:u64, modules:buf<u64>, root_idx:u64, multi:u64 }
struct FunctionIndex { nodes:buf<u64>,imports:buf<u64>,declared:u64,reachable:u64,emitted:u64 }
struct L {
    source:buf<u8>,nodes:buf<u64>,count:u64,text:buf<u8>,at:u64,
    nt:buf<u64>,nt_count:u64,b:machine_ir.Builder,
    bindings:buf<u64>,functions:buf<u64>,heads:buf<u64>,active:buf<u64>,breaks:buf<u64>,break_count:u64,
    code:u64,node:u64,origin:u64,current_fn:u64,return_type:u64,depth:u64,owned_head:V,
    abi2:u64,main_node:u64,wrapper_origin:u64,context:u64,
    lengths:buf<u64>,structs:buf<u64>,runtime_origin:u64,runtime_sig:u64,fault_node:u64,
    access_handle:u64,access_offset:u64,access_spec:u64,
    lits:buf<u64>,litv:buf<u64>,lit_count:u64,lit_chunks:u64,
    dec_byte:u64,dec_next:u64,runtime_mask:u64,
    many:Many,src_index:u64,rel_offset:u64,root_module:u64,helper_origin:u64,
    // THE CLOSED APPLICATION MODE. `closed` is the EXPLICIT FLAG of the mode
    // and it is not the ABI: `abi2` says which ABI, this says whether the
    // program is closed. The five buffers below are the marking's own and
    // they exist only in the closed mode; in the normal mode they are the
    // empty buffer and are never read and never freed.
    closed:u64,work:buf<u64>,queue:buf<u64>,reach:buf<u64>,fnord:buf<u64>,seen:buf<u64>,litlive:buf<u64>,
    // THE BATCH. `batch` is the mode's own flag; `batch_start` and
    // `batch_limit` are RANKS, zero based, in the REACHABLE functions taken
    // in ORDINAL ORDER, and they name the functions this object DEFINES.
    // `batchord` is the reachable functions in that order and `batchsel`
    // says which of them this object defines. `batch_count` is the number of
    // reachable functions and `batch_selected` the number this object owns.
    batch:u64,batch_start:u64,batch_limit:u64,batchord:buf<u64>,batchsel:buf<u64>,
    batch_count:u64,batch_selected:u64,runtime_import:u64,sig_ret:u64,
    // All function nodes in AST order, including unreachable declarations.
    // Owned separately from the marking tables; absent in the normal mode.
    funcidx:FunctionIndex
}
fn bad(l:L,node:u64,code:u64)->u64 {
    // THE BUILDER'S REFUSAL HAS PRIORITY OVER THE LOWER'S OWN.
    //
    // A FULL IMAGE MAKES THE BUILDER REFUSE, and every refusal stated after
    // that is a CONSEQUENCE of it: a coercion that cannot see a value because
    // the record that holds the value was never written, a shape that does not
    // add up because the record it wanted is the one that did not fit.
    //
    // REPORTING THE CONSEQUENCE INSTEAD OF THE CAUSE SENDS THE READER TO THE
    // WRONG LINE, and the cause is the one that says the capacity was
    // exhausted. MEASURED on the full audit: the image filled to exactly
    // floor((capacity-10)/24) records, the builder said E_HEADER, and the
    // lower answered 971 as if the program were malformed.
    //
    // THE BUILDER DOES NOT EXIST YET AT THE DECLARATION AND THE ROOT
    // REFUSALS: `l.b` is NULL there, because the writer is created after the
    // declaration text is written. THE TEST IS SHORT-CIRCUITED so a null
    // handle is never read as a builder, and the FIRST refusal is the one that
    // is kept.
    if l.b!=null && l.b.code!=0 {
        if l.code==0 { l.code=l.b.code;l.node=node; }
        return l.code;
    }
    if l.code==0 { l.code=code;l.node=node; }
    return code;
}
fn n(l:L,node:u64,field:u64)->u64 {
    if node==0 || node>l.count || field>=16 { bad(l,node,E_AST());return 0; }
    return l.nodes[(node-1)*16+field];
}
fn scalar_width(ty:u64)->u64 {
    if ty==1 || ty==5 { return 8; } if ty==2 || ty==6 { return 16; }
    if ty==3 || ty==7 { return 32; } if ty==4 || ty==8 { return 64; }
    if ty==9 { return 1; } return 0;
}
fn sign(ty:u64)->u64 { if ty>=5 && ty<=8 { return 1; }return 0; }
fn buffer_type(ty:u64)->bool { return ty==10 || ty==11; }
fn element_bytes(ty:u64)->u64 { if ty==11 { return 8; }return 1; }
fn bits(l:L,ty:u64)->u64 {
    let scalar:u64=scalar_width(ty);if scalar!=0 { return scalar; }
    if l.abi2!=0 {
        if ty>=10 && ty<=12 { return 64; }
        if ty>12 && ty<len(l.structs) && l.structs[ty]!=0 { return 64; }
    }
    return 0;
}
fn owned(l:L,id:u64,bits:u64,signed:u64,class:u64)->V {
    let v:V=V{id:id,width:bits,sign:signed,class:class,owned_next:l.owned_head,length:0};
    l.owned_head=v;return v;
}
fn release_values(l:L)->u64 {
    let mut cur:V=l.owned_head;
    while cur!=null { let next:V=cur.owned_next;rt_free(runtime(),cur);cur=next; }
    l.owned_head=null;return 0;
}
fn empty(l:L)->V { return owned(l,0,0,0,0); }
fn byte(l:L,x:u64)->u64 {
    if l.code!=0 { return l.code; }
    if l.at>=len(l.text) { return bad(l,0,E_BOUND()); }
    l.text[l.at]=u8(x&255);l.at=l.at+1;return 0;
}
fn text(l:L,s:buf<u8>)->u64 { let mut i:u64=0;while i<len(s) && l.code==0 { byte(l,s[i]);i=i+1; }return l.code; }
// THE WRITER IS BORROWED, THE BUFFER IS OWNED HERE.
//
// A string literal is a RUNTIME BUFFER, and one that is copied into the text
// and never freed is one LIVE BUFFER for the rest of the run. The audit's own
// allocation map measured this site at seven thousand live buffers against the
// runtime's sixty five thousand, and the table filled up.
//
// The free is on EVERY path, including the early return the borrowed writer
// takes when the text is already refused, and the handle is freed ONCE: the
// owner hands it over and does not touch it again. The bytes written, the
// ids, the spans and the limits are the writer's, unchanged.
fn write_owned(l:L,s:buf<u8>)->u64 {
    let code:u64=text(l,s);
    rt_free(runtime(),s);
    return code;
}
fn literal(l:L,id:u64)->u64 {
    if id==1 { let s:buf<u8>="u8";return write_owned(l,s); }
    if id==2 { let s:buf<u8>="u16";return write_owned(l,s); }
    if id==3 { let s:buf<u8>="u32";return write_owned(l,s); }
    if id==4 { let s:buf<u8>="u64";return write_owned(l,s); }
    if id==5 { let s:buf<u8>="i8";return write_owned(l,s); }
    if id==6 { let s:buf<u8>="i16";return write_owned(l,s); }
    if id==7 { let s:buf<u8>="i32";return write_owned(l,s); }
    if id==8 { let s:buf<u8>="i64";return write_owned(l,s); }
    if id==9 { let s:buf<u8>="bool";return write_owned(l,s); }
    if id==10 { let s:buf<u8>="module nova.native\ntarget x86_64-nexora-uefi\ndefault_abi efi-x64-v0\nsection .text {\n";return write_owned(l,s); }
    if id==11 { let s:buf<u8>="export ";return write_owned(l,s); }
    if id==12 { let s:buf<u8>="fn ";return write_owned(l,s); }
    if id==13 { let s:buf<u8>="main";return write_owned(l,s); }
    if id==14 { let s:buf<u8>="native_fn_";return write_owned(l,s); }
    if id==15 { let s:buf<u8>="in p";return write_owned(l,s); }
    if id==16 { let s:buf<u8>=")->";return write_owned(l,s); }
    if id==17 { let s:buf<u8>=" effects {} clobbers {rax} { return ";return write_owned(l,s); }
    if id==18 { let s:buf<u8>="false";return write_owned(l,s); }
    if id==19 { let s:buf<u8>="; }\n";return write_owned(l,s); }
    if id==20 { let s:buf<u8>="}\n";return write_owned(l,s); }
    if id==21 { let s:buf<u8>="_";return write_owned(l,s); }
    if id==22 { let s:buf<u8>=" effects {reads_mem(user),writes_mem(user),changes_flags} clobbers {rax} { return ";return write_owned(l,s); }
    if id==23 { let s:buf<u8>="export fn main(in ctx:u64,in args:u64,in count:u64)->u64 effects {reads_mem(user),writes_mem(user),changes_flags} clobbers {rax} {return 0;}\n";return write_owned(l,s); }
    if id==24 { let s:buf<u8>="fn nova_runtime_signature(in ctx:u64,in a:u64,in b:u64,in c:u64)->u64 effects {reads_mem(user),writes_mem(user),changes_flags} clobbers {rax,rcx,rdx,r8,r9,r10,r11,rflags} {return 0;}\n";return write_owned(l,s); }
    // The storage section and the three pieces of a storage item. The section
    // name is the NXO section id 2 (`.rdata`), and the item is a `u64` because
    // that is the widest unit `machine_emit`'s data layout accepts.
    if id==25 { let s:buf<u8>="section .rdata {\n";return write_owned(l,s); }
    if id==26 { let s:buf<u8>="data ";return write_owned(l,s); }
    if id==27 { let s:buf<u8>=": u64 = ";return write_owned(l,s); }
    if id==28 { let s:buf<u8>=";\n";return write_owned(l,s); }
    // The helper's effects and clobbers: the same set the runtime signature
    // declares, because the helper CALLS the runtime through a callback. R15 is
    // not in it: the context lives in R15 and the helper reads it from there.
    if id==29 { let s:buf<u8>=" effects {reads_mem(user),writes_mem(user),changes_flags} clobbers {rax,rcx,rdx,r8,r9,r10,r11,rflags} { return ";return write_owned(l,s); }
    // THE BATCH'S OWN SPELLINGS. The module head is written without the
    // section, so the imports can come between the two, and the import lines
    // carry the real qualified target, the real local name and the function's
    // own signature.
    if id==30 { let s:buf<u8>="module nova.native\ntarget x86_64-nexora-uefi\ndefault_abi efi-x64-v0\n";return write_owned(l,s); }
    if id==31 { let s:buf<u8>="section .text {\n";return write_owned(l,s); }
    if id==32 { let s:buf<u8>="import nova.native.";return write_owned(l,s); }
    if id==33 { let s:buf<u8>=" as ";return write_owned(l,s); }
    if id==34 { let s:buf<u8>=": fn";return write_owned(l,s); }
    if id==35 { let s:buf<u8>="effects {reads_mem(user),writes_mem(user),changes_flags}\n";return write_owned(l,s); }
    if id==36 { let s:buf<u8>="clobbers {rax}\n";return write_owned(l,s); }
    if id==37 { let s:buf<u8>="effects {reads_mem(user),writes_mem(user),changes_flags}\nclobbers {rax,rcx,rdx,r8,r9,r10,r11,rflags}\n";return write_owned(l,s); }
    if id==38 { let s:buf<u8>="import nova.native.nova_runtime_signature as nova_runtime_signature: fn(in ctx:u64,in a:u64,in b:u64,in c:u64)->u64\n";return write_owned(l,s); }
    if id==39 { let s:buf<u8>=": fn(in p0:u64,in p1:u64,in p2:u64,in p3:u64,in p4:u64,in p5:u64)->u64\n";return write_owned(l,s); }
    if id==40 { let s:buf<u8>="data nova_lit_";return write_owned(l,s); }
    return bad(l,0,E_AST());
}
// ---- string literals --------------------------------------------------------
// A Nova string literal is a STORAGE ITEM in the generated NTASM declaration,
// and the address of that item is the pointer the runtime copies from. The
// scan below runs BEFORE the declaration text is written, because the text is
// parsed once and the data has to be inside it: a string that is not in the
// text has no address to take.
//
// THE ITEM IS A `u64`, NOT AN ARRAY. `machine_emit`'s `data_layout` refuses a
// storage `data` whose ELEMENT COUNT is not zero (`W(e,r,14)!=0` is a
// refusal), so an array-typed `data` would be refused by the emitter instead
// of laid out. Eight bytes is the widest unit that layout accepts, and
// consecutive items are CONTIGUOUS because each one is aligned to its own
// width, so a string of N bytes is ceil(N/8) items and one address.
//
// THE ESCAPES ARE THE LEXER'S OWN SET, read from `nova_language_parse.nova`'s
// scanner: `\n` `\r` `\t` `\0` `\\` `\"` and `\xHH`. Any other escape is a
// refusal here exactly as it is there, and a byte the scanner would have
// passed through (every byte above 0x7f, so UTF-8) is passed through here.
// THE DECODER WRITES ITS ANSWER INTO THE CONTEXT AND NOT INTO A FRESH CELL.
// A struct value in this dialect is a heap cell with a lifetime, and one cell
// per decoded byte would be a leak per byte; the context carries the byte and
// the cursor instead, and nothing is allocated at all.
fn hex_digit(c:u64)->u64 {
    if c>=48 && c<=57 { return c-48; }
    if c>=97 && c<=102 { return c-97+10; }
    if c>=65 && c<=70 { return c-70+10; }
    return 255;
}
fn decode_at(l:L,at:u64,end:u64)->u64 {
    if at>=end { return 0; }
    let c:u64=l.source[at];
    if c!=92 { l.dec_byte=c;l.dec_next=at+1;return 1; }
    if at+1>=end { return 0; }
    let e:u64=l.source[at+1];
    if e==110 { l.dec_byte=10;l.dec_next=at+2;return 1; }
    if e==114 { l.dec_byte=13;l.dec_next=at+2;return 1; }
    if e==116 { l.dec_byte=9;l.dec_next=at+2;return 1; }
    if e==48 { l.dec_byte=0;l.dec_next=at+2;return 1; }
    if e==92 { l.dec_byte=92;l.dec_next=at+2;return 1; }
    if e==34 { l.dec_byte=34;l.dec_next=at+2;return 1; }
    if e==120 {
        if at+3>=end { return 0; }
        let h1:u64=hex_digit(l.source[at+2]);let h2:u64=hex_digit(l.source[at+3]);
        if h1>15 || h2>15 { return 0; }
        l.dec_byte=h1*16+h2;l.dec_next=at+4;return 1;
    }
    return 0;
}
// WHETHER A LITERAL IS EMITTED.
//
// THE MARKING MARKS THE LITERALS AS IT WALKS: a literal node the walk
// reaches belongs to a REACHABLE function, and a literal it never reaches
// belongs to a function the root module's main cannot call. The normal mode
// emits every literal of the program, and the closed mode emits the
// literals of the reachable functions and no other: the same marking that
// chose the declarations chooses the data.
//
// THE FLAG IS NOT THE WALK'S OWN "SEEN" FLAG: a node that was pushed is not
// a node that was visited, and only a visited literal is a live one.
fn literal_is_live(l:L,node:u64)->bool {
    // THE NORMAL PROFILE EMITS EVERY LITERAL. The closed profile emits the
    // literals of the reachable functions, and a batch emits the literals of
    // the functions it DEFINES: the owner is the ordinal the marking walk
    // recorded, and the object that carries the function carries its data.
    if l.closed==0 && l.batch==0 { return true; }
    if node==0 || node>l.count { return false; }
    let owner:u64=l.litlive[node];
    if owner==0 { return false; }
    return defines(l,owner);
}
// THE COUNT, over the WHOLE resolved Nova AST. The descriptor is six words:
// the node, the decoded length, the item count, the base of the item values,
// and the name span of the FIRST item, which is the address the body takes.
fn count_literals(l:L)->u64 {
    let mut literals:u64=0;let mut chunks:u64=0;let mut i:u64=1;
    while i<=l.count {
        if n(l,i,0)==15 && n(l,i,13)==4 && literal_is_live(l,i) {
            let len:u64=n(l,i,15);
            literals=literals+1;
            if len>0 { chunks=chunks+(len+7)/8; }
        }
        i=i+1;
    }
    l.lit_count=literals;l.lit_chunks=chunks;return 0;
}
fn decode_literals(l:L)->u64 {
    let mut index:u64=0;let mut base:u64=0;let mut i:u64=1;
    while i<=l.count && l.code==0 {
        if n(l,i,0)==15 && n(l,i,13)==4 && literal_is_live(l,i) {
            let len:u64=n(l,i,15);
            let mut chunks:u64=0;if len>0 { chunks=(len+7)/8; }
            let a:u64=n(l,i,5);let z:u64=n(l,i,6);
            // THE SPAN ITSELF: ORDERED, INSIDE THE SOURCE, LONG ENOUGH TO HOLD
            // TWO QUOTES, AND OPENING AND CLOSING ON A QUOTE. A forged node
            // count must not make the decoder read outside its span.
            if z>len(l.source) || a>z || z-a<2 || a+1>z { bad(l,i,E_AST());break; }
            if l.source[a]!=34 || l.source[z-1]!=34 { bad(l,i,E_AST());break; }
            let mut at:u64=a+1;let stop:u64=z-1;
            let mut produced:u64=0;let mut written:u64=0;
            let mut chunk:u64=0;let mut shift:u64=0;
            while produced<len && l.code==0 {
                if decode_at(l,at,stop)==0 { bad(l,i,E_AST());break; }
                chunk=chunk|(l.dec_byte<<shift);shift=shift+8;
                if shift==64 { l.litv[base+written]=chunk;written=written+1;chunk=0;shift=0; }
                produced=produced+1;at=l.dec_next;
            }
            // THE WHOLE SPAN WAS CONSUMED, and the decoded count is the lexer's
            // count. Either disagreement is a refusal rather than a silently
            // truncated string.
            if l.code==0 && at!=stop { bad(l,i,E_AST()); }
            if l.code==0 && produced!=len { bad(l,i,E_AST()); }
            if l.code==0 && shift!=0 { l.litv[base+written]=chunk;written=written+1; }
            if l.code==0 && written!=chunks { bad(l,i,E_AST()); }
            let desc:u64=index*6;
            l.lits[desc]=i;l.lits[desc+1]=len;l.lits[desc+2]=chunks;l.lits[desc+3]=base;
            base=base+chunks;index=index+1;
        }
        i=i+1;
    }
    return l.code;
}
fn literal_index(l:L,node:u64)->u64 {
    // THE TABLE HOLDS THE EMITTED DESCRIPTORS AND NO OTHER: the closed mode
    // does not decode the literals of an unreachable function, so a literal
    // that is not emitted has no index and no address.
    let mut i:u64=0;
    while i<l.lit_count {
        if l.lits[i*6]==node { return i+1; }
        i=i+1;
    }
    return 0;
}
fn decimal(l:L,x:u64)->u64 {
    if x>=10 { decimal(l,x/10); }
    return byte(l,48+x%10);
}
fn type_text(l:L,ty:u64)->u64 {
    if l.abi2!=0 && ty>=10 && bits(l,ty)==64 { return literal(l,4); }
    if ty==1 { return literal(l,1); } if ty==2 { return literal(l,2); }
    if ty==3 { return literal(l,3); } if ty==4 { return literal(l,4); }
    if ty==5 { return literal(l,5); } if ty==6 { return literal(l,6); }
    if ty==7 { return literal(l,7); } if ty==8 { return literal(l,8); }
    if ty==9 { return literal(l,9); }return bad(l,0,E_UNSUPPORTED());
}
fn is_main(l:L,fn_node:u64)->bool {
    let a:u64=n(l,fn_node,5);let z:u64=n(l,fn_node,6);
    if z<a || z>len(l.source) || z-a!=4 { return false; }
    return l.source[a]==109 && l.source[a+1]==97 && l.source[a+2]==105 && l.source[a+3]==110;
}
// THE SOURCE AN OFFSET BELONGS TO, AND THE OFFSET INSIDE THAT SOURCE.
//
// THE SPANS ARE THE FRONTEND'S OWN, so the answer is a MEASUREMENT and not a
// convention: a blob with a span table says which file each range of bytes
// came from. Without them the source index is one and the offset is the
// absolute one in the blob, and every file but the first is then reported at
// the wrong place. The mono path has no spans and keeps its own answer.
fn locate(l:L,offset:u64)->u64 {
    l.src_index=1;l.rel_offset=offset;
    if l.many.multi==0 { return 1; }
    let mut i:u64=1;
    while i<=l.many.span_count {
        let start:u64=l.many.spans[(i-1)*2];
        let len:u64=l.many.spans[(i-1)*2+1];
        if len!=0 && offset>=start && offset<start+len {
            l.src_index=i;l.rel_offset=offset-start;return i;
        }
        i=i+1;
    }
    return 1;
}
// THE MODULE A DECLARATION BELONGS TO. The module node is the declaration's
// parent, and the module nodes hang from the program node in SOURCE ORDER, so
// the child's ordinal is the source index and the unit table answers the
// module id. Zero when the declaration is not under a module.
fn module_of(l:L,node:u64)->u64 {
    if l.many.multi==0 { return 0; }
    let owner:u64=n(l,node,1);
    if owner==0 { return 0; }
    let mut child:u64=n(l,l.many.program,2);
    let mut index:u64=1;
    while child!=0 && index<=l.many.span_count {
        if child==owner { return l.many.modules[(index-1)*9+2]; }
        child=n(l,child,4);index=index+1;
    }
    return 0;
}
// THE ROOT'S MAIN. It must EXIST, it must be UNIQUE, and it must BELONG TO
// THE ROOT MODULE. Three different refusals, and choosing one of them
// SILENTLY would lower a program the caller did not ask for: a root without
// a main, two mains anywhere, and a single main that belongs to another
// module.
fn select_root_main(l:L)->u64 {
    let mut mains:u64=0;let mut found:u64=0;let mut i:u64=1;
    while i<=l.count {
        if n(l,i,0)==5 && is_main(l,i) { mains=mains+1;found=i; }
        i=i+1;
    }
    if mains==0 { return bad(l,0,E_ROOT()); }
    if mains>1 { return bad(l,found,E_ROOT()); }
    if module_of(l,found)!=l.root_module { return bad(l,found,E_ROOT()); }
    l.main_node=found;return 0;
}
// ---- the closed application mode --------------------------------------------
//
// A CLOSED APPLICATION IS ONE WHOSE WHOLE PROGRAM IS REACHABLE FROM THE MAIN
// OF ITS ROOT MODULE. The frontend has already resolved the program into ONE
// tree with GLOBAL ORDINALS, so "which functions does this program actually
// use" is a question about that tree: a DIRECT CALL (a K_CALL whose aux is
// zero) carries the ORDINAL of the function it calls, and a declaration
// carries the ordinal it was bound at.
//
// THE ROOTS ARE THE ROOT MODULE'S MAIN AND NOTHING ELSE. This dialect has no
// function-as-a-value: a name that is not a binding is refused by the
// frontend, and a call is the only way to enter a function, so there is no
// function whose address is taken and no root to keep for it. The WRAPPER,
// the RUNTIME SIGNATURE and the HELPER are the lower's own and are always
// emitted.
//
// THE MARKING IS LINEAR. Each reachable function's own subtree is walked ONCE,
// the walk is ITERATIVE with an explicit stack (so a body deeper than the
// expression depth cap is not a refusal here), and a node is pushed at most
// once (so the stack cannot outgrow the tree). There is no rescan of the tree
// per call.
//
// THE TREE IS CHECKED WHILE IT IS WALKED, and every check is a refusal and
// not a repair: a child out of bounds, a child whose parent is not the node
// it hangs from, a node reached twice (a cycle or a node shared by two
// parents), a sibling chain longer than the tree itself, and a call that
// names a function which does not exist. A malformed tree is refused; it is
// never walked into an answer.
fn index_functions(l:L)->u64 {
    // THE FUNCTIONS OF THE PROGRAM, BY THEIR GLOBAL ORDINAL. The scan is
    // linear over the resolved tree and it refuses NOTHING: the validation of
    // an ordinal stays where it was, in `declarations`, so the normal
    // profile's verdicts do not move.
    let mut i:u64=1;let mut total:u64=0;
    while i<=l.count {
        if n(l,i,0)==5 {
            total=total+1;
            let ord:u64=n(l,i,15);
            if ord!=0 && ord<=l.count && l.fnord[ord]==0 { l.fnord[ord]=i; }
        }
        i=i+1;
    }
    l.funcidx.declared=total;return 0;
}
fn mark_reachable(l:L)->u64 {
    // THE ROOT MODULE'S MAIN IS THE FIRST ROOT, and the mode needs a root
    // module: the mono profile has none and its main is chosen by position
    // later, so the closed mode refuses it rather than guess.
    if l.many.multi==0 { return bad(l,0,E_UNSUPPORTED()); }
    let main_ord:u64=n(l,l.main_node,15);
    if main_ord==0 || main_ord>l.count { return bad(l,l.main_node,E_AST()); }
    if l.fnord[main_ord]==0 { return bad(l,l.main_node,E_AST()); }
    l.reach[main_ord]=1;
    l.queue[0]=main_ord;
    let mut head:u64=0;let mut tail:u64=1;let mut live:u64=1;
    while head<tail {
        let ord:u64=l.queue[head];head=head+1;
        let fnode:u64=l.fnord[ord];
        if fnode!=0 {
            // THE WALK OF ONE FUNCTION'S OWN SUBTREE. The stack holds the
            // nodes still to visit and `seen` says which ones are already on
            // it, so a node is pushed at most once and the stack cannot
            // outgrow the tree: it holds at most one entry per node.
            let mut sp:u64=0;
            if l.seen[fnode]!=0 { return bad(l,fnode,E_AST()); }
            l.work[sp]=fnode;sp=sp+1;l.seen[fnode]=ord;
            while sp>0 {
                sp=sp-1;
                let x:u64=l.work[sp];
                // A LITERAL BELONGS TO THE FUNCTION THAT HOLDS IT, and the
                // walk knows which one that is: the ORDINAL of the function
                // being walked. The owner is kept, and not a flag, because the
                // batch's own choice of functions is made after the walk.
                if n(l,x,0)==15 && n(l,x,13)==4 { l.litlive[x]=ord; }
                if n(l,x,0)==17 && n(l,x,13)==0 {
                    // A DIRECT CALL: the aux is zero and the ordinal names the
                    // function called. An intrinsic call carries its own
                    // descriptor in the aux and names no function.
                    let target:u64=n(l,x,15);
                    if target==0 || target>l.count { return bad(l,x,E_AST()); }
                    if l.fnord[target]==0 { return bad(l,x,E_AST()); }
                    if l.reach[target]==0 {
                        l.reach[target]=1;live=live+1;
                        l.queue[tail]=target;tail=tail+1;
                    }
                }
                // THE CHILDREN OF THIS NODE. The chain of siblings is walked
                // with a bound of the tree's own size, so a chain that does
                // not end is a refusal and not a loop, and every child is
                // checked against the node it hangs from.
                let mut child:u64=n(l,x,2);
                let mut steps:u64=0;
                while child!=0 {
                    if steps>=l.count { return bad(l,x,E_AST()); }
                    if child>l.count { return bad(l,child,E_AST()); }
                    if n(l,child,1)!=x { return bad(l,child,E_AST()); }
                    steps=steps+1;
                    // A NODE REACHED TWICE IS A CYCLE OR A NODE SHARED BY TWO
                    // PARENTS, and both are a tree this dialect does not
                    // produce.
                    if l.seen[child]!=0 { return bad(l,child,E_AST()); }
                    // Nonzero still means visited; the ordinal additionally
                    // records the owning function for the batch's direct calls.
                    l.seen[child]=ord;
                    l.work[sp]=child;sp=sp+1;
                    child=n(l,child,4);
                }
            }
        }
    }
    // THE THREE FUNCTIONS THE LOWER WRITES FOR EVERY PROGRAM: the wrapper
    // entry, the runtime signature and the helper. They are SYNTHETIC: they
    // are not the program's own functions, and they are counted apart. The
    // MONO PROFILE HAS NO WRAPPER, so it writes none and carries none.
    //
    // A LATER BATCH IMPORTS THE TWO OF THEM IT NEEDS and defines neither, so
    // its unit carries two synthetic declarations and not three: the count
    // says what the unit carries and not what the program has.
    l.funcidx.reachable=live;
    if l.abi2!=0 {
        if is_later_batch(l) { l.funcidx.emitted=live+2; } else { l.funcidx.emitted=live+3; }
    } else { l.funcidx.emitted=live; }
    return 0;
}
// ---- the batch --------------------------------------------------------------
//
// A BATCH IS A PART OF THE PROGRAM, COMPILED ALONE. It DEFINES the functions
// its ranks name and IMPORTS their direct callees outside this batch, so the
// parts can be compiled one at a time and joined afterwards.
//
// THE RANKS ARE RANKS, NOT ORDINALS: the reachable functions, in ordinal
// order, numbered from zero. The ordinals themselves never move: the name of
// a function is built from its global ordinal, so the same function has the
// same name in every batch and the merge can match the names.
//
// THE IMPORTS ARE REAL. An import is a declaration in the text, with the
// function's own signature, and the machine IR lowers it as a callable
// without a body. The call sites name the imported function by its local
// name, which is the name the definition carries, so the two objects agree
// on it without either of them knowing the other exists.
fn defines(l:L,ord:u64)->bool {
    // DOES THIS OBJECT CARRY THE FUNCTION'S BODY?
    if l.batch!=0 { if ord==0 || ord>l.count { return false; } return l.batchsel[ord]!=0; }
    if l.closed!=0 { if ord==0 || ord>l.count { return false; } return l.reach[ord]!=0; }
    return true;
}
// IS THIS OBJECT THE FIRST ONE? The normal profile and the closed profile
// are one object each, and the first batch is the one that owns the entry,
// the runtime signature and the helper. The LATER batches import the two of
// them they need and have no body for either.
fn is_first_batch(l:L)->bool { return l.batch==0 || l.batch_start==0; }
fn is_later_batch(l:L)->bool { return l.batch!=0 && l.batch_start!=0; }
fn is_reachable(l:L,ord:u64)->bool {
    // IS THE FUNCTION IN THE PROGRAM AT ALL, IN THE CLOSED AND THE BATCH
    // PROFILES? The normal profile carries every function, so it answers
    // yes without reading a table it did not fill.
    if l.closed==0 && l.batch==0 { return true; }
    if ord==0 || ord>l.count { return false; }
    return l.reach[ord]!=0;
}
fn select_batch(l:L)->u64 {
    // THE REACHABLE FUNCTIONS IN ORDINAL ORDER, AND THE RANKS THIS OBJECT
    // OWNS. A LIMIT OF ZERO IS A REFUSAL AND NOT AN EMPTY BATCH: an empty
    // batch would be an object with nothing in it, and a batch that starts
    // past the last function is a range that names nothing.
    let mut rank:u64=0;let mut ord:u64=1;
    while ord<=l.count {
        if l.reach[ord]!=0 { l.batchord[rank]=ord;rank=rank+1; }
        ord=ord+1;
    }
    l.batch_count=rank;
    if l.batch_limit==0 { return bad(l,0,E_BOUND()); }
    if l.batch_start>=rank { return bad(l,0,E_BOUND()); }
    // THE RANGE IS THE SMALLER OF WHAT WAS ASKED FOR AND WHAT IS LEFT, and
    // it is never computed as a sum: a limit of UINT64_MAX must select every
    // function that is left and not wrap around to an empty range.
    let remaining:u64=rank-l.batch_start;
    let mut take:u64=l.batch_limit;
    if take>remaining { take=remaining; }
    let mut r:u64=l.batch_start;
    let mut done:u64=0;
    while done<take {
        l.batchsel[l.batchord[r]]=1;
        r=r+1;done=done+1;
    }
    l.batch_selected=done;
    return 0;
}
fn imports_function(l:L,ord:u64)->bool {
    if l.batch==0 || ord==0 || ord>l.count { return false; }
    return l.funcidx.imports[ord]!=0 && l.batchsel[ord]==0;
}
fn select_imports(l:L)->u64 {
    // Reachability has validated every reachable subtree and direct target.
    // Keep the same global closure and ranks; only this object's declarations
    // shrink. Repeated calls and recursive calls require one identity each.
    let mut i:u64=1;
    while i<=l.count {
        let owner:u64=l.seen[i];
        if owner!=0 && l.batchsel[owner]!=0 && n(l,i,0)==17 && n(l,i,13)==0 {
            l.funcidx.imports[n(l,i,15)]=1;
        }
        i=i+1;
    }
    // The wrapper is synthetic and therefore absent from the AST walk.
    if l.abi2!=0 && is_first_batch(l) { l.funcidx.imports[n(l,l.main_node,15)]=1; }
    let mut imported:u64=0;i=1;
    while i<=l.count { if imports_function(l,i) { imported=imported+1; }i=i+1; }
    l.funcidx.emitted=l.batch_selected+imported;
    if l.abi2!=0 {
        if is_later_batch(l) { l.funcidx.emitted=l.funcidx.emitted+2; }
        else { l.funcidx.emitted=l.funcidx.emitted+3; }
    }
    return l.code;
}
// THE SIGNATURE OF A FUNCTION, IN THE TEXT'S OWN SPELLING: the parameters and
// the return type. A DEFINITION AND AN IMPORT OF THE SAME FUNCTION ARE
// WRITTEN BY THIS ONE FUNCTION, so the two spellings cannot drift.
fn write_signature(l:L,i:u64)->u64 {
    byte(l,40);
    let mut p:u64=n(l,i,2);let mut params:u64=0;let mut ret:u64=0;let mut body:u64=0;let mut seen:u64=0;
    while p!=0 && seen<l.count && l.code==0 {
        if n(l,p,1)!=i { return bad(l,p,E_AST()); }
        let k:u64=n(l,p,0);
        if k==6 {
            if ret!=0 || body!=0 || params>=64 { return bad(l,p,E_AST()); }
            if params!=0 { byte(l,44); }
            let ty:u64=n(l,p,14);
            literal(l,15);decimal(l,params);byte(l,58);type_text(l,ty);params=params+1;
            if l.abi2!=0 && buffer_type(ty) {
                if params>=64 { return bad(l,p,E_BOUND()); }
                byte(l,44);literal(l,15);decimal(l,params);byte(l,58);literal(l,4);params=params+1;
            }
        } else if k==7 {
            if ret!=0 || body!=0 { return bad(l,p,E_AST()); }ret=n(l,p,14);
        } else if k==8 {
            if ret==0 || body!=0 { return bad(l,p,E_AST()); }body=p;
        } else { return bad(l,p,E_UNSUPPORTED()); }
        p=n(l,p,4);seen=seen+1;
    }
    if p!=0 || ret==0 || body==0 { return bad(l,i,E_AST()); }
    l.sig_ret=ret;
    literal(l,16);type_text(l,ret);
    return l.code;
}
// THE IMPORTS OF A BATCH.
//
// A DIRECT CALLEE THIS OBJECT DOES NOT DEFINE IS IMPORTED, as is the first
// batch's main when its wrapper needs it. The import carries the function's
// OWN signature: the same parameters, the same return type,
// the same effects and the same clobbers, so the merged object calls the
// same function and the merge has nothing to reconcile.
//
// THE TARGET IS THE QUALIFIED NAME THE DEFINITION WILL CARRY and the local
// name is the same spelling, so a call site here spells the name the
// definition spells and the two objects agree on it.
fn batch_imports(l:L)->u64 {
    let mut i:u64=1;
    while i<=l.count && l.code==0 {
        if n(l,i,0)==5 {
            let ord:u64=n(l,i,15);
            if ord!=0 && ord<=l.count && l.reach[ord]!=0 && l.batchsel[ord]==0 {
                if imports_function(l,ord)==false {
                    // Preserve signature refusals, in the old import order,
                    // even when this object does not need the declaration.
                    // The first error survives; only tentative text is undone.
                    let saved:u64=l.at;write_signature(l,i);l.at=saved;
                    if l.code!=0 { return l.code; }
                } else {
                literal(l,32);
                private_name(l,ord);
                literal(l,33);
                private_name(l,ord);
                literal(l,34);
                if write_signature(l,i)!=0 { return l.code; }
                // THE SIGNATURE ENDS THE LINE: the import's type is followed
                // by a term and its contracts come after it, so the return
                // type and the effects are not one word.
                byte(l,10);
                literal(l,35);
                literal(l,36);
                }
            }
        }
        i=i+1;
    }
    // THE ENTRY, THE RUNTIME SIGNATURE AND THE HELPER BELONG TO THE FIRST
    // BATCH, and the other batches import the two of them they need: the
    // runtime signature, which every runtime call names, and the helper,
    // which every runtime call goes through.
    if l.batch_start!=0 {
        literal(l,38);
        literal(l,37);
        literal(l,32);
        helper_name(l);
        literal(l,33);
        helper_name(l);
        literal(l,39);
        literal(l,37);
    }
    return l.code;
}
// THE LOCAL NAME OF A DECLARATION, WHETHER IT IS A DEFINITION OR AN IMPORT.
//
// A FUNCTION'S FIRST CHILD IS ITS NAME; an IMPORT'S FIRST CHILD IS THE
// QUALIFIED TARGET and its second is the local name. The name node is the
// one whose NTIR index is 47, and the index is read out of the image, so a
// call site names the same local name the declaration carries.
fn local_name_node(l:L,node:u64)->u64 {
    // THE LOCAL NAME OF A DECLARATION, WHETHER IT IS A DEFINITION OR AN
    // IMPORT.
    //
    // A FUNCTION'S FIRST CHILD IS ITS NAME. An IMPORT'S FIRST CHILD IS THE
    // QUALIFIED TARGET and its second is the LOCAL NAME, and the name inside
    // the qualified target is NOT the local name: it is the target's own
    // spelling. So the import's local name is read from its second child and
    // the function's from its first, and the index 47 says which one it is.
    if node==0 || node>l.nt_count { return 0; }
    let base:u64=ntir.HEADER_WORDS()+(node-1)*ntir.NODE_WORDS();
    let mut child:u64=l.nt[base+8];
    let mut steps:u64=0;
    while child!=0 && child<=l.nt_count && steps<=l.nt_count {
        let cb:u64=ntir.HEADER_WORDS()+(child-1)*ntir.NODE_WORDS();
        if l.nt[cb]-ntir.KIND_BASE()+1==47 { return child; }
        child=l.nt[cb+10];
        steps=steps+1;
    }
    return 0;
}
// THE SYMBOL OF A DECLARATION: THE SPAN OF ITS LOCAL NAME, in a record that
// is already the call site's symbol.
fn name_symbol(l:L,node:u64,record:u64)->u64 {
    let name:u64=local_name_node(l,node);
    if name==0 { return 0; }
    let np:u64=ntir.HEADER_WORDS()+(name-1)*ntir.NODE_WORDS();
    put(l,record,5,l.nt[np+4]);put(l,record,6,l.nt[np+5]);put(l,record,8,2);
    return record;
}
// THE MIR RECORD THAT CAME FROM AN NTIR NODE. The unit walk emits the
// imports, and the lower does not create them, so the record of an imported
// declaration is FOUND by its origin and not by a count.
//
// THE RECORD IS THE CALLABLE AND NOT THE FIRST RECORD THAT SHARES THE
// ORIGIN: a declaration's records all carry the same origin, and the
// callable is the one whose kind is 2051. The kind is checked, so a
// parameter record with the same origin is never mistaken for it.
fn record_of_origin(l:L,node:u64)->u64 {
    let mut r:u64=1;
    while r<=l.b.records {
        let p:u64=machine_ir.HEADER_WORDS()+(r-1)*machine_ir.NODE_WORDS();
        let mut origin:u64=l.b.out[p+1];if origin==0 { origin=l.b.out[p+18]; }
        if origin==node && l.b.out[p]==2051 { return r; }
        r=r+1;
    }
    return 0;
}
fn valid_name(l:L,node:u64)->bool {
    let a:u64=n(l,node,5);let z:u64=n(l,node,6);
    if a>=z || z>len(l.source) { bad(l,node,E_AST());return false; }
    let mut i:u64=a;
    while i<z {
        let c:u64=l.source[i];
        let letter:bool=(c>=65 && c<=90) || (c>=97 && c<=122) || c==95;
        if letter==false && (i==a || c<48 || c>57) { bad(l,node,E_AST());return false; }
        i=i+1;
    }
    return true;
}
fn source_name(l:L,node:u64)->u64 {
    if valid_name(l,node)==false { return l.code; }
    let mut i:u64=n(l,node,5);let end:u64=n(l,node,6);
    while i<end && l.code==0 { byte(l,l.source[i]);i=i+1; }return l.code;
}
fn exported_name_matches(l:L,start:u64,end:u64,node:u64)->bool {
    if valid_name(l,node)==false { return false; }
    let a:u64=n(l,node,5);let z:u64=n(l,node,6);
    if end-start!=z-a { return false; }
    let mut i:u64=0;
    while i<end-start { if l.text[start+i]!=l.source[a+i] { return false; }i=i+1; }
    return true;
}
fn private_name(l:L,ord:u64)->u64 {
    let start:u64=l.at;let mut attempt:u64=0;
    let indexed:bool=len(l.funcidx.nodes)!=0;let mut limit:u64=l.count;
    if indexed { limit=l.funcidx.declared; }
    while attempt<=l.count && l.code==0 {
        l.at=start;literal(l,14);decimal(l,ord);
        if attempt!=0 { literal(l,21);decimal(l,attempt); }
        let end:u64=l.at;let mut i:u64=1;let mut collision:bool=false;
        // Reserve every public identity, including declarations later in the
        // source. Other private bases have distinct function ordinals.
        while i<=limit && collision==false && l.code==0 {
            let mut node:u64=i;if indexed { node=l.funcidx.nodes[i-1]; }
            if n(l,node,0)==5 && (n(l,node,13)==1 || is_main(l,node)) {
                if exported_name_matches(l,start,end,node) { collision=true; }
            }
            i=i+1;
        }
        if collision==false { return l.code; }
        attempt=attempt+1;
    }
    return bad(l,0,E_BOUND());
}
// THE HELPER'S NAME, AND IT IS COLLISION-SAFE. The candidate is checked
// against EVERY function of the resolved program -- public and private -- and
// a program that declares the same name still gets a helper of its own.
fn helper_name(l:L)->u64 {
    let start:u64=l.at;let mut attempt:u64=0;
    let indexed:bool=len(l.funcidx.nodes)!=0;let mut limit:u64=l.count;
    if indexed { limit=l.funcidx.declared; }
    while attempt<=l.count && l.code==0 {
        l.at=start;
        byte(l,110);byte(l,97);byte(l,116);byte(l,105);byte(l,118);byte(l,101);byte(l,95);byte(l,114);byte(l,116);byte(l,95);byte(l,104);byte(l,101);byte(l,108);byte(l,112);byte(l,101);byte(l,114);
        if attempt!=0 { byte(l,95);decimal(l,attempt); }
        let end:u64=l.at;let mut i:u64=1;let mut collision:bool=false;
        while i<=limit && collision==false && l.code==0 {
            let mut node:u64=i;if indexed { node=l.funcidx.nodes[i-1]; }
            if n(l,node,0)==5 { if exported_name_matches(l,start,end,node) { collision=true; } }
            i=i+1;
        }
        if collision==false { return l.code; }
        attempt=attempt+1;
    }
    return bad(l,0,E_BOUND());
}
fn declarations(l:L)->u64 {
    // THE BATCH'S TEXT IS THE MODULE HEAD, THEN THE IMPORTS, THEN THE
    // SECTION. The other profiles write the head and the section in one
    // piece, because they have no import to write between them.
    if l.batch!=0 {
        literal(l,30);
        if batch_imports(l)!=0 { return l.code; }
        literal(l,31);
    } else { literal(l,10); }
    let mut i:u64=1;
    while i<=l.count && l.code==0 {
        if n(l,i,0)==5 {
            if valid_name(l,i)==false { return l.code; }
            let ord:u64=n(l,i,15);
            if ord==0 || ord>l.count || l.functions[ord*2]!=0 { return bad(l,i,E_AST()); }
            l.functions[ord*2]=i;
            // THE CLOSED MODE EMITS THE REACHABLE FUNCTIONS AND NOTHING ELSE,
            // AND A BATCH EMITS THE FUNCTIONS ITS RANKS NAME. The validation
            // above ran for EVERY declaration, so a malformed program is
            // refused in every mode exactly as it is in the normal one, and
            // the ORDINAL of a declaration is kept either way: the names of
            // the emitted functions are built from it, and they stay the
            // global ordinals, so they stay unique and they stay the same in
            // every batch.
            let mut emit:bool=true;
            if defines(l,ord)==false { emit=false; }
            if emit {
            // IN A BATCH EVERY DEFINED FUNCTION IS EXPORTED, because the other
            // objects import it by name and an import names an exported
            // symbol. The normal and the closed profiles keep their own rule:
            // the exported ones keep their name and the others are private.
            let mut exported:bool=false;
            if l.abi2==0 && (is_main(l,i) || n(l,i,13)==1) { exported=true; }
            if l.batch!=0 { exported=true; }
            if exported { literal(l,11); }
            // THE MONO PATH PICKS ITS MAIN HERE. THE MULTI PATH HAS ALREADY
            // CHOSEN THE ROOT'S MAIN, by the rule that it is unique and that
            // it belongs to the root module, so this arm must not take a
            // second one.
            if l.abi2!=0 && l.many.multi==0 && is_main(l,i) {
                if l.main_node!=0 { return bad(l,i,E_AST()); }
                l.main_node=i;
            }
            literal(l,12);
            if l.abi2==0 && (is_main(l,i) || n(l,i,13)==1) { source_name(l,i); } else { private_name(l,ord); }
            // THE SIGNATURE IS WRITTEN BY THE ONE FUNCTION THAT WRITES IT, so
            // a definition and an import of the same function cannot drift.
            if write_signature(l,i)!=0 { return l.code; }
            if l.abi2==0 { literal(l,17); }else { literal(l,22); }
            if l.sig_ret==9 { literal(l,18); } else { byte(l,48); }
            literal(l,19);
            }
        }
