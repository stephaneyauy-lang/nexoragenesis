// THE COMMON CORE. The mono profile and the multi-source profile differ in
// THREE THINGS and in nothing else: the root's main is chosen by a rule
// instead of by position, the spans say which file an offset belongs to, and
// the module table says which module a declaration belongs to. Everything
// else -- the declaration text, the MIR, the bodies, the wrapper -- is this
// code, so there is ONE backend and not two.
//
// THE `closed` FLAG IS THE CLOSED APPLICATION MODE AND IT IS NOT THE ABI.
// `abi2` says which ABI the program speaks; `closed` says whether the program
// is closed, that is, whether only the functions the root module's main can
// reach are emitted. The flag is EXPLICIT: it is its own parameter and it is
// never folded into the ABI's number.
//
// THE BATCH PARAMETERS ARE EXPLICIT TOO, and they are not the ABI either: a
// batch is a RANGE OF RANKS over the reachable functions, in ordinal order,
// and the object it produces DEFINES the functions in that range and IMPORTS
// the rest.
export fn lower_core(source:buf<u8>,nodes:buf<u64>,count:u64,program:u64,spans:buf<u64>,span_count:u64,modules:buf<u64>,root_idx:u64,multi:u64,text_out:buf<u8>,text_length:buf<u64>,
                     words:buf<u64>,capacity:u64,report:buf<u64>,abi2:u64,closed:u64)->u64 {
    return lower_core_batch(source,nodes,count,program,spans,span_count,modules,root_idx,multi,text_out,text_length,words,capacity,report,abi2,closed,0,0,0);
}
export fn lower_core_batch(source:buf<u8>,nodes:buf<u64>,count:u64,program:u64,spans:buf<u64>,span_count:u64,modules:buf<u64>,root_idx:u64,multi:u64,text_out:buf<u8>,text_length:buf<u64>,
                     words:buf<u64>,capacity:u64,report:buf<u64>,abi2:u64,closed:u64,batch:u64,batch_start:u64,batch_limit:u64)->u64 {
    // Invalidate public outputs before any early refusal, within both the
    // actual buffers and the caller's logical MIR capacity.
    if len(text_length)>0 { text_length[0]=0; }
    if len(words)>=machine_ir.HEADER_WORDS() && capacity>=machine_ir.HEADER_WORDS() && capacity<=len(words) { words[3]=0; }
    if len(text_length)<1 || len(report)<14 || count==0 || count>len(nodes)/16 || capacity>len(words) || capacity<machine_ir.HEADER_WORDS() {
        if len(report)>=4 { report[0]=0;report[1]=0;report[2]=E_BOUND();report[3]=0; }
        return E_BOUND();
    }
    let bindings:buf<u64>=alloc(runtime(),(count+1)*4);let functions:buf<u64>=alloc(runtime(),(count+1)*2);
    let lengths:buf<u64>=alloc(runtime(),count+1);let structs:buf<u64>=alloc(runtime(),count+13);
    let heads:buf<u64>=alloc(runtime(),count+1);let active:buf<u64>=alloc(runtime(),count+1);let breaks:buf<u64>=alloc(runtime(),count*2);
    let no:buf<u64>=alloc(runtime(),0);
    // THE MARKING'S OWN TABLES, IN THE CLOSED MODE ONLY. The normal profile
    // never allocates them, so its memory and its verdicts are the ones it
    // had. The handles are held by variables that can be REASSIGNED, and the
    // buffers themselves are named by temporaries whose initialiser IS the
    // allocation: a handle is never produced by an assignment to an
    // immutable binding.
