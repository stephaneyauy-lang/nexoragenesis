        let bo:buf<u64>=alloc(runtime(),count+2);
        let bs:buf<u64>=alloc(runtime(),count+1);
        let bi:buf<u64>=alloc(runtime(),count+1);
        batchord=bo;batchsel=bs;imports=bi;
    }
