            // SIGNATURE AND THE HELPER, and their nodes are the import nodes
            // the text wrote after the functions' own imports.
            while import_cursor<=tree.node_count && image[ntir.HEADER_WORDS()+(import_cursor-1)*ntir.NODE_WORDS()]-ntir.KIND_BASE()+1!=9 { import_cursor=import_cursor+1; }
            if import_cursor>tree.node_count { bad(l,0,E_AST()); }else { l.runtime_origin=import_cursor;l.runtime_import=import_cursor; }
            import_cursor=import_cursor+1;
            while import_cursor<=tree.node_count && image[ntir.HEADER_WORDS()+(import_cursor-1)*ntir.NODE_WORDS()]-ntir.KIND_BASE()+1!=9 { import_cursor=import_cursor+1; }
            if import_cursor>tree.node_count { bad(l,0,E_AST()); }else { l.helper_origin=import_cursor; }
