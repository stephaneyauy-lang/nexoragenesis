                        if l.abi2!=0 && buffer_type(n(l,p,14)) {
                            while mir_param<builder.block && get(l,mir_param,0)!=2054 { mir_param=mir_param+1; }
                            if mir_param>=builder.block { bad(l,p,E_AST()); }else { lengths[binding]=get(l,mir_param,4);mir_param=mir_param+1; }
                        }
                    }
                }else if kind==7 { l.return_type=n(l,p,14); }else if kind==8 { body=p; }
