        let w:buf<u64>=alloc(runtime(),count+2);
        let q:buf<u64>=alloc(runtime(),count+2);
        let r:buf<u64>=alloc(runtime(),count+1);
        let f:buf<u64>=alloc(runtime(),count+1);
        let s:buf<u64>=alloc(runtime(),count+1);
        let v:buf<u64>=alloc(runtime(),count+1);
