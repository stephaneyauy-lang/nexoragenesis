    let l:L=L{source:source,nodes:nodes,count:count,text:text_out,at:0,nt:no,nt_count:0,b:null,
        bindings:bindings,functions:functions,heads:heads,active:active,breaks:breaks,break_count:0,
        code:0,node:0,origin:0,current_fn:0,return_type:0,depth:0,owned_head:null,
        abi2:abi2,main_node:0,wrapper_origin:0,context:0,
        lengths:lengths,structs:structs,runtime_origin:0,runtime_sig:0,fault_node:0,
        access_handle:0,access_offset:0,access_spec:0,
        lits:no,litv:no,lit_count:0,lit_chunks:0,dec_byte:0,dec_next:0,runtime_mask:0,
        many:Many{program:program,spans:spans,span_count:span_count,modules:modules,root_idx:root_idx,multi:multi},
        src_index:1,rel_offset:0,root_module:0,helper_origin:0,
        closed:closed,work:work,queue:queue,reach:reach,fnord:fnord,seen:seen,litlive:litlive,
        batch:batch,batch_start:batch_start,batch_limit:batch_limit,batchord:batchord,batchsel:batchsel,
        batch_count:0,batch_selected:0,runtime_import:0,sig_ret:0,
        funcidx:funcidx};
    let mut i:u64=0;while i<(count+1)*4 { bindings[i]=0;i=i+1; }
    i=0;while i<(count+1)*2 { functions[i]=0;i=i+1; }
    i=0;while i<=count { heads[i]=0;active[i]=0;i=i+1; }
    i=0;while i<=count { lengths[i]=0;i=i+1; }
    i=0;while i<count+13 { structs[i]=0;i=i+1; }
