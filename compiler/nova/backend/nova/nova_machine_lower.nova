                // the text's own declarations, so the walk finds them where the
                // text put them.
                while import_cursor<=tree.node_count && image[ntir.HEADER_WORDS()+(import_cursor-1)*ntir.NODE_WORDS()]-ntir.KIND_BASE()+1!=9 { import_cursor=import_cursor+1; }
                if import_cursor>tree.node_count { bad(l,i,E_AST()); }else { functions[n(l,i,15)*2+1]=import_cursor;import_cursor=import_cursor+1; }
            }
        }
        i=i+1;
    }
