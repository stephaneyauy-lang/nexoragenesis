    // IS WRITTEN, because that text is parsed once and the storage items have
    // to be inside it. A string that is not in the text has no address to take.
    if l.abi2!=0 { count_literals(l); }
    let lits:buf<u64>=alloc(runtime(),l.lit_count*6);
    let litv:buf<u64>=alloc(runtime(),l.lit_chunks);
    l.lits=lits;l.litv=litv;
    if l.abi2!=0 { decode_literals(l); }
    declarations(l);
    rt_free(runtime(),no);
    let decl:buf<u8>=alloc(runtime(),l.at);i=0;while i<l.at { decl[i]=text_out[i];i=i+1; }
    let tree:ntasm_ast.Tree=ntasm_parser.parse(decl,1);
    let nt_words:u64=ntir.HEADER_WORDS()+tree.node_count*ntir.NODE_WORDS();let image:buf<u64>=alloc(runtime(),nt_words);
    if l.code==0 && tree.ok==false { bad(l,0,E_AST()); }
