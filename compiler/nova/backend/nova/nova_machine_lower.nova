    if builder!=null { machine_ir.native_release(builder); }
    rt_free(runtime(),image);ntasm_ast.release(tree);rt_free(runtime(),tree);rt_free(runtime(),decl);
    rt_free(runtime(),breaks);rt_free(runtime(),active);rt_free(runtime(),heads);rt_free(runtime(),functions);rt_free(runtime(),bindings);
    rt_free(runtime(),lengths);rt_free(runtime(),structs);
    rt_free(runtime(),litv);rt_free(runtime(),lits); // through the LOCALS: a runtime buffer argument must NAME a buffer, and the seed refuses a field access there (E400).
    if l.funcidx.declared!=0 { rt_free(runtime(),fnnodes); }
    if l.closed!=0 || l.batch!=0 {
        rt_free(runtime(),litlive);rt_free(runtime(),seen);rt_free(runtime(),fnord);rt_free(runtime(),reach);
