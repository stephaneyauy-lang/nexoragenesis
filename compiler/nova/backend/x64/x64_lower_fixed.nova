module x64_lower_fixed;
import ntasm_ast;import x64_fixed;import register_widths;

fn simple_name_id(tree:ntasm_ast.Tree,expr_id:u64)->u64 {
    if expr_id==0||expr_id>tree.node_count{return 0;}
    let expression:ntasm_ast.Node=ntasm_ast.node_at(tree,expr_id);
    if expression.kind!=35||expression.aux!=0||expression.first_child==0||expression.first_child!=expression.last_child{return 0;}
    let qualified:ntasm_ast.Node=ntasm_ast.node_at(tree,expression.first_child);
    if qualified.kind!=91||qualified.first_child==0||qualified.first_child!=qualified.last_child{return 0;}
    return qualified.first_child;
}

fn same_name(name:buf<u8>,text:buf<u8>)->bool {
    if len(name)!=len(text){return false;}let mut i:u64=0;
    while i<len(text){if name[i]!=text[i]{return false;}i=i+1;}return true;
}

fn node_word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool {
    if node.start>node.end||node.end>len(source)||(node.end-node.start)!=len(text){return false;}
    let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;
}

// ah/ch/dh/bh are the only byte registers that exist without a REX prefix, and
// the width table does not number them. Returns the family 1..4, else 0.
fn high8_family(source:buf<u8>,start:u64,end:u64)->u64 {
    if start>end||end>len(source)||end-start!=2{return 0;}
    if source[start+1]!=104{return 0;}
    if source[start]==97{return 1;}
    if source[start]==99{return 2;}
    if source[start]==100{return 3;}
    if source[start]==98{return 4;}
    return 0;
}

// Resolve one GPR operand into descriptor[0]=family1..16,[1]=width,[2]=high8
// flag. Returns 0 when the span spells no register, which the callers answer
// 406. descriptor[2] is the oracle boolean, never the high8 family index.
fn gpr_operand(source:buf<u8>,start:u64,end:u64,descriptor:buf<u64>)->u64 {
    if len(descriptor)<3{return 0;}
    let high8:u64=high8_family(source,start,end);
    let mut family:u64=register_widths.family(source,start,end);
    let mut width:u64=register_widths.width(source,start,end);
    if high8!=0 { if family==0{family=high8;} width=8; }
    if family==0||width==0{return 0;}
    descriptor[0]=family;descriptor[1]=width;
    if high8==0{descriptor[2]=0;}else{descriptor[2]=1;}
    return 1;
}

// The five shift and rotate mnemonics whose count operand may be cl.
fn shift_mnemonic(name:buf<u8>)->bool {
    let rol:buf<u8>="rol";let ror:buf<u8>="ror";let shl:buf<u8>="shl";
    let shr:buf<u8>="shr";let sar:buf<u8>="sar";
    if same_name(name,rol){return true;}
    if same_name(name,ror){return true;}
    if same_name(name,shl){return true;}
    if same_name(name,shr){return true;}
    if same_name(name,sar){return true;}
    return false;
}

// inc, dec, not, neg, and the multiply and divide group: the one-operand forms
// that share the F6/F7 and FE/FF frames. mul, div and idiv are here rather than
// on a path of their own because they ARE a one-operand register-or-memory form
// and the export that owns that frame is the same one.
fn unary_mnemonic(name:buf<u8>)->bool {
    let inc:buf<u8>="inc";let dec:buf<u8>="dec";let not_:buf<u8>="not";let neg:buf<u8>="neg";
    let mul:buf<u8>="mul";let div_:buf<u8>="div";let idiv:buf<u8>="idiv";
    if same_name(name,inc){return true;}
    if same_name(name,dec){return true;}
    if same_name(name,not_){return true;}
    if same_name(name,neg){return true;}
    if same_name(name,mul){return true;}
    if same_name(name,div_){return true;}
    if same_name(name,idiv){return true;}
    return false;
}

// push and pop, the two stack mnemonics with one operand.
fn stack_mnemonic(name:buf<u8>)->bool {
    let push:buf<u8>="push";let pop:buf<u8>="pop";
    if same_name(name,push){return true;}
    if same_name(name,pop){return true;}
    return false;
}

// The sixteen cmov conditions are exactly the cmov-prefixed spellings, and
// encode_cmov re-checks the whole name: any other prefix match answers 401,
// which is the oracle answer for an unknown mnemonic too.
fn cmov_mnemonic(name:buf<u8>)->bool {
    if len(name)<5{return false;}
    if name[0]!=99||name[1]!=109||name[2]!=111||name[3]!=118{return false;}
    return true;
}

// The sixteen setcc conditions are exactly the set-prefixed spellings, under
// the same rule as cmov_mnemonic: encode_setcc re-checks the whole name.
fn setcc_mnemonic(name:buf<u8>)->bool {
    if len(name)<4||len(name)>5{return false;}
    if name[0]!=115||name[1]!=101||name[2]!=116{return false;}
    return true;
}

// Decode base/index/scale/displacement plus optional FS/GS. descriptor is
// base0..15/RIP17,index0..15/NONE16,scale,displacement bits,segment0/1/2.
fn memory_descriptor(source:buf<u8>,tree:ntasm_ast.Tree,memory_id:u64,descriptor:buf<u64>)->u64 {
    if memory_id==0||memory_id>tree.node_count||len(descriptor)<5{return 409;}
    let memory:ntasm_ast.Node=ntasm_ast.node_at(tree,memory_id);
    if memory.kind!=34||memory.first_child==0||memory.last_child==0||memory.first_child==memory.last_child{return 409;}
    let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,memory.last_child);
    if type_.kind!=36||type_.aux!=1{return 409;}
    let mut current_id:u64=memory.first_child;let mut segment:u64=0;
    let current:ntasm_ast.Node=ntasm_ast.node_at(tree,current_id);
    if current.kind==90 {
        let fs:buf<u8>="fs";let gs:buf<u8>="gs";
        if node_word(source,current,fs){segment=1;}else if node_word(source,current,gs){segment=2;}else{return 409;}
        current_id=current.next_sibling;
    }
    let mut base:u64=16;let mut index:u64=16;let mut scale:u64=1;let mut displacement:u64=0;
    let mut have_displacement:bool=false;let mut previous_end:u64=memory.start;
    while current_id!=memory.last_child {
        if current_id==0||current_id>tree.node_count{return 409;}
        let item:ntasm_ast.Node=ntasm_ast.node_at(tree,current_id);
        let mut negative:bool=false;let mut scan:u64=previous_end;
        while scan<item.start&&scan<len(source){if source[scan]==45{negative=true;}scan=scan+1;}
        if item.kind==91 {
            if negative||item.first_child==0||item.first_child!=item.last_child{return 409;}
            let name:ntasm_ast.Node=ntasm_ast.node_at(tree,item.first_child);
            let rip:buf<u8>="rip";let mut reg:u64=17;
            if node_word(source,name,rip)==false {
                let family:u64=register_widths.family(source,name.start,name.end);
                if family==0||register_widths.width(source,name.start,name.end)!=64{return 406;}
                reg=family-1;
            }
            let mut next:u64=item.next_sibling;let mut scaled:bool=false;let mut item_end:u64=item.end;
            if next!=0&&next!=memory.last_child&&next<=tree.node_count {
                let amount:ntasm_ast.Node=ntasm_ast.node_at(tree,next);
                scan=item.end;
                while scan<amount.start&&scan<len(source){if source[scan]==42{scaled=true;}scan=scan+1;}
                if scaled {
                    if amount.kind!=94||index!=16||reg==17{return 411;}
                    index=reg;scale=amount.aux;next=amount.next_sibling;item_end=amount.end;
                }
            }
            if scaled==false {
                if base==16{base=reg;}
                else if index==16&&reg!=17{index=reg;}
                else{return 411;}
            }
            previous_end=item_end;current_id=next;
        } else if item.kind==94 {
            if have_displacement{return 409;}
            displacement=item.aux;
            if negative&&displacement!=0{displacement=18446744073709551615-displacement+1;}
            have_displacement=true;previous_end=item.end;current_id=item.next_sibling;
        } else{return 409;}
    }
    descriptor[0]=base;descriptor[1]=index;descriptor[2]=scale;descriptor[3]=displacement;descriptor[4]=segment;return 0;
}

// The magnitude and the sign of one literal operand. An unsigned literal is a
// kind 94 node whose aux is the magnitude. A negative literal is a unary-minus
// expression node whose only child is a kind 94 magnitude node: the tree states
// the magnitude and no sign at all, so the sign is read by scanning the source
// text between the operator node and its child for byte 45, the same discipline
// memory_descriptor uses for a displacement sign. words[0] is the two's
// complement of the magnitude when the literal is negative, which is what the
// oracle operand carries, and words[1] is 1 then and 0 otherwise. Returns 0 for
// a signed literal and 409 for every other shape, so a caller falls through to
// its own path instead of guessing a sign.
fn signed_literal(source:buf<u8>,tree:ntasm_ast.Tree,operand_id:u64,words:buf<u64>)->u64 {
    if len(words)<2{return 800;}
    if operand_id==0||operand_id>tree.node_count{return 409;}
    let node:ntasm_ast.Node=ntasm_ast.node_at(tree,operand_id);
    if node.kind!=35{return 409;}
    if node.first_child==0||node.first_child!=node.last_child{return 409;}
    if node.first_child>tree.node_count{return 409;}
    let magnitude:ntasm_ast.Node=ntasm_ast.node_at(tree,node.first_child);
    if magnitude.kind!=94{return 409;}
    let mut negative:bool=false;let mut at:u64=node.start;
    while at<magnitude.start&&at<len(source){if source[at]==45{negative=true;}at=at+1;}
    if negative==false{return 409;}
    if magnitude.aux>9223372036854775808{return 407;}
    words[0]=18446744073709551615-magnitude.aux+1;words[1]=1;return 0;
}

// Width in bits of an unsigned machine scalar type spelled exactly u8, u16,
// u32 or u64. Zero for every other spelling, so a caller refuses instead of
// inventing a width it cannot state.
fn scalar_width(source:buf<u8>,start:u64,end:u64)->u64 {
    if start>end||end>len(source){return 0;}
    let n:u64=end-start;
    if n==2 { if source[start]==117&&source[start+1]==56 { return 8; } return 0; }
    if n==3&&source[start]==117 {
        if source[start+1]==49&&source[start+2]==54 { return 16; }
        if source[start+1]==51&&source[start+2]==50 { return 32; }
        if source[start+1]==54&&source[start+2]==52 { return 64; }
    }
    return 0;
}

// The access width of a memory operand, read from the scalar element type of
// the pointer the spelling carries. The two-register encoders compare the
// memory operand width against the register one, so there the width is not
// optional. Only ptr<space,uN> states one; every other type answers 0 and the
// caller refuses.
fn memory_width(source:buf<u8>,tree:ntasm_ast.Tree,memory_id:u64)->u64 {
    if memory_id==0||memory_id>tree.node_count{return 0;}
    let memory:ntasm_ast.Node=ntasm_ast.node_at(tree,memory_id);
    if memory.kind!=34||memory.last_child==0||memory.last_child>tree.node_count{return 0;}
    let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,memory.last_child);
    if type_.kind!=36||type_.aux!=1{return 0;}
    if type_.last_child==0||type_.last_child>tree.node_count{return 0;}
    let element:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.last_child);
    if element.kind!=36||element.aux!=0{return 0;}
    if element.first_child==0||element.first_child>tree.node_count{return 0;}
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,element.first_child);
    if name.kind!=90{return 0;}
    return signed_scalar_width(source,name.start,name.end);
}

// EXPORT, the width table. Width in bits of a machine scalar type spelled
// exactly u8, u16, u32, u64 or i8, i16, i32, i64. The signed spellings are
// here because the oracle's element->bits is a perfect diagonal in which
// i8..i64 carry 8, 16, 32 and 64 exactly as u8..u64 do: measured against
// frontend.c, `load eax,[x]:ptr<user,i32>` and `load rax,[x]:ptr<user,i64>`
// are both accepted, while a bool element matches no register at all, not even
// al. Zero for every other spelling, so a caller refuses rather than
// inventing a width.
//
// Callers. memory_element_width below is the only caller in this module.
// x64_lower_nxo calls that one on the data path, where a memory operand names
// a data symbol instead of a register and the memory_descriptor of this
// module does not apply; codegen.c:857 reads the same TY(element).bits, so
// the two are reading one rule and not two. Exporting it keeps one table for
// that rule instead of a second copy beside it.
//
// This duplicates register_widths.nova:42 type_width, which is the same table
// over the same names and is private to that module. It is duplicated rather
// than imported because register_widths is not owned here. It is deliberately
// kept separate from the unsigned scalar_width above so that the one-operand
// and two-register families keep reading the table they were written against.
export fn signed_scalar_width(source:buf<u8>,start:u64,end:u64)->u64 {
    if start>end||end>len(source){return 0;}
    let n:u64=end-start;
    if n==2 {
        if (source[start]==117||source[start]==105)&&source[start+1]==56 { return 8; }
        return 0;
    }
    if n==3&&(source[start]==117||source[start]==105) {
        if source[start+1]==49&&source[start+2]==54 { return 16; }
        if source[start+1]==51&&source[start+2]==50 { return 32; }
        if source[start+1]==54&&source[start+2]==52 { return 64; }
    }
    return 0;
}

// EXPORT, the element width of a memory operand. The width in bits of the
// element of the pointer a memory operand carries, over the signed machine
// scalars as well. Same AST walk as memory_width above -- memory node, its
// type child, the element child, the element name -- and 0 for anything that
// states no machine scalar width, bool included.
//
// Callers. The load and store rule in this module answers 409 on 0, because a
// form with no stated access width must be refused rather than encoded at
// some other width. x64_lower_nxo calls it for the same reason on the data
// path and answers 409 on 0 for the same reason. It is exported so that
// caller is one call rather than a restatement of signed_scalar_width.
export fn memory_element_width(source:buf<u8>,tree:ntasm_ast.Tree,memory_id:u64)->u64 {
    if memory_id==0||memory_id>tree.node_count{return 0;}
    let memory:ntasm_ast.Node=ntasm_ast.node_at(tree,memory_id);
    if memory.kind!=34||memory.last_child==0||memory.last_child>tree.node_count{return 0;}
    let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,memory.last_child);
    if type_.kind!=36||type_.aux!=1{return 0;}
    if type_.last_child==0||type_.last_child>tree.node_count{return 0;}
    let element:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.last_child);
    if element.kind!=36||element.aux!=0{return 0;}
    if element.first_child==0||element.first_child>tree.node_count{return 0;}
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,element.first_child);
    if name.kind!=90{return 0;}
    return signed_scalar_width(source,name.start,name.end);
}


// Resolve one operand of a one-register export into the three words those
// exports take: 0 the register number 0..15, 1 the width, 2 the high8
// boolean. Answers 409 when the spelling is not a plain register name and 406
// when it is a name the width table does not number.
fn register_operand(source:buf<u8>,tree:ntasm_ast.Tree,operand_id:u64,words:buf<u64>)->u64 {
    if len(words)<3{return 800;}
    if operand_id==0||operand_id>tree.node_count{return 409;}
    let node:ntasm_ast.Node=ntasm_ast.node_at(tree,operand_id);
    if node.kind!=35{return 409;}
    let register_id:u64=simple_name_id(tree,operand_id);
    if register_id==0{return 409;}
    let register:ntasm_ast.Node=ntasm_ast.node_at(tree,register_id);
    let gpr:buf<u64>=alloc(runtime(),3);
    let mut code:u64=0;
    if gpr_operand(source,register.start,register.end,gpr)==0{code=406;}
    else {words[0]=gpr[0]-1;words[1]=gpr[1];words[2]=gpr[2];}
    rt_free(runtime(),gpr);
    return code;
}

// The memory operand of a one-operand form, stated as kind3, the native memory
// numbering. stack1 is push and pop, which go to encode_stack_memory, and stack0
// is the four unaries and the sixteen setcc conditions, which go to
// encode_unary_operand and encode_setcc_operand. The address comes from
// memory_descriptor and the access width from memory_width, so no family
// re-derives either. A pointer element that states no machine scalar width
// leaves the export nothing to read, and the form is answered with the same 409
// the two-register families answer rather than with a width invented here.
fn encode_one_operand_memory(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,memory_id:u64,stack:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    let width:u64=memory_width(source,tree,memory_id);
    if width==0 { return 409; }
    let address:buf<u64>=alloc(runtime(),5);
    let mut code:u64=memory_descriptor(source,tree,memory_id,address);
    if code==0 {
        if stack==1 { code=x64_fixed.encode_stack_memory(name,1,width,address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else if unary_mnemonic(name) { code=x64_fixed.encode_unary_operand(name,1,3,0,0,width,address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else { code=x64_fixed.encode_setcc_operand(name,1,3,0,0,width,address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
    }
    rt_free(runtime(),address);
    return code;
}

// The one-operand forms the encoder owns: the four unaries, push/pop and the
// sixteen setcc conditions. A register operand goes to encode_unary_operand or
// encode_setcc_operand as kind1, the register number in words[0] and the high8
// boolean in words[2], which is the oracle boolean and never the high8 family
// index, so ah/ch/dh/bh are encoded with the regcode the oracle uses instead of
// being refused. A memory operand goes to the same two exports, or to
// encode_stack_memory for push/pop, through encode_one_operand_memory. A bare
// unsigned literal is the whole immediate form of push/pop; a signed literal is a
// unary-minus node this lowerer does not resolve and is refused with the same
// 409.
// Descriptor tables are ten bytes; mirror the C frontend's array<u8,10> rule.
fn descriptor_width(source:buf<u8>,tree:ntasm_ast.Tree,id:u64)->u64 {
    let memory:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
    let pointer:ntasm_ast.Node=ntasm_ast.node_at(tree,memory.last_child);
    if pointer.kind!=36||pointer.aux!=1{return 0;}
    let array:ntasm_ast.Node=ntasm_ast.node_at(tree,pointer.last_child);
    if array.kind!=36||array.aux!=2{return memory_width(source,tree,id);}
    let element:ntasm_ast.Node=ntasm_ast.node_at(tree,array.first_child);
    let count:ntasm_ast.Node=ntasm_ast.node_at(tree,array.last_child);
    if element.kind!=36||element.aux!=0||count.kind!=94||count.aux!=10{return 0;}
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,element.first_child);
    let u8_:buf<u8>="u8";
    if node_word(source,name,u8_){return 80;}
    return 0;
}

// A machine operand keeps kind, register, high8, width, immediate and sign.
fn binary_operand(source:buf<u8>,tree:ntasm_ast.Tree,id:u64,words:buf<u64>,address:buf<u64>)->u64 {
    if len(words)<6||id==0||id>tree.node_count{return 409;}
    let node:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
    if node.kind==94 {words[0]=2;words[4]=node.aux;words[5]=0;return 0;}
    let signed_:buf<u64>=alloc(runtime(),2);
    let result:u64=signed_literal(source,tree,id,signed_);
    if result==0 {words[0]=2;words[4]=signed_[0];words[5]=signed_[1];}
    rt_free(runtime(),signed_);
    if result==0{return 0;}
    if result==407{return result;}
    let name_id:u64=simple_name_id(tree,id);
    if name_id!=0 {
        let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);
        if name.end<=len(source)&&name.end-name.start==3&&source[name.start]==99&&source[name.start+1]==114&&source[name.start+2]>=48&&source[name.start+2]<=57 {
            words[0]=5;words[1]=u64(source[name.start+2])-48;words[2]=0;words[3]=64;return 0;
        }
    }
    return pair_operand(source,tree,id,words,address);
}

fn binary_mnemonic(name:buf<u8>)->bool {
    let names:buf<u8>="mov|load|store|add|or|adc|sbb|and|sub|xor|cmp|test|read_cr|write_cr|in|out";
    let mut start:u64=0;let mut end:u64=0;
    while end<=len(names){
        if end==len(names)||names[end]==124 {
            let part:buf<u8>=slice(names,start,end-start);
            if same_name(name,part){return true;}
            start=end+1;
        }
        end=end+1;
    }
    return false;
}
fn encode_binary_operands(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,first:u64,second:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    let a:buf<u64>=alloc(runtime(),6);let b:buf<u64>=alloc(runtime(),6);let address:buf<u64>=alloc(runtime(),5);
    address[0]=16;address[1]=16;address[2]=1;
    let mut code:u64=binary_operand(source,tree,first,a,address);
    if code==0{code=binary_operand(source,tree,second,b,address);}
    if code==0&&a[0]==3&&b[0]==3{code=409;}
    let mut immediate:u64=0;let mut sign:u64=0;
    if a[0]==2{immediate=a[4];sign=a[5];}else if b[0]==2{immediate=b[4];sign=b[5];}
    if code==0{code=x64_fixed.encode_binary(name,2,a[0],a[1],a[2],a[3],b[0],b[1],b[2],b[3],address[0],address[1],address[2],address[3],address[4],immediate,sign,features,cpl,out);}
    rt_free(runtime(),a);rt_free(runtime(),b);rt_free(runtime(),address);return code;
}
fn encode_shift_operands(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,first:u64,second:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    let a:buf<u64>=alloc(runtime(),6);let b:buf<u64>=alloc(runtime(),6);let address:buf<u64>=alloc(runtime(),5);
    address[0]=16;address[1]=16;address[2]=1;
    let mut code:u64=binary_operand(source,tree,first,a,address);
    if code==0{code=binary_operand(source,tree,second,b,address);}
    if code==0&&b[0]==1 {if b[1]!=1||b[2]!=0||b[3]!=8{code=406;}}
    if code==0&&b[0]!=1&&b[0]!=2{code=409;}
    if code==0{code=x64_fixed.encode_shift_memory(name,2,a[0],a[1],a[2],a[3],b[0],b[1],b[4],address[0],address[1],address[2],address[3],address[4],features,cpl,out);}
    rt_free(runtime(),a);rt_free(runtime(),b);rt_free(runtime(),address);return code;
}

fn encode_one_operand(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,operand_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if operand_id==0||operand_id>tree.node_count{return 409;}
    let node:ntasm_ast.Node=ntasm_ast.node_at(tree,operand_id);
    // bswap is one register and nothing else: no memory frame, no immediate, no
    // ModRM. It is answered here rather than by adding a fifth name to
    // unary_mnemonic, because that helper routes to encode_unary_operand and
    // this mnemonic has no group-2 frame to sit in. A memory operand is the
    // oracle form error and is answered with it.
    let bswap:buf<u8>="bswap";
    if same_name(name,bswap) {
        if node.kind==34{return 409;}
        let words:buf<u64>=alloc(runtime(),3);
        let mut code:u64=register_operand(source,tree,operand_id,words);
        if code==0{code=x64_fixed.encode_bswap(name,1,words[0],words[1],features,cpl,out);}
        rt_free(runtime(),words);
        return code;
    }
    // sgdt, sidt, lgdt and lidt: ONE memory operand whose access width the
    // native demands to be exactly 80. Two things are true at once and both are
    // stated rather than smoothed over. The width comes from the pointer element
    // the source spells, and NO machine scalar states 80, so a source that names
    // this family today reaches the export and is refused 403 -- which is the
    // oracle's own answer for a width it does not accept, so those rows are
    // parity rows and not gaps. And an element that states no scalar width at all
    // leaves the export nothing to say, which is the 409 every other one-operand
    // family already gives; the two answers are different and are not merged.
    // The privilege half is decided by the export from the NAME alone, so lgdt
    // above ring zero is refused 405 before the address is read at all.
    let sgdt:buf<u8>="sgdt";let sidt:buf<u8>="sidt";let lgdt:buf<u8>="lgdt";let lidt:buf<u8>="lidt";
    if same_name(name,sgdt)||same_name(name,sidt)||same_name(name,lgdt)||same_name(name,lidt) {
        if node.kind!=34{return 409;}
        let width:u64=descriptor_width(source,tree,operand_id);
        if width==0{return 403;}
        let address:buf<u64>=alloc(runtime(),5);
        let mut code:u64=memory_descriptor(source,tree,operand_id,address);
        if code==0{code=x64_fixed.encode_descriptor(name,1,3,0,0,width,address[0],address[1],address[2],address[3],address[4],features,cpl,out);}
        rt_free(runtime(),address);
        return code;
    }
    let ltr:buf<u8>="ltr";let invlpg:buf<u8>="invlpg";
    if same_name(name,ltr)||same_name(name,invlpg) {
        let a:buf<u64>=alloc(runtime(),4);let address:buf<u64>=alloc(runtime(),5);
        address[0]=16;address[1]=16;address[2]=1;
        let mut code:u64=pair_operand(source,tree,operand_id,a,address);
        if same_name(name,invlpg)&&a[0]==3{a[3]=0;}
        if code==0{code=x64_fixed.encode_system_one(name,1,a[0],a[1],a[2],a[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out);}
        rt_free(runtime(),a);rt_free(runtime(),address);return code;
    }
    if unary_mnemonic(name)||setcc_mnemonic(name) {
        if node.kind==34 { return encode_one_operand_memory(source,tree,name,operand_id,0,features,cpl,out); }
        let words:buf<u64>=alloc(runtime(),3);
        let mut code:u64=register_operand(source,tree,operand_id,words);
        if code==0 {
            if unary_mnemonic(name){code=x64_fixed.encode_unary_operand(name,1,1,words[0],words[2],words[1],16,16,1,0,0,features,cpl,out);}
            else{code=x64_fixed.encode_setcc_operand(name,1,1,words[0],words[2],words[1],16,16,1,0,0,features,cpl,out);}
        }
        rt_free(runtime(),words);
        return code;
    }
    if stack_mnemonic(name) {
        if node.kind==34 { return encode_one_operand_memory(source,tree,name,operand_id,1,features,cpl,out); }
        if node.kind==94 { return x64_fixed.encode_stack(name,1,2,0,node.aux,0,features,cpl,out); }
        // A negative literal is a unary-minus node: the sign is read from the
        // source text and the encoder is handed the two's complement the oracle
        // operand carries, so push -1 and its neighbours are encoded, not
        // refused. Anything else here is the register spelling of push/pop.
        let words:buf<u64>=alloc(runtime(),2);
        let mut magnitude:u64=0;let mut is_signed:u64=0;
        let signed_code:u64=signed_literal(source,tree,operand_id,words);
        if signed_code==0{magnitude=words[0];is_signed=words[1];}
        rt_free(runtime(),words);
        if signed_code==0 { return x64_fixed.encode_stack(name,1,2,0,magnitude,is_signed,features,cpl,out); }
        let registers:buf<u64>=alloc(runtime(),3);
        let mut code:u64=register_operand(source,tree,operand_id,registers);
        if code==0 { code=x64_fixed.encode_stack(name,1,1,registers[1],registers[0],0,features,cpl,out); }
        rt_free(runtime(),registers);
        return code;
    }
    return 409;
}

// The two-register families x64_fixed encodes, in the native operand order its
// exports take: 1 xchg, 2 the cmov conditions, 3 bsf/bsr, 4 the
// width-conversion moves, 5 test, 6 imul. Zero is every other mnemonic, which
// keeps the register/register, register/immediate and memory paths exactly as
// they were.
//
// imul is family 6 rather than a mnemonic of its own path because its
// TWO-operand form is the same shape as cmov and bsf: a register destination, a
// register or memory source, equal operand widths, no width 8. It also has a
// THREE-operand form, which no other family here has, and that one is reached by
// encode_imul_three instead: the two-operand dispatch consumes exactly two
// operands, so a third is not merely a different family but a different arity.
fn two_register_family(name:buf<u8>)->u64 {
    let xchg:buf<u8>="xchg";let test:buf<u8>="test";
    let bsf:buf<u8>="bsf";let bsr:buf<u8>="bsr";
    let movzx:buf<u8>="movzx";let movsx:buf<u8>="movsx";let movsxd:buf<u8>="movsxd";
    let imul:buf<u8>="imul";
    let bt:buf<u8>="bt";let bts:buf<u8>="bts";let btr:buf<u8>="btr";let btc:buf<u8>="btc";
    if same_name(name,xchg){return 1;}
    if same_name(name,test){return 5;}
    if same_name(name,bsf){return 3;}
    if same_name(name,bsr){return 3;}
    if same_name(name,movzx){return 4;}
    if same_name(name,movsx){return 4;}
    if same_name(name,movsxd){return 4;}
    if cmov_mnemonic(name){return 2;}
    if same_name(name,imul){return 6;}
    // 7 is the bit-test group. It is NOT handled by encode_two_register, which
    // owns the five families whose second operand is a register: here the second
    // operand may be a literal, and pair_operand answers 409 for a literal.
    if same_name(name,bt){return 7;}
    if same_name(name,bts){return 7;}
    if same_name(name,btr){return 7;}
    if same_name(name,btc){return 7;}
    return 0;
}

// Resolve one operand of a two-register family into the native words those
// exports take: kind1 is a register and kind3 is memory, the native numbering,
// then register, high8 and width. A memory operand also fills the shared
// address descriptor and takes its access width from the pointer element type.
// An operand that is neither a plain register nor a memory expression is 409,
// the oracle form error every one of the five families answers for it.
fn pair_operand(source:buf<u8>,tree:ntasm_ast.Tree,operand_id:u64,descriptor:buf<u64>,address:buf<u64>)->u64 {
    if len(descriptor)<4||len(address)<5{return 800;}
    if operand_id==0||operand_id>tree.node_count{return 409;}
    let node:ntasm_ast.Node=ntasm_ast.node_at(tree,operand_id);
    if node.kind==34 {
        let mut code:u64=memory_descriptor(source,tree,operand_id,address);
        if code!=0{return code;}
        let width:u64=memory_width(source,tree,operand_id);
        if width==0{return 409;}
        descriptor[0]=3;descriptor[1]=0;descriptor[2]=0;descriptor[3]=width;
        return 0;
    }
    let words:buf<u64>=alloc(runtime(),3);
    let mut code:u64=register_operand(source,tree,operand_id,words);
    if code==0 { descriptor[0]=1;descriptor[1]=words[0];descriptor[2]=words[2];descriptor[3]=words[1]; }
    rt_free(runtime(),words);
    return code;
}

// bt, bts, btr and btc: a bit string that may be a memory, and a bit index
// that may be a register OR a literal. The two are resolved separately because
// they do not have the same shape, and the index is deliberately NOT resolved by
// pair_operand: that helper answers 409 for a literal, which is the right answer
// for every other family here and the wrong one for this one. The roles are also
// inverted at the frame level -- the index is ModRM.reg and the bit string is
// ModRM.rm -- which the export owns, so nothing below has to know it.
fn bit_test_pair(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,first_id:u64,second_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if first_id==0||second_id==0{return 409;}
    let a0:buf<u64>=alloc(runtime(),4);
    let a1:buf<u64>=alloc(runtime(),4);
    let address:buf<u64>=alloc(runtime(),5);
    let mut code:u64=pair_operand(source,tree,first_id,a0,address);
    let mut immediate:u64=0;let mut is_signed:u64=0;
    if code==0 {
        let node:ntasm_ast.Node=ntasm_ast.node_at(tree,second_id);
        if node.kind==94 {
            immediate=node.aux;is_signed=0;a1[0]=2;a1[1]=0;a1[2]=0;a1[3]=0;
        } else {
            let words:buf<u64>=alloc(runtime(),2);
            if signed_literal(source,tree,second_id,words)==0 {
                immediate=words[0];is_signed=1;a1[0]=2;a1[1]=0;a1[2]=0;a1[3]=0;
            } else { code=pair_operand(source,tree,second_id,a1,address); }
            rt_free(runtime(),words);
        }
    }
    if code==0&&a0[0]==3&&a1[0]==3 { code=409; }
    if code==0 {
        code=x64_fixed.encode_bit_test(name,2,immediate,is_signed,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out);
    }
    rt_free(runtime(),a0);rt_free(runtime(),a1);rt_free(runtime(),address);
    return code;
}

// The five two-register families, forwarded to the export that owns each of
// them. Addressing stays in memory_descriptor and width resolution in
// gpr_operand, so no family re-derives either. At most one operand is a
// memory: the two families that take one refuse a two-memory pair with the
// oracle form error, and that answer is decided before the address descriptor
// is read, so the two operands can share it.
fn encode_two_register(source:buf<u8>,tree:ntasm_ast.Tree,family:u64,name:buf<u8>,first_id:u64,second_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    let a0:buf<u64>=alloc(runtime(),4);
    let a1:buf<u64>=alloc(runtime(),4);
    let address:buf<u64>=alloc(runtime(),5);
    let mut code:u64=pair_operand(source,tree,first_id,a0,address);
    if code==0 { code=pair_operand(source,tree,second_id,a1,address); }
    if code==0&&a0[0]==3&&a1[0]==3 { code=409; }
    if code==0 {
        if family==1 { code=x64_fixed.encode_xchg(name,2,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else if family==2 { code=x64_fixed.encode_cmov(name,2,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else if family==3 { code=x64_fixed.encode_bit_scan(name,2,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else if family==4 { code=x64_fixed.encode_move_convert(name,2,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else if family==6 { code=x64_fixed.encode_imul(name,2,0,0,0,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
        else { code=x64_fixed.encode_test_two(name,2,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
    }
    rt_free(runtime(),a0);rt_free(runtime(),a1);rt_free(runtime(),address);
    return code;
}

// imul of a register destination by a register or memory source and an
// IMMEDIATE third operand: the 69 or 6B /r id form. The two operands are
// resolved by the same pair_operand the two-operand dispatch uses, so
// addressing and the register/memory words stay single-sourced and no family
// re-derives them; only the arity is new.
//
// The immediate is read the way the shift path reads a count, because the two
// are the same shape in the AST: a literal is a kind 94 node carrying its
// magnitude, and a negative one is a unary-minus node whose child carries only
// the magnitude, so signed_literal folds it to the two's complement the oracle
// operand carries. The sign is handed over rather than guessed, because the
// encoder's compactness choice and its 32-bit range test both depend on it and a
// guessed sign would answer 407 where the oracle answers 0.
//
// immediate_width is 0 here: an NTASM literal states no width, and 0 is the
// native form the oracle's own immediate operands carry. The encoder's
// non-zero-width refusals therefore have no NTASM source that reaches them; that
// is a limit of the SPELLING, not a hole in the encoder, and it is named here
// so nobody reads the gate's width rows as a claim about the language.
fn encode_imul_three(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,first_id:u64,second_id:u64,third_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    let a0:buf<u64>=alloc(runtime(),4);
    let a1:buf<u64>=alloc(runtime(),4);
    let address:buf<u64>=alloc(runtime(),5);
    let mut code:u64=pair_operand(source,tree,first_id,a0,address);
    if code==0 { code=pair_operand(source,tree,second_id,a1,address); }
    if code==0&&a0[0]==3&&a1[0]==3 { code=409; }
    let mut immediate:u64=0;let mut is_signed:u64=0;
    if code==0 {
        let third:ntasm_ast.Node=ntasm_ast.node_at(tree,third_id);
        if third.kind==94 { immediate=third.aux; }
        else {
            let words:buf<u64>=alloc(runtime(),2);
            let folded:u64=signed_literal(source,tree,third_id,words);
            if folded==0 { immediate=words[0];is_signed=words[1]; }
            else { code=folded; }
            rt_free(runtime(),words);
        }
    }
    if code==0 { code=x64_fixed.encode_imul(name,3,immediate,is_signed,0,a0[0],a0[1],a0[2],a0[3],a1[0],a1[1],a1[2],a1[3],address[0],address[1],address[2],address[3],address[4],features,cpl,out); }
    rt_free(runtime(),a0);rt_free(runtime(),a1);rt_free(runtime(),address);
    return code;
}

// lea destination,[address]. The address is decoded by the memory path's own
// discipline and the encoder owns the register, width, address and segment
// rules. The oracle refuses any destination that is not 64 bits wide, so that
// is refused here. The fs/gs prefix used to be refused as well, because
// encode_lea had no way to be told which segment was wanted and answered the
// same bytes for both; it now takes the segment like every other memory
// export, and address[4] is forwarded instead of dropped.
fn encode_lea_operand(source:buf<u8>,tree:ntasm_ast.Tree,register_id:u64,memory_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if register_id==0||memory_id==0{return 409;}
    let register:ntasm_ast.Node=ntasm_ast.node_at(tree,register_id);
    let destination:buf<u64>=alloc(runtime(),3);
    let mut code:u64=0;
    if gpr_operand(source,register.start,register.end,destination)==0{code=406;}
    else if destination[1]!=64{code=403;}
    else {
        let address:buf<u64>=alloc(runtime(),5);
        code=memory_descriptor(source,tree,memory_id,address);
        if code==0{code=x64_fixed.encode_lea(destination[0]-1,destination[1],address[0],address[1],address[2],address[3],address[4],features,cpl,out);}
        rt_free(runtime(),address);
    }
    rt_free(runtime(),destination);
    return code;
}

// Shift and rotate counted by cl. The oracle accepts cl as the only count
// register and answers 406 for every other one, so the count operand is
// resolved here instead of being forwarded as a second GPR.
fn encode_shift_count_cl(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,destination_id:u64,count_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if destination_id==0||count_id==0{return 409;}
    let destination_node:ntasm_ast.Node=ntasm_ast.node_at(tree,destination_id);
    let count_node:ntasm_ast.Node=ntasm_ast.node_at(tree,count_id);
    let destination:buf<u64>=alloc(runtime(),3);
    let mut code:u64=0;
    if gpr_operand(source,destination_node.start,destination_node.end,destination)==0{code=406;}
    else {
        let count:buf<u64>=alloc(runtime(),3);
        if gpr_operand(source,count_node.start,count_node.end,count)==0{code=406;}
        else if count[0]!=2||count[1]!=8||count[2]!=0{code=406;}
        else {code=x64_fixed.encode_shift_cl(name,2,destination[0]-1,destination[1],1,destination[2],features,cpl,out);}
        rt_free(runtime(),count);
    }
    rt_free(runtime(),destination);
    return code;
}

// The oracle answers a mnemonic it does not know with 401 from the name alone,
// without ever reading an operand, while the register/register path of this
// lowerer applies its width rule first and answers 403. Closing that needs a
// mnemonic guard ahead of encode_rr, and two harnesses pin the 403 answer as a
// stated limit: tests_ntasm_x64_lower_two_reg.c and tests_ntasm_x64_lower_shift_cl.c.
// Both compile this file and call this same lower, so the guard cannot be scoped
// to one of them: it has to land with both pins moved in one transaction, and
// the shift gate is outside the ownership of the lot that moved the first pin.
// Until then the divergence is left stated rather than moved: no byte can be
// wrong, only the diagnostic differs.

// Shift and rotate counted by a literal. The oracle accepts cl as the only
// count register and answers 406 for every other one, 409 for a count that is
// neither a register nor a literal, and range-checks the two's complement of a
// negative amount, so a signed count is folded by signed_literal. The register
// destination is resolved by gpr_operand and the memory one by
// memory_descriptor, so addressing and width stay single-sourced with the
// by-cl path. encode_shift_imm states a register number and no high8 regcode,
// so an ah/ch/dh/bh destination is refused rather than answered with the wrong
// ModRM.rm byte, and it takes no memory operand at all.
fn encode_shift_immediate(source:buf<u8>,tree:ntasm_ast.Tree,name:buf<u8>,destination_expr_id:u64,count_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if destination_expr_id==0||count_id==0{return 409;}
    let destination_expr:ntasm_ast.Node=ntasm_ast.node_at(tree,destination_expr_id);
    if destination_expr.kind==34 {
        // The address is resolved here even though it cannot be stated, so the
        // refusal is about the missing encoder channel and not about a spelling
        // the descriptor would have rejected.
        let address:buf<u64>=alloc(runtime(),5);
        let mut code:u64=memory_descriptor(source,tree,destination_expr_id,address);
        rt_free(runtime(),address);
        if code!=0{return code;}
        return 409;
    }
    let register_id:u64=simple_name_id(tree,destination_expr_id);if register_id==0{return 409;}
    let register:ntasm_ast.Node=ntasm_ast.node_at(tree,register_id);
    let destination:buf<u64>=alloc(runtime(),3);
    let mut code:u64=0;let mut amount:u64=0;let mut counted:bool=true;
    if gpr_operand(source,register.start,register.end,destination)==0{code=406;counted=false;}
    else if destination[2]!=0{code=409;counted=false;}
    else {
        let count:ntasm_ast.Node=ntasm_ast.node_at(tree,count_id);
        if count.kind==94 { amount=count.aux; }
        else {
            let words:buf<u64>=alloc(runtime(),2);
            let count_code:u64=signed_literal(source,tree,count_id,words);
            if count_code==0 { amount=words[0]; } else { code=count_code; counted=false; }
            rt_free(runtime(),words);
        }
    }
    if counted { code=x64_fixed.encode_shift_imm(name,2,destination[0]-1,destination[1],amount,features,cpl,out); }
    rt_free(runtime(),destination);
    return code;
}

// Encode one non-label instruction AST node into out[0]=length,out[1..].
// Branch labels remain the responsibility of the two-pass control lowerer.
// The dispatch is by operand count first: zero operands are the fixed forms,
// one operand is the unary/stack/setcc group, two operands are one of the five
// two-register families, the five shift and rotate mnemonics, or the
// fixed/memory/rr/ri paths.
export fn encode_instruction(source:buf<u8>,tree:ntasm_ast.Tree,instruction_id:u64,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if instruction_id==0||instruction_id>tree.node_count||len(out)<16{return 800;}
    let instruction:ntasm_ast.Node=ntasm_ast.node_at(tree,instruction_id);
    if instruction.kind!=32||instruction.aux!=0||instruction.first_child==0||instruction.first_child>tree.node_count{return 409;}
    let name_node:ntasm_ast.Node=ntasm_ast.node_at(tree,instruction.first_child);
    if name_node.start>name_node.end||name_node.end>len(source){return 409;}
    let name:buf<u8>=slice(source,name_node.start,name_node.end-name_node.start);
    let first_id:u64=name_node.next_sibling;
    if first_id==0{return x64_fixed.encode(name,0,features,cpl,out);}
    if first_id>tree.node_count{return 409;}
    let first:ntasm_ast.Node=ntasm_ast.node_at(tree,first_id);let second_id:u64=first.next_sibling;
    if second_id==0{return encode_one_operand(source,tree,name,first_id,features,cpl,out);}
    if second_id>tree.node_count{return 409;}
    let second:ntasm_ast.Node=ntasm_ast.node_at(tree,second_id);
    // imul is the ONLY family with a third operand, and the arity has to be
    // decided here because every path below this line consumes exactly two. The
    // refusal that used to stand on its own answered 409 for a form the oracle
    // encodes, which left encode_imul_three a function no caller could reach: a
    // door with no key. The lowering gate went red on it before this branch
    // existed, and the encoder-side gate stayed green throughout, because an
    // encoder nobody can call still passes its own parity rows.
    if second.next_sibling!=0 {
        let imul:buf<u8>="imul";
        if same_name(name,imul)==false{return 409;}
        let third_id:u64=second.next_sibling;
        if third_id>tree.node_count{return 409;}
        let third:ntasm_ast.Node=ntasm_ast.node_at(tree,third_id);
        if third.next_sibling!=0{return 409;}
        return encode_imul_three(source,tree,name,first_id,second_id,third_id,features,cpl,out);
    }
    if binary_mnemonic(name){return encode_binary_operands(source,tree,name,first_id,second_id,features,cpl,out);}
    if shift_mnemonic(name){return encode_shift_operands(source,tree,name,first_id,second_id,features,cpl,out);}
    let pair:u64=two_register_family(name);
    if pair==7{return bit_test_pair(source,tree,name,first_id,second_id,features,cpl,out);}
    if pair!=0{return encode_two_register(source,tree,pair,name,first_id,second_id,features,cpl,out);}
    let lea:buf<u8>="lea";
    if same_name(name,lea)&&second.kind==34&&first.kind!=34 {
        return encode_lea_operand(source,tree,simple_name_id(tree,first_id),second_id,features,cpl,out);
    }
    if same_name(name,lea){return 409;}
    let destination_id:u64=simple_name_id(tree,first_id);if destination_id==0{return 409;}
    let destination:ntasm_ast.Node=ntasm_ast.node_at(tree,destination_id);
    let width:u64=register_widths.width(source,destination.start,destination.end);
    let family:u64=register_widths.family(source,destination.start,destination.end);
    if width==0||family==0{return 406;}
    let source_id:u64=simple_name_id(tree,second_id);
    if source_id!=0 {
        let source_register:ntasm_ast.Node=ntasm_ast.node_at(tree,source_id);
        let source_width:u64=register_widths.width(source,source_register.start,source_register.end);
        let source_family:u64=register_widths.family(source,source_register.start,source_register.end);
        if source_width==0||source_family==0{return 406;}if source_width!=width{return 403;}
        return x64_fixed.encode_rr(name,2,family-1,source_family-1,width,features,cpl,out);
    }
    if second.kind==94{return x64_fixed.encode_ri(name,2,family-1,width,second.aux,0,features,cpl,out);}
    return 409;
}

// Lower fixed, GPR->GPR, GPR+literal, lea, shift-by-cl and shift-by-literal
// instruction nodes. The walk delegates every node to encode_instruction, so
// the two entry points cannot drift apart. The encoded stream is
// transactional: out[0] is byte length and out[1..] bytes on success; any
// failure leaves out untouched.
export fn lower(source:buf<u8>,tree:ntasm_ast.Tree,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if tree.ok==false||tree.node_count==0||len(out)<2{return 800;}
    let temporary:buf<u8>=alloc(runtime(),len(out));
    let scratch:buf<u8>=alloc(runtime(),16);
    let mut total:u64=0;let mut code:u64=0;let mut id:u64=1;
    while id<=tree.node_count&&code==0 {
        let instruction:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if instruction.kind==32 {
            code=encode_instruction(source,tree,id,features,cpl,scratch);
            if code==0 {
                let length:u64=scratch[0];
                if total+length>255||total+length+1>len(out){code=800;}
                else {let mut i:u64=0;while i<length{temporary[1+total+i]=scratch[1+i];i=i+1;}total=total+length;}
            }
        }
        id=id+1;
    }
    if code==0 {
        out[0]=u8(total);let mut i:u64=0;while i<total{out[1+i]=temporary[1+i];i=i+1;}
    }
    rt_free(runtime(),scratch);rt_free(runtime(),temporary);return code;
}
