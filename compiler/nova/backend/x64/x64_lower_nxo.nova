            let a0:u64=reloc_specs[(j-1)*3];let a1:u64=reloc_specs[(j-1)*3+1];let a2:u64=reloc_specs[(j-1)*3+2];
            reloc_specs[(j-1)*3]=reloc_specs[j*3];
