    // section scan and BEFORE any layout buffer is allocated, so a refused
    // source costs no allocation and writes no bytes and the transaction this
    // module already promises holds. Same placement as the flag guard above and
    // for the same reason: it must not depend on anything the emission path
    // below decides.
    let foldcode:u64=call_fold(source,tree);
