fn same_span(source:buf<u8>,a:ntasm_ast.Node,b:ntasm_ast.Node)->bool {
    if a.start>a.end||b.start>b.end||a.end>len(source)||b.end>len(source)||
       a.end-a.start!=b.end-b.start{return false;}
    let mut i:u64=0;while i<a.end-a.start{
        if source[a.start+i]!=source[b.start+i]{return false;}i=i+1;
    }
    return true;
}
// The declared return width of a function or import declaration, 0 when the
// declaration names no machine scalar. ONE reader, shared by the guard that
// admits a declaration and the printer that describes it, so the two cannot
// disagree: a guard that admitted u32 while the printer said u64 is an object
// that states the wrong return width, and no gate count moves.
fn declared_return_width(source:buf<u8>,tree:ntasm_ast.Tree,decl:ntasm_ast.Node,imported:bool)->u64 {
    let mut child:u64=decl.first_child;if child==0||child>tree.node_count{return 0;}
    let first:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
    if imported {
        if first.kind!=91||first.next_sibling==0{return 0;}
        child=first.next_sibling;
    }
    if child==0||child>tree.node_count{return 0;}
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
    if name.kind!=90||name.next_sibling==0{return 0;}
    let result:ntasm_ast.Node=ntasm_ast.node_at(tree,name.next_sibling);
    if result.kind!=36{return 0;}
    return scalar_type(tree,source,name.next_sibling);
}
// The declared return width of a FRAMED function declaration, 0 when the
// declaration names no machine scalar. This is NOT declared_return_width and
// the difference is measured, not stylistic: declared_return_width reads
// name.next_sibling as the result node, which is correct only for a
// ZERO-PARAMETER declaration because the shared empty_u64_signature guard
// admits nothing else. A framed declaration carries up to fifteen parameters
// (node kind 19) between the name and the result, so on this shape
// name.next_sibling is the first parameter, scalar_type refuses it, and the
// reader answers 0 for EVERY framed function including the u64 ones. Substituted
// here as a drop-in it turned all 3449 checks of the gate red, which is how
// the difference was found rather than assumed.
//
// ONE reader, shared by the guard that admits a framed declaration and the
// printer that builds its contract in build_framed_functions, so the two
// cannot disagree. Both call this on the same declaration node and it is a
// pure function of the source and the tree, so any future divergence between
// the guard and the contract is a defect in this function and not in a pair
// of readers that were allowed to drift apart.
fn framed_return_width(source:buf<u8>,tree:ntasm_ast.Tree,decl:ntasm_ast.Node)->u64 {
    let child:u64=decl.first_child;
    if child==0||child>tree.node_count{return 0;}
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
    if name.kind!=90{return 0;}
    let mut c:u64=name.next_sibling;
    while c!=0&&c<=tree.node_count {
        let node:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if node.kind!=19{break;}
        c=node.next_sibling;
    }
    if c==0||c>tree.node_count{return 0;}
    return scalar_type(tree,source,c);
