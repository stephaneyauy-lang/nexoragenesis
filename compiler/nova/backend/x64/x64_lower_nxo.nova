module x64_lower_nxo;import ntasm_ast;import x64_lower_control;import x64_lower_fixed;import x64_fixed;import ntasm_nxo;import register_widths;import ntasm_macro_splice;import constant_eval;
fn failed(code:u64)->ntasm_nxo.WriteResult{let empty:buf<u8>=alloc(runtime(),0);return ntasm_nxo.WriteResult{code:code,bytes:empty};}

// ---------------------------------------------------------------------------
// Canonical contract text.
//
// compiler/c/ntasm/formats/object_build.c contract_text is the authority for the
// bytes. nxo.nova packs the name and the contract into one string table with
// no separator and requires co == no + nl, a non empty contract of at most
// 65536 bytes and every string byte in 1..127. The canonical text is ASCII
// printable throughout, so it is admissible, and the longest text this module
// can build is about 380 bytes, far inside the 65536 bound.
//
// One contract lives in a fixed slot of a scratch table and is NUL terminated,
// so its length is the offset of that terminator. The terminator is scratch
// only: emit_canonical copies each text by length, so the zero byte, which the
// NXO string table forbids, never reaches the object.
fn contract_stride()->u64 { return 512; }
fn contract_slots()->u64 { return 66; }

// Appends text at at, refusing a byte outside 1..127 and an overrun. The return
// is the new cursor, or 0 on a refusal, which no legitimate cursor can be: the
// first literal of every contract is at least ten bytes long.
fn put_text(out:buf<u8>,cap:u64,at:u64,text:buf<u8>)->u64 {
    let n:u64=len(text);
    if at+n>cap { return 0; }
    let mut i:u64=0;
    while i<n { if text[i]==0 || text[i]>=128 { return 0; } out[at+i]=text[i]; i=i+1; }
    return at+n;
}
// Unsigned decimal, most significant digit first, no leading zero.
fn put_decimal(out:buf<u8>,cap:u64,at:u64,value:u64)->u64 {
    if value==0 { if at+1>cap { return 0; } out[at]=48; return at+1; }
    let mut digits:u64=0;let mut rest:u64=value;
    while rest!=0 { rest=rest/10; digits=digits+1; }
    if at+digits>cap { return 0; }
    let mut i:u64=digits;rest=value;
    while rest!=0 { i=i-1; out[at+i]=u8(48+(rest%10)); rest=rest/10; }
    return at+digits;
}
// Sixteen lowercase hexadecimal digits, most significant first, exactly the
// "%016" PRIx64 of object_build.c. The nibbles come from a division by a
// literal rather than a shift by a computed amount, which is the form the
// bootstrap code generator evaluates correctly here.
fn put_hex16(out:buf<u8>,cap:u64,at:u64,value:u64)->u64 {
    if at+16>cap { return 0; }
    let alphabet:buf<u8>="0123456789abcdef";
    let mut rest:u64=value;
    let mut i:u64=16;
    while i>0 { i=i-1; out[at+i]=alphabet[rest%16]; rest=rest/16; }
    return at+16;
}
// The parameter register family, which the reference prints with %d. The
// frontend leaves v->reg.family at -1 for a parameter with no explicit binding
// and stores the physical family otherwise, so the unbound shape is @-1/0/0.
fn put_family(out:buf<u8>,cap:u64,at:u64,family:u64)->u64 {
    if family==18446744073709551615 {
        if at+2>cap { return 0; }
        out[at]=45;out[at+1]=49;return at+2;
    }
    return put_decimal(out,cap,at,family);
}
fn target_text(target:u64)->buf<u8> {
    if target==1 { return "x86_64-nexora-uefi"; }
    if target==2 { return "x86_64-nexora-none"; }
    return "";
}
// The type name the reference prints for a scalar width, which is the
// nt_frontend_type_name of the kind scalar_type accepted. Every accepted
// declaration of this module spells one of these five, so an empty answer is a
// refusal at the call site and never a printed name.
fn width_name(bits:u64)->buf<u8> {
    if bits==1 { return "bool"; }
    if bits==8 { return "u8"; }
    if bits==16 { return "u16"; }
    if bits==32 { return "u32"; }
    if bits==64 { return "u64"; }
    return "";
}
// The effect flag bit of frontend.c NTF_F_*, in enum order. A Nova buffer
// argument must name a buffer, so every catalogue entry is bound to a local
// before it reaches word.
fn effect_flag(source:buf<u8>,name:ntasm_ast.Node)->u64 {
    let privileged:buf<u8>="privileged";
    if word(source,name,privileged){return 1;}
    let changes:buf<u8>="changes_flags";
    if word(source,name,changes){return 2;}
    let mmio:buf<u8>="mmio";
    if word(source,name,mmio){return 4;}
    let io_port:buf<u8>="io_port";
    if word(source,name,io_port){return 8;}
    let msr:buf<u8>="msr";
    if word(source,name,msr){return 16;}
    let control:buf<u8>="control";
    if word(source,name,control){return 32;}
    let interrupt:buf<u8>="interrupt_state";
    if word(source,name,interrupt){return 64;}
    let no_return:buf<u8>="no_return";
    if word(source,name,no_return){return 128;}
    let ordering:buf<u8>="memory_ordering";
    if word(source,name,ordering){return 256;}
    let clock:buf<u8>="reads_clock";
    if word(source,name,clock){return 512;}
    let suspends:buf<u8>="suspends";
    if word(source,name,suspends){return 1024;}
    return 0;
}
// 1u << NTF_SPACE of a memory effect argument, so user 2, kernel 4,
// physical 8, mmio 16, device 32 and firmware 64.
fn space_bit(source:buf<u8>,name:ntasm_ast.Node)->u64 {
    let user:buf<u8>="user";
    if word(source,name,user){return 2;}
    let kernel:buf<u8>="kernel";
    if word(source,name,kernel){return 4;}
    let physical:buf<u8>="physical";
    if word(source,name,physical){return 8;}
    let mmio:buf<u8>="mmio";
    if word(source,name,mmio){return 16;}
    let device:buf<u8>="device";
    if word(source,name,device){return 32;}
    let firmware:buf<u8>="firmware";
    if word(source,name,firmware){return 64;}
    return 0;
}
// The effects triple of frontend.c parse_effects, written to out[0..3]. A
// memory effect with no parenthesised space is the all space mask 126 of the
// reference. 800 on a name outside the catalogue, on a malformed qualified
// entry and on a memory effect whose space the catalogue does not own.
fn effect_numbers(source:buf<u8>,tree:ntasm_ast.Tree,set_id:u64,out:buf<u64>)->u64 {
    out[0]=0;out[1]=0;out[2]=0;
    if set_id==0 || set_id>tree.node_count { return 800; }
    let set:ntasm_ast.Node=ntasm_ast.node_at(tree,set_id);
    if set.kind!=20 { return 800; }
    let mut child:u64=set.first_child;
    while child!=0 {
        if child>tree.node_count { return 800; }
        let q:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
        if q.kind!=91 || q.first_child==0 || q.first_child!=q.last_child ||
           q.first_child>tree.node_count { return 800; }
        let name:ntasm_ast.Node=ntasm_ast.node_at(tree,q.first_child);
        if name.kind!=90 || name.start>name.end || name.end>len(source) { return 800; }
        let mut next:u64=q.next_sibling;
        let flag:u64=effect_flag(source,name);
        if flag!=0 { out[0]=out[0]|flag; }
        else {
            let mut memory:u64=0;
            let reads:buf<u8>="reads_mem";
            let writes:buf<u8>="writes_mem";
            if word(source,name,reads){memory=1;}
            else if word(source,name,writes){memory=2;}
            else { return 800; }
            // The parenthesised space of a memory effect and the next entry of
            // the set are both a qualified name in the tree, so the reference's
            // syntactic parenthesis is recovered by asking whether the sibling
            // is one of the six spaces the catalogue owns. A sibling that is not
            // one is the next entry, exactly as the reference reads it after a
            // comma, and a space spelled on its own is refused by the name
            // check at the top of the next turn.
            let mut bit:u64=0;
            if next!=0 {
                if next>tree.node_count { return 800; }
                let a:ntasm_ast.Node=ntasm_ast.node_at(tree,next);
                if a.kind!=91 || a.first_child==0 || a.first_child!=a.last_child ||
                   a.first_child>tree.node_count { return 800; }
                let space_name:ntasm_ast.Node=ntasm_ast.node_at(tree,a.first_child);
                if space_name.kind!=90 || space_name.start>space_name.end ||
                   space_name.end>len(source) { return 800; }
                bit=space_bit(source,space_name);
                if bit!=0 { next=ntasm_ast.node_at(tree,next).next_sibling; }
            }
            if bit==0 {
                if memory==1 { out[1]=out[1]|126; } else { out[2]=out[2]|126; }
            } else {
                if memory==1 { out[1]=out[1]|bit; } else { out[2]=out[2]|bit; }
            }
        }
        child=next;
    }
    return 0;
}
// The clobber bitmask of a set node. frontend.c parse_clobbers sets bit
// reg.family and register_widths.family numbers the same catalogue from one,
// so the mask is bit family-1, which is what clobber_mask already builds.
// Writes the mask to out[at]; 800 on a malformed set and on a name the x86_64
// catalogue does not own, rflags among them.
fn source_clobbers(source:buf<u8>,tree:ntasm_ast.Tree,set_id:u64,out:buf<u64>,at:u64)->u64 {
    if at>=len(out) { return 800; }
    out[at]=0;
    if set_id==0 || set_id>tree.node_count { return 800; }
    let set:ntasm_ast.Node=ntasm_ast.node_at(tree,set_id);
    if set.kind!=21 { return 800; }
    let mut mask:u64=0;let mut c:u64=set.first_child;
    while c!=0 {
        if c>tree.node_count { return 800; }
        let q:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if q.kind!=91 || q.first_child==0 || q.first_child!=q.last_child { return 800; }
        if q.first_child>tree.node_count { return 800; }
        let name:ntasm_ast.Node=ntasm_ast.node_at(tree,q.first_child);
        if name.kind!=90 || name.start>name.end || name.end>len(source) { return 800; }
        let family:u64=register_widths.family(source,name.start,name.end);
        if family==0 { return 800; }
        mask=mask|(1<<(family-1));c=q.next_sibling;
    }
    out[at]=mask;return 0;
}

// ---------------------------------------------------------------------------
// W31FlagInference, the helpers. Appending here, immediately after
// source_clobbers, which is the last reader of the declaration clause nodes
// this section also walks.
// ---------------------------------------------------------------------------

fn word_same(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool {
    if start>end||end>len(source){return false;}
    if (end-start)!=len(text){return false;}
    let mut i:u64=0;while i<len(text){if source[start+i]!=text[i]{return false;}i=i+1;}
    return true;
}

// The count of the table below, as a function because this language has no
// module-level constant.
fn flag_mnemonic_count()->u64 { return 29; }

// Does this MNEMONIC write a flag? This is the x86_64 catalogue the reference
// reads through nt_x64_effects, restricted to the forms whose only flags
// obligation is the pair above. A conditional BRANCH is NOT in the set and must
// not be added: jcc READS the flags, which is a different obligation, and the
// reference answers 503 "instruction reads flags not defined on every incoming
// path" for a bare jcc, never 501 or 502. Measured, on all four declaration
// legs of a body that is `L1: jne L1; return 1`: 503 every time.
fn mnemonic_writes_flag(source:buf<u8>,name:ntasm_ast.Node)->bool {
    let mut i:u64=0;
    while i<flag_mnemonic_count() {
        let text:buf<u8>=flag_mnemonic(i);
        if word_same(source,name.start,name.end,text){return true;}
        i=i+1;
    }
    return false;
}

// 29 mnemonics, spelled as byte literals because register_widths.clobber_bit
// shows the convention and a string table this module does not otherwise own
// would be a second source of truth for one catalogue.
//
// The set is NOT copied from body_intrinsics.nova, and that is deliberate.
// body_intrinsics answers a different question -- it asks which mnemonic
// DEMANDS the changes_flags atom from a declaration, and it demands it on
// `cmp` and `test` as well. The reference asks which mnemonic INFERS the
// obligation, and it asks nt_x64_effects. The two sets coincide on this tree
// and must be allowed to diverge, so this table carries the oracle's answer and
// names body_intrinsics as the consumer of the other question rather than
// deriving from it.
fn flag_mnemonic(index:u64)->buf<u8> {
    if index==0 { return "add"; }
    if index==1 { return "adc"; }
    if index==2 { return "sub"; }
    if index==3 { return "sbb"; }
    if index==4 { return "and"; }
    if index==5 { return "or"; }
    if index==6 { return "xor"; }
    if index==7 { return "cmp"; }
    if index==8 { return "test"; }
    if index==9 { return "inc"; }
    if index==10 { return "dec"; }
    if index==11 { return "neg"; }
    if index==12 { return "shl"; }
    if index==13 { return "shr"; }
    if index==14 { return "sar"; }
    if index==15 { return "rol"; }
    if index==16 { return "ror"; }
    if index==17 { return "shld"; }
    if index==18 { return "shrd"; }
    if index==19 { return "imul"; }
    if index==20 { return "mul"; }
    if index==21 { return "div"; }
    if index==22 { return "idiv"; }
    if index==23 { return "bt"; }
    if index==24 { return "bts"; }
    if index==25 { return "btr"; }
    if index==26 { return "btc"; }
    if index==27 { return "bsf"; }
    if index==28 { return "bsr"; }
    return "";
}

// The declaration clauses of one function, as they are spelled in the source.
// `has_changes_flags` is read from the effects set's node children by NAME and
// not by bit, for the reason effects.nova states: the atom bitset this product
// carries is its own numbering and frontend.c's NTF_F_CHANGES_FLAGS is the
// oracle's, so a clobber_bit-shaped lookup here would couple two tables that
// are allowed to differ.
fn function_declares_atom(source:buf<u8>,tree:ntasm_ast.Tree,fn_id:u64,kind:u64,text:buf<u8>)->bool {
    let f:ntasm_ast.Node=ntasm_ast.node_at(tree,fn_id);
    let mut c:u64=f.first_child;
    while c!=0 {
        if c>tree.node_count{return false;}
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if n.kind==kind {
            let mut item:u64=n.first_child;
            while item!=0 {
                if item>tree.node_count{return false;}
                let it:ntasm_ast.Node=ntasm_ast.node_at(tree,item);
                // kind 20 is an effects entry, kind 91 a clobber name. Both
                // carry their spelling in a single name child; neither nests.
                let mut name:u64=it.first_child;
                while name!=0 {
                    if name>tree.node_count{return false;}
                    let nm:ntasm_ast.Node=ntasm_ast.node_at(tree,name);
                    if word_same(source,nm.start,nm.end,text){return true;}
                    name=nm.next_sibling;
                }
                item=it.next_sibling;
            }
        }
        c=n.next_sibling;
    }
    return false;
}

// THE WHOLE RULE, once, for one unit. Returns 0 when every function in `tree`
// that writes a flag declares both clauses, and a non-zero refusal otherwise.
fn flags_inference(source:buf<u8>,tree:ntasm_ast.Tree)->u64 {
    let mut id:u64=1;
    while id<=tree.node_count {
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if n.kind==18 {
            // THE BODY IS A KIND 25 BLOCK, and the specification's own text
            // walked the statements directly under the function node, which
            // reaches none of them. Measured on the parse of the harness's own
            // `add rax, 1; return 1` text: the function node (kind 18) has the
            // name, the result type, the effects set, the clobber set and THEN
            // the body block as its children, and the two statements are
            // children of that block, so a walk of the function's own children
            // sees five declaration nodes and no instruction at all. The
            // module's own empty_u64_signature reads the same shape: the body
            // is `clobbers.next_sibling` and its kind is 25.
            //
            // A body statement is an instruction node (kind 32, aux 0) or one
            // of the two statement kinds that carry no mnemonic (29 and 94),
            // and neither of those two writes a flag on its own.
            let mut body_id:u64=0;
            let mut c:u64=n.first_child;
            while c!=0&&body_id==0 {
                if c>tree.node_count{return 800;}
                let cn:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
                if cn.kind==25{body_id=c;}
                c=cn.next_sibling;
            }
            if body_id==0 { id=id+1; continue; }
            let mut s:u64=ntasm_ast.node_at(tree,body_id).first_child;
            while s!=0 {
                if s>tree.node_count{return 800;}
                let sn:ntasm_ast.Node=ntasm_ast.node_at(tree,s);
                if sn.kind==32&&sn.aux==0 {
                    let name_id:u64=sn.first_child;
                    if name_id==0||name_id>tree.node_count{return 800;}
                    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);
                    if mnemonic_writes_flag(source,name) {
                        let changes_flags:buf<u8>="changes_flags";
                        let rflags:buf<u8>="rflags";
                        let ok_flags:bool=function_declares_atom(source,tree,id,20,changes_flags);
                        let ok_rflags:bool=function_declares_atom(source,tree,id,21,rflags);
                        // 501 BEFORE 502, and the order is the reference's own:
                        // it evaluates the effect obligation first, so a body
                        // missing both answers 501 and never reaches the
                        // clobber line. Publishing them in one code would lose
                        // which obligation fired first, which is the only thing
                        // that tells a repair which of the two it fixed.
                        if ok_flags==false{return 501;}
                        if ok_rflags==false{return 502;}
                    }
                }
                s=sn.next_sibling;
            }
        }
        id=id+1;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// W35CallFold, the helpers. The rule is THIRD and it is the one the landed
// flag patch named and did not own: frontend.c folds a callee's declared
// clobbers AND the callee's output registers into the caller's
// inferred_clobbers, and then refuses
//
//     f->inferred_clobbers & ~(f->clobbers | output_registers)   -> 502
//     compiler/c/ntasm/frontend/frontend.c:5856-5857, PER FUNCTION
//
// Two corpus members answer 502 for this reason and for no other, measured
// by running the reference and not read from a report:
//
//     0032_nova_tests_ntasm_calls        502  function 'main' omits an inferred clobber
//     0069_nova_tests_ntasm_diagnostics  502  function 'main' omits an inferred clobber
//
// and NEITHER body contains a flag-writing mnemonic, so the flag channel
// cannot see them. That is what a narrowing on the flag channel removed zero
// green cases over.
//
// THE TWO OBLIGATIONS ARE SEPARATE FOLDS AND BOTH ARE HERE. frontend.c:1647
// and :1650 are two statements:
//
//     caller->inferred_clobbers |= target->clobbers;
//     uint64_t outputs = nt_conformance_output_registers(p, callee);
//     caller->inferred_clobbers |= outputs;
//
// 0069 is the first fold (leaf declares rax, main declares nothing) and 0032
// is the second (helper returns through rcx, main declares nothing). A rule
// that implemented one fold answers ACCEPT on one of the two members, so both
// are implemented and each has its own negative control.
//
// THE EXEMPTION IS PART OF THIS SAME RULE, not a separate one. The reference's
// `| output_registers` is nt_conformance_output_registers over the CALLER, so
// a bit the function RETURNS in is excused from its own inferred set. The
// landed flag patch recorded this as a gap it could not close, because the
// only obligation it reaches writes RFLAGS and no return convention delivers
// RFLAGS in, so the exemption cannot change an answer on THAT rule. It does
// change an answer on this one, and it is measured changing one: on the same
// call with the same bit, a caller that declares the bit in `clobbers` and a
// caller that RETURNS it through an out parameter are ACCEPT and 502
// respectively. L5/L6 in the scratch census are those two texts.
//
// WHY THE OUTPUT MASK IS BUILT HERE AND NOT TAKED FROM abi.nova. abi owns
// parameter_rules, and its out[1] is exactly this mask, but importing abi into
// this module is not available to it: the gate that compiles
// x64_lower_nxo_pe.nova does not list abi.nova among its inputs, and this
// module is on that route's load list (tests_ntasm_x64_lower_nxo_pe.c reads
// both module texts and pins which modules exist). So the mask is computed
// from the parameter nodes with the same two rules abi applies -- direction
// read as the FIRST whitespace-delimited WHOLE word of the parameter span, and
// family read through register_widths.family -- and the arithmetic is the same
// 1<<(family-1) that source_clobbers above already builds for the declared
// clobber set, so the two masks are in ONE numbering and the comparison
// between them is meaningful.
//
// IT IS NOT COUPLED TO THE REFERENCE'S NUMBERING. That discipline is the one
// effects.nova states and the landed flag patch repeated: this product's atom
// bitset is its own numbering and frontend.c's family table is the oracle's,
// so a lookup that joined the two through one table would be a coupling of two
// tables that are allowed to differ. Every family below is read through
// register_widths.family, which is this tree's own catalogue, and the reference
// contributes only the SHAPE of the fold (which callee bits go where) and not
// any number.
// ---------------------------------------------------------------------------

// The Nth child of a node, zero when there is none. call_clobbers.nova holds
// the same helper; it is private there and this module does not import it.
fn fold_child(tree:ntasm_ast.Tree,parent:u64,ordinal:u64)->u64 {
    if parent==0 || parent>tree.node_count { return 0; }
    let p:ntasm_ast.Node=ntasm_ast.node_at(tree,parent);
    let mut id:u64=p.first_child;let mut index:u64=0;
    while id!=0 && index<ordinal {
        if id>tree.node_count { return 0; }
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        id=n.next_sibling;index=index+1;
    }
    if id>tree.node_count { return 0; }
    return id;
}

// Whole-word equality of two spans, byte for byte. Two calls to different
// functions with the same spelling are the same callee, which is what the
// reference's find_function resolves as well.
fn fold_same_name(source:buf<u8>,a_start:u64,a_end:u64,
                  b_start:u64,b_end:u64)->bool {
    if a_start>a_end || b_start>b_end { return false; }
    if a_end>len(source) || b_end>len(source) { return false; }
    if (a_end-a_start)!=(b_end-b_start) { return false; }
    let mut i:u64=0;
    while i<(a_end-a_start) { if source[a_start+i]!=source[b_start+i] { return false; } i=i+1; }
    return true;
}

// The clobber set node of one declaration, zero when it declares none. Two
// clobber sets on one declaration is a malformed declaration and answers zero
// rather than the first, so a caller cannot be measured against half of a
// declaration it does not have.
fn fold_clobber_set(tree:ntasm_ast.Tree,id:u64)->u64 {
    let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
    let mut c:u64=declaration.first_child;let mut found:u64=0;
    while c!=0 {
        if c>tree.node_count { return 0; }
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if n.kind==21 { if found!=0 { return 0; } found=c; }
        c=n.next_sibling;
    }
    return found;
}

// The body block of one declaration. Measured on the parse of the two corpus
// members with the scratch AST dumper: a kind 18 function node's children are
// the name, the parameter nodes, the result type, the effects set, the clobber
// set and THEN the body block, whose kind is 25, and the statements -- the
// call, which is kind 28 -- are children of that block and not of the function
// node. This is the same correction the landed flag patch made and for the same
// reason: a walk of the function's own children sees declaration nodes and no
// instruction at all.
fn fold_body(tree:ntasm_ast.Tree,id:u64)->u64 {
    let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
    let mut c:u64=declaration.first_child;
    while c!=0 {
        if c>tree.node_count { return 0; }
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if n.kind==25 { return c; }
        c=n.next_sibling;
    }
    return 0;
}

// Is this statement a call? Kind 28 is the statement form `call f(...)` and
// kind 35 with aux 1 is the same call used where an expression is expected.
// Both carry the callee as their first child and body_clobbers.nova and
// call_clobbers.nova both answer true for exactly these two.
fn fold_is_call(n:ntasm_ast.Node)->bool {
    if n.kind==28 { return true; }
    if n.kind==35 && n.aux==1 { return true; }
    return false;
}

// The name node of a call: the qualified-name wrapper's LAST child, which is
// the bare callee name. The reference resolves the callee by that name.
fn fold_call_name(tree:ntasm_ast.Tree,id:u64)->u64 {
    let qid:u64=fold_child(tree,id,0);
    if qid==0 { return 0; }
    let q:ntasm_ast.Node=ntasm_ast.node_at(tree,qid);
    if q.kind!=91 { return 0; }
    if q.last_child==0 || q.last_child>tree.node_count { return 0; }
    return q.last_child;
}

// THE DIRECTION OF ONE PARAMETER NODE IS READ BY param_direction, this
// module's own existing reader of the same rule.
//
// This section once carried a SECOND implementation, fold_direction, written
// out here because this module cannot import abi -- true, and load-bearing:
// build_function_bodies injects no abi table, so this module carries its own.
// But that reason is about abi.nova and not about this file, and param_direction
// already answers the same question. The two were compared mechanically:
//
//   both skip the whitespace set {32,9,10,13} at the front of the parameter
//   span, both scan to the next member of that set, both then read the FIRST
//   whole word and match it WHOLE. Neither reads a prefix, so neither accepts
//   `outbound` for `out` or `inx` for `in`.
//
// Two differences, and both are safe for the one call site below:
//
//   param_direction also answers 1 for `in`, which fold_direction never did.
//   That call site tests `dir==2 || dir==3` and nothing else, so the extra
//   answer is never read.
//
//   fold_direction compared the word with word_same; param_direction compares
//   bytes behind its own length test. word_same opens with
//   (end-start)!=len(text), so both are length-guarded before the first byte is
//   compared and both reject a longer word.
//
// Same rule, one implementation now. The duplication was not carelessness --
// the import really is blocked -- but it was still a copy, and it was a copy of
// the rule that decides what counts as an output register, which is the rule
// the fold's exemption is built on.

// THE OUTPUT REGISTER MASK OF ONE DECLARATION, which is
// nt_conformance_output_registers: bit family-1 for every parameter whose
// direction is out or inout and that carries an explicit register binding.
// The reference also requires 0<=family<16 here; this product's families are
// 1..16 for the general purpose registers and 17 for rflags, so a family of 17
// is excluded here by the same test, and a family above 17 cannot be spelled.
// Every bit is in the SAME numbering source_clobbers builds, which is what
// makes the `| output_registers` of the reference's condition expressible.
fn fold_output_mask(source:buf<u8>,tree:ntasm_ast.Tree,id:u64)->u64 {
    let declaration:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
    let mut mask:u64=0;
    let mut c:u64=declaration.first_child;
    while c!=0 {
        if c>tree.node_count { return 0; }
        let parameter:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if parameter.kind==19 {
            let dir:u64=param_direction(source,parameter);
            if dir==2 || dir==3 {
                let reg_id:u64=fold_child(tree,c,2);
                if reg_id!=0 && reg_id<=tree.node_count {
                    let reg:ntasm_ast.Node=ntasm_ast.node_at(tree,reg_id);
                    // The SAME clobber_bit numbering the declared sets are read
                    // in, so the `|` of the reference's condition joins two
                    // masks that were built by one function. A parameter cannot
                    // bind rflags -- the ABI refuses an out or inout parameter
                    // on rax, rsp or rbp and rflags is not a parameter register
                    // at all -- so this answers for every spelling a parameter
                    // can carry, and a zero simply contributes nothing.
                    let bit:u64=register_widths.clobber_bit(source,reg.start,reg.end);
                    mask=mask|bit;
                }
            }
        }
        c=parameter.next_sibling;
    }
    return mask;
}

// THE DECLARED CLOBBER MASK OF ONE SET, in the numbering this rule compares in.
//
// It is source_clobbers above with ONE difference and the difference is the
// whole reason this function exists rather than a call to source_clobbers:
// source_clobbers builds 1<<(family-1) and answers 800 on a name
// register_widths.family does not number, and rflags is exactly such a name --
// its own comment says so ("rflags among them"). Using source_clobbers here
// would refuse EVERY source whose callee declares rflags, including the ones
// where the caller declares rflags too and the reference accepts them. That
// is not a narrower rule, it is a wrong one, and it was caught by running the
// rule against the reference rather than by reading it.
//
// register_widths.clobber_bit is the numbering this tree already uses for
// exactly this question: it answers 1<<(family-1) for the sixteen general
// purpose registers and the rflags bit for rflags, and it is what
// clobbers.summarize feeds the call_clobbers pass. Reading BOTH sides of the
// reference's condition through it -- the caller's declared set AND the
// callee's declared set -- is what makes the comparison meaningful, and it is
// what keeps this rule off the oracle's family table: the oracle's family
// numbering is the tree's existing declared coupling inside clobber_bit and
// is not re-derived here.
fn fold_declared_mask(source:buf<u8>,tree:ntasm_ast.Tree,set_id:u64,
                      out:buf<u64>,at:u64)->u64 {
    if at>=len(out) { return 800; }
    out[at]=0;
    if set_id==0 || set_id>tree.node_count { return 800; }
    let set:ntasm_ast.Node=ntasm_ast.node_at(tree,set_id);
    if set.kind!=21 { return 800; }
    let mut mask:u64=0;
    let mut c:u64=set.first_child;
    while c!=0 {
        if c>tree.node_count { return 800; }
        let q:ntasm_ast.Node=ntasm_ast.node_at(tree,c);
        if q.kind!=91 || q.first_child==0 || q.first_child!=q.last_child
           || q.first_child>tree.node_count { return 800; }
        let name:ntasm_ast.Node=ntasm_ast.node_at(tree,q.first_child);
        if name.kind!=90 || name.start>name.end || name.end>len(source) { return 800; }
        let bit:u64=register_widths.clobber_bit(source,name.start,name.end);
        if bit==0 { return 800; }
        mask=mask|bit;
        c=q.next_sibling;
    }
    out[at]=mask;return 0;
}

// THE WHOLE RULE, once, for one unit, and PER FUNCTION.
//
// For every function in `tree` this walks that function's own body block,
// finds every call, resolves the callee by name among the unit's declarations,
// and accumulates BOTH folds -- the callee's declared clobber set and the
// callee's output register mask -- into the caller's inferred set. It then
// evaluates the reference's condition with the EXEMPTION in it:
//
//     inferred & ~(declared | output_registers)          -> refuse
//
// Returns 0 when every function in the unit pays, and a non-zero refusal
// otherwise.
//
// SCOPE IS THE UNIT, AND THAT IS WHY EVERY FUNCTION IS WALKED. The reference's
// loop at frontend.c:5817 iterates p->functions and returns 0 for the WHOLE
// program on the first function that fails; its diag() names that function's
// f->name. So one under-declared function refuses every function beside it, and
// a rule that examined only the exported entry would pass exactly the case the
// reference refuses. Measured: the corpus member whose under-declared caller is
// NOT the exported entry still answers 502, naming the side function.
//
// AN IMPORTED CALLEE (kind 9) IS NOT FOLDED HERE. The reference resolves an
// imported callee's clobbers from its declaration too, and an import does
// carry a clobber set, but the two cores that call this rule are the frameless
// and the framed producer, whose units this ticket does not change the
// resolution of; an unresolved or imported callee contributes nothing here
// rather than a guess, which is the direction that cannot invent a refusal.
export fn call_fold(source:buf<u8>,tree:ntasm_ast.Tree)->u64 {
    let scratch:buf<u64>=alloc(runtime(),1);
    let mut code:u64=0;
    let mut id:u64=1;
    while id<=tree.node_count && code==0 {
        let caller:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if caller.kind==18 {
            let caller_name_id:u64=fold_child(tree,id,0);
            if caller_name_id==0 || caller_name_id>tree.node_count { code=800; }
            else {
                let caller_name:ntasm_ast.Node=ntasm_ast.node_at(tree,caller_name_id);
                let caller_set:u64=fold_clobber_set(tree,id);
                if caller_set==0 { code=800; }
                else {
                    // THE CALLEE'S TWO FOLDS, accumulated over every call of
                    // this caller. Declared first, then output registers: the
                    // order is irrelevant to the OR and is kept only because it
                    // reads in the reference's order.
                    let mut inferred:u64=0;
                    let body_id:u64=fold_body(tree,id);
                    if body_id==0 { code=800; }
                    else {
                        let body:ntasm_ast.Node=ntasm_ast.node_at(tree,body_id);
                        let mut s:u64=body.first_child;
                        while s!=0 && code==0 {
                            if s>tree.node_count { code=800; }
                            else {
                                let statement:ntasm_ast.Node=ntasm_ast.node_at(tree,s);
                                if fold_is_call(statement) {
                                    let callee_name_id:u64=fold_call_name(tree,s);
                                    if callee_name_id==0 { code=800; }
                                    else {
                                        let callee_name:ntasm_ast.Node=
                                            ntasm_ast.node_at(tree,callee_name_id);
                                        // Resolve the callee among the unit's own
                                        // declarations. An unresolved callee
                                        // folds nothing, which is another rule's
                                        // refusal and not this one's.
                                        let mut callee_id:u64=0;
                                        let mut scan:u64=1;
                                        while scan<=tree.node_count && callee_id==0 {
                                            let candidate:ntasm_ast.Node=ntasm_ast.node_at(tree,scan);
                                            if candidate.kind==18 {
                                                let candidate_name_id:u64=fold_child(tree,scan,0);
                                                if candidate_name_id!=0 && candidate_name_id<=tree.node_count {
                                                    let candidate_name:ntasm_ast.Node=
                                                        ntasm_ast.node_at(tree,candidate_name_id);
                                                    if fold_same_name(source,candidate_name.start,
                                                                    candidate_name.end,
                                                                    callee_name.start,
                                                                    callee_name.end) {
                                                        callee_id=scan;
                                                    }
                                                }
                                            }
                                            scan=scan+1;
                                        }
                                        if callee_id!=0 {
                                            let callee_set:u64=fold_clobber_set(tree,callee_id);
                                            if callee_set==0 { code=800; }
                                            else {
                                                let c1:u64=fold_declared_mask(source,tree,callee_set,scratch,0);
                                                if c1!=0 { code=800; }
                                                else {
                                                    inferred=inferred|scratch[0];
                                                    inferred=inferred|
                                                        fold_output_mask(source,tree,callee_id);
                                                }
                                            }
                                        }
                                    }
                                }
                                s=statement.next_sibling;
                            }
                        }
                    }
                    if code==0 {
                        // THE CONDITION, with the exemption in it. The caller's
                        // OWN output registers are excused, so a bit it RETURNS
                        // in need not appear in its clobber set. The declared
                        // set and the output mask are in one numbering, which
                        // is the only reason this OR is expressible at all.
                        let declared:u64=fold_declared_mask(source,tree,caller_set,scratch,0);
                        if declared!=0 { code=800; }
                        else {
                            let allowed:u64=scratch[0]|fold_output_mask(source,tree,id);
                            if (inferred&~allowed)!=0 {
                                code=800;
                            }
                        }
                    }
                }
            }
        }
        id=id+1;
    }
    rt_free(runtime(),scratch);
    return code;
}
// One when the spelling is one of the four high byte registers the frontend
// catalogue owns, which it reports with high8 set, and zero otherwise.
fn high8_of(source:buf<u8>,start:u64,end:u64)->u64 {
    if end<start || end-start!=2 { return 0; }
    if start+2>len(source) { return 0; }
    if source[start+1]!=104 { return 0; }
    if source[start]==97 { return 1; }
    if source[start]==98 { return 1; }
    if source[start]==99 { return 1; }
    if source[start]==100 { return 1; }
    return 0;
}
// The length of the contract in slot index, zero when the slot is out of range,
// holds no terminator or is filled to the last byte. A zero answer is a refusal
// at the call site: the C reader also refuses a zero length contract.
fn contract_length(contracts:buf<u8>,index:u64)->u64 {
    let stride:u64=contract_stride();
    let base:u64=index*stride;
    if base+stride>len(contracts) { return 0; }
    let mut n:u64=0;
    while n<stride { if contracts[base+n]==0 { return n; } n=n+1; }
    return 0;
}
// The function contract of object_build.c, field by field and in its order:
// fn;target, abi, features, section, ret, params, effects, clobbers, requires,
// ensures. params is a flat five word per parameter list, direction, type
// width, family, bits and high8, and is not read at all when pcount is zero, so
// any buffer is acceptable there. Zero on a refusal: an index outside the
// scratch table, a type name outside the catalogue or a text that does not fit
// the slot.
fn fn_contract(contracts:buf<u8>,index:u64,target:buf<u8>,features:u64,ret:buf<u8>,
               params:buf<u64>,pcount:u64,flags:u64,reads:u64,writes:u64,
               clobbers:u64)->u64 {
    let stride:u64=contract_stride();
    let base:u64=index*stride;
    if base+stride>len(contracts) { return 0; }
    if len(target)==0 || len(ret)==0 { return 0; }
    let cap:u64=base+stride-1;
    let head:buf<u8>="fn;target=";
    let abi:buf<u8>=";abi=nx64-abi-v0;features=";
    let section:buf<u8>=";section=.text;ret=";
    let open:buf<u8>=";params=(";
    let comma:buf<u8>=",";
    let colon:buf<u8>=":";
    let at_sign:buf<u8>="@";
    let slash:buf<u8>="/";
    let effects:buf<u8>=");effects=";
    let clobber_text:buf<u8>=";clobbers=";
    let predicates:buf<u8>=";requires={};ensures={}";
    let mut at:u64=put_text(contracts,cap,base,head);
    if at==0 { return 0; }
    at=put_text(contracts,cap,at,target);if at==0 { return 0; }
    at=put_text(contracts,cap,at,abi);if at==0 { return 0; }
    at=put_decimal(contracts,cap,at,features);if at==0 { return 0; }
    at=put_text(contracts,cap,at,section);if at==0 { return 0; }
    at=put_text(contracts,cap,at,ret);if at==0 { return 0; }
    at=put_text(contracts,cap,at,open);if at==0 { return 0; }
    let mut j:u64=0;
    while j<pcount {
        if pcount*5>len(params) { return 0; }
        if j!=0 { at=put_text(contracts,cap,at,comma);if at==0 { return 0; } }
        let p:u64=j*5;
        let type_name:buf<u8>=width_name(params[p+1]);
        at=put_decimal(contracts,cap,at,params[p]);if at==0 { return 0; }
        at=put_text(contracts,cap,at,colon);if at==0 { return 0; }
        at=put_text(contracts,cap,at,type_name);if at==0 { return 0; }
        at=put_text(contracts,cap,at,at_sign);if at==0 { return 0; }
        at=put_family(contracts,cap,at,params[p+2]);if at==0 { return 0; }
        at=put_text(contracts,cap,at,slash);if at==0 { return 0; }
        at=put_decimal(contracts,cap,at,params[p+3]);if at==0 { return 0; }
        at=put_text(contracts,cap,at,slash);if at==0 { return 0; }
        at=put_decimal(contracts,cap,at,params[p+4]);if at==0 { return 0; }
        j=j+1;
    }
    at=put_text(contracts,cap,at,effects);if at==0 { return 0; }
    at=put_decimal(contracts,cap,at,flags);if at==0 { return 0; }
    at=put_text(contracts,cap,at,slash);if at==0 { return 0; }
    at=put_decimal(contracts,cap,at,reads);if at==0 { return 0; }
    at=put_text(contracts,cap,at,slash);if at==0 { return 0; }
    at=put_decimal(contracts,cap,at,writes);if at==0 { return 0; }
    at=put_text(contracts,cap,at,clobber_text);if at==0 { return 0; }
    at=put_hex16(contracts,cap,at,clobbers);if at==0 { return 0; }
    at=put_text(contracts,cap,at,predicates);if at==0 { return 0; }
    contracts[at]=0;return at-base;
}
// The data contract of object_build.c: data;type=<type name>;section=<number>,
// where the number is the NXO section id of the symbol itself.
fn data_contract(contracts:buf<u8>,index:u64,type_name:buf<u8>,section:u64)->u64 {
    let stride:u64=contract_stride();
    let base:u64=index*stride;
    if base+stride>len(contracts) { return 0; }
    if len(type_name)==0 { return 0; }
    let cap:u64=base+stride-1;
    let head:buf<u8>="data;type=";
    let section_text:buf<u8>=";section=";
    let mut at:u64=put_text(contracts,cap,base,head);
    if at==0 { return 0; }
    at=put_text(contracts,cap,at,type_name);if at==0 { return 0; }
    at=put_text(contracts,cap,at,section_text);if at==0 { return 0; }
    at=put_decimal(contracts,cap,at,section);if at==0 { return 0; }
    contracts[at]=0;return at-base;
}
// The contract of a declaration whose accepted shape is already a zero
// parameter u64 function with an empty effect and clobber set, which is every
// function of every producer below except the framed one. The record table is
// passed as the parameter list because pcount is zero and fn_contract does not
// read it.
fn simple_fn_contract(contracts:buf<u8>,index:u64,target:u64,features:u64,
                      records:buf<u64>,ret_width:u64)->u64 {
    let target_text_:buf<u8>=target_text(target);
    let ret:buf<u8>=width_name(ret_width);
    if len(ret)==0{return 0;}
    return fn_contract(contracts,index,target_text_,features,ret,records,0,0,0,0,0);
}
// The single function declaration of a source, zero when the source holds none
// or more than one, or holds an import this one symbol object cannot describe.
fn sole_declaration(tree:ntasm_ast.Tree)->u64 {
    let mut found:u64=0;let mut id:u64=1;
    while id<=tree.node_count {
        let n:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if n.kind==18 { if found!=0 { return 0; } found=id; }
        if n.kind==9 { return 0; }
        id=id+1;
    }
    return found;
}
// The contract of a function declaration read from the source: return type,
// parameter list, effects and clobbers. scratch holds four words, the effects
// triple then the clobber mask. Zero on anything outside the printed
// catalogue, which includes a parameter, an abi clause, a requires or an
// ensures clause and a return type this module does not lower.
fn declaration_contract(source:buf<u8>,tree:ntasm_ast.Tree,decl:u64,contracts:buf<u8>,
                        index:u64,target:u64,features:u64,scratch:buf<u64>)->u64 {
    if decl==0 || decl>tree.node_count { return 0; }
    if len(scratch)<4 { return 0; }
    let item:ntasm_ast.Node=ntasm_ast.node_at(tree,decl);
    if item.kind!=18 { return 0; }
    let name_id:u64=item.first_child;
    if name_id==0 || name_id>tree.node_count { return 0; }
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);
    if name.kind!=90 || name.next_sibling==0 { return 0; }
    let result_id:u64=name.next_sibling;
    let result:ntasm_ast.Node=ntasm_ast.node_at(tree,result_id);
    if result.kind!=36 || result.first_child==0 || result.first_child!=result.last_child ||
       result.first_child>tree.node_count || result.next_sibling==0 { return 0; }
    // scalar_type takes the type node, not the name inside it.
    let ret:u64=scalar_type(tree,source,result_id);
    if ret==0 { return 0; }
    let effects:u64=result.next_sibling;
    if effect_numbers(source,tree,effects,scratch)!=0 { return 0; }
    let clobber_set:u64=ntasm_ast.node_at(tree,effects).next_sibling;
    if clobber_set==0 || clobber_set>tree.node_count { return 0; }
    if source_clobbers(source,tree,clobber_set,scratch,3)!=0 { return 0; }
    // A parameter, an abi clause, a requires or an ensures clause would each add
    // a field this printer does not own, so the declaration is refused instead
    // of described by a contract that omits it.
    let after:u64=ntasm_ast.node_at(tree,clobber_set).next_sibling;
    if after!=0 {
        let part:ntasm_ast.Node=ntasm_ast.node_at(tree,after);
        if part.kind!=25 { return 0; }
        if part.next_sibling!=0 { return 0; }
    }
    let target_text_:buf<u8>=target_text(target);
    let ret_name:buf<u8>=width_name(ret);
    return fn_contract(contracts,index,target_text_,features,ret_name,
                       scratch,0,scratch[0],scratch[1],scratch[2],scratch[3]);
}
export fn build(source:buf<u8>,tree:ntasm_ast.Tree,features:u64,cpl:u64)->ntasm_nxo.WriteResult {
    if tree.node_count>1152921504606846975{return failed(800);}
    let decl:u64=sole_declaration(tree);
    if decl==0{return failed(800);}
    let code_bytes:buf<u8>=alloc(runtime(),tree.node_count*16);let length:buf<u64>=alloc(runtime(),1);
    let code:u64=x64_lower_control.lower_wide(source,tree,features,cpl,code_bytes,length);
    if code!=0{rt_free(runtime(),length);rt_free(runtime(),code_bytes);return failed(code);}
    let size:u64=length[0];let text:buf<u8>=alloc(runtime(),size);let mut i:u64=0;
    while i<size{text[i]=code_bytes[i];i=i+1;}rt_free(runtime(),length);rt_free(runtime(),code_bytes);
    let rdata:buf<u8>=alloc(runtime(),0);let data:buf<u8>=alloc(runtime(),0);
    let contracts:buf<u8>=alloc(runtime(),contract_stride());
    let scratch:buf<u64>=alloc(runtime(),4);
    // The object keeps the shape it always had, target 1, one symbol named
    // "main" at offset zero whose size is the whole lowered text, but the two
    // contract bytes "v0" are the exact bytes ntasm_nxo_merge compares, so they
    // are replaced by the canonical text of the single declaration the source
    // holds. A source whose declaration is not a zero parameter function the
    // printer owns is refused rather than described by a contract nobody read.
    let printed:u64=declaration_contract(source,tree,decl,contracts,0,1,features,scratch);
    rt_free(runtime(),scratch);
    let contract:u64=contract_length(contracts,0);
    if printed==0||contract==0{
        rt_free(runtime(),contracts);rt_free(runtime(),rdata);rt_free(runtime(),data);
        rt_free(runtime(),text);return failed(800);}
    let strings:buf<u8>=alloc(runtime(),4+contract);
    strings[0]=109;strings[1]=97;strings[2]=105;strings[3]=110;
    let mut j:u64=0;while j<contract{strings[4+j]=contracts[j];j=j+1;}
    let symbols:buf<u64>=alloc(runtime(),8);
    symbols[0]=0;symbols[1]=4;symbols[2]=1;symbols[3]=3;symbols[4]=0;symbols[5]=size;
    symbols[6]=4;symbols[7]=contract;
    rt_free(runtime(),contracts);
    let relocations:buf<u64>=alloc(runtime(),0);
    let object:ntasm_nxo.Object=ntasm_nxo.Object{target:1,entry:1,text:text,rdata:rdata,data:data,symbols:symbols,relocations:relocations,strings:strings};
    let result:ntasm_nxo.WriteResult=ntasm_nxo.emit(object);ntasm_nxo.release(object);return result;
}

fn word(source:buf<u8>,node:ntasm_ast.Node,text:buf<u8>)->bool {
    if node.start>node.end||node.end>len(source)||node.end-node.start!=len(text){return false;}
    let mut i:u64=0;while i<len(text){if source[node.start+i]!=text[i]{return false;}i=i+1;}return true;
}
fn section_of(source:buf<u8>,tree:ntasm_ast.Tree,item:ntasm_ast.Node)->u64 {
    let mut id:u64=1;
    while id<=tree.node_count {
        let section:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if section.kind==17&&section.start<=item.start&&item.end<=section.end {
            if section.first_child==0||section.first_child>tree.node_count{return 0;}
            let dotted:ntasm_ast.Node=ntasm_ast.node_at(tree,section.first_child);
            if dotted.kind!=93||dotted.first_child==0||dotted.first_child>tree.node_count{return 0;}
            let name:ntasm_ast.Node=ntasm_ast.node_at(tree,dotted.first_child);
            let text_:buf<u8>="text";if word(source,name,text_){return 1;}
            let ro:buf<u8>="rdata";if word(source,name,ro){return 2;}
            let data_:buf<u8>="data";if word(source,name,data_){return 3;}
            return 0;
        }
        id=id+1;
    }
    return 0;
}
fn data_width(source:buf<u8>,tree:ntasm_ast.Tree,item:ntasm_ast.Node)->u64 {
    let name_id:u64=item.first_child;if name_id==0||name_id>tree.node_count{return 0;}
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,name_id);
    let type_id:u64=name.next_sibling;if type_id==0||type_id>tree.node_count{return 0;}
    let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,type_id);
    let value_id:u64=type_.next_sibling;
    if type_.kind!=36||type_.first_child==0||type_.first_child!=type_.last_child||
       type_.first_child>tree.node_count||value_id==0||value_id>tree.node_count{return 0;}
    let value:ntasm_ast.Node=ntasm_ast.node_at(tree,value_id);
    if value.next_sibling!=0||value.kind!=94||value.start>=value.end||value.end>len(source)||
       source[value.start]<48||source[value.start]>57{return 0;}
    let type_name:ntasm_ast.Node=ntasm_ast.node_at(tree,type_.first_child);
    let t8:buf<u8>="u8";if word(source,type_name,t8){if value.aux>255{return 0;}return 1;}
    let t16:buf<u8>="u16";if word(source,type_name,t16){if value.aux>65535{return 0;}return 2;}
    let t32:buf<u8>="u32";if word(source,type_name,t32){if value.aux>4294967295{return 0;}return 4;}
    let t64:buf<u8>="u64";if word(source,type_name,t64){return 8;}
    return 0;
}
fn before(source:buf<u8>,a:u64,al:u64,b:u64,bl:u64)->bool {
    let mut i:u64=0;while i<al&&i<bl{
        if source[a+i]!=source[b+i]{return source[a+i]<source[b+i];}i=i+1;
    }
    return al<bl;
}
fn data_name(tree:ntasm_ast.Tree,item:ntasm_ast.Node)->ntasm_ast.Node {
    return ntasm_ast.node_at(tree,item.first_child);
}
fn data_literal(tree:ntasm_ast.Tree,item:ntasm_ast.Node)->ntasm_ast.Node {
    let name:ntasm_ast.Node=data_name(tree,item);
    let type_:ntasm_ast.Node=ntasm_ast.node_at(tree,name.next_sibling);
    return ntasm_ast.node_at(tree,type_.next_sibling);
}
// spec/formats/nxo-v0.md, "Charge utile des sections de donnees": the C reference
// codegen emits data items in ascending source name order, ties broken by
// declaration order, and gives each item the next offset its own width
// requires, zero padding the section.
// items holds four words per data declaration in declaration order: the node
// id, the section, the width and the literal value. layout holds four words
// per declaration plus two: the item index emitted i-th, the offset of item i,
// the name start and the name length of item i, then the two padded section
// sizes. Returns 0 on success.
fn layout_data(source:buf<u8>,tree:ntasm_ast.Tree,items:buf<u64>,count:u64,layout:buf<u64>)->u64 {
    // stable insertion sort on the source name, the C tiebreak being the
    // declaration index, so equal names keep their relative order
    let mut i:u64=0;
    while i<count {
        let mut j:u64=i;
        let next:ntasm_ast.Node=data_name(tree,ntasm_ast.node_at(tree,items[i*4]));
        while j>0 {
            let prev:ntasm_ast.Node=data_name(tree,ntasm_ast.node_at(tree,items[layout[j-1]*4]));
            if !before(source,next.start,next.end-next.start,prev.start,prev.end-prev.start){break;}
            layout[j]=layout[j-1];j=j-1;
        }
        layout[j]=i;i=i+1;
    }
    // the name span of every item, so the emit loops need no tree walk
    i=0;
    while i<count {
        let at:u64=layout[i];
        let name:ntasm_ast.Node=data_name(tree,ntasm_ast.node_at(tree,items[at*4]));
        layout[count*2+at]=name.start;
        layout[count*3+at]=name.end-name.start;
        i=i+1;
    }
    let mut ro_end:u64=0;let mut dat_end:u64=0;
    i=0;
    while i<count {
        let at:u64=layout[i];
        let width:u64=items[at*4+2];
        if width==0{return 1;}
        let mut align:u64=width;if align>8{align=8;}
        if items[at*4+1]==2 {
            while align>0&&ro_end%align!=0{ro_end=ro_end+1;}
            layout[count+at]=ro_end;ro_end=ro_end+width;
        } else {
            while align>0&&dat_end%align!=0{dat_end=dat_end+1;}
            layout[count+at]=dat_end;dat_end=dat_end+width;
        }
        i=i+1;
    }
    layout[count*4]=ro_end;layout[count*4+1]=dat_end;return 0;
}
// Collects the data declarations of the whole unit, four words each in
// declaration order, refusing a unit the bounded producers cannot lay out.
fn collect_data(source:buf<u8>,tree:ntasm_ast.Tree,limit:u64,items:buf<u64>)->u64 {
    let mut seen:u64=0;
    let mut id:u64=1;
    while id<=tree.node_count {
        let item:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if item.kind==24 {
            if seen>=limit{return 0;}
            let sec:u64=section_of(source,tree,item);
            let width:u64=data_width(source,tree,item);
            if width==0||(sec!=2&&sec!=3){return 0;}
            items[seen*4]=id;items[seen*4+1]=sec;items[seen*4+2]=width;
            items[seen*4+3]=data_literal(tree,item).aux;
            seen=seen+1;
        }
        id=id+1;
    }
    return seen;
}
fn target_of(source:buf<u8>,tree:ntasm_ast.Tree)->u64 {
    let mut id:u64=1;
    while id<=tree.node_count {
        let node:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if node.kind==3 {
            if node.first_child==0||node.first_child>tree.node_count{return 0;}
            let name:ntasm_ast.Node=ntasm_ast.node_at(tree,node.first_child);
            let uefi:buf<u8>="x86_64-nexora-uefi";if word(source,name,uefi){return 1;}
            let bare:buf<u8>="x86_64-nexora-none";if word(source,name,bare){return 2;}
            return 0;
        }
        id=id+1;
    }
    return 0;
}
// The immediate a return statement carries, folded when the operand is a
// constant expression rather than a bare literal.
//
// WHY A FOLD AT ALL. The producer used to parse the source and never run the
// expansion, which is where the corpus member comptime-macro's 800 lived: the
// top level walk accepted a comptime block and a macro declaration, and then
// layout_body met an expand invocation that nothing had replaced. The splice
// was already extracted to ntasm_macro_splice and reachable; this module
// simply never asked it anything. The splice substitutes the argument and
// stops, so what it produces for the corpus member is `return 41+1` as an
// expression tree, and layout_body accepts a return operand only when it is a
// bare literal. Reachability and the fold are therefore one change and not
// two: an expansion that is never folded produces a DIFFERENT object rather
// than no object.
//
// WHY THE FOLD LIVES HERE AND NOT IN THE SPLICER. It is a lowering decision,
// so it belongs on this side of the splice with the rest of the lowering.
// Folding inside the splicer would make the splicer's published tree depend
// on the target's arithmetic, and the splice is used by the pipeline as well
// as by this producer.
//
// THE REFERENCE'S OWN BOUNDARY, measured against nt_object_compile rather than
// assumed: a u64 return accepts a folded expression, and `return 41+1`,
// `return 6*7` and `return (41)+1` are each ONE object with a bare
// `return 42`, at 496 bytes apiece. A negative is refused by the reference
// with 401, for a bare literal (-1) and for an expression (2-5) alike, so a
// negative fold is refused here rather than turned into a bit pattern the
// reference would not have emitted. A shape constant_eval does not accept is
// refused too, and not guessed at: an unevaluated operand is a shape this
// lowering does not own.
//
// out[0] is 0 on success with the value in out[1], and a refusal code
// otherwise. Zero is a legal immediate, so success cannot be signalled by the
// value itself and the status is a separate word.
fn return_immediate(tree:ntasm_ast.Tree,operand:u64,out:buf<u64>)->u64 {
    if len(out)<2 { return 800; }
    out[0]=0;out[1]=0;
    if operand==0||operand>tree.node_count { return 800; }
    let value:ntasm_ast.Node=ntasm_ast.node_at(tree,operand);
    if value.kind==94 { out[1]=value.aux; return 0; }
    let folded:constant_eval.Value=constant_eval.evaluate(tree,operand);
    if folded.status!=0 { return 800; }
    if folded.negative { return 800; }
    out[1]=folded.magnitude;
    return 0;
}
fn supported_shape(source:buf<u8>,tree:ntasm_ast.Tree)->bool {
    let root:ntasm_ast.Node=ntasm_ast.node_at(tree,1);
    if root.kind!=1{return false;}
    let mut top:u64=root.first_child;
    while top!=0 {
        if top>tree.node_count{return false;}
        let item:ntasm_ast.Node=ntasm_ast.node_at(tree,top);
        if item.kind!=2&&item.kind!=3&&item.kind!=17&&item.kind!=11&&item.kind!=13{return false;}
        if item.kind==17 {
            let sec:u64=section_of(source,tree,item);
            if sec==0||item.first_child==0{return false;}
            let header:ntasm_ast.Node=ntasm_ast.node_at(tree,item.first_child);
            let mut decl:u64=header.next_sibling;
            while decl!=0 {
                if decl>tree.node_count{return false;}
                let d:ntasm_ast.Node=ntasm_ast.node_at(tree,decl);
                if (sec==1&&d.kind!=18)||(sec!=1&&d.kind!=24){return false;}
                if d.kind==18 {
                    let mut child:u64=d.first_child;let mut bodies:u64=0;
                    while child!=0 {
                        if child>tree.node_count{return false;}
                        let part:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
                        if part.kind==36 {
                            if part.first_child==0||part.first_child!=part.last_child||part.first_child>tree.node_count{return false;}
                            // THE THIRD COPY, AND THE ONLY GUARD-ONLY ONE OF THE
                            // THREE. This predicate used to be its own u64 literal,
                            // word(source,result_type,u64_), while the two closed
                            // routes both read their width from a shared reader. It
                            // now calls that same reader, so it is the third CALLER of
                            // the rule rather than a third COPY of it, and the four
                            // widths it admits are the four the reader admits.
                            //
                            // WHY A GUARD-ONLY REPAIR IS COMPLETE HERE, and it is not
                            // complete everywhere. The printer this guard feeds is the
                            // one at build_scalar_data, which already reads
                            // declared_return_width and hands it to width_name, so the
                            // print half of this pair needed no repair and the guard
                            // was the whole of it. The reference was asked rather than
                            // assumed: it lowers build_scalar_data's own shape at u64
                            // AND at u32 and states ret=u32 in the contract it builds,
                            // and it emits IDENTICAL .text for the two widths, so no
                            // lowering change is in scope. A guard that admits a width
                            // the printer can name is therefore a correct pair.
                            //
                            // bool IS EXCLUDED, and that is measured rather than
                            // stylistic. The reference refuses a bool return here with
                            // 400 "integer literal cannot initialize bool", and this
                            // guard admits only bodies whose return value is a bare
                            // integer literal, so admitting bool would admit a
                            // declaration the reference refuses. The framed route draws
                            // the same line at its own width check; the two now agree
                            // instead of being two independent answers.
                            let declared:u64=declared_return_width(source,tree,d,false);
                            if declared!=8&&declared!=16&&declared!=32&&declared!=64{return false;}
                        }else if part.kind==20||part.kind==21 {
                            if part.first_child!=0{return false;}
                        }else if part.kind!=90&&part.kind!=25{return false;}
                        if part.kind==25 {
                            bodies=bodies+1;let mut statement:u64=part.first_child;
                            while statement!=0 {
                                if statement>tree.node_count{return false;}
                                let line:ntasm_ast.Node=ntasm_ast.node_at(tree,statement);
                                if line.kind!=32&&line.kind!=29{return false;}
                                if line.kind==29 {
                                    if line.next_sibling!=0||line.first_child==0||line.first_child>tree.node_count{return false;}
                                    let value:ntasm_ast.Node=ntasm_ast.node_at(tree,line.first_child);
                                    if value.kind!=94||value.aux!=0||value.start>=value.end||value.end>len(source)||source[value.start]!=48{return false;}
                                }
                                statement=line.next_sibling;
                            }
                        }
                        child=part.next_sibling;
                    }
                    if bodies!=1{return false;}
                }
                decl=d.next_sibling;
            }
        }
        top=item.next_sibling;
    }
    return true;
}
// Takes ownership of section buffers, flat unsorted symbol records, the
// relocation specs and the contract table.
// Record words: source name start/length, section, flags, offset, size, value.
// relocs are TRIPLETS: (one-based target record, .text field offset, addend).
// The third word is the A of object.h line 20, "REL32 = S+A-(P+4)", and it is
// the ADDEND, not the field. A call patch carries a zero addend because the
// reference's call arithmetic is exactly S-(P+4): codegen.c 1632-1634 hands
// patch_local the callee's own function offset, and patch_local at codegen.c
// 363-369 is target-(site+4) with no addend term anywhere. A symbolic data
// reference carries the literal displacement the source spells, which is the
// A its add_data_patch records beside the site.
// The FIELD itself is the resolved displacement, not a placeholder, and it is
// the caller's to write before it gets here: object.h line 20 says so, and
// codegen.c 1626-1632 resolves every call patch but an unresolved import while
// codegen.c 1650-1667 resolves every data patch unconditionally. This function
// owns the symbol table, the string table and the record order; it does not
// own the section payloads, and it does not read or write a displacement.
// The three word form replaces the two word pair this function used to take;
// every producer below writes the same three words, because a call patch's
// addend is zero in the reference too.
// contracts holds one contract slot per record, in record order, so the
// canonical name order the emit loop walks cannot separate a symbol from its
// own contract text.
fn empty_reloc_specs()->buf<u64> { let specs:buf<u64>=alloc(runtime(),0);return specs; }
fn one_reloc_spec(record:u64,site:u64)->buf<u64> {
    let specs:buf<u64>=alloc(runtime(),3);specs[0]=record;specs[1]=site;specs[2]=0;return specs;
}
// True when the name span of a record is admissible in the NXO string table,
// which refuses a zero byte and any byte outside 1..127 (nxo.nova validate).
fn printable_name(source:buf<u8>,start:u64,length:u64)->bool {
    if start>len(source)||length==0||length>512||length>len(source)-start{return false;}
    let mut i:u64=0;
    while i<length { if source[start+i]==0||source[start+i]>=128 { return false; } i=i+1; }
    return true;
}

// The span of the module name of a source, and zero when the source has no
// module declaration this module can find.
//
// THIS EXISTS BECAUSE OF THE NAMING RULE, which is not a choice this producer
// gets to make. The canonical symbol name in an NXO is the MODULE QUALIFIED
// name, and it is qualified for every symbol, function and variable alike. The
// reference decides it in exactly one place, object_build.c:305, inside
// nt_object_compile:
//
//     snprintf(order[j].symbol.name, mn + sn + 2, "%s.%s", s->module, s->name);
//
// and object_build.c:213 sorts on that same qualified string, because
// object.c:65 refuses a symbol table whose names are not ascending. So the
// qualified name is the object's own identity: it is what the string table
// carries, what the sort key is, and what a link resolves a reference to.
//
// Every symbol of one source shares the module, so qualifying is a constant
// prefix. That is why the ORDER is still the bare name order and stays
// correct: a common prefix does not change the relative order of two names.
// The length does change, and the length is what the string table accounts for.
fn module_of(source:buf<u8>,tree:ntasm_ast.Tree)->u64 {
    let mut id:u64=1;
    while id<tree.node_count {
        let node:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if node.kind==2 {
            if node.first_child==0||node.first_child>tree.node_count{return 0;}
            // A module name is dotted in this language -- every member of the
            // corpus spells it bootstrap.return42 -- and a dotted name parses
            // as a QUALIFIED node (kind 91) whose own span covers the whole
            // dotted spelling, not as a bare identifier (kind 90).
            let name:ntasm_ast.Node=ntasm_ast.node_at(tree,node.first_child);
            if (name.kind!=90&&name.kind!=91)||name.start>=name.end||name.end>len(source){return 0;}
            return id;
        }
        id=id+1;
    }
    return 0;
}
// The canonical name length of one record. A record whose flags carry
// QUALIFIED_BIT already carries its own fully qualified name, and the module
// prefix is not added to it a second time; every other record is the module,
// a dot, and the bare name. The arithmetic is object_build.c:305's
// mn + sn + 2, and for the qualified record it is sn + 1, the same string.
fn name_length(records:buf<u64>,at:u64,prefix:u64)->u64 {
    if (records[at+3]&16)!=0{return records[at+1];}
    return records[at+1]+prefix;
}
// Byte k of the canonical name of record r, read out of the source. A record
// whose flags carry bit 16 is its own name, source[records[r*7] .. +nlen]; any
// other record is the module, a dot, and the bare name, which is the three part
// string object_build.c:305 prints into mn+sn+2 bytes. Reading the name out of
// the source rather than out of a built copy keeps one owner for the rule: the
// bytes this function returns are the bytes the emit loop writes.
fn name_byte(source:buf<u8>,ms:u64,ml:u64,records:buf<u64>,prefix:u64,r:u64,k:u64)->u8 {
    if (records[r*7+3]&16)!=0{return source[records[r*7]+k];}
    if k<ml{return source[ms+k];}
    if k==ml{return 46;}
    return source[records[r*7]+k-prefix];
}
// Lexicographic order of the canonical names of two records, the comparison
// object_build.c:213 sorts the qualified strings with. It is deliberately not
// `before`, which compares spans of the SOURCE: with a per record prefix the
// source span is no longer the name the object carries, and the bare span order
// can then disagree with the name order the table is required to be in.
fn name_before(source:buf<u8>,ms:u64,ml:u64,records:buf<u64>,prefix:u64,a:u64,b:u64)->bool {
    let al:u64=name_length(records,a*7,prefix);
    let bl:u64=name_length(records,b*7,prefix);
    let mut i:u64=0;
    while i<al&&i<bl{
        let x:u8=name_byte(source,ms,ml,records,prefix,a,i);
        let y:u8=name_byte(source,ms,ml,records,prefix,b,i);
        if x!=y{return x<y;}
        i=i+1;
    }
    return al<bl;
}
// The canonical order of the object symbol table is the NAME order alone, across
// all three sections. object.c nt_object_validate refuses a table whose symbol
// names are not ascending ("invalid, duplicated or unsorted symbol name"), and
// nt_object_write is what the gate compares against, so name order is the
// contract and nothing else may reorder it.
//
// This function existed for one lot and was removed within it. It ordered data
// symbols before .text functions, on the reading that codegen.c generate calls
// emit_static_data before it emits the functions. That reading is true of the
// CODE image and false of the OBJECT: the image carries symbols in creation
// order, the object carries them in name order, and the two differ as soon as a
// data name sorts after a function name. It turned 104 fixtures of the
// x64_lower_nxo_pe gate red and it was wrong. Recorded here because the mistake
// is easy to repeat and because the image order and the object order are
// different things that look the same on a two symbol fixture.
fn emit_canonical(source:buf<u8>,target:u64,text:buf<u8>,ro:buf<u8>,data_:buf<u8>,
                  records:buf<u64>,reloc_specs:buf<u64>,contracts:buf<u8>,
                  tree:ntasm_ast.Tree)->ntasm_nxo.WriteResult {
    let used:u64=len(records)/7;let mut string_size:u64=0;let mut i:u64=0;
    // The module prefix, resolved here so that the naming rule has exactly one
    // owner in this module, the way object_build.c:305 is the single place the
    // C reference forms a qualified name. A source whose module declaration
    // this producer cannot read is REFUSED, never emitted with a bare name.
    let module_id:u64=module_of(source,tree);
    let mut module_start:u64=0;let mut module_len:u64=0;
    if module_id!=0 {
        let decl:ntasm_ast.Node=ntasm_ast.node_at(tree,module_id);
        let name_node:ntasm_ast.Node=ntasm_ast.node_at(tree,decl.first_child);
        module_start=name_node.start;module_len=name_node.end-name_node.start;
    }
    if module_len==0||!printable_name(source,module_start,module_len){
        rt_free(runtime(),contracts);rt_free(runtime(),records);rt_free(runtime(),text);rt_free(runtime(),ro);rt_free(runtime(),data_);rt_free(runtime(),reloc_specs);
        return failed(800);
    }
    // An unresolved import is the one symbol of a unit that is NOT qualified
    // with the module of the source that declares it. The reference names it
    // by its PATH: frontend.c:2974 records the dotted path in f->import_name
    // and the alias in f->name, and codegen.c:1586-1599 splits that path at its
    // LAST dot, handing the tail to add_symbol as the name and the head as the
    // module. object_build.c:305 then joins those two with a dot, so the name
    // the object carries is the path itself, and neither the alias nor the
    // declaring module appears anywhere in it. Bit 16 of the flags word is the
    // per record "this name is already qualified" mark; it is masked off again
    // before the flags reach the object, which carries only object.h's four.
    let prefix:u64=module_len+1;
    while i<used {
        let at:u64=i*7;let start:u64=records[at];let nlen:u64=records[at+1];
        let clen:u64=contract_length(contracts,i);
        let full:u64=name_length(records,at,prefix);
        if !printable_name(source,start,nlen)||clen==0||clen>65536||full>512{
            rt_free(runtime(),contracts);rt_free(runtime(),records);rt_free(runtime(),text);rt_free(runtime(),ro);rt_free(runtime(),data_);rt_free(runtime(),reloc_specs);
            return failed(800);
        }
        string_size=string_size+full+clen;i=i+1;
    }
    let reloc_count:u64=len(reloc_specs)/3;
    if used==0||used>65536||len(records)%7!=0||string_size>67108864||
       len(reloc_specs)%3!=0||reloc_count>1048576{
