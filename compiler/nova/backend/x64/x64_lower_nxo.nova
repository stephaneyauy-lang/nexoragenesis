        // which is that same stage in this tree), so the defect was invisible
        // at every level that compares a PE. g.relocs[cr*3] is the canonical,
        // one based symbol index by now, and order maps it back to the source
        // index flay is addressed by.
        let mut cr:u64=0;
        while cr<g.reloc_count&&code==0 {
            let canonical:u64=g.relocs[cr*3];
            let csite:u64=g.relocs[cr*3+1];
            if canonical==0||canonical>fn_count { code=800; }
            else {
                let cf:u64=order[canonical-1];
                let cend:u64=csite+4;
                let ctarget:u64=flay[cf*20+13];
                let mut cdisp:u64=0;
                if ctarget>=cend { cdisp=ctarget-cend; }
                else { let cgap:u64=cend-ctarget; cdisp=18446744073709551615-cgap+1; }
                // 18446744071562067968 is -2147483648 as two's complement, so
                // anything outside the pair is not a reachable rel32 and
                // codegen.c NTCG_E_RANGE refuses it. 407 is the code this
                // module already uses for that refusal, at emit_branch, and it
                // is the same answer the data patch loop below gives.
                if cdisp>2147483647&&cdisp<18446744071562067968 { code=407; }
                else {
                    if csite+4>len(text) { code=800; }
                    else {
                        let mut cb:u64=0;
                        while cb<4 { text[csite+cb]=u8((cdisp>>(cb*8))&255); cb=cb+1; }
                    }
                }
            }
            cr=cr+1;
        }
        // codegen.c generate RESOLVES every data patch before the object is
        // written; the object is not the place the reference defers it to. The
        // loop at codegen.c lines 1646 to 1668 puts the rdata base at the text
        // length rounded up to 4096 plus the eight byte rdata header, the data
        // base at that plus the rdata length rounded up to 4096, and writes
        // target - (site + 4) into the four displacement bytes, in object mode
        // exactly as in the flat image. The ONE REL32 field the reference
        // leaves zero is a call to an unresolved import, and it skips that one
        // on purpose at codegen.c line 1629; a symbolic DATA reference is never
        // skipped, so the zero this producer used to write beside its own
        // relocation was never the reference's rule. It was justified by a
        // citation to "object.c line 20", which is the body of r64 and states
        // no such contract; the materialiser overwrites the field either way,
        // which is why the two PEs agreed while the two objects did not.
        let rb_base:u64=((total+4095)/4096)*4096;
        let db_base:u64=((rb_base+8+ro_size+4095)/4096)*4096;
        let mut dp:u64=0;
        while dp<g.patch_count&&code==0 {
            let ditem:u64=g.patches[dp*3]-fn_count-1;
            let dsite:u64=g.patches[dp*3+1];
            let dadd:u64=g.patches[dp*3+2];
            let dsec:u64=items[ditem*4+1];
            let mut dbase:u64=0;
            if dsec==2 { dbase=rb_base+8; }
            else if dsec==3 { dbase=db_base; }
            else { code=800; }
            if code==0 {
                let dend:u64=dsite+4;
                let dtarget:u64=dbase+layout[data_count+ditem]+dadd;
                let mut ddisp:u64=0;
                if dtarget>=dend { ddisp=dtarget-dend; }
                else { let dgap:u64=dend-dtarget; ddisp=18446744073709551615-dgap+1; }
                // 18446744071562067968 is -2147483648 as two's complement, so
                // anything outside the pair is not a reachable rel32 and
                // codegen.c NTCG_E_RANGE refuses it. 407 is the code this
                // module already uses for that refusal, at emit_branch.
                if ddisp>2147483647&&ddisp<18446744071562067968 { code=407; }
                else {
                    if dsite+4>len(text) { code=800; }
                    else {
                        let mut db:u64=0;
                        while db<4 { text[dsite+db]=u8((ddisp>>(db*8))&255); db=db+1; }
                    }
                }
            }
            dp=dp+1;
        }
    }
    if code==0 {
        // emit_canonical takes ownership of text, ro, data_, the symbol records,
        // the relocation specs and the contract table, so none of them is
        // released here.
        let result:ntasm_nxo.WriteResult=emit_canonical(source,target,g.text,ro,data_,nxo,specs,contracts,tree);
        rt_free(runtime(),signature);rt_free(runtime(),patches);
        rt_free(runtime(),layout);rt_free(runtime(),items);rt_free(runtime(),shape);
        rt_free(runtime(),labels);rt_free(runtime(),records);rt_free(runtime(),stream);
        rt_free(runtime(),scratch);rt_free(runtime(),pos);rt_free(runtime(),tmp);
        rt_free(runtime(),order);rt_free(runtime(),flay);rt_free(runtime(),lcount);
        rt_free(runtime(),lets);rt_free(runtime(),pcount);
        rt_free(runtime(),rawflag);rt_free(runtime(),raw);rt_free(runtime(),spill);
        rt_free(runtime(),cdepth);
        rt_free(runtime(),params);rt_free(runtime(),ids);
        return result;
    }
    rt_free(runtime(),signature);rt_free(runtime(),patches);rt_free(runtime(),specs);
    rt_free(runtime(),layout);rt_free(runtime(),items);rt_free(runtime(),shape);
    rt_free(runtime(),contracts);
    rt_free(runtime(),nxo);rt_free(runtime(),relocs);rt_free(runtime(),text);
    rt_free(runtime(),ro);rt_free(runtime(),data_);
    rt_free(runtime(),labels);rt_free(runtime(),records);rt_free(runtime(),stream);
    rt_free(runtime(),scratch);rt_free(runtime(),pos);rt_free(runtime(),tmp);
    rt_free(runtime(),order);rt_free(runtime(),flay);rt_free(runtime(),lcount);
    rt_free(runtime(),lets);rt_free(runtime(),pcount);
    rt_free(runtime(),rawflag);rt_free(runtime(),raw);rt_free(runtime(),spill);
    rt_free(runtime(),cdepth);
    rt_free(runtime(),params);rt_free(runtime(),ids);
    return failed(code);
}
