// The section shape of the framed producer: exactly one .text, at most one
// .rdata and at most one .data, and nothing else. out receives three words: the
// .text section id, the number of data declarations the two data sections hold
// and a bit mask with bit 1 for a .rdata and bit 2 for a .data. Zero refuses a
// second section of a kind, a section that is not one of the three, a
// declaration in the wrong section, a data item outside the four printed widths
// and a unit that holds more than sixty four data items.
fn collect_frame_sections(source:buf<u8>,tree:ntasm_ast.Tree,out:buf<u64>)->u64 {
    out[0]=0;out[1]=0;out[2]=0;
    let root:ntasm_ast.Node=ntasm_ast.node_at(tree,1);
    if root.kind!=1{return 0;}
    let mut top:u64=root.first_child;
    while top!=0 {
        if top>tree.node_count{return 0;}
        let item:ntasm_ast.Node=ntasm_ast.node_at(tree,top);
        if item.kind==17 {
            let sec:u64=section_of(source,tree,item);
            if sec==0||sec>3{return 0;}
            if item.first_child==0||item.first_child>tree.node_count{return 0;}
            let header:ntasm_ast.Node=ntasm_ast.node_at(tree,item.first_child);
            let mut decl:u64=header.next_sibling;
            while decl!=0 {
                if decl>tree.node_count{return 0;}
                let part:ntasm_ast.Node=ntasm_ast.node_at(tree,decl);
                if sec==1 {
                    if part.kind!=18{return 0;}
                } else {
                    if part.kind!=24{return 0;}
                    if data_width(source,tree,part)==0{return 0;}
                    if out[1]>=64{return 0;}
                    out[1]=out[1]+1;
                }
                decl=part.next_sibling;
            }
            if sec==1 {
                if out[0]!=0{return 0;}
                out[0]=top;
            } else {
                let bit:u64=1<<(sec-1);
                if (out[2]&bit)!=0{return 0;}
                out[2]=out[2]|bit;
            }
        } else if item.kind!=2&&item.kind!=3&&item.kind!=11&&item.kind!=13{return 0;}
        top=item.next_sibling;
    }
    if out[0]==0{return 0;}
    return 1;
}
// Framed multi-function producer. One .text section, one to sixty four
// functions, one exported, every function with at least one in parameter, a u64
// return, and any effect and clobber set the catalogue can name. A unit may add
// at most one .rdata and one .data section of literal u8/u16/u32/u64 items. Text
// layout is the codegen.c
