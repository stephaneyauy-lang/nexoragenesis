// Bounded AST producer: one text/main function, scalar literal data, no imports
// or relocations. The existing build() fixture remains available unchanged. The
// data payload follows spec/formats/nxo-v0.md: canonical name order, each item aligned
// to its own width, exactly as the C reference codegen lays it out.
export fn build_scalar_data(source:buf<u8>,tree:ntasm_ast.Tree,features:u64,cpl:u64)->ntasm_nxo.WriteResult {
    if tree.ok==false||tree.node_count==0||tree.node_count>1152921504606846975{return failed(800);}
    let target:u64=target_of(source,tree);if target==0||!supported_shape(source,tree){return failed(800);}
    let mut text_sections:u64=0;let mut ro_sections:u64=0;let mut data_sections:u64=0;
    let mut functions:u64=0;
    let mut id:u64=1;
    while id<=tree.node_count {
        let item:ntasm_ast.Node=ntasm_ast.node_at(tree,id);
        if item.kind==17 {
            let sec:u64=section_of(source,tree,item);
            if sec==1{text_sections=text_sections+1;}else if sec==2{ro_sections=ro_sections+1;}
            else if sec==3{data_sections=data_sections+1;}else{return failed(800);}
        }else if item.kind==18 {
            if section_of(source,tree,item)!=1||item.first_child==0||item.first_child>tree.node_count{return failed(800);}
            let name:ntasm_ast.Node=ntasm_ast.node_at(tree,item.first_child);
            let main_:buf<u8>="main";if !word(source,name,main_){return failed(800);}
            functions=functions+1;
        }else if item.kind==24 {
            let sec:u64=section_of(source,tree,item);let width:u64=data_width(source,tree,item);
            if width==0{return failed(800);}
            if sec!=2&&sec!=3{return failed(800);}
        }else if item.kind==9{return failed(800);}
        id=id+1;
    }
    if text_sections!=1||functions!=1||ro_sections>1||data_sections>1{return failed(800);}
    let items:buf<u64>=alloc(runtime(),256);
    let count:u64=collect_data(source,tree,64,items);
    if count==0||count>64{rt_free(runtime(),items);return failed(800);}
    let layout:buf<u64>=alloc(runtime(),count*4+2);
    let bad:u64=layout_data(source,tree,items,count,layout);
    let ro_size:u64=layout[count*4];let data_size:u64=layout[count*4+1];
    if bad!=0||ro_size>67108864||data_size>67108864{
        rt_free(runtime(),layout);rt_free(runtime(),items);return failed(800);
    }
    let code_bytes:buf<u8>=alloc(runtime(),tree.node_count*16);
    let length:buf<u64>=alloc(runtime(),1);
    let code:u64=x64_lower_control.lower_wide(source,tree,features,cpl,code_bytes,length);
    if code!=0{
