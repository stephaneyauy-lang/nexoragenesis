    let rawflag:buf<u64>=alloc(runtime(),64);
    let void_bytes:buf<u8>=alloc(runtime(),0);
    let void_words:buf<u64>=alloc(runtime(),0);
    let void_triples:buf<u64>=alloc(runtime(),0);
