fn empty_u64_signature(source:buf<u8>,tree:ntasm_ast.Tree,decl:ntasm_ast.Node,imported:bool)->bool {
    let mut child:u64=decl.first_child;if child==0||child>tree.node_count{return false;}
    let first:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
    if imported {
        if first.kind!=91||first.next_sibling==0{return false;}
        child=first.next_sibling;
    }
    let name:ntasm_ast.Node=ntasm_ast.node_at(tree,child);
    if name.kind!=90||name.next_sibling==0{return false;}
    let result:ntasm_ast.Node=ntasm_ast.node_at(tree,name.next_sibling);
    if result.kind!=36||result.first_child==0||result.first_child!=result.last_child||
       result.first_child>tree.node_count||result.next_sibling==0{return false;}
    if declared_return_width(source,tree,decl,imported)==0{return false;}
    let effects:ntasm_ast.Node=ntasm_ast.node_at(tree,result.next_sibling);
    if effects.kind!=20||effects.first_child!=0||effects.next_sibling==0{return false;}
    // The clobber set is NOT required to be empty. codegen.c never reads it on
    // the frameless path: the three places it consults a clobber set are the
    // rflags preserve bit, the pop-versus-lea epilogue, and the CALLEE set at a
    // call site, and a body that is a constant return reaches none of them. The
    // reference builds an object for a declaration with a non-empty set, so a
    // guard that refused one was refusing a shape the product must emit.
    let clobbers:ntasm_ast.Node=ntasm_ast.node_at(tree,effects.next_sibling);
    if clobbers.kind!=21{return false;}
    if imported{return clobbers.next_sibling==0;}
    if clobbers.next_sibling==0||clobbers.next_sibling>tree.node_count{return false;}
    let body:ntasm_ast.Node=ntasm_ast.node_at(tree,clobbers.next_sibling);
    return body.kind==25&&body.next_sibling==0;
}
