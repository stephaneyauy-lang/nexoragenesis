module ntasm_nxo_inspect;
import ntasm_nxo;

// Transactional seven-word NXO summary for tooling and reproducible manifests.
// Output order: target, entry, text, rdata, data, symbols, relocations.
export fn inspect(input:buf<u8>,out:buf<u64>)->u64 {
    if len(out)<7 { return 809; }
    let read_result:ntasm_nxo.ReadResult=ntasm_nxo.read(input);
    if read_result.code!=0 { return read_result.code; }
    let object:ntasm_nxo.Object=read_result.object;
    let text:buf<u8>=object.text;
    let rdata:buf<u8>=object.rdata;
    let data:buf<u8>=object.data;
    let symbols:buf<u64>=object.symbols;
    let relocations:buf<u64>=object.relocations;
    let target:u64=object.target;
    let entry:u64=object.entry;
    let text_size:u64=len(text);
    let rdata_size:u64=len(rdata);
    let data_size:u64=len(data);
    let symbol_count:u64=len(symbols)/8;
    let relocation_count:u64=len(relocations)/5;
    ntasm_nxo.release(object);
    out[0]=target;
    out[1]=entry;
    out[2]=text_size;
    out[3]=rdata_size;
    out[4]=data_size;
    out[5]=symbol_count;
    out[6]=relocation_count;
    return 0;
}

export fn inspect_symbol(input:buf<u8>,index:u64,out:buf<u64>)->u64 {
    if len(out)<8 { return 809; }
    let read_result:ntasm_nxo.ReadResult=ntasm_nxo.read(input);
    if read_result.code!=0 { return read_result.code; }
    let object:ntasm_nxo.Object=read_result.object;
    let symbols:buf<u64>=object.symbols;
    let count:u64=len(symbols)/8;
    if index>=count { ntasm_nxo.release(object);return 810; }
    let at:u64=index*8;
    let w0:u64=symbols[at];let w1:u64=symbols[at+1];
    let w2:u64=symbols[at+2];let w3:u64=symbols[at+3];
    let w4:u64=symbols[at+4];let w5:u64=symbols[at+5];
    let w6:u64=symbols[at+6];let w7:u64=symbols[at+7];
    ntasm_nxo.release(object);
    out[0]=w0;out[1]=w1;out[2]=w2;out[3]=w3;
    out[4]=w4;out[5]=w5;out[6]=w6;out[7]=w7;
    return 0;
}

export fn inspect_relocation(input:buf<u8>,index:u64,out:buf<u64>)->u64 {
    if len(out)<5 { return 809; }
    let read_result:ntasm_nxo.ReadResult=ntasm_nxo.read(input);
    if read_result.code!=0 { return read_result.code; }
    let object:ntasm_nxo.Object=read_result.object;
    let relocations:buf<u64>=object.relocations;
    let count:u64=len(relocations)/5;
    if index>=count { ntasm_nxo.release(object);return 811; }
    let at:u64=index*5;
    let w0:u64=relocations[at];let w1:u64=relocations[at+1];
    let w2:u64=relocations[at+2];let w3:u64=relocations[at+3];
    let w4:u64=relocations[at+4];
    ntasm_nxo.release(object);
    out[0]=w0;out[1]=w1;out[2]=w2;out[3]=w3;out[4]=w4;
    return 0;
}

// Symbol word pair selectors inside the flat eight-word symbol record.
fn name_pair()->u64 { return 0; }
fn contract_pair()->u64 { return 6; }
// Shared body of the two text accessors below. `field` selects the
// (offset,length) word pair of one canonical string. Every failure path
// returns before any caller buffer is written, so a rejected call leaves the
// byte output and the length output exactly as the caller supplied them.
// Codes reuse the established inspector codes: 800 invalid NXO, 809 caller
// output too small, 810 index out of range.
fn copy_symbol_text(input:buf<u8>,index:u64,field:u64,out:buf<u8>,out_length:buf<u64>)->u64 {
    if len(out_length)<1 { return 809; }
    let read_result:ntasm_nxo.ReadResult=ntasm_nxo.read(input);
    if read_result.code!=0 { return read_result.code; }
    let object:ntasm_nxo.Object=read_result.object;
    let symbols:buf<u64>=object.symbols;
    let strings:buf<u8>=object.strings;
    let count:u64=len(symbols)/8;
    if index>=count { ntasm_nxo.release(object);return 810; }
    let at:u64=index*8+field;
    let offset:u64=symbols[at];
    let size:u64=symbols[at+1];
    let bound:u64=len(strings);
    if offset>bound || size>bound-offset { ntasm_nxo.release(object);return 800; }
    if size>len(out) { ntasm_nxo.release(object);return 809; }
    let mut i:u64=0;
    while i<(size) { out[i]=strings[offset+i];i=i+1; }
    ntasm_nxo.release(object);
    out_length[0]=size;
    return 0;
}
// Copies the exact canonical name bytes of the zero-based symbol index and
// reports the copied count through the separate u64 length output.
export fn copy_symbol_name(input:buf<u8>,index:u64,out:buf<u8>,out_length:buf<u64>)->u64 {
    return copy_symbol_text(input,index,name_pair(),out,out_length);
}
// Copies the exact canonical contract bytes of the zero-based symbol index
// and reports the copied count through the separate u64 length output.
export fn copy_symbol_contract(input:buf<u8>,index:u64,out:buf<u8>,out_length:buf<u64>)->u64 {
    return copy_symbol_text(input,index,contract_pair(),out,out_length);
}