// A4: MIR/1.1 adds explicit call_arg records; ordinary operations stay three-address.
module machine_ir;

import ntir;
import register_widths;
import ntasm_ast;

// Machine IR/1.0: 10-word header, 24-word preorder records. The original
// twenty record fields retain their offsets; four explicit runtime facts
// carry cell_family, cell_offset, cell_mode and call_clobbers.
//
// Value ids are immutable expression results or execution-site register reads.
// Physical register state is one 64-bit runtime cell per family, shared by
// every block in a function. Reads are distinct vregs; writes name a slice.
// This is deliberately not a lowering-order last-write map and does not need
// fictitious SSA phis to express mutable machine registers. The bind table
// remains declaration/provenance metadata, not the answer for a runtime read.
//
// Declaration width/sign propagate into arithmetic. The memory annotation's
// element bounds load/store accesses. IN parameters are immutable snapshots;
// ABI-resolved OUT/INOUT flags identify names that read the current cell.
// Call masks name callee clobbers and outputs, resolved after ABI annotation.
// Flags definitions/reads are explicit cell_mode bits, distinct from bool
// predicate values. The verifier checks these facts without parsing source.
//
// Serialization publishes all 24 fields. Changing the stride requires the
// major revision 1.0, per spec/formats/machine-ir-v0.md section 9.
fn MIR_MAGIC()->u64 { return 0x4D495231; }
// Historical 0.2/0.3 added declaration facts without changing stride20.
// Current 1.0 has stride24 and explicit runtime cells; this is a major change.
export fn FORMAT_MAJOR()->u64 { return 1; }
export fn FORMAT_MINOR()->u64 { return 3; }
export fn HEADER_WORDS()->u64 { return 10; }
export fn NODE_WORDS()->u64 { return 24; }
export fn KIND_BASE()->u64 { return 2048; }
export fn KIND_COUNT()->u64 { return 40; }
// A7.02: field names for MIR/1.0. Header indices 0..9, records 10..33.
export fn SCHEMA_FIELDS()->u64 { return 34; }
export fn schema_field(i:u64)->buf<u8> {
    if i==0 { return "magic"; }
    if i==1 { return "major"; }
    if i==2 { return "minor"; }
    if i==3 { return "record_count"; }
    if i==4 { return "root"; }
    if i==5 { return "stride"; }
    if i==6 { return "values"; }
    if i==7 { return "blocks"; }
    if i==8 { return "domain_bit"; }
    if i==9 { return "typed_count"; }
    if i==10 { return "kind"; }
    if i==11 { return "ntir_node"; }
    if i==12 { return "line"; }
    if i==13 { return "column"; }
    if i==14 { return "value_out"; }
    if i==15 { return "arg_a"; }
    if i==16 { return "arg_b"; }
    if i==17 { return "arg_c"; }
    if i==18 { return "arg_count"; }
    if i==19 { return "width"; }
    if i==20 { return "signed"; }
    if i==21 { return "space"; }
    if i==22 { return "class"; }
    if i==23 { return "flags"; }
    if i==24 { return "aux"; }
    if i==25 { return "aux2"; }
    if i==26 { return "parent"; }
    if i==27 { return "ordinal"; }
    if i==28 { return "origin"; }
    if i==29 { return "depth"; }
    if i==30 { return "cell_family"; }
    if i==31 { return "cell_offset"; }
    if i==32 { return "cell_mode"; }
    if i==33 { return "call_clobbers"; }
    return "";
}
export fn kind_at(index:u64)->u64 { return KIND_BASE()+index-1; }

// The `machine_ir` domain of the versions block, spec/ntasm/ntasm.md §17. The bit is
// versions.nova's own (versions.nova:4, `machine_ir` returns 2), NOT a number
// written here for convenience: the gate reads the bit out of the source with
// versions.check and requires the two to be the same number.
export fn DOMAIN_BIT()->u64 { return 2; }

// ---- the kind table -------------------------------------------------------
fn k_unit()->u64 { return 2048; }
fn k_target()->u64 { return 2049; }
fn k_versions()->u64 { return 2050; }
fn k_function()->u64 { return 2051; }
fn k_extern()->u64 { return 2052; }
fn k_block()->u64 { return 2053; }
fn k_param()->u64 { return 2054; }
fn k_bind()->u64 { return 2055; }
fn k_vreg()->u64 { return 2056; }
fn k_symbol()->u64 { return 2057; }
fn k_local_cell()->u64 { return 2086; }
fn k_const()->u64 { return 2058; }
fn k_string()->u64 { return 2059; }
fn k_data()->u64 { return 2060; }
fn k_align()->u64 { return 2061; }
fn k_abi()->u64 { return 2062; }
fn k_effect()->u64 { return 2063; }
fn k_clobber()->u64 { return 2064; }
fn k_asm()->u64 { return 2065; }
fn k_address()->u64 { return 2066; }
fn k_load()->u64 { return 2067; }
fn k_store()->u64 { return 2068; }
fn k_copy()->u64 { return 2069; }
fn k_binary()->u64 { return 2070; }
fn k_unary()->u64 { return 2071; }
fn k_select()->u64 { return 2072; }
fn k_convert()->u64 { return 2073; }
fn k_extend()->u64 { return 2074; }
fn k_truncate()->u64 { return 2075; }
fn k_call()->u64 { return 2076; }
fn k_call_indirect()->u64 { return 2087; }
fn call_kind(kind:u64)->bool { return kind==k_call() || kind==k_call_indirect(); }
fn k_return()->u64 { return 2077; }
fn k_jump()->u64 { return 2078; }
fn k_branch()->u64 { return 2079; }
fn k_phi()->u64 { return 2080; }
fn k_unreachable()->u64 { return 2081; }
fn k_space()->u64 { return 2082; }
fn k_call_arg()->u64 { return 2083; }
fn k_type_decl()->u64 { return 2084; }
fn k_contract_expr()->u64 { return 2085; }

// ---- classes, flags, opcodes ---------------------------------------------
//
// The class word is THIS module's vocabulary and not the NTIR's. An ntir
// register family is 1..16 and a class here is 0..4, so a physical family
// cannot be smuggled through this field even by accident: the verifier refuses
// any class outside 0..4 (938).
export fn CLASS_NONE()->u64 { return 0; }
export fn CLASS_VALUE()->u64 { return 1; }
export fn CLASS_ADDRESS()->u64 { return 2; }
export fn CLASS_PREDICATE()->u64 { return 3; }
export fn CLASS_CONSTANT()->u64 { return 4; }
export fn CLASS_LIMIT()->u64 { return 4; }

export fn FLAG_PURE()->u64 { return 1; }
export fn FLAG_SIDE_EFFECT()->u64 { return 2; }
export fn FLAG_MAY_FAULT()->u64 { return 4; }
export fn FLAG_TERMINATOR()->u64 { return 8; }
export fn FLAG_ENTRY()->u64 { return 16; }
export fn FLAG_LOOP_HEADER()->u64 { return 32; }
export fn FLAG_VOLATILE()->u64 { return 64; }
export fn FLAG_DIAMOND()->u64 { return 128; }
export fn FLAG_NAMED()->u64 { return 256; }
// THE DECLARED RESULT IS PRESENT. A bit and not a number, and the reason is
// the trap lot 62 found in `NtFVariable.span`: a `0` that means "absent" and a
// `0` that means "present and zero" are the same word, so a reader cannot tell
// a function that declares no result from one that declares a result of no
// width, and it will pick one and be wrong. The flag separates the two states
// and `aux2` then carries the width WITHIN the present state, where a zero is
// a real answer -- "declared, and the width is not one this level can name" --
// and `verify` refuses that image instead of letting a consumer approximate
// it. This is also the only new bit in the word: 1..256 keep their meanings and
// 512 is disjoint from all of them, which is what makes adding it additive.
export fn FLAG_RESULT_TYPED()->u64 { return 512; }
// MIR/0.3, THE DECLARATION FACTS AN OBJECT WRITER NEEDS, and why they are bits
// on records that already exist rather than new records. An object symbol is
// named, flagged, placed in a section and described by a contract, and the
// 0.2 image could answer none of the questions that do not come from the
// code itself: whether a function is EXPORTED, which section a `data` lives
// in, what a `data` is CALLED, which register a clobber set names and which
// direction a parameter has. Each answer was dropped on the way here -- the
// AST keeps `export` in its aux word and ntir.nova copies no aux -- so an
// emitter reading 0.2 had to guess or to re-read the source, and both are the
// failure this format exists to prevent.
//
// The six bits are disjoint from 1..512 and from each other, and `verify`
// holds each one to the kinds that may carry it, so no existing reader can
// meet one on a record it already reads: a 0.2 consumer sees the same words
// it always saw on every kind it handled. `mir_symbol` is the exception that
// is NOT an exception: its flags word is the qualifier depth (`symbol_of`),
// a count, and `verify` skips it for that reason.
//
//   FLAG_EXPORT      mir_function, mir_data: `export` precedes the keyword.
//   FLAG_RDATA       mir_data: declared in `section .rdata`.
//   FLAG_WDATA       mir_data: declared in `section .data`. A `mir_data` with
//                    neither bit is a module-scope `const`, which has no
//                    storage at all; RDATA and WDATA together are refused.
//   FLAG_DIR_OUT     mir_param: the direction word is `out`.
//   FLAG_DIR_INOUT   mir_param: the direction word is `inout`. Neither bit is
//                    `in`, the only other spelling parser.nova admits.
//                    THESE TWO ARE NOT WRITTEN BY THIS MODULE. The direction
//                    rule has one owner, abi.nova's `direction`, over an AST
//                    parameter node, and this module holds no AST; a sixth
//                    reading here is what tests_ntasm_abi.c's copy census
//                    refuses (measured 7 October 2026: DIRECTION-COPY-EXTRA).
//                    machine_pipeline.lower_tree, which holds the developed
//                    tree, asks abi.direction for every parameter record by
//                    its NTIR node -- NTIR node ids are AST ids -- and writes
//                    the answer before verify runs.
//   FLAG_PREDICATED  mir_function: a non-empty `requires` or `ensures` set.
//                    The predicates themselves are NOT carried, so a consumer
//                    that needs their text must refuse the function rather
//                    than describe it without them.
//   FLAG_DIR_UNREAD  mir_param: the direction has not been read. Every
//                    parameter this module lowers carries it, and the pipeline
//                    replaces it with the owner's answer; it stays when the
//                    owner answers 0 (a span that opens on no direction word,
//                    which is what a parameter a MACRO produced has: it
//                    carries the invocation's span, measured 7 October 2026 on
//                    validate's four `parity ... bound macro` rows). A
//                    consumer that needs the direction refuses it; nothing
//                    reads it as `in`.
export fn FLAG_EXPORT()->u64 { return 1024; }
export fn FLAG_RDATA()->u64 { return 2048; }
export fn FLAG_WDATA()->u64 { return 4096; }
export fn FLAG_DIR_OUT()->u64 { return 8192; }
export fn FLAG_DIR_INOUT()->u64 { return 16384; }
export fn FLAG_PREDICATED()->u64 { return 32768; }
export fn FLAG_DIR_UNREAD()->u64 { return 65536; }
fn FLAG_DECLARED_MASK()->u64 { return 130048; }

export fn OP_NONE()->u64 { return 0; }
export fn OP_COPY()->u64 { return 1; }
export fn OP_ADD()->u64 { return 2; }
export fn OP_SUB()->u64 { return 3; }
export fn OP_MUL()->u64 { return 4; }
export fn OP_DIV()->u64 { return 5; }
export fn OP_REM()->u64 { return 6; }
export fn OP_AND()->u64 { return 7; }
export fn OP_OR()->u64 { return 8; }
export fn OP_XOR()->u64 { return 9; }
export fn OP_SHL()->u64 { return 10; }
export fn OP_SHR()->u64 { return 11; }
export fn OP_SAR()->u64 { return 12; }
export fn OP_EQ()->u64 { return 13; }
export fn OP_NE()->u64 { return 14; }
export fn OP_LT_U()->u64 { return 15; }
export fn OP_LT_S()->u64 { return 16; }
export fn OP_GT_U()->u64 { return 17; }
export fn OP_GT_S()->u64 { return 18; }
export fn OP_LE_U()->u64 { return 19; }
export fn OP_LE_S()->u64 { return 20; }
export fn OP_GE_U()->u64 { return 21; }
export fn OP_GE_S()->u64 { return 22; }
export fn OP_NEG()->u64 { return 23; }
export fn OP_NOT()->u64 { return 24; }
export fn OP_LNOT()->u64 { return 25; }
export fn OP_LOAD()->u64 { return 26; }
export fn OP_STORE()->u64 { return 27; }
export fn OP_ADDR()->u64 { return 28; }
export fn OP_CALL()->u64 { return 29; }
export fn OP_RET()->u64 { return 30; }
export fn OP_JMP()->u64 { return 31; }
export fn OP_BRANCH()->u64 { return 32; }
export fn OP_UNREACHABLE()->u64 { return 33; }
export fn OP_ALIGN()->u64 { return 34; }
export fn OP_CMP()->u64 { return 35; }
export fn OP_NOP()->u64 { return 36; }
export fn OP_TEST()->u64 { return 37; }
export fn OP_PUSH()->u64 { return 38; }
export fn OP_POP()->u64 { return 39; }
export fn OP_XCHG()->u64 { return 40; }
export fn OP_LEA()->u64 { return 41; }
export fn OP_MOVZX()->u64 { return 42; }
export fn OP_MOVSX()->u64 { return 43; }
export fn OP_UMUL()->u64 { return 44; }
export fn OP_LIMIT()->u64 { return 44; }

// The arity a resolved opcode must have, as min*16+max, so the verifier can
// check a record's operand count without a second table. A 0,0 pair is an
// opcode that takes nothing; a min of 0 with a max of 2 is the address
// operation, which may have a base only, or a base and an index.
export fn op_arity(op:u64)->u64 {
    // OP_COPY is ONE OR TWO operands, and it was two only.  Two is the
    // ASSIGNMENT form -- `mov rax, rcx` -- where operand 0 is the destination.
    // One is the MATERIALISATION form, where a record defines a fresh value from
    // a source and there is no destination operand at all.  Both are the same
    // opcode and they are both real: machine_ir emits one-operand `mir_asm`
    // records for `mov rax, 5` the moment operand 0 stops being lowered as a
    // source, and `verify` refused them at 944 with the two-operand rule.  A
    // publication that admits only one of the two shapes the producer emits is
    // not a constraint; it is a race with the emitter.
    if op==OP_COPY() { return 1*16+2; }
    if op==OP_MUL() { return 2*16+3; }
    if op==OP_UMUL() { return 1*16+1; }
    if op==OP_DIV() { return 1*16+2; }
    if op==OP_ADD() || op==OP_SUB() { return 2*16+2; }
    if op==OP_REM() || op==OP_AND() || op==OP_OR() || op==OP_XOR() { return 2*16+2; }
    if op==OP_SHL() || op==OP_SHR() || op==OP_SAR() { return 2*16+2; }
    if op==OP_EQ() || op==OP_NE() { return 2*16+2; }
    if op==OP_LT_U() || op==OP_LT_S() { return 2*16+2; }
    if op==OP_GT_U() || op==OP_GT_S() { return 2*16+2; }
    if op==OP_LE_U() || op==OP_LE_S() { return 2*16+2; }
    if op==OP_GE_U() || op==OP_GE_S() { return 2*16+2; }
    if op==OP_NEG() || op==OP_NOT() || op==OP_LNOT() { return 1*16+1; }
    if op==OP_LOAD() || op==OP_STORE() { return 1*16+1; }
    if op==OP_ADDR() { return 0*16+2; }
    if op==OP_CALL() { return 1*16+3; }
    if op==OP_RET() { return 0*16+1; }
    if op==OP_JMP() { return 1*16+1; }
    if op==OP_BRANCH() { return 1*16+3; }
    if op==OP_UNREACHABLE() { return 0*16+0; }
    if op==OP_ALIGN() { return 0*16+1; }
    if op==OP_CMP() || op==OP_TEST() || op==OP_XCHG() { return 2*16+2; }
    if op==OP_NOP() { return 0*16+0; }
    if op==OP_PUSH() || op==OP_POP() { return 1*16+1; }
    if op==OP_LEA() { return 1*16+2; }
    if op==OP_MOVZX() || op==OP_MOVSX() { return 1*16+1; }
    return 0;
}

// The opcodes that produce a value and the ones that do not. A record with a
// terminator opcode must have FLAG_TERMINATOR and a block must end with
// exactly one of them; that pairing is the shape rule the verifier enforces.
fn op_produces(op:u64)->bool {
    if op==OP_NONE() || op==OP_RET() || op==OP_JMP() { return false; }
    if op==OP_UNREACHABLE() || op==OP_STORE() { return false; }
    if op==OP_NOP() || op==OP_PUSH() || op==OP_ALIGN() { return false; }
    if op==OP_BRANCH() || op==OP_LOAD() || op==OP_UMUL() { return false; }
    return true;
}
fn op_is_terminator(op:u64)->bool {
    if op==OP_RET() { return true; }
    if op==OP_JMP() || op==OP_BRANCH() { return true; }
    return op==OP_UNREACHABLE();
}

// ---- refusal codes --------------------------------------------------------
//
// A fresh band. The highest published Nova diagnostic is 844 and ntir.nova
// owns 800 and 808..819; NTF_E_OOM is 900 in the C enum (frontend.h:53), so
// this band starts at 930 and no existing code can reach it.
export fn E_TAG()->u64 { return 930; }
export fn E_HEADER()->u64 { return 931; }
export fn E_KIND()->u64 { return 932; }
export fn E_LINK()->u64 { return 933; }
export fn E_SHAPE()->u64 { return 934; }
export fn E_CYCLE()->u64 { return 935; }
export fn E_SHARED()->u64 { return 936; }
export fn E_UNREACHED()->u64 { return 937; }
export fn E_TYPED()->u64 { return 938; }
export fn E_ORIGIN()->u64 { return 939; }
export fn E_INPUT()->u64 { return 940; }
export fn E_VALUE()->u64 { return 941; }
export fn E_TARGET()->u64 { return 942; }
export fn E_VERSION()->u64 { return 943; }
export fn E_ARITY()->u64 { return 944; }
export fn E_SCALE()->u64 { return 945; }
export fn E_NTIR()->u64 { return 946; }
// 947, and what it means: the instruction's DESTINATION operand is the stack
// or the frame pointer. It is a code of its own rather than a reuse of
// E_INPUT or E_SHAPE because the reason it fires is the only reason it can
// fire, and a gate that saw 940 could not tell "this mnemonic means nothing
// here" from "this mnemonic is well formed and its destination is a register
// the rest of the function addresses through". The C oracle names the same
// thing twice and with two different codes: frontend.c:5493-5498 raises
// NTF_E_CONTRACT, 503, "<mnemonic> requires unavailable stack/frame balance
// proof", and codegen.c:1006 raises NTCG_E_UNSUPPORTED, 702, "mov destination
// is the stack or frame pointer".
export fn E_FRAME()->u64 { return 947; }

// 948, and what it means: an instruction carries an operand in a form this
// level does not admit. It is a code of its own, and not a reuse of E_INPUT or
// E_SHAPE, for the same reason E_FRAME is its own: the thing that fires it is
// the only thing that can fire it, and a gate that saw 940 could not tell "this
// operand is a shape no target-independent machine has" from "this operand is
// well formed here and well formed nowhere else". The C oracle says the same
// thing, once, at NTF_E_TYPE 400, "operand cannot lower to x86-64 form"
// (frontend.c:5467-5470), for every one of the forms below -- the name in a
// non-`mov` source, the name in a destination, and the name under a unary.
export fn E_FORM()->u64 { return 948; }

// ---- the NTIR image, read as the published flat buffer -------------------
//
// THE LOWERING READS THE NTIR, NOT THE SOURCE. The whole input is the u64
// image ntir.build produced: no token is re-scanned, no expression is re-parsed
// and no AST node is visited, because this module never holds an AST. The one
// thing it does read from the source text is the byte CONTENT of spans the
// NTIR itself recorded — an integer magnitude, a mnemonic spelling, a symbol
// name — and it reads them through `span_bytes`, never by tokenizing. The gate
// proves the dependency direction: it damages the NTIR IMAGE and requires the
// Machine IR to change, which a re-parse could not do because the source never
// changed.
//
// ntir.nova:46-72 is the layout read here, and ntir publishes HEADER_WORDS,
// NODE_WORDS, KIND_BASE, KIND_COUNT and kind_at, so the stride and the kind
// numbering are read from the owner rather than written down twice.
fn nw(id:u64)->u64 { return ntir.HEADER_WORDS()+(id-1)*ntir.NODE_WORDS(); }
fn nk(words:buf<u64>,id:u64)->u64 { return words[nw(id)]; }
fn nline(words:buf<u64>,id:u64)->u64 { return words[nw(id)+2]; }
fn ncolumn(words:buf<u64>,id:u64)->u64 { return words[nw(id)+3]; }
fn nstart(words:buf<u64>,id:u64)->u64 { return words[nw(id)+4]; }
fn nend(words:buf<u64>,id:u64)->u64 { return words[nw(id)+5]; }
fn nfirst(words:buf<u64>,id:u64)->u64 { return words[nw(id)+8]; }
fn nnext(words:buf<u64>,id:u64)->u64 { return words[nw(id)+10]; }
fn nwidth(words:buf<u64>,id:u64)->u64 { return words[nw(id)+12]; }
fn nsigned(words:buf<u64>,id:u64)->u64 { return words[nw(id)+13]; }
fn nspace(words:buf<u64>,id:u64)->u64 { return words[nw(id)+14]; }
fn naux(words:buf<u64>,id:u64)->u64 { return words[nw(id)+11]; }
fn nclass(words:buf<u64>,id:u64)->u64 { return words[nw(id)+15]; }
// The child of parent at a one-based ordinal, or 0.
fn nchild(words:buf<u64>,count:u64,parent:u64,ordinal:u64)->u64 {
    if parent==0 || parent>count || ordinal==0 { return 0; }
    let mut id:u64=nfirst(words,parent);
    let mut index:u64=1;
    while id!=0 && index<ordinal {
        if id>count { return 0; }
        id=nnext(words,id);
        index=index+1;
    }
    if id>count { return 0; }
    return id;
}
// The NTIR table index of a node, or 0 when the node's kind is not in the
// table. The index is DERIVED as kind-KIND_BASE and then checked against
// ntir.kind_at, so a table that is not the base run makes this return 0
// instead of a plausible wrong index.
fn nindex(words:buf<u64>,id:u64)->u64 {
    if id==0 { return 0; }
    let mut kind:u64=nk(words,id);
    if kind<ntir.KIND_BASE() { return 0; }
    let mut index:u64=kind-ntir.KIND_BASE()+1;
    if index>ntir.KIND_COUNT() { return 0; }
    if ntir.kind_at(index)!=kind { return 0; }
    return index;
}

// ---- admission -----------------------------------------------------------
//
// Which NTIR kinds become machine state and which do not. The answer is not a
// taste: a machine level consumes declarations that resolve to a WIDTH, a
// COUNT, a CALLING CONVENTION or a SYMBOL, and executable statements. It does
// not consume a macro body, a comptime evaluation, a contract predicate or an
// object-file choice, and it must not absorb a target fact — which is why
// index 7 (`output pe64`) is NOT here. That choice belongs to the object
// layer, and a Machine IR that carried it would already be target-bound.
//
// The gate reads this table back at run time and separately checks that every
// EXECUTABLE NTIR node in its fixtures is attributed, so a table that quietly
// stopped admitting statements is a red and not a smaller image.
export fn admits_index(index:u64)->bool {
    if index==1 { return true; }   // unit
    if index==2 { return true; }   // module, its name becomes a symbol
    if index==3 { return true; }   // target
    if index==4 { return true; }   // versions
    if index==6 { return true; }   // default_abi
    if index==9 { return true; }   // import
    if index==10 { return true; }  // const
    if index==18 { return true; }  // function
    if index==19 { return true; }  // parameter
    if index==20 { return true; }  // effects
    if index==21 { return true; }  // clobbers
    if index==24 { return true; }  // data
    if index==25 { return true; }  // block
    if index==26 { return true; }  // let
    if index==27 { return true; }  // abi_clause
    if index==28 { return true; }  // call
    if index==29 { return true; }  // return
    if index==30 { return true; }  // if
    if index==32 { return true; }  // instruction
    if index==33 { return true; }  // label
    if index==34 { return true; }  // predicate metadata
    if index==35 { return true; }  // memory_operand
    if index==36 { return true; }  // expr
    // 37 (type) and 47 (name) are NOT in this table. Both are admitted per
    // NODE and not per KIND, and both refusals are load bearing.
    if index==46 { return true; }  // align_stack
    if index==48 { return true; }  // qualified
    if index==51 { return true; }  // literal
    return false;
}
// Signature types and parameter names now own metadata records in MIR1.1.
// Recognize only those nodes, not arbitrary local type/name nodes.
fn signature_origin(words:buf<u64>,id:u64)->bool {
    let count:u64=words[3];let mut node:u64=id;let mut depth:u64=0;
    while node!=0 && node<=count && depth<=64 {
        let mut parent:u64=0;let mut r:u64=1;
        while r<=count && parent==0 {
            let mut child:u64=nfirst(words,r);let mut seen:u64=0;
            while child!=0 && child<=count && seen<count {
                if child==node { parent=r;break; }
                child=nnext(words,child);seen=seen+1;
            }
            r=r+1;
        }
        if parent==0 { return false; }
        let pk:u64=nindex(words,parent);let nk:u64=nindex(words,node);
        if pk==19 && (nk==37 || (node==id && nk==47 && nfirst(words,parent)==node)) { return true; }
        if (pk==18 || pk==9) && nk==37 { return true; }
        if pk!=37 || nk!=37 { return false; }
        node=parent;depth=depth+1;
    }
    return false;
}
export fn admits_type(words:buf<u64>,id:u64)->bool {
    if nindex(words,id)!=37 { return false; }
    return nspace(words,id)!=0 || signature_origin(words,id);
}
export fn admits_name(words:buf<u64>,id:u64)->bool {
    if nindex(words,id)!=47 { return false; }
    if nwidth(words,id)!=0 && nclass(words,id)!=0 { return true; }
    return signature_origin(words,id);
}
// THE WIDTH A REGISTER SPELLING HAS, AND WHO IS AUTHORITATIVE.
//
// The NTIR is authoritative. It says so in the arm it now carries: a name node
// is typed by its OWN visit (the k_name arm in type_node), not by whichever
// parent happened to reach it, so the word in the image is a property of the
// node and not of the sweep order. Before that arm existed, build visited ids
// ascending, the parser allocates a parent before its children, and
// type_instruction typed the register child FIRST -- and the child's own visit
// then zeroed exactly the words the parent had written, so every register
// named in an instruction arrived with width 0. That was measured, and it is
// fixed upstream now.
//
// register_widths is therefore NOT A FALLBACK. It is the OPPONENT. The two are
// compared and a DISAGREEMENT IS A REFUSAL, never a quiet repair: a fallback
// that can never fire is dead code, and dead code in a lowering is how a wrong
// answer becomes invisible. So this answers 0 when the two disagree and the
// caller turns that into a refusal at the name's own position, which the gate
// can confront. A drift between the two is then a red in the suite rather
// than a repair in the pass.
fn name_width(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    if nindex(words,id)!=47 { return 0; }
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    if start>=end || end>len(source) { return 0; }
    let mut from_ntir:u64=nwidth(words,id);
    let mut from_catalogue:u64=register_widths.width(source,start,end);
    if from_ntir!=0 && from_catalogue!=0 && from_ntir!=from_catalogue { return 0; }
    if from_ntir!=0 { return from_ntir; }
    return from_catalogue;
}
fn name_is_register(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->bool {
    if name_width(words,source,count,id)!=0 { return true; }
    return false;
}
// Per NODE, which is the only granularity that works: whether a NAME is a
// binding, or whether a TYPE names a space, is a fact about the node.
export fn admits(words:buf<u64>,id:u64)->bool {
    if id==0 { return false; }
    let mut index:u64=nindex(words,id);
    if index==37 { return admits_type(words,id); }
    if index==47 { return admits_name(words,id); }
    return admits_index(index);
}
// The per-node answer WITH the fallback, for a caller that has the source.
export fn admits_here(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->bool {
    if id==0 { return false; }
    let mut index:u64=nindex(words,id);
    if index==37 { return admits_type(words,id); }
    if index==47 { return signature_origin(words,id) || name_is_register(words,source,count,id); }
    return admits_index(index);
}
// The kind of the record that IS this NTIR node, or 0 when the index is
// admitted only as an origin. Published so a reader of the table alone can
// tell which kinds are "the record for a node" and which are synthesized.
export fn carries(index:u64)->u64 {
    if index==1 { return k_unit(); }
    if index==3 { return k_target(); }
    if index==4 { return k_versions(); }
    if index==6 { return k_abi(); }
    if index==9 { return k_extern(); }
    if index==10 { return k_data(); }
    if index==18 { return k_function(); }
    if index==19 { return k_param(); }
    if index==20 { return k_effect(); }
    if index==21 { return k_clobber(); }
    if index==24 { return k_data(); }
    if index==27 { return k_abi(); }
    if index==28 { return k_call(); }
    if index==29 { return k_return(); }
    if index==32 { return k_asm(); }
    if index==35 { return k_load(); }
    if index==46 { return k_align(); }
    if index==51 { return k_const(); }
    return 0;
}
// A kind is in the table when the table names it, and the table is the same
// one the gate reads back through kind_at.
export fn kind_present(kind:u64)->bool {
    if kind<KIND_BASE() { return false; }
    if kind>=KIND_BASE()+KIND_COUNT() { return false; }
    return true;
}
fn mir_kind_name(kind:u64)->buf<u8> {
    if kind==k_local_cell() { return "local_cell"; }
    if kind==k_unit() { return "unit"; }
    if kind==k_target() { return "target"; }
    if kind==k_versions() { return "versions"; }
    if kind==k_function() { return "function"; }
    if kind==k_extern() { return "extern"; }
    if kind==k_block() { return "block"; }
    if kind==k_param() { return "param"; }
    if kind==k_bind() { return "bind"; }
    if kind==k_vreg() { return "vreg"; }
    if kind==k_symbol() { return "symbol"; }
    if kind==k_const() { return "const"; }
    if kind==k_string() { return "string"; }
    if kind==k_data() { return "data"; }
    if kind==k_align() { return "align"; }
    if kind==k_abi() { return "abi"; }
    if kind==k_effect() { return "effect"; }
    if kind==k_clobber() { return "clobber"; }
    if kind==k_asm() { return "asm"; }
    if kind==k_address() { return "address"; }
    if kind==k_load() { return "load"; }
    if kind==k_store() { return "store"; }
    if kind==k_copy() { return "copy"; }
    if kind==k_binary() { return "binary"; }
    if kind==k_unary() { return "unary"; }
    if kind==k_select() { return "select"; }
    if kind==k_convert() { return "convert"; }
    if kind==k_extend() { return "extend"; }
    if kind==k_truncate() { return "truncate"; }
    if kind==k_call() { return "call"; }
    if kind==k_call_indirect() { return "call_indirect"; }
    if kind==k_return() { return "return"; }
    if kind==k_jump() { return "jump"; }
    if kind==k_branch() { return "branch"; }
    if kind==k_phi() { return "phi"; }
    if kind==k_unreachable() { return "unreachable"; }
    if kind==k_space() { return "space"; }
    if kind==k_call_arg() { return "call_arg"; }
    if kind==k_type_decl() { return "type_decl"; }
    if kind==k_contract_expr() { return "contract_expr"; }
    return "unknown";
}
export fn kind_name_of(kind:u64)->buf<u8> { return mir_kind_name(kind); }
export fn kind_text(index:u64)->buf<u8> { return mir_kind_name(kind_at(index)); }

// ---- the builder ---------------------------------------------------------
//
// ONE STRUCT, MUTATED IN PLACE, is the whole lowering state. Two side tables
// hang off it: a span-keyed LOCAL TYPE TABLE and a span-keyed BINDING TABLE.
// Both are keyed by byte span rather than by name because a name in the NTIR
// has no identity beyond the span it was written on, and inventing a symbol
// table here would be a resolver this level does not own.
export struct Builder {
    out:buf<u64>, records:u64, values:u64, capacity:u64,
    parent:u64, depth:u64, c0:u64, c1:u64, c2:u64, c3:u64,
    block:u64, term:u64, func:u64, blocks:u64,
    loops:u64, pend_hits:u64, sp_jump:u64, sp_label:u64, fixed_jumps:u64,
    types:buf<u64>, type_count:u64,
    binds:buf<u64>, bind_count:u64,
    pend:buf<u64>, pend_count:u64, ops:buf<u64>,
    rev:buf<u64>, rev_count:u64,
    code:u64, line:u64, column:u64, node:u64,
    // W170 INSTRUMENT. WHICH ASSIGNMENT RAISED THE CODE, as a name and not as a
    // count. It is stamped in `refuse` -- the one place a refusal is raised --
    // and cleared at the top of every record, so a stamp can never outlive the
    // record that set it. It is deliberately NOT a counter: a counter is a
    // queue, and a queue reports the previous value as the current one, which
    // is how a peer lost two confident rule names to a stamp that survived the
    // record that set it.
    stamp:u64, stamp_line:u64,
    // THE FLAGS PREDICATE THIS BLOCK IS CURRENTLY UNDER. `cmp` and `test`
    // define it and a conditional jump consumes it, and it is cleared at every
    // block boundary because a target-independent level does not claim to know
    // whether a given machine carries flags across a branch.
    pred:u64, want_width:u64, want_signed:u64,
    // A6 (13 October 2026): the NTIR ids of the expression nodes the AST marks
    // as CALLS (kind 35, aux 1), validated by `lower_with_calls`. Empty for
    // `lower`, which keeps reading the call from its parenthesis only.
    calls:buf<u64>, call_count:u64, native_mode:bool
}
// start, end, width, signed, space, value. The value word is what turns this
// table from a type index into a DATA-FLOW ANSWER: it is the machine value a
// name currently holds, which the NTIR has no word for at all.
fn TYPE_WORDS()->u64 { return 7; }
fn BIND_WORDS()->u64 { return 5; }

fn refuse(b:Builder,code:u64,words:buf<u64>,count:u64,node:u64)->u64 {
    // A BUILDER THAT ALREADY REFUSED KEEPS ITS CODE, ITS STAMP AND ITS
    // POSITION. In the native profile the image can fill up while a function is
    // being emitted, and the emitter then walks on into the parameter, result
    // and clobber helpers, where a shape rule can fire and name a mistake that
    // was never made: the image was full, and that is E_HEADER. Overwriting it
    // with the second code sent the reader to a rule that did not decide
    // anything.
    //
    // The legacy profile is UNCHANGED: a builder that has not refused raises
    // the code of the rule that refused, with its own stamp and position.
    if b.native_mode && b.code!=0 { return b.code; }
    // W170 INSTRUMENT: the STAMP goes on the ASSIGNMENT that raises the code,
    // and `stamp` names this one site rather than counting it. A rule that
    // merely READS a field is not stamped, because a reader that stamped would
    // name whichever rule ran last rather than whichever rule decided.
    b.stamp=code;
    b.stamp_line=b.line;
    b.code=code;
    b.line=nline(words,node);
    b.column=ncolumn(words,node);
    b.node=node;
    return code;
}



// One record, zeroed, with exactly one of ntir_node and origin set. The
// STRIDE and the field offsets are this module's own, and the gate learns them
// from HEADER_WORDS and NODE_WORDS rather than writing them down twice.
fn emit(b:Builder,kind:u64,ntir_node:u64,origin:u64,words:buf<u64>)->u64 {
    if b.code!=0 { return 0; }
    if b.capacity<HEADER_WORDS() || b.records>=(b.capacity-HEADER_WORDS())/NODE_WORDS() { b.code=E_HEADER(); return 0; }
    b.records=b.records+1;
    // W170 INSTRUMENT: THE STAMP IS CLEARED PER RECORD, AND NOT HERE. The first
    // version of this instrument cleared the stamp at the top of `emit`, on the
    // argument that `emit` runs exactly once per record. That argument was
    // wrong and the instrument measured nothing: `emit` runs once per record
    // EMITTED, while a refusal is raised while a record is being FILLED IN, so
    // the next `emit` wiped the stamp of the record that had just refused and
    // every stamp came back 0. An instrument that reports 0 everywhere is
    // indistinguishable from an instrument that never ran, and this one was the
    // second. The clear belongs where a record stops, below.
    let mut at:u64=HEADER_WORDS()+(b.records-1)*NODE_WORDS();
    let mut o:buf<u64>=b.out;
    let mut i:u64=0;
    while i<NODE_WORDS() { o[at+i]=0; i=i+1; }
    o[at]=kind;
    o[at+1]=ntir_node;
    o[at+18]=origin;
    o[at+16]=b.parent;
    // THE ORDINAL IS THE INDEX OF THIS RECORD INSIDE ITS PARENT, which is what
    // field 17 says it is at the top of this file and what `need_block` says it
    // is two hundred lines below. It used to be the index inside the RUN of
    // records that happened to share a parent -- `records - parent_base`, with
    // `parent_base` reloaded whenever `b.parent` changed -- so a record that
    // was the first child of its parent was written as ordinal 1 even when
    // five siblings had already been filed under that same parent, and a
    // record that was the seventh child was written as 1 whenever the
    // preceding record belonged to somebody else. Both numbers are correct
    // answers to "which of the consecutive records that share this parent is
    // this one", and neither is the index.
    //
    // `c0..c3` ARE THE CHILDREN EMITTED SO FAR FOR THE NODE CURRENTLY OPEN AT
    // DEPTH 0..3`, so a record at depth d takes its ordinal from c(d-1) and
    // then BECOMES the node open at depth d, with no children yet, which is
    // what zeroes c(d). Depth is the format's own field 19 and this emitter
    // only ever writes 0, 1, 2 or 3, so four counters are the whole of it and
    // nothing is allocated per record.
    let mut ord:u64=0;
    if b.records!=1 {
        let mut seen:u64=b.c0;
        if b.depth==2 { seen=b.c1; }
        if b.depth==3 { seen=b.c2; }
        if b.depth>3 { seen=b.c3; }
        ord=seen+1;
        if b.depth==1 { b.c0=ord; b.c1=0; }
        if b.depth==2 { b.c1=ord; b.c2=0; }
        if b.depth==3 { b.c2=ord; b.c3=0; }
        if b.depth>3 { b.c3=ord; }
    }
    o[at+17]=ord;
    o[at+19]=b.depth;
    let mut claimed:u64=ntir_node;
    if claimed!=0 { o[at+2]=nline(words,claimed); o[at+3]=ncolumn(words,claimed); }
    else { o[at+2]=nline(words,origin); o[at+3]=ncolumn(words,origin); }
    return b.records;
}
fn wput(b:Builder,id:u64,field:u64,value:u64)->u64 {
    if id==0 || id>b.records { return 0; }
    let mut o:buf<u64>=b.out;
    o[HEADER_WORDS()+(id-1)*NODE_WORDS()+field]=value;
    return id;
}
fn get(b:Builder,id:u64,field:u64)->u64 {
    if id==0 || id>b.records { return 0; }
    let mut o:buf<u64>=b.out;
    return o[HEADER_WORDS()+(id-1)*NODE_WORDS()+field];
}
fn new_value(b:Builder)->u64 { b.values=b.values+1; return b.values; }
fn wget(b:Builder,id:u64,field:u64)->u64 { return get(b,id,field); }
fn at(id:u64)->u64 { return HEADER_WORDS()+(id-1)*NODE_WORDS(); }

// THE LOCAL TABLE IS KEYED BY THE NAME'S BYTES, not by its span. A
// declaration writes one span and every later use writes another, so a
// span-keyed table can only ever find the declaration and never a read — and
// the first read of every local then looks like a read of something that was
// never defined. A register spelling repeats its span and a local does not,
// which is exactly why the two need two tables.
fn same4(source:buf<u8>,a_start:u64,a_end:u64,b_start:u64,b_end:u64)->bool {
    if a_start>a_end || a_end>len(source) { return false; }
    if b_start>b_end || b_end>len(source) { return false; }
    if (a_end-a_start)!=(b_end-b_start) { return false; }
    let mut i:u64=0;
    while i<(a_end-a_start) {
        if source[a_start+i]!=source[b_start+i] { return false; }
        i=i+1;
    }
    return true;
}
// ---- the span-keyed local type table -------------------------------------
//
// The NTIR types a DECLARATION and not an EXPRESSION: a `let` node carries
// nothing, and the width lives on its type child. Choosing between a signed
// and an unsigned comparison, or between a sign-extending and a zero-extending
// conversion, is the first thing a machine level must do and the first thing
// the NTIR cannot answer. So the Machine IR builds the table and resolves
// through it: a name's span is the key, the declared type's NTIR width and
// signedness are the value, and an expression that needs a signedness it
// cannot find is REFUSED rather than guessed.
fn type_find(b:Builder,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut i:u64=0;
    while i<b.type_count {
        let mut at_t:u64=i*TYPE_WORDS();
        if same4(source,t[at_t],t[at_t+1],start,end)==true { return i+1; }
        i=i+1;
    }
    return 0;
}
fn type_put(b:Builder,source:buf<u8>,start:u64,end:u64,width:u64,signed:u64,space:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut slot:u64=type_find(b,source,start,end);
    if slot==0 {
        b.type_count=b.type_count+1;
        let mut at_t:u64=(b.type_count-1)*TYPE_WORDS();
        t[at_t]=start;t[at_t+1]=end;
        t[at_t+2]=width;t[at_t+3]=signed;t[at_t+4]=space;t[at_t+5]=0;
        return b.type_count;
    }
    let mut at_t:u64=(slot-1)*TYPE_WORDS();
    if width!=0 { t[at_t+2]=width; }
    if signed!=2 { t[at_t+3]=signed; }
    if space!=0 { t[at_t+4]=space; }
    return slot;
}
// The machine value a local currently holds, 0 when the local has none. A
// read that finds 0 is a read of something that was never defined, and the
// caller refuses it rather than inventing an operand.
fn type_value(b:Builder,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut slot:u64=type_find(b,source,start,end);
    if slot==0 { return 0; }
    return t[(slot-1)*TYPE_WORDS()+5];
}
fn type_define(b:Builder,source:buf<u8>,start:u64,end:u64,value:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut slot:u64=type_find(b,source,start,end);
    if slot==0 { return 0; }
    t[(slot-1)*TYPE_WORDS()+5]=value;
    return slot;
}
fn type_width(b:Builder,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut slot:u64=type_find(b,source,start,end);
    if slot==0 { return 0; }
    return t[(slot-1)*TYPE_WORDS()+2];
}
fn type_signed(b:Builder,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut slot:u64=type_find(b,source,start,end);
    if slot==0 { return 2; }
    return t[(slot-1)*TYPE_WORDS()+3];
}
fn type_space(b:Builder,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.types;
    let mut slot:u64=type_find(b,source,start,end);
    if slot==0 { return 0; }
    return t[(slot-1)*TYPE_WORDS()+4];
}

// The declared type of a name, read off the TYPE node the NTIR typed. This is
// the one place the local table is filled: a `let` and a `parameter` each
// carry a type child, and ntir put that type's width, signedness and space in
// the child's own typed words.
fn declare_name(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,name_node:u64,type_node:u64)->u64 {
    if name_node==0 || name_node>count { return 0; }
    let mut width:u64=0;
    let mut sign:u64=2;
    let mut space:u64=0;
    if type_node!=0 && type_node<=count {
        width=nwidth(words,type_node);
        sign=nsigned(words,type_node);
        space=nspace(words,type_node);
    }
    type_put(b,source,nstart(words,name_node),nend(words,name_node),width,sign,space);
    return 1;
}

// ---- the binding table ----------------------------------------------------
//
// Legacy bind records retain declaration/provenance attribution and widths.
// Their arg_a is lowering metadata, not the runtime physical state. MIR/1.0
// register_read always creates a distinct cell access instead of consulting
// this table for the value a register currently holds.
fn bind_find(b:Builder,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.binds;
    let mut i:u64=0;
    while i<b.bind_count {
        let mut at_b:u64=i*BIND_WORDS();
        if same4(source,t[at_b],t[at_b+1],start,end)==true { return i+1; }
        i=i+1;
    }
    return 0;
}
// The cell of a binding, created on first use. A register the source bound and
// never wrote is an INPUT, so the first use of a spelling emits a `mir_vreg`
// whose storage class is 2 — a machine value the target must supply — and then
// a `mir_bind` holding it. The cell is the answer from then on, and the whole
// of what the source said about the binding that survives into this record is
// `aux`, its width.
// THE CELL. `bind_slot` is the only way a binding is reached, and it NEVER
// returns zero: a spelling with no cell gets one, empty, and the caller
// decides whether an empty cell is a definition or an input. Splitting the
// two is what makes a register read before any write an INPUT rather than a
// zero, and it is why the table holds a record id instead of a value.
fn bind_slot(b:Builder,words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    let mut slot:u64=bind_find(b,source,start,end);
    if slot!=0 {
        let mut found:u64=b.binds[(slot-1)*BIND_WORDS()+4];
        if found!=0 { return found; }
    }
    b.bind_count=b.bind_count+1;
    let mut at_b:u64=(b.bind_count-1)*BIND_WORDS();
    let mut t:buf<u64>=b.binds;
    t[at_b]=start;t[at_b+1]=end;
    let mut record:u64=emit(b,k_bind(),0,id,words);
    let mut width:u64=name_width(words,source,count,id);
    wput(b,record,9,width);
    wput(b,record,10,0);
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,14,width);
    t[at_b+2]=0;t[at_b+3]=width;t[at_b+4]=record;
    return record;
}
// The cell of a binding, defined on first use. A register the source bound and
// never wrote is an INPUT, so the first use of a spelling emits a `mir_vreg`
// whose storage class is 2 — a machine value the target must supply — and
// points the cell at it. The cell is the answer from then on, and the whole of
// what the source said about the binding that survives into this record is
// `aux`, its width.
fn bind_cell(b:Builder,words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    let mut record:u64=bind_slot(b,words,source,count,id);
    if get(b,record,5)!=0 { return record; }
    let mut fresh:u64=new_value(b);
    let mut input:u64=emit(b,k_vreg(),0,id,words);
    wput(b,input,4,fresh);
    wput(b,input,9,name_width(words,source,count,id));
    wput(b,input,10,0);
    wput(b,input,12,CLASS_VALUE());
    wput(b,input,13,FLAG_PURE());
    wput(b,input,14,2);
    wput(b,record,5,fresh);
    wput(b,record,8,1);
    return record;
}
fn bind_write(b:Builder,words:buf<u64>,source:buf<u8>,count:u64,id:u64,value:u64)->u64 {
    let mut record:u64=bind_slot(b,words,source,count,id);
    wput(b,record,5,value);
    wput(b,record,8,1);
    let mut width:u64=name_width(words,source,count,id);
    wput(b,record,9,width);
    wput(b,record,10,0);
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,14,width);
    return record;
}

// ---- the symbol table -----------------------------------------------------
//
// A qualified name in the NTIR is a spelling with no owner. The Machine IR
// resolves each one it consumes into a symbol record with a digest, so two
// spellings that differ cannot be confused and two that agree cannot be
// distinguished by accident.
fn fnv(bytes:buf<u8>,from:u64,to:u64)->u64 {
    if from>to || to>len(bytes) { return 0; }
    let mut h:u64=14695981039346656037;
    let mut i:u64=from;
    while i<to {
        h=h^(bytes[i]);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
fn symbol_of(b:Builder,source:buf<u8>,words:buf<u64>,count:u64,id:u64)->u64 {
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    if start>end || end>len(source) { return 0; }
    let mut o:buf<u64>=b.out;
    let mut i:u64=1;
    while i<=b.records {
        if o[at(i)]==k_symbol() && o[at(i)+5]==start && o[at(i)+6]==end { return i; }
        i=i+1;
    }
    let mut record:u64=emit(b,k_symbol(),0,id,words);
    wput(b,record,5,start);
    wput(b,record,6,end);
    wput(b,record,8,2);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,14,fnv(source,start,end));
    wput(b,record,15,end-start);
    // The qualifier depth: how many dotted segments the spelling carries. It
    // is a property of the SYMBOL, not of the text of this occurrence, and it
    // is what tells a module-qualified callee from a local one.
    let mut depth:u64=0;
    let mut at_s:u64=start;
    while at_s<end {
        if source[at_s]==46 { depth=depth+1; }
        at_s=at_s+1;
    }
    wput(b,record,13,depth);
    return record;
}

// ---- MIR/0.3 declaration facts, read off the NTIR and its spans ---------
//
// `export` IS IN THE GAP BEFORE THE DECLARATION, and only there. parser.nova's
// `section_decl` and the top-level loop both step over the keyword and then
// open the `fn` or `data` node at the NEXT token, with no `lines` between the
// two, so the keyword sits on the same line as the node's first byte,
// separated by blanks and nothing else. That is the same kind of read as
// `binary_op`'s operator gap: bytes the NTIR's own spans bracket, not a
// re-scan. A keyword on an earlier line, or inside a comment ending that line,
// is not this declaration's and is not seen, because the walk stops at the
// first byte that is not a space or a tab.
fn exported_before(source:buf<u8>,start:u64)->bool {
    if start>len(source) { return false; }
    let mut at_g:u64=start;
    while at_g>0 && (source[at_g-1]==32 || source[at_g-1]==9) { at_g=at_g-1; }
    if at_g<6 { return false; }
    if source[at_g-6]!=101 || source[at_g-5]!=120 || source[at_g-4]!=112 { return false; }
    if source[at_g-3]!=111 || source[at_g-2]!=114 || source[at_g-1]!=116 { return false; }
    if at_g==6 { return true; }
    let mut before:u64=at_g-7;
    if source[before]==32 || source[before]==9 || source[before]==10 || source[before]==13 { return true; }
    return source[before]==123 || source[before]==125 || source[before]==59;
}
// THE FEATURE VOCABULARY, and it is a SECOND READING on purpose. features.nova
// owns the table (`lookup`: lm 1, msr 2, syscall 4, sse2 8, tsc 16) and the C
// frontend owns the oracle (frontend.c, m->features starts at 1 and ORs one
// bit per name). This module cannot import features.nova without adding it to
// every bundle that compiles machine_ir -- eighteen C gates, most of which do
// not carry it -- so the five spellings are written here once more, and the
// production gate compares the mask this module publishes with the one
// features.check computes on the same tree. The two are meant to be able to
// disagree, and a disagreement is a red, not a repair.
fn feature_bit(source:buf<u8>,start:u64,end:u64)->u64 {
    if start>end || end>len(source) { return 0; }
    let n:u64=end-start;
    if n==2 && source[start]==108 && source[start+1]==109 { return 1; }
    if n==3 && source[start]==109 && source[start+1]==115 && source[start+2]==114 { return 2; }
    if n==7 && source[start]==115 && source[start+1]==121 && source[start+2]==115
       && source[start+3]==99 && source[start+4]==97 && source[start+5]==108
       && source[start+6]==108 { return 4; }
    if n==4 && source[start]==115 && source[start+1]==115 && source[start+2]==101
       && source[start+3]==50 { return 8; }
    if n==3 && source[start]==116 && source[start+1]==115 && source[start+2]==99 { return 16; }
    return 0;
}
// The module's feature mask: 1 (`lm`) whether or not a `features` block is
// written, ORed with one bit per entry, which is frontend.c's own rule. The
// NTIR keeps the parser's two-level shape -- the `features` wrapper, the set
// under it, one qualified name per entry -- and an entry this table does not
// know is refused rather than dropped, because a mask that silently lost a
// name would be a smaller contract than the one the source wrote.
fn features_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,mask:u64)->u64 {
    let mut set:u64=nfirst(words,id);
    let mut result:u64=mask;
    while set!=0 && set<=count && b.code==0 {
        let mut entry:u64=set;
        if nindex(words,set)==8 { entry=nfirst(words,set); }
        while entry!=0 && entry<=count && b.code==0 {
            let mut name:u64=entry;
            if nindex(words,entry)==48 { name=nfirst(words,entry); }
            if name==0 || name>count { refuse(b,E_INPUT(),words,count,entry); }
            else {
                let bit:u64=feature_bit(source,nstart(words,name),nend(words,name));
                if bit==0 { refuse(b,E_INPUT(),words,count,name); }
                result=result|bit;
            }
            if nindex(words,set)==8 { entry=nnext(words,entry); } else { entry=0; }
        }
        set=nnext(words,set);
    }
    return result;
}
// The section a declaration is written in, from the section's own name child
// (`section_name`, index 50, whose one child is the name after the dot):
// 1 `.text`, 2 `.rdata`, 3 `.data`, 0 anything else. The numbers are the NXO
// section ids, which is what a consumer will turn them into.
fn section_code(words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    let mut dotted:u64=nfirst(words,id);
    if dotted==0 || dotted>count || nindex(words,dotted)!=50 { return 0; }
    let mut name:u64=nfirst(words,dotted);
    if name==0 || name>count { return 0; }
    let start:u64=nstart(words,name);
    let end:u64=nend(words,name);
    if start>end || end>len(source) { return 0; }
    let n:u64=end-start;
    if n==4 && source[start]==116 && source[start+1]==101 && source[start+2]==120 && source[start+3]==116 { return 1; }
    if n==5 && source[start]==114 && source[start+1]==100 && source[start+2]==97
       && source[start+3]==116 && source[start+4]==97 { return 2; }
    if n==4 && source[start]==100 && source[start+1]==97 && source[start+2]==116 && source[start+3]==97 { return 3; }
    return 0;
}

// ---- operator recovery ----------------------------------------------------
//
// THE NTIR DROPS THE OPERATOR, and that is a measured fact, not a complaint.
// ntir.nova:63-72 copies the AST kind and the AST id and nothing else from the
// twelve-word record; the AST's aux word — which is where parser.nova:256 puts
// the operator token — is not among the words NTIR carries. An expression node
// therefore arrives with its children and its span and with no opcode, and a
// Machine IR cannot select an opcode without one.
//
// What it CAN do is notice that the operator is the only thing between its two
// children: the spans the NTIR itself recorded bracket it. `binary_op` reads
// the bytes in that gap, and the gap is derived from the NTIR, not guessed.
// The gate recomputes the same gap in C and requires the same opcode, so a
// wrong recovery is a measured difference and not a shared assumption.
fn gap_text(source:buf<u8>,from:u64,to:u64)->u64 {
    // The operator gap, whitespace stripped, returned as a small code so the
    // comparison costs no allocation and no buffer.
    let mut i:u64=from;
    while i<to && (source[i]==32 || source[i]==9) { i=i+1; }
    let mut j:u64=to;
    while j>i && (source[j-1]==32 || source[j-1]==9) { j=j-1; }
    let mut n:u64=j-i;
    if n==0 { return 0; }
    if n==1 {
        let mut c:u64=source[i];
        if c==43 { return 1; }   // +
        if c==45 { return 2; }   // -
        if c==42 { return 3; }   // *
        if c==47 { return 4; }   // /
        if c==37 { return 5; }   // %
        if c==60 { return 6; }   // <
        if c==62 { return 7; }   // >
        if c==38 { return 8; }   // &
        if c==124 { return 9; }  // |
        if c==94 { return 10; }  // ^
        if c==126 { return 11; } // ~
        if c==33 { return 12; }  // !
        if c==61 { return 21; }  // = assignment
        return 0;
    }
    if n==2 {
        let mut a:u64=source[i];
        let mut c:u64=source[i+1];
        if a==61 && c==61 { return 13; }  // ==
        if a==33 && c==61 { return 14; }  // !=
        if a==60 && c==61 { return 15; }  // <=
        if a==62 && c==61 { return 16; }  // >=
        if a==60 && c==60 { return 17; }  // <<
        if a==62 && c==62 { return 18; }  // >>
        if a==38 && c==38 { return 19; }  // &&
        if a==124 && c==124 { return 20; } // ||
        return 0;
    }
    return 0;
}
// The operator of a binary expression node, 0 when the node is not one.
fn binary_op(source:buf<u8>,words:buf<u64>,count:u64,id:u64)->u64 {
    let mut first:u64=nfirst(words,id);
    if first==0 { return 0; }
    let mut second:u64=nnext(words,first);
    if second==0 || second>count { return 0; }
    let mut third:u64=nnext(words,second);
    if third!=0 { return 0; }
    let mut from:u64=nend(words,first);
    let mut to:u64=nstart(words,second);
    if to<from || to>len(source) { return 0; }
    return gap_text(source,from,to);
}
// The prefix operator of a unary expression node, 0 when the node is not one.
// A parenthesised expression also has a single child that starts after the
// node does, so the two are told apart by the gap: `(` is not an operator and
// this returns 0, and the caller then treats the node as a grouping.
fn unary_op(source:buf<u8>,words:buf<u64>,count:u64,id:u64)->u64 {
    let mut first:u64=nfirst(words,id);
    if first==0 || first>count { return 0; }
    if nnext(words,first)!=0 { return 0; }
    let mut from:u64=nstart(words,id);
    let mut to:u64=nstart(words,first);
    if to<=from || to>len(source) { return 0; }
    let mut code:u64=gap_text(source,from,to);
    if code==2 || code==11 || code==12 { return code; }
    return 0;
}
// Signedness comes from the lowered left value, including literals and grouped expressions.
fn signed_op(b:Builder,words:buf<u64>,count:u64,id:u64,sign:u64,
             unsigned_opcode:u64,signed_opcode:u64)->u64 {
    if sign==1 { return signed_opcode; }
    if sign==0 { return unsigned_opcode; }
    return refuse(b,E_INPUT(),words,count,id);
}
// The opcode a recovered operator code means, with the sign-sensitive
// comparisons resolved. 0 when the code names no opcode here.
fn opcode_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,code:u64,operand_signed:u64)->u64 {
    if code==1 { return OP_ADD(); }
    if code==2 { return OP_SUB(); }
    if code==3 { return OP_MUL(); }
    if code==4 { return OP_DIV(); }
    if code==5 { return OP_REM(); }
    if code==6 { return signed_op(b,words,count,id,operand_signed,OP_LT_U(),OP_LT_S()); }
    if code==7 { return signed_op(b,words,count,id,operand_signed,OP_GT_U(),OP_GT_S()); }
    if code==8 { return OP_AND(); }
    if code==9 { return OP_OR(); }
    if code==10 { return OP_XOR(); }
    if code==11 { return OP_NOT(); }
    if code==12 { return OP_LNOT(); }
    if code==13 { return OP_EQ(); }
    if code==14 { return OP_NE(); }
    if code==15 { return signed_op(b,words,count,id,operand_signed,OP_LE_U(),OP_LE_S()); }
    if code==16 { return signed_op(b,words,count,id,operand_signed,OP_GE_U(),OP_GE_S()); }
    if code==17 { return OP_SHL(); }
    if code==18 { return signed_op(b,words,count,id,operand_signed,OP_SHR(),OP_SAR()); }
    if code==19 { return OP_LNOT(); }
    if code==20 { return OP_LNOT(); }
    if code==21 { return OP_COPY(); }
    return 0;
}

// ---- an integer magnitude, read through a span the NTIR recorded ---------
//
// THE ONE THING THIS LEVEL READS FROM THE SOURCE TEXT. ntir.nova:552-555 says
// out loud that it will not read the value of an integer token, because a
// width it cannot derive from a declared type is not a width it may invent. A
// Machine IR cannot avoid the value: an immediate is the immediate, and a
// comparison against a constant is a comparison against a number. So this
// reads the digits inside the span the NTIR recorded, and answers 0 for
// anything that is not a decimal or 0x integer — and 0 is refused, so a
// literal this could not read stops the lowering rather than becoming a zero.
// It never scans for a token; it walks a range the NTIR already delimited.
// THE DIGIT WALK, WITH THE TWO BOUNDS NAMED. `bound` is the largest
// ACCUMULATOR this read may reach and `ceiling` is the largest SUCCESSOR it
// may publish; they are two different questions and the pin arm needs them
// to disagree.
//
// WHY THEY ARE SEPARATE, and it is the whole of what a u64 maximum is. The
// successor is reserved so that a literal `0` reads back as `1` and stays
// distinct from a span this level could not read at all -- so every answer is
// `value+1`, and `value+1` does not exist once `value` IS the maximum. An
// encoding that both reserves a value and reaches the maximum needs one more
// code than a u64 has, so the successor-reserving reader (`read_magnitude`
// below) refuses the maximum at `bound` and `read_magnitude` returns 0 for
// it. That refusal is CORRECT for every caller whose answer is a number in
// the machine: `literal()` publishes `magnitude-1` as the immediate, so a
// saturated successor would publish the maximum's PREDECESSOR for the literal
// that wrote the maximum, silently. Refusing is the honest answer there.
//
// The pin arm is not that caller. Its minor is two decimal digits wide by
// construction -- the pin is `(major+1)*100+(minor+1)` and `tests_ntasm_machine_ir.c`
// writes the decode down as `pin/100 - 1` -- so a minor above 98 does not fit
// the field whatever this function answers, and the only question left is
// whether it WRAPS into the major's own digits or SATURATES at the top of
// the field. It wraps today: the successor of 18446744073709551615 is 0, the
// pin comes out at 100, and 100/100-1 names a major the source never wrote
// while reading as a version at all. So the pin arm reads through
// `bound = the maximum` with a `ceiling`, and a minor that does not fit
// publishes `ceiling`: the field's top, which is the largest minor this pin
// can carry and is not the successor of any smaller minor's reserved slot.
fn read_span(source:buf<u8>,start:u64,end:u64,bound:u64,ceiling:u64)->u64 {
    if start>=end || end>len(source) { return 0; }
    let mut i:u64=start;
    let mut base:u64=10;
    if end-start>1 && source[start]==48 && (source[start+1]==120 || source[start+1]==88) {
        base=16;
        i=start+2;
    }
    let mut value:u64=0;
    let mut digits:u64=0;
    while i<end {
        let mut c:u64=source[i];
        if c==95 { i=i+1; continue; }
        let mut part:u64=0;
        if base==10 {
            if c<48 || c>57 { return 0; }
            part=c-48;
        } else {
            if c>=48 && c<=57 { part=c-48; }
            else if c>=97 && c<=102 { part=c-97+10; }
            else if c>=65 && c<=70 { part=c-65+10; }
            else { return 0; }
        }
        if value>(bound-part)/base { return 0; }
        value=value*base+part;
        digits=digits+1;
        i=i+1;
    }
    if digits==0 { return 0; }
    if value>=ceiling { return ceiling; }
    return value+1;
}
// THE SUCCESSOR-RESERVING READER, and it is the four machine-facing callers
// that fix its two bounds: `bound` is the maximum minus one so the maximum
// refuses here rather than answering with the sentinel, and `ceiling` is the
// maximum so no answer can ever be clamped.
//
// THE DEFECT THAT BOUND CLOSES is a wrap, not a policy. Guarded against the
// maximum itself, the accumulator reaches 18446744073709551615 for the
// literal 18446744073709551615 and `value+1` wraps to EXACTLY 0 -- the
// sentinel every caller reads as "this span holds no magnitude". So the one
// literal this function could least afford to confuse with an absent one was
// the one it answered with the absent answer, SILENTLY, and 1844...614 one
// row away came back as the maximum instead. One number carrying two
// meanings is the defect; this bound makes the maximum refuse the same way
// any other unreadable span refuses, so 0 carries exactly one meaning again:
// no magnitude was produced.
//
// The four callers of the magnitude this publishes are `literal()`
// (E_INPUT), `memory_value`'s scale arm (E_SCALE), its displacement arm
// (E_INPUT) and `align_of` (E_INPUT). Refusing is what 0 already meant to all
// of them, and it is still what it means: the pin arm no longer reads the
// successor, it reads `read_span` above with the bounds its own field needs.
fn read_magnitude(source:buf<u8>,start:u64,end:u64)->u64 {
    return read_span(source,start,end,18446744073709551614,18446744073709551615);
}
// THE LITERAL READER, which reaches the maximum because it reserves nothing:
// the same digit walk as `read_span` (decimal, 0x hexadecimal, `_` separators,
// overflow refused), with `ok` carrying what the reserved 0 carries there.
struct Magnitude { ok:bool, value:u64 }
fn read_literal_value(source:buf<u8>,start:u64,end:u64)->Magnitude {
    if start>=end || end>len(source) { return Magnitude{ok:false,value:0}; }
    let mut i:u64=start;
    let mut base:u64=10;
    if end-start>1 && source[start]==48 && (source[start+1]==120 || source[start+1]==88) {
        base=16;
        i=start+2;
    }
    let mut value:u64=0;
    let mut digits:u64=0;
    while i<end {
        let mut c:u64=source[i];
        if c==95 { i=i+1; continue; }
        let mut part:u64=0;
        if base==10 {
            if c<48 || c>57 { return Magnitude{ok:false,value:0}; }
            part=c-48;
        } else {
            if c>=48 && c<=57 { part=c-48; }
            else if c>=97 && c<=102 { part=c-97+10; }
            else if c>=65 && c<=70 { part=c-65+10; }
            else { return Magnitude{ok:false,value:0}; }
        }
        if value>(18446744073709551615-part)/base { return Magnitude{ok:false,value:0}; }
        value=value*base+part;
        digits=digits+1;
        i=i+1;
    }
    if digits==0 { return Magnitude{ok:false,value:0}; }
    return Magnitude{ok:true,value:value};
}

// ---- values ---------------------------------------------------------------
struct Value { id:u64, width:u64, signed:u64, space:u64, class:u64 }
fn no_value()->Value {
    return Value{id:0,width:0,signed:2,space:0,class:CLASS_NONE()};
}
fn fail_value()->Value {
    return Value{id:0,width:0,signed:2,space:0,class:CLASS_NONE()};
}
fn EXPR_DEPTH_CAP()->u64 { return 64; }
fn expr(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->Value {
    if b.code!=0 { return fail_value(); }
    if depth>EXPR_DEPTH_CAP() { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
    if id==0 || id>count { refuse(b,E_LINK(),words,count,id); return fail_value(); }
    let mut index:u64=nindex(words,id);
    if index==51 { return literal(b,words,count,source,id); }
    if index==36 { return expression(b,words,count,source,id,depth); }
    if index==47 { return name_value(b,words,count,source,id); }
    // A QUALIFIED NAME in operand position is how the parser spells a bare
    // operand: primary() wraps every NAME in an expression node and a
    // module-qualified one in a qualified node inside that
    // (parser.nova:218-229), so the name to resolve is the qualified head.
    //
    // A PARENTHESIS AFTER THAT NAME MAKES IT A CALL, and this level could not
    // see one until now. The parser marks the difference with the AST's own
    // `aux` word -- `aux(p,result,1)` for the call spelling and no `aux` for the
    // bare one (parser.nova:270-276) -- and the NTIR does not carry it: the
    // twelve-word record holds the AST kind and the AST id and nothing else
    // (ntir.nova:6-7), so the marker is gone before this level is handed the
    // image. The SPAN THE NTIR DID RECORD brackets the parenthesis exactly as
    // it brackets the operator `binary_op` recovers one level down, so the
    // spelling is read from the source at the name's own end and this is the
    // same derivation at one level down rather than a second convention.
    //
    // THE ORDER OF THE TWO ARMS IS THE WHOLE OF IT. The parenthesis is tested
    // FIRST, so a name that is written with one is never read as a bare
    // operand, and `f()` where `f` is a local is a call to something that is
    // not callable rather than a silent read of `f`.
    if index==48 {
        let mut head:u64=nfirst(words,id);
        if head==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
        if call_spelled(source,words,count,id)==true {
            return call_value(b,words,count,source,id,head,0,depth);
        }
        return name_value(b,words,count,source,head);
    }
    refuse(b,E_INPUT(),words,count,id);
    return fail_value();
}
// A literal is MATERIALIZED here, which the NTIR explicitly does not do. An
// integer becomes a `mir_const` whose `in_a` is the magnitude and whose
// `aux2` is the smallest machine width that holds it — a fact about the
// NUMBER, not about the declaration it will be assigned to. A string becomes a
// `mir_string` carrying a digest of its bytes.
fn literal(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->Value {
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    if start>end || end>len(source) { refuse(b,E_LINK(),words,count,id); return fail_value(); }
    if end-start>=2 && source[start]==34 {
        let mut record:u64=emit(b,k_string(),0,id,words);
        let mut value:u64=new_value(b);
        wput(b,record,4,value);
        wput(b,record,5,start+1);
        wput(b,record,6,end-start);
        wput(b,record,8,1);
        wput(b,record,9,8);
        wput(b,record,10,0);
        wput(b,record,12,CLASS_CONSTANT());
        wput(b,record,13,FLAG_PURE());
        wput(b,record,14,fnv(source,start,end));
        return Value{id:value,width:8,signed:0,space:0,class:CLASS_CONSTANT()};
    }
    // A LITERAL IS READ WITHOUT THE SUCCESSOR ENCODING. `read_magnitude`
    // reserves 0 for "no magnitude" and so cannot publish the u64 maximum; the
    // reference C accepts `return 18446744073709551615` (returnmax), and the
    // immediate this record publishes is the number itself, so the success of
    // the read travels in its own word instead of in a reserved value.
    let mut read:Magnitude=read_literal_value(source,start,end);
    if read.ok==false { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
    let mut amount:u64=read.value;
    let mut width:u64=8;
    if amount>255 { width=16; }
    if amount>65535 { width=32; }
    if amount>4294967295 { width=64; }
    let mut record:u64=emit(b,k_const(),id,0,words);
    let mut value:u64=new_value(b);
    wput(b,record,4,value);
    wput(b,record,5,amount);
    wput(b,record,8,1);
    wput(b,record,9,width);
    wput(b,record,10,0);
    wput(b,record,12,CLASS_CONSTANT());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,15,width);
    return Value{id:value,width:width,signed:0,space:0,class:CLASS_CONSTANT()};
}
// THE TWO BOOLEAN LITERALS, AND WHERE THE TRUTH ABOUT THEM LIVES.  The answer
// is: NTASM-level, keyed on a RESERVED NAME, with the token space FROZEN.  Four
// separate arguments, each of them a measurement on this tree rather than a
// preference.
//
// 1. THE ORACLE PUTS IT AT THE PARSER AND DOES NOT MAKE IT A TOKEN.
//    `compiler/c/ntasm/frontend/frontend.c:1012-1017` classifies the two spellings
//    inside `parse_primary`, AFTER the lexer has already handed back a TK_NAME,
//    and writes `x->kind = NTF_X_BOOL`.  Its token enum (frontend.c:14-30) is
//    EOF..SHR plus TK_LAND and TK_LOR and has no boolean member.  The reference
//    compiler, which every parity gate in this suite confronts the product
//    with, therefore never produces a boolean token -- so a token here would be
//    a token the oracle cannot emit.
//
// 2. THE PRODUCT'S OWN KEYWORD TABLE ALREADY RESERVES THEM.
//    `parser.nova:73` carries one flat NUL-separated table whose seventy-first
//    and seventy-second entries are `true` and `false`.  Nothing has ever read
//    those two indices.  The reserved set is already written down; what was
//    missing is anyone consulting it.
//
// 3. THE PARSER'S NODE SHAPE IS ALREADY THE CANONICAL ONE, and it is matched
//    BY SPELLING in four shipped modules: `initializer_types.nova:364`
//    (`bool_status` proves `true`/`false` a bool by comparing the kind 35
//    expression span against the word), `macro_expand.nova:2321-2333`
//    (`boolean_word`, which documents this exact shape in prose),
//    `stub_table.nova:444-446`, and `x64_lower_nxo.nova:3740,4203,4443`.  A new
//    token would leave all four matching nothing, which is the "a token nobody
//    switches on is a name with a number" failure: real numbers, zero readers.
//
// 4. THE COST OF THE TOKEN, STATED, BECAUSE THE DECISION IS A CONTRACT.  A
//    boolean kind would be 268, and `lexer-contract.md:11` freezes the named
//    kinds at EOF 256..SHR 267 -- while `parser.nova:233-234` ALREADY spends
//    268 and 269 on `&&` and `||`, so 268 is not even free.  Every consumer of
//    the frozen space would have to learn it: `decls`, `machine_x64`,
//    `nova_language_lex`, `a5_inventory`, `artifact_ownership`, `corpus_e2e`.
//    None of them has a boolean to switch on.  The token space is frozen for
//    parity with the oracle, and this is the place that says why.
//
// THE ANSWER 1 IS A WORD AND 2 IS THE OTHER, which is `macro_expand.nova:2330`
// numbering, not one invented here: `true` is 1 and `false` is 2, so the value
// of the word is `2-which` (it read `which-1`, which inverted both literals;
// see `boolean_value`).  A caller that reads 0 has a name that is neither.
fn boolean_word(source:buf<u8>,start:u64,end:u64)->u64 {
    let true_word:buf<u8>="true";
    if span_is_owned(source,start,end,true_word) { return 1; }
    let false_word:buf<u8>="false";
    if span_is_owned(source,start,end,false_word) { return 2; }
    return 0;
}
// A boolean literal is MATERIALIZED exactly as an integer literal is, and for
// the same reason: the NTIR deliberately does not read a literal's value
// (see the comment on `literal`), so the value is minted here or nowhere.
// The width is 1 and not 8 because that is what `bool` IS: `ntir.scalar_of`
// (ntir.nova:251) answers width 1 for the spelling, and a value whose width
// disagrees with its type's is the disagreement `name_width` refuses.
fn boolean_value(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,which:u64)->Value {
    let mut record:u64=emit(b,k_const(),id,0,words);
    let mut value:u64=new_value(b);
    wput(b,record,4,value);
    // THE LITERAL IS 1 FOR `true` AND 0 FOR `false`. `boolean_word` answers
    // 1 for `true` and 2 for `false`, and this line used to write `which-1`,
    // which published `true` as 0 and `false` as 1. Measured on 6 October
    // 2026 by EXECUTION, not by reading: branching-entry.ntasm (`if true
    // { return 42 } else { return 43 }`) returned 43 through the Machine IR
    // emitter and 42 through the C reference, because the emitter honoured
    // the 0 it was given. No gate before it executed a branch on a literal.
    wput(b,record,5,2-which);
    wput(b,record,8,1);
    wput(b,record,9,1);
    wput(b,record,10,0);
    wput(b,record,12,CLASS_CONSTANT());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,15,1);
    // THE CLASS IS VALUE, NOT CONSTANT, and the reason is the SHAPE rather than
    // the spelling. An INTEGER literal is AST kind 94, so `expr` hands it to
    // `literal` directly and its CLASS_CONSTANT lands on the k_const record and
    // stops there. A boolean literal is spelled as a NAME -- that is the shape
    // `initializer_types.bool_status` (initializer_types.nova:364),
    // `macro_expand.boolean_word` (macro_expand.nova:2321),
    // `stub_table.nova:444` and `x64_lower_nxo.nova:3740` already match on --
    // so `expr` reaches it through `expression`, whose one-child arm emits a
    // k_copy that COPIES the inner class (this file, the `second==0` arm).
    // `class_admissible` grants CLASS_CONSTANT to k_const, k_string and k_data
    // and to nothing else, so a copied constant is refused 938 and `if true`
    // never reaches its branch.
    //
    // MEASURED, and the measurement is the reason this line exists. With
    // CLASS_CONSTANT here, `if true` answered 938 at the `if` node while
    // `if <bool parameter>` answered 0 on the same program shape; with
    // CLASS_VALUE it answers 0, and `if <bool local>`, `if <bool parameter>`
    // and `if <boolean literal>` all lower identically.
    //
    // CLASS_VALUE is what a bool of every other origin already carries here: a
    // bool parameter answers it from the binding table and a bool local answers
    // it from `type_value`. Nothing is lost -- the record is still a k_const and
    // still constant, so the folding is intact and only the CLASS travels.
    return Value{id:value,width:1,signed:0,space:0,class:CLASS_VALUE()};
}
// Register names become execution-site reads; other names use the local
// declaration table. Missing local definitions remain E_VALUE, never zero.
// MIR/1.0: an access is a runtime cell read, never a lowering-order alias.
// Family identity comes from the authoritative register catalogue.
fn cell_family(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    return register_family(words,source,count,id);
}
fn cell_offset(words:buf<u64>,source:buf<u8>,id:u64)->u64 {
    let start:u64=nstart(words,id); let end:u64=nend(words,id);
    if end==start+2 && source[start+1]==104 { return 8; }
    return 0;
}
fn register_read(b:Builder,words:buf<u64>,source:buf<u8>,count:u64,id:u64)->Value {
    let family:u64=cell_family(words,source,count,id);
    if family==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
    let r:u64=emit(b,k_vreg(),0,id,words); let v:u64=new_value(b);
    let width:u64=name_width(words,source,count,id);
    wput(b,r,4,v); wput(b,r,9,width); wput(b,r,10,0);
    wput(b,r,12,CLASS_VALUE()); wput(b,r,13,FLAG_PURE()); wput(b,r,14,2);
    wput(b,r,20,family); wput(b,r,21,cell_offset(words,source,id)); wput(b,r,22,1);
    return Value{id:v,width:width,signed:0,space:0,class:CLASS_VALUE()};
}
fn flags_writer(op:u64)->bool {
    return op==OP_ADD() || op==OP_SUB() || op==OP_MUL() || op==OP_UMUL() || op==OP_AND()
        || op==OP_OR() || op==OP_XOR() || op==OP_SHL() || op==OP_SHR()
        || op==OP_SAR() || op==OP_NEG() || op==OP_CMP() || op==OP_TEST();
}
// Effects are declaration facts. No body inference and no text parse here.
fn call_mask(words:buf<u64>,count:u64,source:buf<u8>,callee:u64)->u64 {
    let mut child:u64=nfirst(words,callee); let mut mask:u64=0;
    while child!=0 {
        if nindex(words,child)==21 {
            let mut item:u64=nfirst(words,child);
            while item!=0 {
                let head:u64=nfirst(words,item);
                if head!=0 { mask=mask|register_widths.clobber_bit(source,nstart(words,head),nend(words,head)); }
                item=nnext(words,item);
            }
        }
        child=nnext(words,child);
    }
    let result:u64=declared_result(words,count,callee);
    if result!=0 && nwidth(words,result)!=0 { mask=mask|1; }
    return mask;
}

fn name_value(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->Value {
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    if start>end || end>len(source) { refuse(b,E_LINK(),words,count,id); return fail_value(); }
    // THE RESERVED NAME IS ANSWERED BEFORE THE TABLES ARE CONSULTED, and the
    // order is the whole of it. `true` and `false` are reserved words, so they
    // are not names a table can hold: `type_find` would answer 0 for both and
    // the local table would never have been given them, because
    // `macro_expand.reserved_word` (macro_expand.nova:684) already refuses both
    // spellings at every introducer with 376 reason 3. Asking the tables first
    // is what produced the 941, and it was asking a question with a known
    // answer: nothing CAN bind these two words, so nothing ever will.
    //
    // This is also the negative side of the literal, and it is not a second
    // rule bolted on. Once the two spellings mean a bool here, a declaration
    // that names one can no longer be read back as an ordinary identifier: the
    // READ is a bool, and the existing bool-versus-declared-type refusal says
    // so. `let true:u64=3` followed by `return 0` still verifies, and
    // `let true:u64=3` followed by `return true` is refused -- which is exactly
    // what the reference does (frontend.c:1012 makes the read a bool, and
    // frontend.c:1628-1631 refuses it against the u64 with its own 400).
    let mut boolean:u64=boolean_word(source,start,end);
    if boolean!=0 { return boolean_value(b,words,count,source,id,boolean); }
    // A register spelling whose NTIR width and register_widths width DISAGREE
    // is a refusal at the name, not a repair. See name_width: the catalogue
    // is the opponent of the NTIR here, not its fallback.
    if nindex(words,id)==47 && nclass(words,id)!=0 {
        let mut typed:u64=nwidth(words,id);
        let mut catalogue:u64=register_widths.width(source,start,end);
        if typed!=0 && catalogue!=0 && typed!=catalogue {
            refuse(b,E_INPUT(),words,count,id);
            return fail_value();
        }
    }
    if name_is_register(words,source,count,id) {
        return register_read(b,words,source,count,id);
    }
    let mut held:u64=type_value(b,source,start,end);
    if held==0 { refuse(b,E_VALUE(),words,count,id); return fail_value(); }
    return Value{id:held,width:type_width(b,source,start,end),
                 signed:type_signed(b,source,start,end),
                 space:type_space(b,source,start,end),class:CLASS_VALUE()};
}

// A CALL SPELLING, READ AT THE NAME'S OWN END. See the comment in `expr`: the
// AST's `aux` marker does not survive into the NTIR, so the parenthesis the
// NTIR's own span ends before is what this level has. Forty is the token the
// parser spells an argument list with (parser.nova:270 `accept(p,40)`).
//
// WHITESPACE IS SKIPPED, and it is skipped rather than not because `pred ()`
// and `pred()` are one construct written two ways and a level that read only
// the byte at the name's end would call the first of them a bare operand. The
// two bytes skipped are the two `gap_text` skips when it recovers an operator
// out of the same spans, so this is the third reader of that gap and not a
// fourth convention for it.
// A6 (13 October 2026): an expression node the AST marks as a call, read from
// the table `lower_with_calls` validated. This is the typed half of the call
// test; `call_spelled` stays the textual half and both are asked. A grafted
// stub call (stub_table.graft) has no parenthesis in the text -- its head
// cites the `handler` span of the stub declaration -- and is a call by this
// marker alone. A bare name is never in the table (the table is checked to
// hold only kind 35 aux 1 nodes), so it stays a name.
fn call_marked(b:Builder,id:u64)->bool {
    let calls:buf<u64>=b.calls;
    let mut i:u64=0;
    while i<b.call_count {
        if calls[i]==id { return true; }
        i=i+1;
    }
    return false;
}
fn call_spelled(source:buf<u8>,words:buf<u64>,count:u64,id:u64)->bool {
    if id==0 || id>count { return false; }
    let mut after:u64=nend(words,id);
    if after>len(source) { return false; }
    while after<len(source) {
        let mut c:u64=source[after];
        if c==32 || c==9 { after=after+1; continue; }
        if c==40 { return true; }
        return false;
    }
    return false;
}
// A NAME IN EXPRESSION POSITION IS THREE DIFFERENT THINGS, AND TWO OF THE
// THREE WERE ALREADY HERE BEFORE THE CALL WAS.
//
//   A VALUE   `type_find`/`type_value` over the span-keyed local table, which
//             is what `name_value` asks, and which a `let`, a `parameter` and a
//             `const` each register through `declare_name`.
//   A TYPE    `register_widths.type_width`, a SPELLING catalogue in another
//             module, plus `admits_type` on a type node. Neither of these is a
//             lookup by name into this builder, and neither needed to be.
//   A FUNCTION  THE THIRD CASE, AND THE ONE THAT WAS ABSENT. There was no
//             name-to-function lookup anywhere in this file: `callable` emits
//             the `mir_function` record without writing the declaration's name
//             span into any field, and `call_stmt` never asks whether its
//             callee is declared at all -- it mints a `k_symbol` for whatever
//             spelling it is handed. So `if pred()` reached `name_value`,
//             `type_find("pred")` answered 0 because a FUNCTION IS NOT A TYPE,
//             and the row was refused 941 on a name that was perfectly well
//             declared.
//
// THE SCAN IS OVER THE WHOLE NTIR AND IT HAS NO ORDER TEST, which is the answer
// to the question `resolve_any` was asked and got wrong. That walk searches
// ordinals from the cursor DOWNWARD, which is why the `binding > here` branch
// in `parse_use` was unreachable and 801 could not be produced by any input at
// all (nova_language_parse.nova, "resolve_any searches ordinals from `here`
// DOWNWARD"). This one scans `1..count` and compares SPANS, so there is no
// ordinal comparison here to be unreachable: a call to a function declared
// LATER in the unit resolves exactly as one declared earlier does. That is the
// same answer `call_types.call_type` already gives, walking
// `1..node_count` for the same two kinds.
fn declared_callable(words:buf<u64>,count:u64,source:buf<u8>,start:u64,end:u64)->u64 {
    if start>end || end>len(source) { return 0; }
    let mut id:u64=1;
    while id<=count {
        let mut index:u64=nindex(words,id);
        let mut declares:bool=index==18 || index==9;
        if declares==true {
            // A FUNCTION'S NAME IS ITS FIRST CHILD and an IMPORT'S IS ITS
            // SECOND, because an import spells the module it comes from before
            // the name (parser.nova:466 against parser.nova:495). This is
            // `decl_name_id`'s own rule, in call_types.nova and control_flow.nova
            // alike, read here rather than a third answer to the same question.
            let mut name:u64=nfirst(words,id);
            if index==9 {
                let mut first:u64=nfirst(words,id);
                if first==0 { name=0; }
                else { name=nnext(words,first); }
            }
            if name!=0 && name<=count && nindex(words,name)==47 {
                if span_eq(source,nstart(words,name),nend(words,name),start,end)==true { return id; }
            }
        }
        id=id+1;
    }
    return 0;
}

// THE SAME LOOKUP FOR A DECLARED DATA SYMBOL, and it is a separate function
// rather than one more index in `declared_callable` above. Folding index 24 in
// there would make `call counter()` resolve to a data item, which is a
// different answer to a different question and not a wider one. A `data` node
// spells its name as its FIRST child, the same as a function's, so the walk is
// the same walk with one index changed.
fn declared_data(words:buf<u64>,count:u64,source:buf<u8>,start:u64,end:u64)->u64 {
    if start>end || end>len(source) { return 0; }
    let mut id:u64=1;
    while id<=count {
        if nindex(words,id)==24 {
            let mut name:u64=nfirst(words,id);
            if name!=0 && name<=count && nindex(words,name)==47 {
                if span_eq(source,nstart(words,name),nend(words,name),start,end)==true { return id; }
            }
        }
        id=id+1;
    }
    return 0;
}
// THE FORMALS AND THE DECLARED RESULT OF A CALLABLE, counted off the two node
// kinds `callable` itself dispatches on: a parameter is 19 and a result type is
// 37. Both are facts the NTIR typed, read through the same two accessors
// `param` and `result_of` use, so the arity this level refuses against and the
// width it hands back are the declaration's own and not a re-derivation.
fn declared_formals(words:buf<u64>,count:u64,callee:u64)->u64 {
    let mut formals:u64=0;
    let mut child:u64=nfirst(words,callee);
    while child!=0 && child<=count {
        if nindex(words,child)==19 { formals=formals+1; }
        child=nnext(words,child);
    }
    return formals;
}
fn declared_result(words:buf<u64>,count:u64,callee:u64)->u64 {
    let mut child:u64=nfirst(words,callee);
    while child!=0 && child<=count {
        if nindex(words,child)==37 { return child; }
        child=nnext(words,child);
    }
    return 0;
}
// A CALL IN EXPRESSION POSITION, and it is the `mir_call` `call_stmt` already
// writes, built by the same five steps in the same order, so a call reads the
// same whether it stands alone or sits inside a predicate.
//
// IT IS STRICTLY STRICTER THAN `call_stmt`, and that is deliberate rather than
// an omission. `call_stmt` mints a symbol for whatever spelling it is handed
// and never asks whether a declaration exists, because a call at the STATEMENT
// position has already been vouched for by a stage that did ask. This one is
// reached from `expr`, which no such stage stands behind, so it asks:
//
//   NOT DECLARED      940. The name is well-formed and nothing in the unit
//                     declares it. This is the case that would otherwise have
//                     been a silent read of an unrelated local, and it is a
//                     DIFFERENT refusal from 941 on purpose: 941 says the name
//                     holds no value, and this says the name is not a callable.
//   WRONG ARITY       944. Zero arguments against a declaration that takes one
//                     or more. `call_stmt` uses this same code for its own slot
//                     limit, so an arity answer is one code on this level.
//
// The argument count `call_stmt` writes is `taken+1` because the callee
// occupies arg_a on EVERY call, and the same one is written here: a
// zero-argument call is arg_count 1, not 0.
fn call_value(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,head:u64,argument:u64,depth:u64)->Value {
    let mut callee:u64=declared_callable(words,count,source,nstart(words,head),nend(words,head));
    if callee==0 { refuse(b,E_INPUT(),words,count,head); return fail_value(); }
    let mut formals:u64=declared_formals(words,count,callee);

    let mut result:u64=declared_result(words,count,callee);
    let mut width:u64=0;
    let mut sign:u64=2;
    if result!=0 && result<=count {
        width=nwidth(words,result);
        sign=nsigned(words,result);
        if sign>2 { sign=2; }
    }
    let mut symbol:u64=symbol_of(b,source,words,count,head);
    if symbol==0 { refuse(b,E_INPUT(),words,count,head); return fail_value(); }
    let args:buf<u64>=alloc(runtime(),64);
    let mut arg:u64=argument;let mut supplied:u64=0;
    while arg!=0 {
        if supplied>=64 { rt_free(runtime(),args);refuse(b,E_ARITY(),words,count,arg);return fail_value(); }
        let got:Value=expr(b,words,count,source,arg,depth+1);
        if b.code!=0 { rt_free(runtime(),args);return fail_value(); }
        args[supplied]=got.id;supplied=supplied+1;arg=nnext(words,arg);
    }
    let record:u64=emit(b,k_call(),id,0,words);let value:u64=new_value(b);
    wput(b,record,4,value);wput(b,record,5,symbol);
    let mut k:u64=0;arg=argument;
    while k<supplied {
        if k<2 { wput(b,record,6+k,args[k]); }
        else {
            let extra:u64=emit(b,k_call_arg(),arg,0,words);
            wput(b,extra,5,args[k]);wput(b,extra,6,record);wput(b,extra,8,2);wput(b,extra,14,k);
        }
        k=k+1;arg=nnext(words,arg);
    }
    rt_free(runtime(),args);
    // Input arity depends on directions resolved by the ABI stage, after lower.
    let mut inline_count:u64=supplied+1;if inline_count>3 { inline_count=3; }
    wput(b,record,8,inline_count);
    wput(b,record,9,width);
    wput(b,record,10,sign);
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_SIDE_EFFECT()+FLAG_MAY_FAULT());
    wput(b,record,14,supplied);
    wput(b,record,15,OP_CALL());
    wput(b,record,23,call_mask(words,count,source,callee));
    if (get(b,record,23)&131072)!=0 { b.pred=value; }
    return Value{id:value,width:width,signed:sign,space:0,class:CLASS_VALUE()};
}

fn coerce(b:Builder,words:buf<u64>,count:u64,id:u64,target:u64,
          want:u64,want_signed:u64,got:Value)->u64 {
    if b.code!=0 { return 0; }
    if got.id==target { return target; }
    if want==0 || got.width==0 {
        let mut copy:u64=emit(b,k_copy(),0,id,words);
        wput(b,copy,4,target);
        wput(b,copy,5,got.id);
        wput(b,copy,8,1);
        wput(b,copy,9,want);
        wput(b,copy,10,want_signed);
        wput(b,copy,12,CLASS_VALUE());
        wput(b,copy,13,FLAG_PURE());
        wput(b,copy,14,OP_COPY());
        return target;
    }
    if want>got.width {
        let mut record:u64=emit(b,k_extend(),0,id,words);
        wput(b,record,4,target);
        wput(b,record,5,got.id);
        wput(b,record,8,1);
        wput(b,record,9,want);
        wput(b,record,10,want_signed);
        wput(b,record,12,CLASS_VALUE());
        wput(b,record,13,FLAG_PURE());
        wput(b,record,14,got.signed);
        wput(b,record,15,want-got.width);
        return target;
    }
    if want<got.width {
        let mut record:u64=emit(b,k_truncate(),0,id,words);
        wput(b,record,4,target);
        wput(b,record,5,got.id);
        wput(b,record,8,1);
        wput(b,record,9,want);
        wput(b,record,10,want_signed);
        wput(b,record,12,CLASS_VALUE());
        wput(b,record,13,FLAG_PURE());
        wput(b,record,15,got.width-want);
        return target;
    }
    // Same width: the only thing left to decide is the signedness the value
    // will be READ as, and a reinterpretation is a real machine operation.
    let mut record:u64=emit(b,k_convert(),0,id,words);
    wput(b,record,4,target);
    wput(b,record,5,got.id);
    wput(b,record,8,1);
    wput(b,record,9,want);
    wput(b,record,10,want_signed);
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,14,got.signed);
    wput(b,record,15,got.signed);
    return target;
}

// ---- expressions ---------------------------------------------------------
fn expression(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->Value {
    let mut first:u64=nfirst(words,id);
    if first==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
    let mut second:u64=nnext(words,first);
    // A callee directly followed by argument children is a call even after macro respanning.
    if (nindex(words,first)==47 || nindex(words,first)==48) && (second!=0 || call_spelled(source,words,count,first)==true || call_marked(b,id)==true) {
        let mut head:u64=first;
        if nindex(words,first)==48 { head=nfirst(words,first); }
        return call_value(b,words,count,source,id,head,second,depth);
    }
    let mut op:u64=binary_op(source,words,count,id);
    if op!=0 {
        if second==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
        let mut left:Value=expr(b,words,count,source,first,depth+1);
        if b.code!=0 { return fail_value(); }
        let mut right:Value=expr(b,words,count,source,second,depth+1);
        if b.code!=0 { return fail_value(); }
        let mut arithmetic_sign:u64=left.signed;
        if b.want_width!=0 { arithmetic_sign=b.want_signed; }
        let mut opcode:u64=opcode_of(b,words,count,source,id,op,arithmetic_sign);
        if b.code!=0 { return fail_value(); }
        if opcode==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
        let mut record:u64=emit(b,k_binary(),0,id,words);
        let mut value:u64=new_value(b);
        wput(b,record,4,value);
        wput(b,record,5,left.id);
        wput(b,record,6,right.id);
        wput(b,record,8,2);
        wput(b,record,14,opcode);
        let mut predicate:bool=opcode>=OP_EQ() && opcode<=OP_GE_S();
        if predicate==true {
            wput(b,record,9,1);
            wput(b,record,10,left.signed);
            wput(b,record,12,CLASS_PREDICATE());
        } else {
            let mut width:u64=left.width;
            if width==0 { width=right.width; }
            if b.want_width!=0 { width=b.want_width; }
            else if width<right.width { width=right.width; }
            if width<64 && nindex(words,first)==51 && nindex(words,second)==51 { width=64; }
            wput(b,record,9,width);
            let mut sign:u64=left.signed;
            if sign!=right.signed { sign=2; }
            if b.want_width!=0 { sign=b.want_signed; }
            wput(b,record,10,sign);
            wput(b,record,12,CLASS_VALUE());
        }
        return Value{id:value,width:get(b,record,9),signed:get(b,record,10),
                     space:0,class:get(b,record,12)};
    }
    let mut unop:u64=unary_op(source,words,count,id);
    if unop!=0 {
        let mut inner:Value=expr(b,words,count,source,first,depth+1);
        if b.code!=0 { return fail_value(); }
        let mut opcode:u64=opcode_of(b,words,count,source,id,unop,inner.signed);
        if unop==2 { opcode=OP_NEG(); }
        if opcode==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
        let mut record:u64=emit(b,k_unary(),0,id,words);
        let mut value:u64=new_value(b);
        wput(b,record,4,value);
        wput(b,record,5,inner.id);
        wput(b,record,8,1);
        let mut width:u64=inner.width; let mut sign:u64=inner.signed;
        if b.want_width!=0 { width=b.want_width; sign=b.want_signed; }
        else if nindex(words,first)==51 { width=64; }
        wput(b,record,9,width);
        wput(b,record,10,sign);
        wput(b,record,12,CLASS_VALUE());
        wput(b,record,13,FLAG_PURE());
        wput(b,record,14,opcode);
        return Value{id:value,width:width,signed:sign,space:inner.space,
                     class:CLASS_VALUE()};
    }
    if second==0 {
        // ONE CHILD, NO OPERATOR: a bare name or a parenthesised expression.
        // Either way the node itself yields a value in a record of its own, so
        // every expression node in the NTIR is given a value number and the
        // later passes have something to renumber.
        let mut inner:Value=expr(b,words,count,source,first,depth+1);
        if b.code!=0 { return fail_value(); }
        let mut record:u64=emit(b,k_copy(),0,id,words);
        let mut value:u64=new_value(b);
        wput(b,record,4,value);
        wput(b,record,5,inner.id);
        wput(b,record,8,1);
        wput(b,record,9,inner.width);
        wput(b,record,10,inner.signed);
        wput(b,record,11,inner.space);
        wput(b,record,12,inner.class);
        wput(b,record,13,FLAG_PURE());
        wput(b,record,14,OP_COPY());
        return Value{id:value,width:inner.width,signed:inner.signed,space:inner.space,
                     class:inner.class};
    }
    // Three children or more with no operator between the first two: a call
    // written as an expression. This level resolves calls at the statement
    // position only, so it says so rather than inventing a function value.
    refuse(b,E_INPUT(),words,count,id);
    return fail_value();
}

// ---- memory operands -----------------------------------------------------
//
// THE DECOMPOSED ADDRESS is the second target-independent thing the NTIR does
// not have. A memory operand in the NTIR is a span with a child list; here it
// becomes a VALUE that some arithmetic produced, decomposed into a base, an
// index, a scale FACTOR and a displacement. The scale is a demand ("this
// address has a times four in it"), not a claim that a target can encode one:
// whether 1, 2, 4 and 8 are encodable at all is a target property, and this
// level records the demand so the target pass can refuse it if it must.
fn space_record(b:Builder,words:buf<u64>,count:u64,type_node:u64)->u64 {
    let mut space:u64=nspace(words,type_node);
    if space==0 { return 0; }
    let mut o:buf<u64>=b.out;
    let mut i:u64=1;
    while i<=b.records {
        if o[at(i)]==k_space() && o[at(i)+18]==type_node { return i; }
        i=i+1;
    }
    let mut record:u64=emit(b,k_space(),0,type_node,words);
    wput(b,record,11,space);
    wput(b,record,12,CLASS_ADDRESS());
    wput(b,record,13,FLAG_PURE());
    return record;
}
// The magnitude of a literal node, or 0 when it is not one this level read.
fn scale_of(words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    if nindex(words,id)!=51 { return 0; }
    return read_magnitude(source,nstart(words,id),nend(words,id));
}
// The same dispatch, with the ACCUMULATOR bound lifted to the maximum and
// the successor CLAMPED at `ceiling` instead of refused. `scale_of` above
// cannot do this and must not: its four machine-facing callers want a number
// in the machine, and for those the maximum's successor does not exist.
// This one is for the pin, whose minor is a two-digit field and therefore
// saturates rather than wraps. The dispatch is `scale_of`'s, line for line;
// only the two bounds differ, so there is one rule for "is this node a
// literal this level may read" and it is the rule `scale_of` writes.
fn scale_capped(words:buf<u64>,count:u64,source:buf<u8>,id:u64,ceiling:u64)->u64 {
    if id==0 || id>count { return 0; }
    if nindex(words,id)!=51 { return 0; }
    return read_span(source,nstart(words,id),nend(words,id),
                     18446744073709551615,ceiling);
}
fn memory_value(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->Value {
    if depth>EXPR_DEPTH_CAP() { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
    // The element type is the LAST child and the terms are between the start
    // and it, which is the shape parser.nova:262-278 builds.
    let mut element:u64=nfirst(words,id);
    if element==0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
    while nnext(words,element)!=0 { element=nnext(words,element); }
    let mut child:u64=nfirst(words,id);
    let mut base:u64=0;
    let mut base_symbol:u64=0;
    let mut index_value:u64=0;
    let mut scale:u64=1;
    let mut displacement:u64=0;
    let mut displacement_seen:u64=0;
    let mut segments:u64=0;
    let mut terms:u64=0;
    while child!=0 && child!=element {
        let mut kind:u64=nindex(words,child);
        if kind==47 && nwidth(words,child)==0 {
            // A segment name (`fs`, `gs`): not a term and not a value. It is
            // counted so the gate can see that the level kept the fact that a
            // segment was written without naming a segment register.
            segments=segments+1;
            child=nnext(words,child);
            continue;
        }
        if kind==48 || kind==47 {
            let mut head:u64=0;
            if kind==48 { head=nfirst(words,child); }
            if head==0 { refuse(b,E_INPUT(),words,count,child); return fail_value(); }
            if name_is_register(words,source,count,head)==false {
                // A SYMBOLIC BASE IS NOT MACHINE STATE, AND IT IS NOT ABSENT
                // EITHER. The first version refused it outright -- "not machine
                // state at this level" -- and that refusal is what left
                // `load rax,[counter]:ptr<user,u64>` at 940 E_INPUT on the `load`
                // itself. The level carries no address, so a symbol cannot become
                // a VALUE and is not made one here; what it can carry is the
                // SYMBOL, and turning a symbol into a relocation is the backend's
                // job, not this one's.
                //
                // AND THE LOOKUP IS A LOOKUP, NOT A SPELLING TEST. Minting a
                // `mir_symbol` for any name that is not a register would
                // manufacture a binding for a name nobody declared, which is
                // exactly what `data_of`'s own comment refuses to do when it
                // declines to register a `data` symbol as a binding (spec/
                // ntasm.md:401, "Un `data` n'est pas une liaison"). A name that
                // is not a DECLARED data symbol is still refused, with the same
                // code at the same node, so nothing that used to be refused here
                // is admitted.
                let mut symrec:u64=0;
                if declared_data(words,count,source,nstart(words,head),nend(words,head))!=0 {
                    symrec=symbol_of(b,source,words,count,head);
                }
                if symrec==0 {
                    refuse(b,E_INPUT(),words,count,child);
                    return fail_value();
                }
                base_symbol=symrec;
                terms=terms+1;
                child=nnext(words,child);
                continue;
            }
            let mut term:Value=name_value(b,words,count,source,head);
            if b.code!=0 { return fail_value(); }
            let mut next_id:u64=nnext(words,child);
            let mut scaled:u64=0;
            if next_id!=0 && nindex(words,next_id)==51 {
                let mut factor:Value=expr(b,words,count,source,next_id,depth+1);
                if b.code!=0 { return fail_value(); }
                scaled=factor.id;
            } else {
                scaled=0;
            }
            if scaled!=0 {
                if index_value!=0 { refuse(b,E_INPUT(),words,count,child); return fail_value(); }
                let mut magnitude:u64=scale_of(words,count,source,next_id);
                if magnitude!=2 && magnitude!=4 && magnitude!=8 {
                    refuse(b,E_SCALE(),words,count,next_id);
                    return fail_value();
                }
                let mut mul:u64=emit(b,k_binary(),0,child,words);
                let mut value:u64=new_value(b);
                wput(b,mul,4,value);
                wput(b,mul,5,term.id);
                wput(b,mul,6,scaled);
                wput(b,mul,8,2);
                wput(b,mul,9,term.width);
                wput(b,mul,10,0);
                wput(b,mul,12,CLASS_VALUE());
                wput(b,mul,13,FLAG_PURE());
                wput(b,mul,14,OP_MUL());
                index_value=value;
                scale=magnitude;
                child=nnext(words,next_id);
            } else {
                if base==0 { base=term.id; }
                else if index_value==0 { index_value=term.id; }
                else { refuse(b,E_INPUT(),words,count,child); return fail_value(); }
                child=next_id;
            }
            terms=terms+1;
            continue;
        }
        if kind==51 {
            if displacement_seen!=0 { refuse(b,E_INPUT(),words,count,id); return fail_value(); }
            let mut magnitude:u64=scale_of(words,count,source,child);
            if magnitude==0 { refuse(b,E_INPUT(),words,count,child); return fail_value(); }
            displacement=magnitude-1;
            displacement_seen=1;
            child=nnext(words,child);
            continue;
        }
        refuse(b,E_INPUT(),words,count,child);
        return fail_value();
    }
    if terms==0 && segments==0 {
        refuse(b,E_INPUT(),words,count,id);
        return fail_value();
    }
    let mut address:u64=emit(b,k_address(),0,id,words);
    let mut value:u64=new_value(b);
    wput(b,address,4,value);
    wput(b,address,5,base);
    wput(b,address,6,index_value);
    wput(b,address,8,0);
    // THE SYMBOLIC BASE RIDES IN `arg_c`, and `arg_count` becomes 3 so the
    // slot is live. `arg_is(k_address, 2)` answers 0 -- neither a value nor a
    // link -- so verify range-checks neither this slot nor its block, which is
    // right: it holds a RECORD id, not a value id and not a block id. A record
    // id is not bounded by `values` and bounding it by `count` would be a
    // range check on the wrong space.
    if base_symbol!=0 { wput(b,address,7,base_symbol); wput(b,address,8,3); }
    wput(b,address,9,64);
    wput(b,address,10,0);
    wput(b,address,11,nspace(words,element));
    wput(b,address,12,CLASS_ADDRESS());
    wput(b,address,13,FLAG_PURE());
    wput(b,address,14,scale);
    wput(b,address,15,displacement);
    space_record(b,words,count,element);
    return Value{id:value,width:64,signed:0,space:nspace(words,element),
                 class:CLASS_ADDRESS()};
}

// The first operand of an instruction, the one right after the mnemonic.
fn operand_node(words:buf<u64>,count:u64,mnemonic:u64)->u64 {
    return nnext(words,mnemonic);
}
// The access width of a memory operand: the width of its ELEMENT type, which
// the NTIR stored on the type node while the operand itself carries the
// 80-bit descriptor width. Reading the element is a computation the NTIR left
// for whoever needs the access and not merely its address.
fn access_width(words:buf<u64>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    let mut last:u64=nfirst(words,id);
    if last==0 { return 0; }
    while nnext(words,last)!=0 { last=nnext(words,last); }
    let mut width:u64=nwidth(words,element_node(words,count,id));
    if width==0 || width==80 { return 0; }
    return width;
}
// The element type node of a memory operand: its LAST child.
fn element_node(words:buf<u64>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    let mut last:u64=nfirst(words,id);
    if last==0 { return 0; }
    while nnext(words,last)!=0 { last=nnext(words,last); }
    if nspace(words,last)!=0 {
        let mut item:u64=nfirst(words,last);
        while item!=0 { if nindex(words,item)==37 { return item; } item=nnext(words,item); }
    }
    return last;
}
// A block is CLOSED the moment its terminator exists, and `b.term` is the
// whole of that state: 0 means open, non-zero names the terminator. The
// terminator record is also written into the block's own `aux`, so a reader
// of the image never has to search for it.
fn set_term(b:Builder,record:u64)->u64 {
    if b.block!=0 { wput(b,b.block,14,record); }
    b.term=record;
    return record;
}
// A jump whose target block does not exist yet, remembered by the LABEL
// SPELLING it names. Three words per entry: the record, the span start, the
// span end.
fn pend_add(b:Builder,record:u64,field:u64,start:u64,end:u64)->u64 {
    b.pend_count=b.pend_count+1;
    let mut at_p:u64=(b.pend_count-1)*4;
    let mut t:buf<u64>=b.pend;
    t[at_p]=record;t[at_p+1]=field;t[at_p+2]=start;t[at_p+3]=end;
    return b.pend_count;
}
// Every jump waiting on this spelling now has a target. A jump still waiting
// when the image is finished is a dangling edge and the verifier refuses it.
//
// THE SPANS ARE NOT COMPARED. They were, and no forward reference could ever
// resolve, because the two ends of a forward reference are not the same text
// in the source: the `L` in `jmp L` and the `L` in `L:` are two OCCURRENCES,
// and the NTIR gives each its own node and its own span. A table keyed on the
// span therefore matches a label only against itself, so every jump to a
// label that appears LATER in the function stayed unresolved, kept its
// target at zero, and the verifier refused the image -- which is what it is
// built to do to a dangling edge, and told the caller nothing about the
// source that produced it.
//
// THE KEY IS THE SPELLING, which is what the comment above this pair has
// always claimed the table was keyed by. `span_eq` compares the bytes, so
// two occurrences of `L` match and `LL` does not match `L`.
fn pend_resolve(b:Builder,block:u64,source:buf<u8>,start:u64,end:u64)->u64 {
    let mut t:buf<u64>=b.pend;
    let mut i:u64=0;
    let mut hits:u64=0;
    while i<b.pend_count {
        let mut at_p:u64=i*4;
        let mut field:u64=t[at_p+1];
        if span_eq(source,t[at_p+2],t[at_p+3],start,end) && get(b,t[at_p],field)==0 {
            wput(b,t[at_p],field,block);
            hits=hits+1;
        }
        i=i+1;
    }
    return hits;
}
// The `mir_store` a given memory operand produced, found by its origin.
fn find_store(b:Builder,words:buf<u64>,count:u64,node:u64)->u64 {
    let mut o:buf<u64>=b.out;
    let mut i:u64=1;
    while i<=b.records {
        if o[at(i)]==k_store() && o[at(i)+18]==node { return i; }
        i=i+1;
    }
    return 0;
}

// ---- a mnemonic, resolved to a target-independent opcode ------------------
//
// THIS IS THE FRONTIER, AND IT IS NAMED AS ONE. The source language already
// spells instructions the way an x86 assembler does, so a spelling arrives
// here that a target-independent level cannot own. This table resolves the
// spellings that mean something on ANY machine and refuses the rest. An
// instruction whose meaning this level cannot name is REFUSED 940 with its
// position, which is a refusal the NTIR does not make and therefore the
// clearest single piece of evidence that this level's refusal set is a strict
// SUPERSET of the NTIR's.
fn span_is(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool {
    if start>end || end>len(source) { return false; }
    if end-start!=len(text) { return false; }
    let mut i:u64=0;
    while i<len(text) { if source[start+i]!=text[i] { return false; } i=i+1; }
    return true;
}
// Two spans of the SAME buffer holding the same bytes, which is what two
// occurrences of one label are and what a span-to-span comparison never was.
fn span_eq(source:buf<u8>,a_start:u64,a_end:u64,b_start:u64,b_end:u64)->bool {
    if a_start>a_end || a_end>len(source) { return false; }
    if b_start>b_end || b_end>len(source) { return false; }
    if a_end-a_start!=b_end-b_start { return false; }
    let mut i:u64=0;
    while i<a_end-a_start {
        if source[a_start+i]!=source[b_start+i] { return false; }
        i=i+1;
    }
    return true;
}
// Consume only literal buffers created by lexical lookup helpers;
// span_is itself retains its borrowed-buffer contract.
fn span_is_owned(source:buf<u8>,start:u64,end:u64,text:buf<u8>)->bool {
    let result:bool=span_is(source,start,end,text);
    rt_free(runtime(),text);
    return result;
}
fn mnemonic_op(source:buf<u8>,words:buf<u64>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return OP_NONE(); }
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    if start>=end { return OP_NONE(); }
    let mut a:buf<u8>="mov";if span_is_owned(source,start,end,a) { return OP_COPY(); }
    let mut b:buf<u8>="movzx";if span_is_owned(source,start,end,b) { return OP_MOVZX(); }
    let mut c:buf<u8>="movsx";if span_is_owned(source,start,end,c) { return OP_MOVSX(); }
    let mut d:buf<u8>="add";if span_is_owned(source,start,end,d) { return OP_ADD(); }
    let mut e:buf<u8>="sub";if span_is_owned(source,start,end,e) { return OP_SUB(); }
    let mut f:buf<u8>="imul";if span_is_owned(source,start,end,f) { return OP_MUL(); }
    let mut g:buf<u8>="mul";if span_is_owned(source,start,end,g) { return OP_UMUL(); }
    let mut h:buf<u8>="idiv";if span_is_owned(source,start,end,h) { return OP_DIV(); }
    let mut i:buf<u8>="div";if span_is_owned(source,start,end,i) { return OP_DIV(); }
    let mut j:buf<u8>="and";if span_is_owned(source,start,end,j) { return OP_AND(); }
    let mut k:buf<u8>="or";if span_is_owned(source,start,end,k) { return OP_OR(); }
    let mut l:buf<u8>="xor";if span_is_owned(source,start,end,l) { return OP_XOR(); }
    let mut m:buf<u8>="shl";if span_is_owned(source,start,end,m) { return OP_SHL(); }
    let mut n:buf<u8>="shr";if span_is_owned(source,start,end,n) { return OP_SHR(); }
    let mut o:buf<u8>="sar";if span_is_owned(source,start,end,o) { return OP_SAR(); }
    let mut p:buf<u8>="cmp";if span_is_owned(source,start,end,p) { return OP_CMP(); }
    let mut q:buf<u8>="test";if span_is_owned(source,start,end,q) { return OP_TEST(); }
    let mut r:buf<u8>="not";if span_is_owned(source,start,end,r) { return OP_NOT(); }
    let mut s:buf<u8>="neg";if span_is_owned(source,start,end,s) { return OP_NEG(); }
    let mut t:buf<u8>="lea";if span_is_owned(source,start,end,t) { return OP_LEA(); }
    let mut u:buf<u8>="nop";if span_is_owned(source,start,end,u) { return OP_NOP(); }
    let mut v:buf<u8>="push";if span_is_owned(source,start,end,v) { return OP_PUSH(); }
    let mut w:buf<u8>="pop";if span_is_owned(source,start,end,w) { return OP_POP(); }
    let mut x:buf<u8>="xchg";if span_is_owned(source,start,end,x) { return OP_XCHG(); }
    let mut y:buf<u8>="ret";if span_is_owned(source,start,end,y) { return OP_RET(); }
    let mut z:buf<u8>="jmp";if span_is_owned(source,start,end,z) { return OP_JMP(); }
    let mut bb:buf<u8>="load";if span_is_owned(source,start,end,bb) { return OP_LOAD(); }
    let mut st:buf<u8>="store";if span_is_owned(source,start,end,st) { return OP_STORE(); }
    let mut aa:buf<u8>="ud2";if span_is_owned(source,start,end,aa) { return OP_UNREACHABLE(); }
    return OP_NONE();
}
// The NAME a node names, looking through an expression wrapper and a
// qualified wrapper, or 0. This is the ONLY place a register or a label
// spelling is reached, and what comes back is a node, never a location.
fn named_head(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    let mut kind:u64=nindex(words,id);
    if kind==47 { return id; }
    if kind==48 { return nfirst(words,id); }
    if kind==36 {
        let mut first:u64=nfirst(words,id);
        if first==0 { return 0; }
        if nnext(words,first)!=0 { return 0; }
        return named_head(words,source,count,first);
    }
    return 0;
}
// The register a node names, or 0.
fn register_node(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    let mut head:u64=named_head(words,source,count,id);
    if head==0 { return 0; }
    if name_is_register(words,source,count,head) { return head; }
    return 0;
}
// THE TWO REGISTERS A FUNCTION BODY MAY NOT WRITE, and the arithmetic is the
// whole content of this function.
//
// Every local, spill, snapshot, call argument and temporary slot of a lowered
// function is addressed through RBP, and the epilogue leaves through RSP, so
// neither is a data register a body may reach. codegen.c:993-1004 states that
// for the backend in the sentence this rule is derived from, and the oracle
// generalises it past `mov`: frontend.c:5493-5498 refuses EVERY machine
// instruction whose computed write set meets either register, whatever the
// mnemonic, with "<mnemonic> requires unavailable stack/frame balance proof"
// at NTF_E_CONTRACT, 503.
//
// THE TWO FAMILY NUMBERS ARE A COUPLING AND NOT A CONSTANT THAT MEANS
// "RBP, RSP" IN THE ABSTRACT. They are register_widths.family's own 1-based
// catalogue, which is also the one abi.nova spells, and the oracle's numbers
// are the SAME numbers shifted by one: the C table at frontend.c:741 is
// `{"rax","rcx","rdx","rbx","rsp","rbp",...}`, 0-based, so oracle rsp is 4
// and oracle rbp is 5, and the mask frontend.c:5495 tests is
// `(BIT(4) | BIT(5))` with BIT(n) = 1<<n at frontend.c:13. Nova is 1-based
// (rsp 5, rbp 6) for the same two registers. Change one numbering and this
// function silently starts refusing rbx and rcx instead, which is why the
// pair is named and not written as a bare constant at the call site.
fn frame_family(family:u64)->bool {
    if family==5 { return true; }
    if family==6 { return true; }
    return false;
}
// The family of the register a node names, or 0. It reads the SAME span
// name_width reads, because that is what decided the node was a register in
// the first place: a node that register_node accepted and a node whose family
// this answers must be talking about one spelling.
fn register_family(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    if name_width(words,source,count,id)==0 { return 0; }
    return register_widths.family(source,nstart(words,id),nend(words,id));
}
// The label a node names, or 0. A label's name is a NAME the NTIR left
// untyped, so it is told apart from a register by that and by nothing else.
// A CONDITIONAL JUMP, AND THE CONDITION IT TESTS. The opcode vocabulary has no
// `je`: a conditional branch is not a target-independent OPCODE, it is a branch
// on a PREDICATE, and the vocabulary already has exactly that -- `OP_BRANCH` on
// a `k_branch`, which is what `if cond {}` emits. So a `je` is lowered as the
// record `if` already produces, and the CONDITION goes in `aux2`, which on a
// `k_branch` the format leaves to the kind.
//
// WHICH IS WHY THIS IS NOT A NEW OPCODE AND NOT A NEW RECORD KIND. Adding
// `OP_JCC` would have moved `OP_LIMIT` from 43, and `machine_x64` derives
// `COVERED_ARMS()` by counting `covered_op` over `1..OP_LIMIT`, so a new
// uncovered opcode would have been a format change three consumers had to agree
// to, for a shape the image already had a spelling for.
//
// TWELVE CONDITIONS, AND `je` AND `jz` ARE THE SAME ONE. They are one condition
// with two spellings, so they answer one number; giving each spelling its own
// would have made `je` and `jz` different branches, which they are not. 0 means
// "not a conditional jump", and that is the whole of the refusal path: a
// mnemonic that is neither an opcode nor a condition is still refused exactly
// where it always was.
fn jcc_code(source:buf<u8>,words:buf<u64>,count:u64,id:u64)->u64 {
    if id==0 || id>count { return 0; }
    let mut start:u64=nstart(words,id);
    let mut end:u64=nend(words,id);
    if start>=end { return 0; }
    let mut a:buf<u8>="je";if span_is_owned(source,start,end,a) { return 1; }
    let mut b:buf<u8>="jne";if span_is_owned(source,start,end,b) { return 2; }
    let mut c:buf<u8>="jz";if span_is_owned(source,start,end,c) { return 1; }
    let mut d:buf<u8>="jnz";if span_is_owned(source,start,end,d) { return 2; }
    let mut e:buf<u8>="ja";if span_is_owned(source,start,end,e) { return 3; }
    let mut f:buf<u8>="jae";if span_is_owned(source,start,end,f) { return 4; }
    let mut g:buf<u8>="jb";if span_is_owned(source,start,end,g) { return 5; }
    let mut h:buf<u8>="jbe";if span_is_owned(source,start,end,h) { return 6; }
    let mut i:buf<u8>="jg";if span_is_owned(source,start,end,i) { return 7; }
    let mut j:buf<u8>="jge";if span_is_owned(source,start,end,j) { return 8; }
    let mut k:buf<u8>="jl";if span_is_owned(source,start,end,k) { return 9; }
    let mut l:buf<u8>="jle";if span_is_owned(source,start,end,l) { return 10; }
    let mut m:buf<u8>="js";if span_is_owned(source,start,end,m) { return 11; }
    let mut n:buf<u8>="jns";if span_is_owned(source,start,end,n) { return 12; }
    return 0;
}

fn label_head(words:buf<u64>,source:buf<u8>,count:u64,id:u64)->u64 {
    let mut head:u64=named_head(words,source,count,id);
    if head==0 { return 0; }
    if nindex(words,head)==47 && admits_name(words,head)==false { return head; }
    return 0;
}

// A BINDING NAME, as opposed to a register spelling or a label. This is the
// fourth operand form spec/ntasm/ntasm.md 6.1 freezes, and it is the only operand
// form whose legality depends on the OPCODE.
//
// IT IS TOLD APART FROM A LABEL BY THE LOCAL TABLE, AND NOT BY `label_head`.
// The first version of this predicate excluded labels with `label_head`, and
// it answered FALSE for every name in the tree including `let` bindings: a
// `let` name is a name the NTIR left untyped, which is precisely what
// `admits_name` says and precisely what `label_head` tests for, so the two
// predicates are the same predicate and the exclusion excluded everything.
// The rule then fired on nothing and the case measured an empty set -- the
// same failure the two operator loops sat in, one level down. A name is a
// BINDING when the local table holds it, and a label is a name no declaration
// ever registered; `type_find` is the same lookup `name_value` itself uses to
// decide that a name is a local at all, so this cannot disagree with the code
// that consumes the operand.
//
// It looks through the expression and qualified wrappers, and MEASURED, not
// assumed. `primary` wraps EVERY bare operand name in an expression node
// (parser.nova:196-197, `node(p,35,begin)` then `attach(...,name(p))`) and a
// module-qualified one in a qualified node inside that (parser.nova:219); that
// is why `expr` unwraps both here at machine_ir.nova:1068-1076. A predicate
// that read the node kind instead of unwrapping was tried and fired on
// NOTHING -- the gate went from fourteen refusals to zero, and the rows that
// "proved" it were not the parenthesised ones but all fourteen, because the
// wrapper is on every one of them. Parentheses are therefore not a bypass to
// defend against here; the wrapper itself is what has to be looked through.
// A declared const is an immediate source, distinct from mutable bindings.
fn constant_binding_name(words:buf<u64>,count:u64,source:buf<u8>,id:u64)->bool {
    let head:u64=named_head(words,source,count,id); if head==0 { return false; }
    let mut node:u64=1;
    while node<=count {
        if nindex(words,node)==10 {
            let name:u64=nfirst(words,node);
            if name!=0 && same4(source,nstart(words,head),nend(words,head),nstart(words,name),nend(words,name)) { return true; }
        }
        node=node+1;
    }
    return false;
}

fn binding_name(b:Builder,words:buf<u64>,source:buf<u8>,count:u64,id:u64)->bool {
    let mut head:u64=named_head(words,source,count,id);
    if head==0 { return false; }
    if name_is_register(words,source,count,head) { return false; }
    if type_find(b,source,nstart(words,head),nend(words,head))==0 { return false; }
    return true;
}
// Three words per collected operand: value, width, signedness.
fn op_note(b:Builder,slot:u64,value:u64,width:u64,signed:u64)->u64 {
    let mut t:buf<u64>=b.ops;
    t[slot*3]=value;
    t[slot*3+1]=width;
    t[slot*3+2]=signed;
    return slot+1;
}
fn op_value(b:Builder,slot:u64)->u64 {
    let mut t:buf<u64>=b.ops;
    return t[slot*3];
}
fn op_width(b:Builder,slot:u64)->u64 {
    let mut t:buf<u64>=b.ops;
    return t[slot*3+1];
}
fn op_signed(b:Builder,slot:u64)->u64 {
    let mut t:buf<u64>=b.ops;
    return t[slot*3+2];
}
// The effect bits an opcode implies, as a computed answer rather than a
// declaration. An effect SET in the source is an input to this level; the
// bits below are what the lowered BODY actually does, and the two are
// different facts.
fn op_effects(op:u64)->u64 {
    if op==OP_STORE() || op==OP_PUSH() || op==OP_POP() { return FLAG_SIDE_EFFECT(); }
    if op==OP_XCHG() || op==OP_CMP() || op==OP_TEST() { return 0; }
    return FLAG_PURE();
}
fn op_faults(op:u64)->u64 {
    if op==OP_LOAD() || op==OP_STORE() { return FLAG_MAY_FAULT(); }
    if op==OP_JMP() || op==OP_BRANCH() { return 0; }
    return 0;
}
// An instruction. The record is `mir_asm` and it is emitted BEFORE its
// operands are lowered, then patched. That is not an optimisation: it is what
// keeps the attribution order increasing, because an instruction's memory
// operand is a LATER NTIR node than the instruction itself and the record
// that IS the instruction has to come first.
fn instruction(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    if depth>EXPR_DEPTH_CAP() { return refuse(b,E_INPUT(),words,count,id); }
    let mut mnemonic:u64=nfirst(words,id);
    if mnemonic==0 || mnemonic>count { return refuse(b,E_INPUT(),words,count,id); }
    let mut op:u64=mnemonic_op(source,words,count,mnemonic);
    // A CONDITIONAL JUMP. The record is the one `if cond {}` already emits -- a
    // `k_branch` on a PREDICATE value -- and the CONDITION is `aux2`, which
    // `if` leaves free because an `if` has no condition to spell.
    let mut jcc:u64=jcc_code(source,words,count,mnemonic);
    if jcc!=0 {
        let mut target:u64=nnext(words,mnemonic);
        let mut head:u64=label_head(words,source,count,target);
        if head==0 { return refuse(b,E_INPUT(),words,count,id); }
        let mut branch:u64=emit(b,k_branch(),0,id,words);
        wput(b,branch,5,b.pred);
        wput(b,branch,6,0);
        wput(b,branch,8,3);
        wput(b,branch,12,CLASS_PREDICATE());
        wput(b,branch,13,FLAG_TERMINATOR());
        wput(b,branch,14,OP_BRANCH());
        wput(b,branch,15,jcc);
        wput(b,branch,22,8);
        set_term(b,branch);
        // THE TAKEN EDGE IS A FORWARD REFERENCE to the label's own block, and it
        // is `pend_add` on FIELD 6 -- the taken edge, not `arg_a`, which is
        // carrying the predicate. Resolved by `label_stmt` when the label is
        // reached, and `verify` refuses the image if it never is.
        pend_add(b,branch,6,nstart(words,head),nend(words,head));
        let mut back:u64=0;
        while back<b.rev_count {
            let at_back:u64=back*3;
            if span_eq(source,b.rev[at_back+1],b.rev[at_back+2],nstart(words,head),nend(words,head)) {
                wput(b,branch,6,b.rev[at_back]); b.fixed_jumps=b.fixed_jumps+1; break;
            }
            back=back+1;
        }
        // THE FALL-THROUGH BLOCK IS EMITTED HERE rather than left to
        // `need_block`, because `arg_c` has to NAME it and a block that does
        // not exist yet cannot be named. The next statement lands in it through
        // `need_block`, which finds `b.term==0` and reuses it.
        // A BLOCK IS EMITTED AT DEPTH 2 UNDER THE FUNCTION, and `new_block` sets
        // depth 3 and `b.parent` to the new record only AFTERWARDS. Calling it
        // with the block we are still inside therefore filed the block as an
        // OPERATION of that block -- one level too deep and one parent too
        // narrow -- and `verify` answered 936 E_SHARED on it. Every other caller
        // of `new_block` sets these two words first; this one had to as well.
        let mut func:u64=b.func;
        b.parent=func;
        b.depth=2;
        let mut fall:u64=new_block(b,words,count,id,0);
        wput(b,branch,7,fall);
        return 0;
    }
    if op==OP_NONE() { return refuse(b,E_INPUT(),words,count,mnemonic); }
    if op==OP_JMP() {
        let mut target:u64=nnext(words,mnemonic);
        let mut head:u64=label_head(words,source,count,target);
        if head==0 { return refuse(b,E_INPUT(),words,count,id); }
        let mut record:u64=emit(b,k_jump(),0,id,words);
        wput(b,record,5,0);
        wput(b,record,8,1);
        wput(b,record,13,FLAG_TERMINATOR());
        wput(b,record,14,b.block);
        wput(b,record,15,nstart(words,head));
        set_term(b,record);
        pend_add(b,record,5,nstart(words,head),nend(words,head));
        // PAIRED BY TEXT, NOT BY OFFSET.  MEASURED: the label publishes 94 and
        // the jump publishes 109 for the SAME NAME, so no offset comparison
        // can ever match, while `span_eq` -- which compares the bytes -- can.
        // `pend_resolve` pairs this way but runs at the LABEL, which for a
        // loop is before this jump exists; this is the other direction, and it
        // runs when both sides are present.  Two Builder fields, no image word.
        {
            let mut rv:u64=0; let mut k3:u64=0;
            while k3<b.rev_count {
                let mut a3:u64=k3*3;
                if span_eq(source,b.rev[a3+1],b.rev[a3+2],nstart(words,head),nend(words,head)) { rv=b.rev[a3]; break; }
                k3=k3+1;
            }
            if rv!=0 { wput(b,record,5,rv); b.fixed_jumps=b.fixed_jumps+1; }
        }
        // THE SPAN EACH SIDE PUBLISHES, kept so the two can be COMPARED as
        // numbers instead of argued about.  This is a publication, not a
        // change: nothing below it behaves differently.
        b.sp_jump=nstart(words,head);
        return 0;
    }
    let mut asm:u64=emit(b,k_asm(),id,0,words);
    wput(b,asm,14,op);
    wput(b,asm,8,0);
    wput(b,asm,12,CLASS_VALUE());
    let mut child:u64=nnext(words,mnemonic);
    // The FIRST operand, kept because `child` is reassigned on every turn of
    // the loop and the refusal below needs the instruction it belongs to rather
    // than whichever operand happened to exceed the capacity.
    let first_operand:u64=child;
    let mut taken:u64=0;
    // THE OPERAND'S POSITION IN THE CHAIN, and it is counted here for the same
    // reason the OPERAND FORM scan at the bottom of this function counts its
    // own: `taken` is a count of operands COLLECTED, and a destination is
    // deliberately not collected, so `taken` cannot answer "is this the first
    // operand".  Measured, on this tree, through the entry's mode 4: with the
    // destination test keyed on `taken==0`, `mov rax, rcx` lowered its
    // destination, left `taken` at zero, and therefore lowered its SOURCE
    // through the same destination arm -- the record carried field 8 = 0 and
    // `verify` refused the producer's own image with E_ARITY 944 against
    // `op_arity(OP_COPY)` = 1*16+2 (below).  Two operands as spelled, zero in
    // the image, and a refusal that names arity on a `mov` whose arity is
    // right.  One counter, used by both rules, is the repair.
    let mut at_operand:u64=0;
    let mut memory_destination:u64=0;
    // THE WIDTH OF A NAMED DESTINATION, and it is a separate word because the
    // width an instruction ENCODES at is the width of the thing it WRITES, not
    // the width of the first thing it reads.  Once operand 0 is a destination
    // rather than a source -- which is what the arm below makes it -- the
    // record's word 9 would otherwise describe the FIRST OPERAND COLLECTED,
    // which for `mov rax, 5` is the literal, and an encoder picking its form
    // from that word would move a 64-bit register eight bits wide.
    let mut dest_width:u64=0;
    while child!=0 {
        at_operand=at_operand+1;
        // THE COLLECTED OPERANDS AGAINST THE OPCODE'S OWN PUBLISHED CAPACITY.
        // This read `taken>=3`, which is the same as no rule at all for every
        // opcode whose capacity is two: the check fires one operand LATE, so the
        // third operand of a two-operand instruction was collected, the record
        // carried three, `verify` checked three against `op_arity(OP_CMP)` = 2*16+2
        // and... did not refuse, and the encoder found it at 962 instead.
        //
        // The capacity is `op_arity(op)%16` from the owner's published table, not
        // a number written here. It is compared against `taken`, which counts
        // operands COLLECTED, and that distinction is load-bearing: a DESTINATION
        // is consumed without being collected, so `load rax, [counter]` spells
        // two operand slots, collects one, and must not be refused. An earlier
        // version of this repair counted SLOTS and refused that legal two-slot
        // form -- measured, not argued.
        //
        // The refusal names the INSTRUCTION, not the operand that exceeded it:
        // `id` is the statement, and every other refusal in this file names the
        // construct that is wrong rather than the token inside it. The gate
        // expects 7:5 -- the `cmp` -- and this line is what keeps that.
        // The refusal names the MNEMONIC -- `cmp` at 7:5 -- and not the
        // enclosing statement (which starts at column 1) nor the operand that
        // exceeded the capacity (which is the third one, at column 15). The gate
        // pins 7:5 and it is the only one of the three a reader can act on: the
        // statement is a block, the operand is a name, and the instruction is the
        // thing that has too many of them.
        if taken>=op_arity(op)%16 { return refuse(b,E_ARITY(),words,count,first_operand); }
        if nindex(words,child)==35 {
            let mut address:Value=memory_value(b,words,count,source,child,depth+1);
            if b.code!=0 { return b.code; }
            if at_operand==1 && (op==OP_COPY() || op==OP_STORE()) {
                // A write through memory. The access becomes a `mir_store`
                // carrying the resolved width and space, and the instruction
                // itself records that its operands were decomposed.
                memory_destination=child;
                let mut store:u64=emit(b,k_store(),0,child,words);
                let mut tail:u64=element_node(words,count,child);
                wput(b,store,5,address.id);
                wput(b,store,6,0);
                wput(b,store,8,1);
                wput(b,store,9,access_width(words,count,child));
                wput(b,store,10,nsigned(words,tail));
                wput(b,store,11,nspace(words,tail));
                wput(b,store,12,CLASS_ADDRESS());
                wput(b,store,13,FLAG_SIDE_EFFECT()+FLAG_MAY_FAULT());
                wput(b,store,14,OP_STORE());
                wput(b,asm,15,1);
                wput(b,asm,8,0);
                child=nnext(words,child);
                continue;
            }
            // A read through memory: the access is a `mir_load` and the
            // instruction consumes the value it produced.
            let mut load:u64=emit(b,k_load(),child,0,words);
            let mut value:u64=new_value(b);
            wput(b,load,4,value);
            wput(b,load,5,address.id);
            wput(b,load,8,1);
            wput(b,load,9,access_width(words,count,child));
            let mut tail:u64=element_node(words,count,child);
            wput(b,load,10,nsigned(words,tail));
            wput(b,load,11,nspace(words,tail));
            wput(b,load,12,CLASS_VALUE());
            wput(b,load,13,FLAG_MAY_FAULT());
            wput(b,load,14,OP_LOAD());
            // NOT MARKED DECOMPOSED, and the difference from the store arm above
            // is the whole content of it. A `mov` through a memory DESTINATION
            // leaves the asm with nothing to say -- the `mir_store` carries both
            // the address and the value -- so its arg_count is 0 and field 15
            // records that the operands were decomposed. A `load` is the other
            // shape: `op_arity(OP_LOAD)` is 1*16+1, the address IS the
            // instruction's operand, and marking it decomposed made `verify`
            // answer 944 E_ARITY on `decomposed!=0 && taken!=0` -- a refusal
            // against the producer's own image, over a record whose one operand
            // the opcode's published arity asks for.
            //
            // So the value the `mir_load` produced is still collected here, the
            // asm keeps its one operand, and the backend reads the address from
            // the asm and the loaded value from the `mir_load`.
            taken=op_note(b,taken,value,access_width(words,count,child),
                          nsigned(words,tail));
            child=nnext(words,child);
            continue;
        }
        // A NAMED DESTINATION IS NOT A SOURCE.  `mov rax, 5` used to lower its
        // first operand through `expr` like every other operand, so the binding
        // cell -- an INPUT value the machine must supply -- became an operand the
        // instruction READS.  The emitted program then opened with a move out
        // of rax, before anything had written it: measured on the corpus,
        // `mov rax, 5 / add rax, 1 / return rax` emitted `48 89 c2 ...` and the
        // consumer's `use_before_def` control named it at offset 1, "opcode 89
        // at 1 reads r0 before anything writes it".
        //
        // THE RULE IS POSITIONAL, NOT A BAN ON NAMES: operand 0 of a `mov` is
        // a destination.  That is already the rule the OPERAND FORM guard below
        // enforces -- a binding name is admitted in position 0 for OP_COPY and
        // nowhere else, precisely because that position is an assignment -- and
        // this arm makes the data flow agree with it.  `mov rax, rcx` is
        // untouched: there the SOURCE is operand 1 and is still read -- AND IT
        // WAS NOT, because this arm was keyed on `taken==0` rather than on the
        // position, and the destination it skipped does not advance `taken`.
        // Measured through the entry's mode 4 on this tree, before the repair:
        // `mov rax, rcx` and `mov rax, rbx` each produced a `mir_asm` with
        // field 8 = 0 and fields 5, 6 and 7 all zero -- TWO operands as spelled,
        // ZERO in the image -- and `verify` then refused the producer's own
        // output with E_ARITY 944, because `op_arity(OP_COPY)` is 1*16+2 and
        // 0 is below its floor.  `mov rax, 5` measured 1 and `add rax, rcx`
        // measured 2, so the count was not wrong everywhere: it was wrong
        // exactly where the source is a register name, which is the one case
        // this arm is about.  `at_operand` is the chain position the OPERAND
        // FORM scan below already uses, so the two rules now read one counter.
        if (op==OP_COPY() || op==OP_LOAD()) && at_operand==1 && register_node(words,source,count,child)!=0 {
            // THE WIDTH IS THE NAME'S, and the name is one step IN: a bare
            // operand arrives wrapped in an expression node, and
            // `register_node` resolves through `named_head` to reach the name.
            // Reading the width off the WRAPPER produced eight for `rax` --
            // the wrapper's own width -- and the emitter then encoded
            // `mov al, 1`, one byte into a sixty-four-bit register, which is
            // the defect A3 warned about arriving by the other door.
            let mut dhead:u64=named_head(words,source,count,child);
            dest_width=name_width(words,source,count,dhead);
            child=nnext(words,child);
            continue;
        }
        let mut value:Value=expr(b,words,count,source,child,depth+1);
        if b.code!=0 { return b.code; }
        taken=op_note(b,taken,value.id,value.width,value.signed);
        child=nnext(words,child);
    }
    // AN OPERAND THIS RECORD CANNOT CARRY IS A REFUSAL, NOT A DISCARD, and this
    // is the whole of the `cmp rax, rbx, rcx` regression.
    //
    // The loop above stops at three COLLECTED operands and refuses; a fourth would
    // have been caught by that guard. But a two-operand opcode whose slots fill
    // after two COLLECTED operands leaves the loop with a THIRD operand still
    // chained, and nothing read it. The record then carried the two operands it
    // could hold, `verify` checked that record against the opcode's published
    // arity, found it correct, and answered 0 -- for a program that has three
    // operands in it. The IMAGE was valid. The PROGRAM was not the image, and
    // nothing downstream of the lowering could have known.
    //
    // So the question belongs HERE, where the chain is still readable: is there
    // an operand left over? That is a different question from the one inside the
    // loop -- which asks whether THIS operand is too many -- and both are needed:
    // without the one inside, a four-operand instruction is accepted, and without
    // this one, `cmp` with three operands is accepted.
    if memory_destination!=0 {
        // The stored value is the FIRST source operand, and the store record
        // is patched now that the operand loop has produced it.
        if taken!=1 { return refuse(b,E_ARITY(),words,count,id); }
        let mut store:u64=find_store(b,words,count,memory_destination);
        if store==0 { return refuse(b,E_SHAPE(),words,count,id); }
        wput(b,store,6,op_value(b,0));
        wput(b,store,15,get(b,store,9));
        wput(b,store,9,op_width(b,0));
        wput(b,store,8,2);
        wput(b,asm,13,FLAG_SIDE_EFFECT()+FLAG_MAY_FAULT());
        wput(b,asm,12,CLASS_NONE());
        return 0;
    }
    let mut flags:u64=op_effects(op)+op_faults(op);
    // THE TERMINATOR FLAG IS ASKED OF THE PREDICATE, NOT OF A SPELLING. This
    // used to read `op==OP_RET()`, which is the one terminator this level
    // could spell; `op_is_terminator` four lines up above already answers true
    // for OP_JMP, OP_BRANCH and OP_UNREACHABLE, and `verify` refuses with
    // E_SHAPE any terminator op whose record does not carry this flag. So the
    // two halves of this module disagreed about which ops are terminal, and the
    // disagreement was only invisible while the two sets happened to be the
    // same singleton. Adding `ud2` -- an opcode the level below already
    // encodes, and one this file's own `machine_x64` counterpart maps to
    // OP_UNREACHABLE -- made it visible as a 934 on every `-> never` function.
    // Reading the predicate removes the second statement of the fact instead of
    // restating it, so the next terminator cannot fall between the two.
    if op_is_terminator(op)==true { flags=flags+FLAG_TERMINATOR(); }
    wput(b,asm,13,flags);
    if taken>0 { wput(b,asm,5,op_value(b,0)); }
    if taken>1 { wput(b,asm,6,op_value(b,1)); }
    if taken>2 { wput(b,asm,7,op_value(b,2)); }
    wput(b,asm,8,taken);
    // The DESTINATION's width when there is one, else the first source's.
    if dest_width!=0 { wput(b,asm,9,dest_width); }
    else if taken>0 { wput(b,asm,9,op_width(b,0)); }
    if taken>0 { wput(b,asm,10,op_signed(b,0)); }
    if op_produces(op)==true {
        let mut value:u64=new_value(b);
        wput(b,asm,4,value);
    }
    // A COMPARISON DEFINES THE FLAGS, AND SO IT PRODUCES A PREDICATE VALUE that
    // a conditional jump consumes. `op_produces(OP_CMP)` is true for exactly
    // this reason, and the class is PREDICATE rather than VALUE so a consumer
    // can tell "a comparison" from "a number" without reading the opcode. `cmp`
    // has no destination, so the bind-write guard below already skips it and
    // nothing here writes a cell.
    if op==OP_CMP() || op==OP_TEST() {
        wput(b,asm,12,CLASS_PREDICATE());
        b.pred=get(b,asm,4);
    }
    // A WRITE to a bound spelling updates the cell, which is the whole of the
    // data flow a machine level has to carry: not a register, a value.
    //
    // AND IT IS ALSO THE ONE PLACE IN THE TREE THAT KNOWS WHICH OPERAND IS THE
    // DESTINATION, so the frame rule is enforced here and nowhere else. The
    // `op!=OP_CMP() && op!=OP_TEST()` guard is the source/destination
    // boundary and it is load-bearing here, not incidental: `cmp rbp,rax` and
    // `test rbp,rax` READ the frame pointer, they do not write it, and the
    // oracle accepts both -- frontend.c:5495 tests registers_written and
    // nt_x64_effects reports 0 for them, so measured they fall through to the
    // ordinary "omits an inferred effect" accounting at NTF_E_EFFECT, 501.
    // A rule that scanned operands without this guard would refuse two valid
    // programs, which is the direction this project keeps paying for.
    if taken>0 && op!=OP_CMP() && op!=OP_TEST() && op!=OP_UMUL() {
        let mut destination:u64=register_node(words,source,count,operand_node(words,count,mnemonic));
        if destination!=0 {
            let mut family:u64=register_family(words,source,count,destination);
            if frame_family(family)==true { return refuse(b,E_FRAME(),words,count,id); }
            // A `load` DOES NOT PRODUCE A VALUE OF ITS OWN. The `mir_load` the
            // memory-operand arm emitted is what produces it, and that value is
            // operand 0, so binding the cell to `get(b,asm,4)` -- which is zero,
            // because `op_produces(OP_LOAD)` is false -- would bind it to a value
            // NO RECORD PRODUCES, and the next reader of the cell would find a
            // value id that appears in no `value_out`.
            let mut written:u64=get(b,asm,4);
            if op==OP_LOAD() && taken>0 { written=op_value(b,0); }
            bind_write(b,words,source,count,destination,written);
            wput(b,asm,20,cell_family(words,source,count,destination));
            wput(b,asm,21,cell_offset(words,source,destination));
            wput(b,asm,22,2);
        }
    }

    if op==OP_UMUL() {
        // A genuine mul has one source and implicit AX or RDX:RAX outputs.
        wput(b,asm,20,1); wput(b,asm,21,0); wput(b,asm,22,2);
    }
    if flags_writer(op) {
        wput(b,asm,22,get(b,asm,22)|4);
        b.pred=get(b,asm,4);
    }

    // AND THIS IS THE OTHER PLACE THAT KNOWS WHICH OPERAND IS THE DESTINATION,
    // which is why the OPERAND FORM rule lives here too. `instruction` is the
    // only function in the tree that resolves an instruction's SOURCE
    // operands, and a binding name is the one operand form whose legality
    // depends on the opcode: spec/ntasm/ntasm.md 6.1 admits it in `mov`'s source
    // position and nowhere else.
    //
    // WHY `mov` AND ONLY `mov`, which is the whole content of the rule. The
    // name reaches a machine instruction through the mixed lowering at
    // codegen.c:984-1015: evaluate the name into RAX (1008), park RAX in a
    // snapshot slot (1010-1011), RESTORE RAX (1012 -- `restore_expression_rax`
    // loads RAX back from the slot the expression prologue saved it in), then
    // load the destination at the destination's width (1014-1015). The
    // restore is what makes the sequence sound, and it is also the whole of
    // why the sequence can only IMPLEMENT AN ASSIGNMENT: the destination's old
    // value is gone by the time the destination is written. `add rax, answer`
    // has a destination that is also a source, so the same sequence would
    // compute `rax = answer` and call it an addition. No scratch fixes that,
    // because a scratch register the source never named is invisible to the
    // `nt_x64_effects` footprint the declaration is built from -- measured,
    // two-sided, in the gate: with a destination that is not rax the oracle
    // publishes no write to rax at all, and with rax as the destination it
    // does. That is why the form is a language decision and not an oversight,
    // and it is why the rule is here rather than guessed at the backend.
    //
    // THE ORDER AGAINST THE FRAME RULE IS DELIBERATE AND IT IS NOT FREE. `add
    // rbp, answer` breaks both rules. The frame rule is checked first, so it
    // answers E_FRAME and the anchored case above keeps its ten; the oracle
    // reaches the opposite order and answers 400 for the form before 503 for
    // the frame. Both are refusals either way, so the order decides only which
    // code a reader sees, and the one that is already anchored wins.
    //
    // IT IS A SCAN OVER THE OPERAND CHAIN AND NOT A TEST INSIDE THE LOOP, for
    // the order above and one more reason: the loop has already lowered these
    // operands into values, and a refusal raised from inside it would discard
    // records that the frame rule above has already written. A refusal is a
    // refusal, so nothing is observable, but keeping the two rules at one
    // level each is what lets the order between them be read at a glance.
    // The guard is NOT `memory_destination==0`. That branch returns above, so
    // the test would be true on every path that reaches here and a reader
    // would be asked to believe a condition that decides nothing.
    let mut scan:u64=nnext(words,mnemonic);
    let mut position:u64=0;
    while scan!=0 {
        if binding_name(b,words,source,count,scan) {
            if position==0 || (op!=OP_COPY() && constant_binding_name(words,count,source,scan)==false) {
                return refuse(b,E_FORM(),words,count,scan);
            }
        }
        position=position+1;
        scan=nnext(words,scan);
    }
    // AND THE BLOCK IS TOLD, for the same reason and from the same predicate:
    // `set_term` writes the terminator into the block's own `aux` and into
    // `b.term`, and `verify` reads that `aux` back as the block's terminator.
    // A `ud2` that carried the flag but was not registered here would leave the
    // block naming no terminator, which is E_SHAPE again by the check above.
    if op_is_terminator(op)==true { set_term(b,asm); }
    if first_operand!=0 && nindex(words,first_operand)==35 && op_produces(op)
        && op!=OP_CMP() && op!=OP_TEST() {
        let mut load:u64=asm+1;
        while load<=b.records && (get(b,load,0)!=k_load() || get(b,load,4)!=op_value(b,0)) { load=load+1; }
        if load>b.records { return refuse(b,E_SHAPE(),words,count,id); }
        let store:u64=emit(b,k_store(),0,first_operand,words);
        wput(b,store,5,get(b,load,5)); wput(b,store,6,get(b,asm,4)); wput(b,store,8,2);
        wput(b,store,9,get(b,load,9)); wput(b,store,10,get(b,load,10)); wput(b,store,11,get(b,load,11));
        wput(b,store,12,CLASS_ADDRESS()); wput(b,store,13,FLAG_SIDE_EFFECT()+FLAG_MAY_FAULT());
        wput(b,store,14,OP_STORE()); wput(b,store,15,get(b,load,9));
    }
    return 0;
}

// ---- blocks --------------------------------------------------------------
//
// A BASIC BLOCK IS A NEW THING. The NTIR has a `block` node, which is a
// lexical scope in a tree; a basic block is a linear run of operations with
// exactly one terminator and no way to enter it in the middle. Nothing in the
// NTIR says which is which, so this level decides it and records the
// decision: `aux` on a `mir_block` is the id of its terminator, FLAG_ENTRY
// marks the entry, and the loop-header bit is COMPUTED afterwards from the
// edge set rather than guessed while lowering.
fn new_block(b:Builder,words:buf<u64>,count:u64,origin:u64,flags:u64)->u64 {
    let mut record:u64=emit(b,k_block(),0,origin,words);
    wput(b,record,13,flags);
    wput(b,record,14,0);
    wput(b,record,12,CLASS_NONE());
    b.blocks=b.blocks+1;
    b.block=record;
    b.parent=record;
    b.depth=3;
    b.term=0;
    b.pred=0;
    return record;
}
// A block to write into: the current one when it is open, a fresh one when
// the previous statement closed it. Every block record has the function as
// its parent, so the image is a preorder forest of three levels and the
// ordinal of each record is its index inside its parent.
fn need_block(b:Builder,words:buf<u64>,count:u64,origin:u64)->u64 {
    if b.block!=0 && b.term==0 { return b.block; }
    let mut func:u64=b.func;
    b.parent=func;
    b.depth=2;
    return new_block(b,words,count,origin,0);
}
// Close a block with an edge to `target`, when nothing closed it already.
fn close_block(b:Builder,words:buf<u64>,count:u64,origin:u64,target:u64)->u64 {
    if b.term!=0 { return b.term; }
    let mut record:u64=emit(b,k_jump(),0,origin,words);
    wput(b,record,5,target);
    wput(b,record,8,1);
    wput(b,record,13,FLAG_TERMINATOR());
    wput(b,record,14,b.block);
    return set_term(b,record);
}
fn STMT_DEPTH_CAP()->u64 { return 64; }
fn all_lets(words:buf<u64>,count:u64,node:u64)->bool {
    if node==0 || node>count { return false; }
    if nindex(words,node)!=25 { return false; }
    let mut child:u64=nfirst(words,node);
    if child==0 { return false; }
    while child!=0 {
        if nindex(words,child)!=26 { return false; }
        child=nnext(words,child);
    }
    return true;
}
fn body(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,node:u64,depth:u64)->u64 {
    if depth>STMT_DEPTH_CAP() { return refuse(b,E_INPUT(),words,count,node); }
    let mut child:u64=nfirst(words,node);
    while child!=0 && b.code==0 {
        // W170 INSTRUMENT: the third of the three per-record walks, and the
        // one that matters most for this row, because a statement -- and so a
        // refusal raised while filling a statement's records -- is walked here.
        // The three are `unit`, `callable` and `body`; a clear in only two of
        // them is a clear that leaves one population reporting the previous
        // record's rule, which is the defect the instrument exists to prevent.
        b.stamp=0;
        b.stamp_line=0;
        stmt(b,words,count,source,child,depth);
        child=nnext(words,child);
    }
    return b.code;
}
// One statement. The dispatch is on the NTIR kind and every arm either
// produces the records the statement means or refuses with its position.
// There is no arm that produces nothing and returns success: a statement this
// level cannot lower is a refusal, never a silent omission.
// A plain block has no control transfer of its own. Its local name/type
// bindings end with that lexical block; physical register cells do not.
fn scoped_block(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    let saved_count:u64=b.type_count;
    let size:u64=saved_count*TYPE_WORDS();
    let saved:buf<u64>=alloc(runtime(),size);
    if len(saved)!=size { rt_free(runtime(),saved);return refuse(b,E_INPUT(),words,count,id); }
    let types:buf<u64>=b.types;
    let mut i:u64=0;while i<size { saved[i]=types[i];i=i+1; }
    body(b,words,count,source,id,depth+1);
    i=0;while i<size { types[i]=saved[i];i=i+1; }
    b.type_count=saved_count;rt_free(runtime(),saved);
    return b.code;
}
fn stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    if b.code!=0 { return b.code; }
    if id==0 || id>count { return refuse(b,E_LINK(),words,count,id); }
    let mut index:u64=nindex(words,id);
    if index==25 { return scoped_block(b,words,count,source,id,depth); }
    if index==26 { return let_stmt(b,words,count,source,id,depth); }
    if index==28 { return call_stmt(b,words,count,source,id,depth); }
    if index==29 { return return_stmt(b,words,count,source,id,depth); }
    if index==30 { return if_stmt(b,words,count,source,id,depth); }
    if index==32 { return instruction(b,words,count,source,id,depth); }
    if index==33 { return label_stmt(b,words,count,source,id); }
    if index==46 { return align_stmt(b,words,count,source,id,depth); }
    return refuse(b,E_INPUT(),words,count,id);
}
// A `let` becomes a VIRTUAL REGISTER, a definition site with a value number
// and no location. The declared type is registered against the name's span so
// the expressions after it can be typed, and the initializer is COERCED into
// the declared type — the conversion records are where a machine level earns
// its keep, because the NTIR typed the declaration and stopped there.
fn let_stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    let mut name:u64=nfirst(words,id);
    if name==0 || name>count { return refuse(b,E_INPUT(),words,count,id); }
    let mut type_node:u64=nnext(words,name);
    let mut init:u64=nnext(words,type_node);
    if type_node==0 { return refuse(b,E_INPUT(),words,count,id); }
    if nspace(words,type_node)!=0 { space_record(b,words,count,type_node); }
    declare_name(b,words,count,source,name,type_node);
    let mut record:u64=emit(b,k_vreg(),0,id,words);
    let mut value:u64=new_value(b);
    wput(b,record,4,value);
    wput(b,record,9,nwidth(words,type_node));
    wput(b,record,10,nsigned(words,type_node));
    wput(b,record,11,nspace(words,type_node));
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,14,0);
    let old_width:u64=b.want_width; let old_signed:u64=b.want_signed;
    b.want_width=nwidth(words,type_node); b.want_signed=nsigned(words,type_node);
    let mut got:Value=expr(b,words,count,source,init,depth+1);
    b.want_width=old_width; b.want_signed=old_signed;
    if b.code!=0 { return b.code; }
    coerce(b,words,count,id,value,nwidth(words,type_node),nsigned(words,type_node),got);
    if b.code!=0 { return b.code; }
    type_define(b,source,nstart(words,name),nend(words,name),value);
    return 0;
}
// A call is a machine CALL with a resolved arity, a callee symbol and a value
// for its result. The arity is a count this level computed and not a
// declaration it read: the NTIR call node carries no arity word anywhere.
fn call_stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    let mut callee:u64=nfirst(words,id);
    if callee==0 || callee>count { return refuse(b,E_INPUT(),words,count,id); }
    let mut symbol:u64=symbol_of(b,source,words,count,callee);
    if symbol==0 { return refuse(b,E_INPUT(),words,count,callee); }
    let args:buf<u64>=alloc(runtime(),64);
    let mut child:u64=nnext(words,callee);let mut taken:u64=0;
    let mut width:u64=0;let mut signed:u64=2;let mut space:u64=0;
    while child!=0 {
        if taken>=64 { rt_free(runtime(),args);return refuse(b,E_ARITY(),words,count,child); }
        let got:Value=expr(b,words,count,source,child,depth+1);
        if b.code!=0 { rt_free(runtime(),args);return b.code; }
        args[taken]=got.id;width=got.width;signed=got.signed;space=got.space;
        taken=taken+1;child=nnext(words,child);
    }
    let record:u64=emit(b,k_call(),id,0,words);let value:u64=new_value(b);
    wput(b,record,4,value);wput(b,record,5,symbol);
    wput(b,record,9,width);wput(b,record,10,signed);wput(b,record,11,space);
    let mut k:u64=0;child=nnext(words,callee);
    while k<taken {
        if k<2 { wput(b,record,6+k,args[k]); }
        else {
            let extra:u64=emit(b,k_call_arg(),child,0,words);
            wput(b,extra,5,args[k]);wput(b,extra,6,record);wput(b,extra,8,2);wput(b,extra,14,k);
        }
        k=k+1;child=nnext(words,child);
    }
    rt_free(runtime(),args);
    // `arg_count` IS HOW MANY OF arg_a, arg_b AND arg_c ARE LIVE (the layout
    // table above, field 8), and the callee occupies arg_a on EVERY call,
    // written above whether or not an argument follows it. So the count is
    // one plus the arguments, and writing the bare argument count left arg_b
    // live-in-fact and dead-in-fact at the same time: `verify` reads a record
    // whose slot is past arg_count and carrying a value as the forbidden
    // shape, a value in a slot the record says is not there, and refused the
    // whole call at E_SHAPE. That is why EVERY call with one or more
    // arguments was refused and a zero-argument call was not: the count only
    // diverged once an argument existed to write.
    let mut inline_count:u64=taken+1;if inline_count>3 { inline_count=3; }
    wput(b,record,8,inline_count);
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_SIDE_EFFECT()+FLAG_MAY_FAULT());
    wput(b,record,14,taken);
    wput(b,record,15,OP_CALL());
    let declaration:u64=declared_callable(words,count,source,nstart(words,callee),nend(words,callee));
    if declaration==0 { return refuse(b,E_INPUT(),words,count,callee); }
    let result:u64=declared_result(words,count,declaration);
    if result!=0 { wput(b,record,9,nwidth(words,result)); wput(b,record,10,nsigned(words,result)); }
    else { wput(b,record,4,0); }
    wput(b,record,23,call_mask(words,count,source,declaration));
    if (get(b,record,23)&131072)!=0 && get(b,record,4)!=0 { b.pred=get(b,record,4); }
    return 0;
}
fn return_stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    need_block(b,words,count,id);
    if b.code!=0 { return b.code; }
    let mut record:u64=emit(b,k_return(),id,0,words);
    let mut child:u64=nfirst(words,id);
    if child!=0 {
        let mut got:Value=expr(b,words,count,source,child,depth+1);
        if b.code!=0 { return b.code; }
        wput(b,record,5,got.id);
        wput(b,record,8,1);
        wput(b,record,9,got.width);
        wput(b,record,10,got.signed);
        wput(b,record,11,got.space);
    }
    wput(b,record,12,CLASS_NONE());
    wput(b,record,13,FLAG_TERMINATOR());
    wput(b,record,14,OP_RET());
    set_term(b,record);
    return 0;
}
// A label opens a block, and every jump that named it is patched to point
// there. That forward reference is the only one in the image: the verifier
// refuses at 933 any `mir_jump` whose target is still zero, so an unresolved
// jump cannot survive into an image that verifies.
fn label_stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    let mut name:u64=nfirst(words,id);
    if name==0 || name>count { return refuse(b,E_INPUT(),words,count,id); }
    symbol_of(b,source,words,count,name);
    let mut func:u64=b.func;
    // THE BLOCK THAT ENDED JUST BEFORE THIS LABEL, TAKEN BEFORE `new_block`
    // OVERWRITES IT. `new_block` assigns `b.block=record`, so the first
    // version -- which read `b.block` AFTER the call -- got the label's OWN
    // block back, filed the fall-through edge under the new block, and made
    // that edge a jump from the label's block to itself. The block the edge
    // was meant to leave kept `aux=0`, so it had no terminator at all, and
    // the verifier read the missing terminator and refused. Correct
    // behaviour on a malformed image, and an answer that has nothing to do
    // with jumping to a label.
    let mut previous:u64=b.block;
    let mut previous_open:bool=previous!=0 && b.term==0;
    // THE FALL-THROUGH EDGE IS EMITTED BEFORE THE LABEL'S OWN BLOCK, and that
    // order is this repair's second half. The edge is a child of the block that
    // ended here, so it belongs inside that block's run of children; emitting
    // it afterwards put it after the label's block record, and a record whose
    // parent is not on the open ancestor chain is not a tree position at all.
    // `new_block` writes the very next record, so the block this edge reaches
    // is `b.records+1` and the forward reference costs nothing to express.
    //
    // IT IS EMITTED WHENEVER THE PREVIOUS BLOCK IS STILL OPEN, with no question
    // asked about whether some jump already named this label. Those are two
    // different edges: `jmp L` reaches L's block from elsewhere, and the block
    // before `L:` reaches it by running off the end of itself, and a label can
    // have both. Gating the fall-through on "no jump named this label" left the
    // preceding block with no terminator at all on any label a jump named, and
    // `verify` reads a block that names no terminator as a shape error -- which
    // is what `jmp L2 / L1: / nop / L2:` still answered before this line
    // changed.
    if previous_open {
        b.parent=previous;
        b.depth=3;
        let mut record:u64=emit(b,k_jump(),0,id,words);
        let mut target:u64=b.records+1;
        wput(b,record,5,target);
        wput(b,record,8,1);
        wput(b,record,13,FLAG_TERMINATOR());
        wput(b,record,14,previous);
        set_term(b,record);
    }
    b.parent=func;
    b.depth=2;
    let mut block:u64=new_block(b,words,count,id,0);
    let mut pending:u64=pend_resolve(b,block,source,nstart(words,name),nend(words,name));
    b.rev_count=b.rev_count+1;
    let mut at_rv:u64=(b.rev_count-1)*3;
    b.rev[at_rv]=block;
    b.rev[at_rv+1]=nstart(words,name);
    b.rev[at_rv+2]=nend(words,name);
    b.sp_label=nstart(words,name);
    // THE COUNT pend_resolve RETURNS, KEPT INSTEAD OF DISCARDED.  It was
    // assigned to a local and read by nobody, so the file could not tell
    // "the two spans differ" from "the pass matched nothing" -- the two
    // explanations for an explicit jump keeping a zero target.  This is the
    // second time this file computed a fact and dropped it; the first was
    // loop_headers, published at report[6].
    b.pend_hits=b.pend_hits+pending;
    return 0;
}
fn align_stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    let mut amount_node:u64=nfirst(words,id);
    if amount_node==0 { return refuse(b,E_INPUT(),words,count,id); }
    let mut got:Value=expr(b,words,count,source,amount_node,depth+1);
    if b.code!=0 { return b.code; }
    let mut magnitude:u64=scale_of(words,count,source,amount_node);
    if magnitude==0 { return refuse(b,E_INPUT(),words,count,id); }
    let mut record:u64=emit(b,k_align(),id,0,words);
    wput(b,record,5,got.id);
    wput(b,record,8,1);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,13,FLAG_PURE());
    wput(b,record,14,magnitude);
    wput(b,record,15,OP_ALIGN());
    return 0;
}
// A SELECT or a DIAMOND, decided by a property of the NTIR subtree and not by
// taste. An `if` with no else arm whose arm does nothing but assign is a
// value-level choice, and lowering that to three blocks would be a lie about
// what the program does. Everything else becomes a branch, two blocks and a
// merge, because the arms have effects this level has to keep.
fn if_stmt(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,depth:u64)->u64 {
    let mut condition:u64=nfirst(words,id);
    if condition==0 { return refuse(b,E_INPUT(),words,count,id); }
    let mut then_node:u64=nnext(words,condition);
    let mut else_node:u64=0;
    if then_node!=0 { else_node=nnext(words,then_node); }
    let mut predicate:Value=expr(b,words,count,source,condition,depth+1);
    if b.code!=0 { return b.code; }
    if else_node==0 && all_lets(words,count,then_node) {
        let mut assign:u64=nfirst(words,then_node);
        let mut name_node:u64=nfirst(words,assign);
        let mut type_node:u64=nnext(words,name_node);
        let mut init:u64=nnext(words,type_node);
        let mut arm:Value=expr(b,words,count,source,init,depth+1);
        if b.code!=0 { return b.code; }
        let mut record:u64=emit(b,k_select(),0,id,words);
        let mut value:u64=new_value(b);
        wput(b,record,4,value);
        wput(b,record,5,predicate.id);
        wput(b,record,6,arm.id);
        wput(b,record,7,0);
        wput(b,record,8,2);
        wput(b,record,9,arm.width);
        wput(b,record,10,arm.signed);
        wput(b,record,12,CLASS_VALUE());
        wput(b,record,13,FLAG_PURE());
        wput(b,record,14,OP_BRANCH());
        return 0;
    }
    if then_node==0 { return refuse(b,E_INPUT(),words,count,id); }
    need_block(b,words,count,id);
    if b.code!=0 { return b.code; }
    let mut branch:u64=emit(b,k_branch(),0,id,words);
    wput(b,branch,5,predicate.id);
    // THREE OPERANDS ARE WRITTEN -- the predicate, the block taken and the
    // block skipped -- so `arg_count` is three. It was one, which declared
    // slots 1 and 2 dead, and `verify` reads a dead slot that carries a value
    // as a shape error. Nothing read it before because nothing got this far:
    // the record was refused on the forest rule first, so a second defect was
    // sitting behind the first one. `arg_is` already says what the slots are --
    // 1 for the predicate, 2 for each of the two links -- and `finalize`
    // already reads slots 1 and 2 unconditionally.
    wput(b,branch,8,3);
    wput(b,branch,12,CLASS_PREDICATE());
    wput(b,branch,13,FLAG_TERMINATOR());
    wput(b,branch,14,OP_BRANCH());
    set_term(b,branch);
    let mut func:u64=b.func;
    // EACH BLOCK IS EMITTED WITH ITS OWN CONTENTS, which is the other half of
    // the order repair. The three block records used to be created back to
    // back and their operations afterwards, so the image read
    // entry, branch, THEN, ELSE, MERGE, <then's operations>, <else's>, <merge's>
    // and a record whose parent is not on the open ancestor chain is not a tree
    // position at all -- three sibling blocks under one function cannot be
    // spelled at all that way. A block's operations are its children, so they
    // belong inside the block's own run.
    //
    // THE MERGE IS THE LAST BLOCK CREATED, so no arm knows its id while the arm
    // is being emitted. The two closing edges are therefore written with a
    // target of zero and patched once the merge exists, and an arm that closed
    // itself -- a `return`, which ends the block -- has no edge to patch at
    // all. `close_block` returns whatever already closed the block, so the
    // patch is guarded on the block having been open when it was called.
    b.parent=func;
    b.depth=2;
    let mut taken_block:u64=new_block(b,words,count,then_node,0);
    b.block=taken_block;
    b.parent=taken_block;
    b.depth=3;
    b.term=0;
    body(b,words,count,source,then_node,depth+1);
    if b.code!=0 { return b.code; }
    let mut taken_open:bool=b.term==0;
    let mut taken_edge:u64=close_block(b,words,count,then_node,0);
    let mut skipped_block:u64=0;
    let mut skipped_edge:u64=0;
    if else_node!=0 {
        b.parent=func;
        b.depth=2;
        skipped_block=new_block(b,words,count,else_node,0);
        b.block=skipped_block;
        b.parent=skipped_block;
        b.depth=3;
        b.term=0;
        body(b,words,count,source,else_node,depth+1);
        if b.code!=0 { return b.code; }
        let mut skipped_open:bool=b.term==0;
        skipped_edge=close_block(b,words,count,else_node,0);
        if skipped_open==false { skipped_edge=0; }
    }
    b.parent=func;
    b.depth=2;
    let mut merge:u64=new_block(b,words,count,id,0);
    wput(b,branch,6,taken_block);
    if skipped_block!=0 { wput(b,branch,7,skipped_block); }
    else { wput(b,branch,7,merge); }
    if taken_open==true { wput(b,taken_edge,5,merge); }
    if skipped_edge!=0 { wput(b,skipped_edge,5,merge); }
    b.block=merge;
    b.parent=merge;
    b.depth=3;
    b.term=0;
    // The merge point, and the phi that names the blocks that arrive at it.
    // `arg_count` is the number of incoming blocks this level counted, and BOTH
    // BRANCHES OF THE MERGE ARE WRITTEN IN BOTH CASES: with no else arm the
    // second arrival is the branch's own false edge, which lands on the merge,
    // so slot 1 names the merge. It was written without being counted, so the
    // slot was dead and carried a value, and `verify` reads a dead slot that
    // carries a value as a shape error -- on every `if` with no else arm, and
    // only on those.
    let mut phi:u64=emit(b,k_phi(),0,id,words);
    wput(b,phi,5,taken_block);
    wput(b,phi,8,2);
    wput(b,phi,12,CLASS_NONE());
    wput(b,phi,13,FLAG_PURE());
    if skipped_block!=0 { wput(b,phi,6,skipped_block); }
    else { wput(b,phi,6,merge); }
    return 0;
}

// MIR1.1 signature type trees retain pointer element facts. Metadata only:
// arg_a declaration owner, arg_b element type, arg_c parameter name symbol.
// aux:0 scalar,1 pointer,2 array; aux2 array length; NAMED marks the root.
fn signature_type(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,owner:u64,name:u64,root:bool,depth:u64)->u64 {
    if depth>64 || id==0 || id>count || nindex(words,id)!=37 { refuse(b,E_TYPED(),words,count,id);return 0; }
    let mut symbol:u64=0;
    if name!=0 { symbol=symbol_of(b,source,words,count,name); }
    let r:u64=emit(b,k_type_decl(),id,0,words);
    wput(b,r,5,owner);wput(b,r,8,3);wput(b,r,9,nwidth(words,id));
    wput(b,r,10,nsigned(words,id));wput(b,r,11,nspace(words,id));wput(b,r,12,CLASS_NONE());
    if root { wput(b,r,13,FLAG_PURE()+FLAG_NAMED()); }else { wput(b,r,13,FLAG_PURE()); }
    let first:u64=nfirst(words,id);let second:u64=nnext(words,first);
    if first==0 || first>count { refuse(b,E_TYPED(),words,count,id);return 0; }
    if second!=0 {
        let mut element:u64=second;
        if nindex(words,first)==37 { element=first;wput(b,r,14,2);wput(b,r,15,naux(words,second)); }
        else { wput(b,r,14,1); }
        let child:u64=signature_type(b,words,count,source,element,owner,0,false,depth+1);
        if b.code!=0 { return 0; }wput(b,r,6,child);
    }
    if symbol!=0 { wput(b,r,7,symbol); }
    return r;
}

// Contract facts use ordinary parent/ordinal metadata; tree links are explicit.
// form15: 1 feature,2 predicate,3 parameter,4 literal,5 name,6 operation.
// word20 links siblings,21 holds C opcode;22/23 stay zero.
fn contract_op(code:u64)->u64 {
    if code<=5 { return code; }
    if code==8 { return 6; }if code==9 { return 7; }if code==10 { return 8; }
    if code==17 { return 9; }if code==18 { return 10; }
    if code==13 { return 11; }if code==14 { return 12; }
    if code==6 { return 13; }if code==15 { return 14; }
    if code==7 { return 15; }if code==16 { return 16; }
    if code==19 { return 20; }if code==20 { return 21; }return 0;
}
fn contract_new(b:Builder,words:buf<u64>,id:u64,owner:u64,clause:u64,form:u64,root:bool)->u64 {
    let r:u64=emit(b,k_contract_expr(),id,0,words);
    wput(b,r,5,owner);wput(b,r,8,2);wput(b,r,10,SIGNED_NONE());wput(b,r,13,FLAG_PURE());
    if root { wput(b,r,13,FLAG_PURE()+FLAG_NAMED()); }
    wput(b,r,14,clause);wput(b,r,15,form);return r;
}
fn contract_arg(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,owner:u64,clause:u64,depth:u64)->u64 {
    if id==0 || id>count || depth>64 { refuse(b,E_INPUT(),words,count,id);return 0; }
    let index:u64=nindex(words,id);let first:u64=nfirst(words,id);
    if index==36 {
        if first==0 { refuse(b,E_INPUT(),words,count,id);return 0; }
        let second:u64=nnext(words,first);let mut op:u64=0;
        if second!=0 { op=contract_op(binary_op(source,words,count,id)); }
        else { let u:u64=unary_op(source,words,count,id);if u==2 { op=17; }if u==11 { op=18; } }
        if op!=0 {
            let r:u64=contract_new(b,words,id,owner,clause,6,false);wput(b,r,8,3);wput(b,r,21,op);
            let left:u64=contract_arg(b,words,count,source,first,owner,clause,depth+1);wput(b,r,6,left);
            if second!=0 { let right:u64=contract_arg(b,words,count,source,second,owner,clause,depth+1);wput(b,r,7,right); }
            return r;
        }
        if second==0 { return contract_arg(b,words,count,source,first,owner,clause,depth+1); }
        refuse(b,E_INPUT(),words,count,id);return 0;
    }
    if index==51 {
        let m:Magnitude=read_literal_value(source,nstart(words,id),nend(words,id));
        if m.ok==false { refuse(b,E_INPUT(),words,count,id);return 0; }
        let r:u64=contract_new(b,words,id,owner,clause,4,false);wput(b,r,8,3);wput(b,r,6,m.value);wput(b,r,9,64);wput(b,r,10,0);return r;
    }
    if index==47 || index==48 {
        let yes:buf<u8>="true";let no:buf<u8>="false";
        let is_yes:bool=span_is(source,nstart(words,id),nend(words,id),yes);
        if is_yes || span_is(source,nstart(words,id),nend(words,id),no) {
            let r:u64=contract_new(b,words,id,owner,clause,4,false);wput(b,r,8,3);wput(b,r,9,1);wput(b,r,10,0);if is_yes { wput(b,r,6,1); }return r;
        }
        let mut p:u64=owner+1;
        while p<=b.records {
            if get(b,p,0)==k_type_decl() && get(b,p,7)!=0 {
                let formal:u64=get(b,p,5);let sym:u64=get(b,p,7);
                if get(b,formal,0)==k_param() && get(b,formal,16)==owner && same4(source,nstart(words,id),nend(words,id),get(b,sym,5),get(b,sym,6)) {
                    let r:u64=contract_new(b,words,id,owner,clause,3,false);wput(b,r,6,get(b,formal,14));return r;
                }
            }
            p=p+1;
        }
        let r:u64=contract_new(b,words,id,owner,clause,5,false);
        let sym:u64=symbol_of(b,source,words,count,id);wput(b,r,6,sym);return r;
    }
    refuse(b,E_INPUT(),words,count,id);return 0;
}
fn contract_clause(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,owner:u64,clause:u64,depth:u64)->u64 {
    if id==0 || id>count || depth>64 { return refuse(b,E_INPUT(),words,count,id); }
    let index:u64=nindex(words,id);
    if index==22 || index==23 {
        let mut child:u64=nfirst(words,id);let mut seen:u64=0;
        while child!=0 && child<=count && seen<count && b.code==0 {
            contract_clause(b,words,count,source,child,owner,clause,depth+1);
            child=nnext(words,child);seen=seen+1;
        }
        if child!=0 { return refuse(b,E_LINK(),words,count,id); }return b.code;
    }
    if index!=34 { return refuse(b,E_INPUT(),words,count,id); }
    let name:u64=nfirst(words,id);if name==0 || name>count { return refuse(b,E_LINK(),words,count,id); }
    let feature:buf<u8>="feature";let arg:u64=nnext(words,name);
    if span_is(source,nstart(words,name),nend(words,name),feature) {
        if arg==0 || arg>count || nnext(words,arg)!=0 { return refuse(b,E_ARITY(),words,count,id); }
        let r:u64=contract_new(b,words,id,owner,clause,1,true);
        let sym:u64=symbol_of(b,source,words,count,arg);wput(b,r,6,sym);return b.code;
    }
    let r:u64=contract_new(b,words,id,owner,clause,2,true);wput(b,r,8,3);
    let sym:u64=symbol_of(b,source,words,count,name);wput(b,r,6,sym);
    let mut a:u64=arg;let mut previous:u64=0;let mut seen:u64=0;
    while a!=0 && a<=count && seen<count && b.code==0 {
        let child:u64=contract_arg(b,words,count,source,a,owner,clause,0);
        if previous==0 { wput(b,r,7,child); }else { wput(b,previous,20,child); }
        previous=child;a=nnext(words,a);seen=seen+1;
    }
    if a!=0 { return refuse(b,E_LINK(),words,count,id); }return b.code;
}
fn contract_arity(hash:u64)->u64 {
    let one:buf<u8>="non_null";if hash==fnv(one,0,len(one)) { return 1; }
    let two:buf<u8>="canonical";if hash==fnv(two,0,len(two)) { return 1; }
    let three:buf<u8>="stack_in";if hash==fnv(three,0,len(three)) { return 1; }
    let four:buf<u8>="stack_aligned";if hash==fnv(four,0,len(four)) { return 1; }
    let five:buf<u8>="msr_initialized";if hash==fnv(five,0,len(five)) { return 1; }
    let six:buf<u8>="interrupts_enabled";if hash==fnv(six,0,len(six)) { return 0; }
    let seven:buf<u8>="interrupts_disabled";if hash==fnv(seven,0,len(seven)) { return 0; }
    let eight:buf<u8>="mapping_present";if hash==fnv(eight,0,len(eight)) { return 1; }
    let nine:buf<u8>="valid_user_return";if hash==fnv(nine,0,len(nine)) { return 2; }
    return 3;
}
fn contract_tree_depth(words:buf<u64>,count:u64,r:u64,depth:u64)->bool {
    if r==0 { return true; }if r>count || depth>64 { return false; }
    let form:u64=words[at(r)+15];
    if form==2 {
        let mut child:u64=words[at(r)+7];let mut seen:u64=0;
        while child!=0 && seen<count { if child<=r || child>count || contract_tree_depth(words,count,child,depth+1)==false { return false; }child=words[at(child)+20];seen=seen+1; }
        return child==0;
    }
    if form==6 {
        if contract_tree_depth(words,count,words[at(r)+6],depth+1)==false { return false; }
        return contract_tree_depth(words,count,words[at(r)+7],depth+1);
    }
    return true;
}
fn verify_contract_facts(words:buf<u64>,count:u64,out:buf<u64>)->u64 {
    let mut r:u64=1;
    while r<=count {
        let base:u64=at(r);
        if words[base]==k_contract_expr() {
            let owner:u64=words[base+5];let a:u64=words[base+6];let b:u64=words[base+7];let form:u64=words[base+15];
            let root:bool=(words[base+13]&FLAG_NAMED())!=0;
            if owner==0 || owner>=r || words[at(owner)]!=k_function() { return place(out,words,r,E_LINK()); }
            if words[base+16]!=owner || words[base+4]!=0 || words[base+12]!=CLASS_NONE() { return place(out,words,r,E_SHAPE()); }
            if words[base+14]!=1 && words[base+14]!=2 { return place(out,words,r,E_SHAPE()); }
            if form==0 || form>6 || root!=(form==1 || form==2) { return place(out,words,r,E_SHAPE()); }
            let mut flags:u64=FLAG_PURE();if root { flags=flags+FLAG_NAMED(); }
            if words[base+13]!=flags || words[base+22]!=0 || words[base+23]!=0 { return place(out,words,r,E_SHAPE()); }
            let mut slots:u64=2;if form==2 || form==4 || form==6 { slots=3; }
            if words[base+8]!=slots { return place(out,words,r,E_SHAPE()); }
            if form!=4 && (words[base+9]!=0 || words[base+10]!=SIGNED_NONE() || words[base+11]!=0) { return place(out,words,r,E_TYPED()); }
            if form==1 || form==2 || form==5 { if a==0 || a>count || words[at(a)]!=k_symbol() || words[at(a)+16]!=owner { return place(out,words,r,E_LINK()); } }
            if form==3 && a>=words[at(owner)+14] { return place(out,words,r,E_ARITY()); }
            if form==4 && (b>1 || words[base+10]!=0 || (words[base+9]!=1 && words[base+9]!=64) || words[base+11]!=0) { return place(out,words,r,E_TYPED()); }
            if form==4 && words[base+9]==1 && (a>1 || b!=0) { return place(out,words,r,E_TYPED()); }
            if form!=6 && words[base+21]!=0 { return place(out,words,r,E_SHAPE()); }
            if root && words[base+20]!=0 { return place(out,words,r,E_SHAPE()); }
            let op:u64=words[base+21];if form==6 && (op==0 || op>21 || a==0 || ((op>=17 && op<=19) && b!=0) || ((op<17 || op>19) && b==0)) { return place(out,words,r,E_ARITY()); }
            let mut link:u64=0;let mut slot:u64=0;
            while slot<3 {
                link=0;if slot==0 { link=words[base+20]; }if slot==1 && form==6 { link=a; }if slot==2 && (form==6 || form==2) { link=b; }
                if link!=0 { if link<=r || link>count || words[at(link)]!=k_contract_expr() || words[at(link)+5]!=owner || words[at(link)+14]!=words[base+14] || (words[at(link)+13]&FLAG_NAMED())!=0 { return place(out,words,r,E_LINK()); } }
                slot=slot+1;
            }
            if form==6 && (words[at(a)+20]!=0 || (b!=0 && words[at(b)+20]!=0)) { return place(out,words,r,E_SHAPE()); }
            if form==2 {
                let want:u64=contract_arity(words[at(a)+14]);let mut got:u64=0;let mut child:u64=b;
                while child!=0 && child<=count && got<=2 { got=got+1;child=words[at(child)+20]; }
                if want>2 || got!=want || child!=0 { return place(out,words,r,E_ARITY()); }
            }
            let mut incoming:u64=0;let mut q:u64=1;
            while q<r {
                if words[at(q)]==k_contract_expr() {
                    let qf:u64=words[at(q)+15];if words[at(q)+20]==r { incoming=incoming+1; }
                    if qf==6 && words[at(q)+6]==r { incoming=incoming+1; }
                    if (qf==6 || qf==2) && words[at(q)+7]==r { incoming=incoming+1; }
                }
                q=q+1;
            }
            if (root && incoming!=0) || (root==false && incoming!=1) { return place(out,words,r,E_SHARED()); }
            if root && contract_tree_depth(words,count,r,0)==false { return place(out,words,r,E_CYCLE()); }
        }
        if words[base]==k_function() {
            let mut roots:u64=0;let mut q:u64=1;
            while q<=count { if words[at(q)]==k_contract_expr() && words[at(q)+5]==r && (words[at(q)+13]&FLAG_NAMED())!=0 { roots=roots+1; }q=q+1; }
            let flag:bool=(words[base+13]&FLAG_PREDICATED())!=0;
            if (flag && roots==0) || (flag==false && roots!=0) { return place(out,words,r,E_SHAPE()); }
        }
        r=r+1;
    }
    return 0;
}
// ---- declarations --------------------------------------------------------
fn param(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,ordinal:u64)->u64 {
    let mut name:u64=nfirst(words,id);
    if name==0 || name>count { return refuse(b,E_INPUT(),words,count,id); }
    let mut type_node:u64=nnext(words,name);
    let mut reg:u64=nnext(words,type_node);
    if type_node!=0 && type_node<=count {
        if nspace(words,type_node)!=0 { space_record(b,words,count,type_node); }
        declare_name(b,words,count,source,name,type_node);
    }
    // MIR/0.3: the direction is NOT read here (see FLAG_DIR_UNREAD): the
    // record says so, and machine_pipeline.lower_tree replaces the bit with
    // abi.direction's answer.
    let direction:u64=FLAG_DIR_UNREAD();
    let mut record:u64=emit(b,k_param(),id,0,words);
    let mut value:u64=new_value(b);
    wput(b,record,4,value);
    if type_node!=0 && type_node<=count {
        wput(b,record,9,nwidth(words,type_node));
        wput(b,record,10,nsigned(words,type_node));
        wput(b,record,11,nspace(words,type_node));
    }
    wput(b,record,12,CLASS_VALUE());
    wput(b,record,13,FLAG_PURE()+direction);
    wput(b,record,14,ordinal);
    // MIR/0.3: zero is unbound; 1..16 preserve the explicit GPR family from NTIR.
    wput(b,record,15,nclass(words,id));
    // THE WHOLE OF THE BINDING. A parameter written `in x:u64 @rax` reaches
    // this level as a width, because `mir_bind.aux` is the width the target
    // must satisfy and nothing else. The register, the family and the
    // direction are all the NTIR's business and this record's aux is the only
    // one of them that survives.
    if reg!=0 && reg<=count {
        bind_write(b,words,source,count,reg,value);
        wput(b,record,21,cell_offset(words,source,reg));
    }
    type_define(b,source,nstart(words,name),nend(words,name),value);
    signature_type(b,words,count,source,type_node,record,name,true,0);
    return b.code;
}
fn abi_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,owner:u64,named:u64)->u64 {
    let mut record:u64=emit(b,k_abi(),id,0,words);
    wput(b,record,6,owner);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,13,named*FLAG_NAMED());
    let mut dashed:u64=nfirst(words,id);
    if dashed!=0 && dashed<=count {
        wput(b,record,14,fnv(source,nstart(words,dashed),nend(words,dashed)));
    }
    wput(b,record,15,owner);
    return 0;
}
// A DECLARED SET becomes one record per entry plus a set record, so an empty
// set is still a fact in the image rather than an absence. `arg_count` says
// whether this record is a set (0) or an entry (1), and `aux2` is the record
// of the function the set belongs to — a LINK the NTIR does not have, since
// an effects node in the tree hangs off nothing but its position.
fn effect_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,owner:u64)->u64 {
    let mut record:u64=emit(b,k_effect(),0,id,words);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,15,owner);
    let mut first:u64=nfirst(words,id);
    if first==0 { return 0; }
    let mut child:u64=first;
    let mut ordinal:u64=0;
    while child!=0 && child<=count {
        let mut symbol:u64=symbol_of(b,source,words,count,child);
        if symbol==0 { return refuse(b,E_INPUT(),words,count,child); }
        wput(b,record,5,symbol);
        wput(b,record,8,1);
        wput(b,record,14,ordinal);
        ordinal=ordinal+1;
        child=nnext(words,child);
    }
    return 0;
}
// A CLOBBER keeps its WIDTH and drops its register, for the same reason a
// binding does: a machine level states the constraint, the target satisfies
// it. The clobbered spelling still becomes a binding cell, because the NTIR
// typed it as a register and an admitted node must be attributed.
fn clobber_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,owner:u64)->u64 {
    let mut record:u64=emit(b,k_clobber(),0,id,words);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,15,owner);
    // MIR/0.3: THE SET ITSELF, as the oracle's own mask in arg_a. The register
    // a clobber names is dropped by the binding cells below -- they keep a
    // width -- and a contract must still say WHICH registers the function may
    // clobber, so the mask is computed here, where the spelling is still in
    // reach, with the same `register_widths.clobber_bit` clobbers.nova
    // summarizes with (rax bit 0 ... r15 bit 15, rflags bit 17). arg_count is 1
    // even for `clobbers {}`, whose mask is a real zero and not an absence.
    wput(b,record,8,1);
    let mut mask:u64=0;
    let mut first:u64=nfirst(words,id);
    if first==0 { return 0; }
    let mut child:u64=first;
    let mut ordinal:u64=0;
    while child!=0 && child<=count {
        let mut head:u64=nfirst(words,child);
        if head!=0 && name_is_register(words,source,count,head) { bind_cell(b,words,source,count,head); }
        if head!=0 && head<=count { wput(b,record,14,nwidth(words,head)); }
        if head==0 || head>count { return refuse(b,E_INPUT(),words,count,child); }
        let bit:u64=register_widths.clobber_bit(source,nstart(words,head),nend(words,head));
        if bit==0 { return refuse(b,E_INPUT(),words,count,head); }
        mask=mask|bit;
        wput(b,record,5,mask);
        ordinal=ordinal+1;
        child=nnext(words,child);
    }
    return 0;
}
// The element type of a type node, for the layout requirements a data
// declaration demands. An array is two children with a type first, a pointer
// is two children with a NAME first, and a scalar is one child: the shape is
// the discriminator because the NTIR dropped the AST aux again.
fn data_element(words:buf<u64>,count:u64,source:buf<u8>,type_node:u64)->u64 {
    if type_node==0 || type_node>count { return 0; }
    let mut first:u64=nfirst(words,type_node);
    let mut second:u64=0;
    if first!=0 { second=nnext(words,first); }
    if second==0 { return type_node; }
    if nindex(words,first)==37 { return first; }
    return type_node;
}
// The element count of an array type, 0 when the type is not an array. The
// length is a literal in the second child, and its magnitude is read through
// the span the NTIR recorded — the same read an immediate needs.
fn array_length(words:buf<u64>,count:u64,source:buf<u8>,type_node:u64)->u64 {
    if type_node==0 || type_node>count { return 0; }
    let mut first:u64=nfirst(words,type_node);
    if first==0 { return 0; }
    let mut second:u64=nnext(words,first);
    if second==0 || second>count { return 0; }
    if nindex(words,first)!=37 { return 0; }
    if nindex(words,second)!=51 { return 0; }
    let mut magnitude:u64=read_magnitude(source,nstart(words,second),nend(words,second));
    if magnitude==0 { return 0; }
    return magnitude-1;
}
// A data or const declaration becomes a LAYOUT DEMAND: the element count, the
// byte alignment the element's width requires and the memory space the
// initializer touches. No section offset and no size appear here: those are
// the object layer's, and a Machine IR that carried them would already be an
// object file.
// AND, FOR A `const` ALONE, THE NAME THE WHOLE UNIT MAY READ. `let_stmt` and
// `param` each finish by registering the name they declared, and a
// module-scope `const` reached neither of them: `name_value` looks a bare
// operand name up in that table and answers 0 for a name nothing ever put
// there, which it reads as a read of something never defined and refuses
// (941). The declaration is not missing and neither is its value -- this
// function has already lowered the initializer through `expr` and holds the
// value number in record word 5. What was missing is the span-keyed entry
// that names that value, and the stage that should write it is the stage
// that produced the value.
//
// ONLY index 10, and `data` (index 24) is excluded on the spec's own
// normative sentence -- "Un `data` n'est pas une liaison, et cette phrase est
// normative", spec/ntasm/ntasm.md:401 -- so a data symbol stays unreadable in
// operand position and keeps its 400 at body_clobbers. Registering it would
// be manufacturing a binding the language says does not exist.
//
// The value written is `got.id`, the number `expr` returned for THIS
// initializer. Nothing is defaulted into the slot: a `const` with no
// initializer writes no entry at all and stays refused, which is a different
// image from a const whose value is zero.
fn data_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,section:u64)->u64 {
    // Data and module constants belong to the unit, even after a function.
    // callable leaves the builder at its last block; do not inherit that scope.
    b.parent=1;b.depth=1;b.block=0;b.term=0;b.func=1;
    let mut name:u64=nfirst(words,id);
    if name==0 || name>count { return refuse(b,E_INPUT(),words,count,id); }
    if nstart(words,name)>nend(words,name) || nend(words,name)>len(source) {
        return refuse(b,E_INPUT(),words,count,name);
    }
    let mut type_node:u64=nnext(words,name);
    let mut init:u64=nnext(words,type_node);
    if type_node==0 || type_node>count { return refuse(b,E_INPUT(),words,count,id); }
    if nspace(words,type_node)!=0 { space_record(b,words,count,type_node); }
    // A `const` is a LITERAL, not a binding (spec/ntasm/ntasm.md:410), and its
    // declared type is what an operand reading it must be checked against, so
    // the entry carries the type child this function already read.
    let mut is_const:bool=nindex(words,id)==10;
    if is_const==true { declare_name(b,words,count,source,name,type_node); }
    let mut element:u64=data_element(words,count,source,type_node);
    let mut length:u64=array_length(words,count,source,type_node);
    let mut record:u64=emit(b,k_data(),id,0,words);
    let mut width:u64=nwidth(words,element);
    wput(b,record,9,width);
    wput(b,record,10,nsigned(words,element));
    wput(b,record,11,nspace(words,element));
    wput(b,record,12,CLASS_CONSTANT());
    // MIR/0.3: the storage section and the export keyword, as flag bits. A
    // `const` (index 10) is reached with section 0 and carries neither storage
    // bit, which is how a consumer tells a literal from a storage location.
    let mut flags:u64=FLAG_PURE();
    if section==2 { flags=flags+FLAG_RDATA(); }
    if section==3 { flags=flags+FLAG_WDATA(); }
    if exported_before(source,nstart(words,id)) { flags=flags+FLAG_EXPORT(); }
    wput(b,record,13,flags);
    wput(b,record,14,length);
    let mut alignment:u64=1;
    if width>=8 { alignment=width/8; }
    if alignment>16 { alignment=16; }
    wput(b,record,15,alignment);
    // MIR/0.3: THE NAME, as the span `mir_function` already uses for its own
    // (arg_b, arg_c), so the record now has three live slots whatever the
    // initializer: arg_a is the initializer's value or 0, which `arg_is`
    // answers 5 for -- a value, and zero is the absence.
    wput(b,record,6,nstart(words,name));
    wput(b,record,7,nend(words,name));
    wput(b,record,8,3);
    if init!=0 && init<=count {
        let mut got:Value=expr(b,words,count,source,init,1);
        if b.code!=0 { return b.code; }
        wput(b,record,5,got.id);
        // The span entry is written with the value the lowering just produced,
        // and only when there IS one: the `init!=0` guard above is the same
        // guard that leaves arg_a at 0 (word 8 is 3 either way since MIR/0.3,
        // because the name span lives in arg_b and arg_c), so the two agree by
        // construction rather than by two conventions.
        if is_const==true {
            type_define(b,source,nstart(words,name),nend(words,name),got.id);
        }
    }
    return 0;
}
// THE DECLARED RESULT, and it is read off the NTIR's OWN TYPE CHILD rather
// than off the source text. ntir.nova's `type_signature` walks the AST
// function's `-> u64` into the TYPE NODE's typed words, so `nwidth` and
// `nsigned` on the `index==37` child answer the question with no re-scan and
// no parse -- the same two accessors `param` uses nine lines below for a
// formal's type, which is why the two agree by construction rather than by
// two conventions.
//
// The flag is set on the CHILD'S BEHALF and the width goes in `aux2`, which
// `mir_function` never used, and `signed` takes the result's signedness. Both
// are written ONLY when a type child exists, so "declares no result" and
// "declares a result" are two different images and not one image with two
// readings -- the lot 62 trap, closed by construction rather than by a check.
fn result_of(b:Builder,words:buf<u64>,record:u64,type_node:u64)->u64 {
    let mut width:u64=nwidth(words,type_node);
    let mut sign:u64=nsigned(words,type_node);
    if sign>2 { sign=2; }
    wput(b,record,15,width);
    wput(b,record,10,sign);
    wput(b,record,13,get(b,record,13)+FLAG_RESULT_TYPED());
    return 0;
}
// A function or an import: the same declaration shape, and the only
// difference is that a function has a body and therefore a CFG.
fn callable(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64,has_body:u64)->u64 {
    // THE DECLARATION'S OWN PARENT AND DEPTH ARE SET BEFORE IT IS EMITTED,
    // not after. A function is a CHILD OF THE UNIT at depth 1, and `emit` reads
    // both words out of the Builder, so the two have to be true at the call.
    //
    // Set after it, as they were, the SECOND callable of a module inherits
    // whatever the FIRST callable's body walk last left in the Builder: the
    // record is written with the previous function's BLOCK as its parent, at
    // depth 3, with an ordinal taken from that block's child counter. The
    // image is then a tree whose root's second child hangs under a leaf three
    // levels down, and the verifier refuses that function's FIRST child with
    // E_SHARED -- correctly, because the child really is outside the open
    // ancestor chain, and wrongly attributed, because the parent link above
    // it is the defect.
    //
    // MEASURED, on the validate gate, before and after: the whole corpus has
    // ONE function per module in every gate that reads a Machine IR image, so
    // the mis-parenting was invisible to all of them; the two-function
    // programs of tests_ntasm_validate.c refused with 936, and the compiled
    // reference accepts the same sources. The unit is record 1 by the format's
    // own field 4 and by the verifier's own `ch0=1`, so 1 is the parent here
    // rather than a remembered value.
    b.parent=1;
    b.depth=1;
    let mut record:u64=emit(b,k_function(),id,0,words);
    // AN IMPORT IS NOT A DIFFERENT KIND, AND SAYING SO WITH FIELD 0 WAS A
    // DEFECT. This used to overwrite the just-emitted kind with k_extern
    // whenever the declaration had no body. Nothing reads that value: k_extern
    // (2052) has four mentions in the tree and all four are here -- the
    // constant, the two kind-name tables, and this write -- so no stage
    // anywhere distinguished an import by it.
    //
    // What it DID cost was the verifier. verify holds three declared-result
    // checks behind `kind==k_function()` and one negative complement at
    // `kind!=k_function()`, which refuses E_SHAPE on any other kind that
    // carries FLAG_RESULT_TYPED. An import that declares a result carries it,
    // result_of having written it at :2552, so every import declaring `-> u64`
    // was refused 934. Widening only the negative guard closes that red but
    // leaves the import wearing k_extern, and so leaves checks 1 and 3
    // -- "the flag without a width" and "a width this level cannot name" --
    // switched off for every import. Removing the write instead leaves the
    // record a k_function and runs all three.
    //
    // Same class as the parent/depth ordering above: a word written into the
    // record AFTER emit() published it, read back by a later pass. Measured,
    // out of tree, on the decls gate, before and after this line: 27 checks,
    // 2 failures -> 0, with corpus_e2e, x64_lower_nxo_pe, validate and splice
    // unmoved.
    wput(b,record,12,CLASS_NONE());
    // MIR/0.3: `export fn`. Written before any child can add its own bit
    // (`result_of` adds FLAG_RESULT_TYPED with get+add), so the order of the
    // two writes does not matter. An import is never exported: index 9 is
    // reached from the unit walk, where no `export` keyword can precede it.
    if has_body!=0 && exported_before(source,nstart(words,id)) { wput(b,record,13,FLAG_EXPORT()); }
    b.func=record;
    b.parent=record;
    b.depth=2;
    b.block=0;
    b.term=0;
    let mut child:u64=nfirst(words,id);
    let mut formals:u64=0;
    while child!=0 && child<=count && b.code==0 {
        let mut index:u64=nindex(words,child);
        // W170 INSTRUMENT: the same clear as in `unit`, and for the same
        // reason. This loop walks a function's own children, which is a
        // different population from the one `unit` walks, so a clear in only
        // one of the two would leave the other reporting the previous record's
        // rule for every record it did not itself refuse.
        b.stamp=0;
        b.stamp_line=0;
        if index==47 {
            // THE FUNCTION S NAME SPAN, AND IT IS THE WORD THAT LETS A CONSUMER
            // TELL TWO PROGRAMS APART.  MEASURED END TO END: renaming
            // fn main to fn main_perturbed produced a BYTE-IDENTICAL object,
            // same length and same FNV, on two independently compiled images,
            // while the gate proved the two SOURCE texts differ.  An object that
            // cannot tell two programs apart is a library, entry is 0, and the
            // PE converter refuses it at 803.
            //
            // 47 is the NTIR INDEX of the name node, not its kind: the kind is
            // 1070.  Two earlier attempts asked for 90 and then for 1070, and
            // both moved nothing, because nindex answers the index and not the
            // kind.  A number is not the thing that transfers between two
            // vocabularies, and the dump never showed which one this was.
            //
            // THE SLOTS ARE THE RECORD S OWN TABLE, read at this file s head:
            // field 5 is arg_a, 6 is arg_b, 7 is arg_c and 8 is arg_count.  The
            // span goes in arg_b and arg_c because that is where
            // machine_x64 reads it from, guarded by arg_count >= 3.
            // THE PRODUCER S OWN BOUND ON THE SPAN IT WRITES.  The consumer
            // reads these two words and NOTHING here checks them: this arm is
            // the only writer of a mir_function name span, and it wrote
            // whatever the NTIR node carried.  The idiom below is the one this
            // file already uses in six other places, so it is not a new
            // convention but the file s own.  A record whose span is inverted
            // or runs past the source is refused HERE, by the writer, rather
            // than by whoever reads it next and trusts it.
            let mut sp0:u64=nstart(words,child);
            let mut sp1:u64=nend(words,child);
            if sp0>sp1 || sp1>len(source) { return refuse(b,E_INPUT(),words,count,id); }
            wput(b,record,6,sp0);
            wput(b,record,7,sp1);
            wput(b,record,8,3);
        } else if index==48 && has_body==0 {
            // MIR/0.3: THE IMPORTED NAME. `import math.add as add` is a
            // qualified target followed by the local name, and the index-47 arm
            // above keeps only the local one in arg_b/arg_c -- the name a call
            // site spells. The target is what the object must import, so it
            // becomes this import's first child, a `mir_symbol` whose span is
            // the qualified spelling and whose depth word counts its dots.
            if symbol_of(b,source,words,count,child)==0 { return refuse(b,E_INPUT(),words,count,child); }
        } else if index==22 || index==23 {
            let before:u64=b.records;
            contract_clause(b,words,count,source,child,record,index-21,0);
            if b.records>before {
                let flags:u64=get(b,record,13);
                if (flags&FLAG_PREDICATED())==0 { wput(b,record,13,flags+FLAG_PREDICATED()); }
            }
        } else if index==19 {
            param(b,words,count,source,child,formals);
            formals=formals+1;
        } else if index==37 {
            if nspace(words,child)!=0 { space_record(b,words,count,child); }
            result_of(b,words,record,child);
            wput(b,record,11,nspace(words,child));
            signature_type(b,words,count,source,child,record,0,true,0);
        } else if index==27 {
            abi_of(b,words,count,source,child,record,1);
        } else if index==20 {
            effect_of(b,words,count,source,child,record);
        } else if index==21 {
            clobber_of(b,words,count,source,child,record);
        } else if index==25 && has_body!=0 {
            b.parent=record;
            b.depth=2;
            let mut entry:u64=new_block(b,words,count,child,FLAG_ENTRY());
            if b.code==0 { wput(b,record,5,entry); }
            if b.native_mode==false { body(b,words,count,source,child,1); }
            if b.code==0 && b.term==0 && b.native_mode==false {
                let mut end:u64=emit(b,k_unreachable(),0,child,words);
                wput(b,end,13,FLAG_TERMINATOR());
                wput(b,end,14,OP_UNREACHABLE());
                set_term(b,end);
            }
        }
        child=nnext(words,child);
    }
    wput(b,record,14,formals);
    return b.code;
}
// The target triple, as a DIGEST. One word of the whole image depends on
// which machine this unit is for, and it is this one: the gate lowers the
// same program for two triples and requires the two images to differ in
// exactly this word and nowhere else.
fn target_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    let mut dashed:u64=nfirst(words,id);
    if dashed==0 || dashed>count { return refuse(b,E_INPUT(),words,count,id); }
    let mut start:u64=nstart(words,dashed);
    let mut end:u64=nend(words,dashed);
    if start>end || end>len(source) { return refuse(b,E_INPUT(),words,count,id); }
    let mut record:u64=emit(b,k_target(),id,0,words);
    wput(b,record,5,start);
    wput(b,record,6,end);
    wput(b,record,8,2);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,14,fnv(source,start,end));
    wput(b,record,15,end-start);
    return 0;
}
// The versions block, and the PIN. `aux` counts the entries and `aux2` is the
// machine_ir entry's own major*100+minor read out of the source, so the image
// records the schema it was produced under instead of only a magic number
// that nobody can check against the program. The gate confronts `aux2` with
// this module's FORMAT_MAJOR and FORMAT_MINOR and with versions.check's own
// verdict on the same block, so a version that moves in one place and not the
// other is a red.
fn versions_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    let mut record:u64=emit(b,k_versions(),id,0,words);
    wput(b,record,12,CLASS_NONE());
    let mut child:u64=nfirst(words,id);
    let mut entries:u64=0;
    let mut pin:u64=0;
    let mut name:buf<u8>="machine_ir";
    while child!=0 && child<=count {
        if nindex(words,child)==5 {
            entries=entries+1;
            let mut entry_name:u64=nfirst(words,child);
            let mut major:u64=nnext(words,entry_name);
            let mut minor:u64=nnext(words,major);
            if entry_name!=0 && span_is(source,nstart(words,entry_name),
                                        nend(words,entry_name),name) {
                // THE PIN IS `(major+1)*100+(minor+1)`, so ITS minor field is
                // two decimal digits wide, and that is a property of the
                // format rather than of this arm: `tests_ntasm_machine_ir.c`
                // writes the decode down as `pin/100 - 1` and refuses a pin
                // below 101 because `(0+1)*100+(0+1)` is the smallest this
                // shape can hold. A minor above 98 therefore does not fit the
                // field whatever any reader answers, and the only question
                // left is whether it WRAPS into the major's own digits or
                // SATURATES at the top of the field.
                //
                // IT WRAPPED, and the wrap named a version nobody wrote. The
                // u64 maximum is the one literal whose successor does not
                // exist, so `scale_of` refused it at `read_magnitude`'s
                // successor-reserving bound and answered 0; this arm then
                // published the 0 that names no major at all. The two halves
                // were one defect and fixing either alone leaves the other:
                // removing that refusal alone publishes `100`, which is not
                // zero but is worse -- 100/100-1 decodes to 0 and reads as a
                // version while carrying no minor, and `100` is also what
                // `read_magnitude`'s wrapped successor would have produced
                // one row below at MAX-1. So the minor is read here through
                // `scale_capped`, which lifts the accumulator bound to the
                // maximum and CLAMPS the successor at 99.
                //
                // WHAT THIS COSTS, named because it is a real collision and
                // not a rounding: 18446744073709551614 and
                // 18446744073709551615 both publish 199. That is the field
                // saying "the minor does not fit in two digits", which is
                // true of both, and the major half still decodes exactly --
                // the major is the half every reader consumes and the half
                // this encoding never had to bound. A pin that carried the
                // minor losslessly would need more than two digits, and the
                // format's two digits are the harness's own.
                //
                // WHY THERE IS NO REFUSAL HERE ANY MORE. `scale_capped`
                // answers 0 for exactly two reachable conditions in this arm,
                // and neither is the u64 maximum: a node that is not a
                // literal, and a span whose digits pass the maximum. The
                // second is unreachable from a source, because `lexer.nova`
                // refuses a numeric token whose value exceeds the maximum
                // before the parser can attach it -- and
                // `parser.nova`'s `versions_decl` attaches `literal(p)` for
                // both halves after checking the token is a number, so a
                // versions entry's major and minor are always well-formed
                // numeric literals. That is why E_INPUT here was refusing a
                // fact that was never true, and why the u64 maximum -- the
                // one literal this arm could still be asked about -- was the
                // only thing it ever fired on.
                let mut major_value:u64=scale_capped(words,count,source,major,99);
                let mut minor_value:u64=scale_capped(words,count,source,minor,99);
                pin=major_value*100+minor_value;
            }
        }
        child=nnext(words,child);
    }
    wput(b,record,14,entries);
    wput(b,record,15,pin);
    return 0;
}
fn section_of(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    let placed:u64=section_code(words,count,source,id);
    let mut child:u64=nfirst(words,id);
    while child!=0 && child<=count && b.code==0 {
        let mut index:u64=nindex(words,child);
        if index==18 && b.native_mode==false { callable(b,words,count,source,child,1); }
        if index==24 { data_of(b,words,count,source,child,placed); }
        child=nnext(words,child);
    }
    return b.code;
}
// THE UNIT WALK. One pass over the NTIR's top level in id order, so the image
// order is the NTIR order by construction.
fn unit(b:Builder,words:buf<u64>,count:u64,source:buf<u8>,id:u64)->u64 {
    let mut record:u64=emit(b,k_unit(),id,0,words);
    wput(b,record,12,CLASS_NONE());
    wput(b,record,14,0);
    b.parent=record;
    b.depth=1;
    b.block=0;
    b.term=0;
    b.func=record;
    // MIR/0.3: the module feature mask lives in the unit's `aux2`, which no
    // earlier format wrote. `lm` (1) is in every mask, as in frontend.c.
    let mut features:u64=1;
    let mut child:u64=nfirst(words,id);
    while child!=0 && child<=count && b.code==0 {
        let mut index:u64=nindex(words,child);
        if index==8 { features=features_of(b,words,count,source,child,features); }
        // W170 INSTRUMENT: THE STAMP IS CLEARED AT THE TOP OF EVERY RECORD
        // WALKED, which is the loop that covers one record at a time and stops
        // the moment `b.code` is set. This is the site the first version got
        // wrong: clearing in `emit` cleared it once per record EMITTED, which
        // is a different population, and it ran after the refusal it was meant
        // to preserve. Here the stamp is cleared before the record is walked
        // and no later record can overwrite it, because the walk ends on the
        // refusal. So the stamp names the assignment that refused THIS record,
        // and a record that refuses nothing reports 0 rather than the previous
        // record's rule.
        b.stamp=0;
        b.stamp_line=0;
        if index==2 {
            symbol_of(b,source,words,count,child);
        } else if index==3 {
            target_of(b,words,count,source,child);
        } else if index==4 {
            versions_of(b,words,count,source,child);
        } else if index==6 {
            abi_of(b,words,count,source,child,0,0);
        } else if index==9 {
            callable(b,words,count,source,child,0);
        } else if index==10 {
            data_of(b,words,count,source,child,0);
        } else if index==17 {
            section_of(b,words,count,source,child);
        } else if index==18 && b.native_mode==false {
            callable(b,words,count,source,child,1);
        }
        child=nnext(words,child);
    }
    wput(b,record,14,b.values);
    wput(b,record,15,features);
    return b.code;
}

// ---- the post-passes, which is where the NEW facts are computed -----------
fn loop_headers(b:Builder,words:buf<u64>,count:u64)->u64 {
    let mut o:buf<u64>=b.out;
    let mut r:u64=1;
    let mut marked:u64=0;
    while r<=b.records {
        let mut kind:u64=o[at(r)];
        let mut target:u64=0;
        if kind==k_jump() { target=o[at(r)+5]; }
        if kind==k_branch() {
            let mut taken:u64=o[at(r)+6];
            let mut skipped:u64=o[at(r)+7];
            let mut source:u64=o[at(r)+16];
            if taken!=0 && taken<=source {
                o[at(taken)+13]=o[at(taken)+13]+FLAG_LOOP_HEADER();
                marked=marked+1;
            }
            if skipped!=0 && skipped<=source {
                o[at(skipped)+13]=o[at(skipped)+13]+FLAG_LOOP_HEADER();
                marked=marked+1;
            }
        }
        if target!=0 && target<=b.records {
            let mut source:u64=o[at(r)+16];
            if target<=source {
                o[at(target)+13]=o[at(target)+13]+FLAG_LOOP_HEADER();
                marked=marked+1;
            }
        }
        r=r+1;
    }
    return marked;
}
// The number of ADDRESS VALUES carrying each memory space, counted over the
// whole image after lowering. The NTIR knows which spaces the program
// mentions; it cannot know how many addresses each one reaches, because that
// is a fact about the lowered body.
fn space_counts(b:Builder,words:buf<u64>,count:u64)->u64 {
    let mut o:buf<u64>=b.out;
    let mut r:u64=1;
    let mut total:u64=0;
    while r<=b.records {
        let mut kind:u64=o[at(r)];
        let mut space:u64=o[at(r)+11];
        let mut touches:bool=kind==k_address() || kind==k_load() || kind==k_store();
        if touches==true && space!=0 {
            let mut s:u64=1;
            while s<=b.records {
                if o[at(s)]==k_space() && o[at(s)+11]==space {
                    o[at(s)+8]=o[at(s)+8]+1;
                    total=total+1;
                    s=b.records+1;
                } else {
                    s=s+1;
                }
            }
        }
        r=r+1;
    }
    return total;
}
fn finalize(b:Builder,words:buf<u64>,count:u64)->u64 {
    let mut o:buf<u64>=b.out;
    b.loops=loop_headers(b,words,count);
    space_counts(b,words,count);
    let mut typed:u64=0;
    let mut blocks:u64=0;
    let mut r:u64=1;
    while r<=b.records {
        if o[at(r)]==k_block() { blocks=blocks+1; }
        if o[at(r)+9]!=0 || o[at(r)+11]!=0 || o[at(r)+12]!=CLASS_NONE() {
            typed=typed+1;
        }
        r=r+1;
    }
    o[0]=MIR_MAGIC();
    o[1]=FORMAT_MAJOR();
    o[2]=FORMAT_MINOR();
    o[3]=b.records;
    o[4]=1;
    o[5]=NODE_WORDS();
    o[6]=b.values;
    o[7]=blocks;
    o[8]=DOMAIN_BIT();
    o[9]=typed;
    return 0;
}
// The width vocabulary, the space catalogue and the space predicate are
// ntir's own answers, read through the exported entry points where ntir
// publishes one and recomputed with ntir's own numbers where it does not, so
// the verifier cannot accept a width the NTIR would refuse.
fn mir_space_known(space:u64)->bool {
    if space==1 { return true; } if space==2 { return true; }
    if space==4 { return true; } if space==8 { return true; }
    if space==16 { return true; } return space==32;
}
// THE SIGNEDNESS VOCABULARY OF WORD 10, spelled once and read by the rule that
// needs it. It is the three values the record layout at the top of this file
// publishes -- 0 unsigned, 1 signed, 2 no signedness -- and 2 is
// ntir.nova's own SIGNED_NONE, which is what `scalar_of` writes for `never`
// and what every macro type form writes. It is named here rather than reached
// through ntir so that this level does not grow a second convention for a
// vocabulary the NTIR already owns.
fn SIGNED_NONE()->u64 { return 2; }
fn mir_width_known(width:u64)->bool {
    if width==0 { return true; }
    if width==1 { return true; }
    if width==8 { return true; } if width==16 { return true; }
    if width==32 { return true; } if width==64 { return true; }
    return width==80;
}

// ---- the lowering --------------------------------------------------------
//
// THE WHOLE OF THE INPUT IS THE NTIR IMAGE. There is no parse here, no
// re-scan and no AST: this function takes sixteen-bit-free flat words and
// produces twenty-four-word records, and the only source bytes it ever touches are
// inside spans the NTIR recorded.
//
// THE REFUSAL SET IS A SUPERSET, AND IT IS STRUCTURAL RATHER THAN A CLAIM.
// The input image is handed to ntir.verify ONCE, before anything is built, and
// a refusal there is returned unchanged with its position. So every image the
// NTIR refuses is refused here, and on top of that this level refuses what
// the NTIR never saw: a mnemonic it cannot name (940), a comparison whose
// signedness it cannot resolve (940), a read of something never defined (941),
// a scale factor outside 1/2/4/8 (945), a call with three operands (944).
export fn lower(source:buf<u8>,ntir_words:buf<u64>,ntir_count:u64,
        out:buf<u64>,capacity:u64,report:buf<u64>)->u64 {
    let none:buf<u64>=alloc(runtime(),0);
    let code:u64=lower_core(source,ntir_words,ntir_count,out,capacity,report,none,0);
    rt_free(runtime(),none);
    return code;
}

// A6 (13 October 2026): THE SAME LOWERING, TOLD WHICH EXPRESSIONS ARE CALLS.
// `calls` holds NTIR ids (which are the AST ids, ntir.nova "NODE IDS ARE AST
// IDS") of expression nodes the AST marks as calls; `ast_call_marks` builds it
// from a tree. This metadata exists only at the AST/NTIR -> MIR boundary: a
// route that receives an already built Machine IR image consumes the image
// alone and never needs it.
//
// THE NTIR CANNOT PROVE A MARK, SO THE AST DOES. `aux` does not survive into
// the NTIR, so there a bare name (kind 35, aux 0) and a call without argument
// (kind 35, aux 1) have the same shape; a table checked against the NTIR alone
// could turn a name into a call. Every id is therefore checked against `tree`,
// the very tree the NTIR was built from (after expansion and stub graft):
// the AST node is kind 35 with aux 1, its first child is a name or a
// qualified name, and the NTIR node of the same id was lowered from it (its
// ast_kind is 35, its ast_id is that id, its span is the AST node's span).
// One id that fails refuses the whole call with 940, report[3] = that id.
// Carry visibility from the corresponding AST at the AST/NTIR -> MIR seam.
// Generated functions have no textual "export fn" spelling. Consumers of
// already-built MIR still use only its recorded flags, never this tree.
fn apply_ast_exports(tree:ntasm_ast.Tree,words:buf<u64>,count:u64,
        out:buf<u64>,report:buf<u64>)->u64 {
    if tree.ok==false || len(report)<4 || len(out)<HEADER_WORDS() { return 800; }
    if tree.node_count>len(tree.node_words)/12 { return 800; }
    if len(words)<ntir.HEADER_WORDS() || count>(len(words)-ntir.HEADER_WORDS())/ntir.NODE_WORDS() { return E_NTIR(); }
    let records:u64=out[3];
    if records>(len(out)-HEADER_WORDS())/NODE_WORDS() { return 800; }
    let mut r:u64=1;
    while r<=records {
        let base:u64=at(r);
        if out[base]==k_function() && out[base+5]!=0 {
            let id:u64=out[base+1];
            let mut bad:bool=id==0 || id>count || id>tree.node_count;
            if bad==false {
                let ast:u64=(id-1)*12;
                bad=tree.node_words[ast]!=18 || tree.node_words[ast+11]>1
                    || words[nw(id)+6]!=18 || words[nw(id)+7]!=id
                    || nstart(words,id)!=tree.node_words[ast+6]
                    || nend(words,id)!=tree.node_words[ast+7];
            }
            if bad {
                report[0]=0;report[1]=0;report[2]=E_INPUT();report[3]=id;
                return E_INPUT();
            }
            let previous:u64=out[base+13];
            let mut flags:u64=previous-(previous&FLAG_EXPORT());
            if tree.node_words[(id-1)*12+11]==1 { flags=flags+FLAG_EXPORT(); }
            out[base+13]=flags;
        }
        r=r+1;
    }
    return 0;
}
export fn lower_with_calls(source:buf<u8>,tree:ntasm_ast.Tree,ntir_words:buf<u64>,
        ntir_count:u64,out:buf<u64>,capacity:u64,report:buf<u64>,calls:buf<u64>)->u64 {
    if len(report)<4 { return 800; }
    if len(ntir_words)<ntir.HEADER_WORDS()+ntir_count*ntir.NODE_WORDS() {
        report[2]=E_NTIR();
        return E_NTIR();
    }
    let mut i:u64=0;
    while i<len(calls) {
        let id:u64=calls[i];
        let mut bad:bool=id==0 || id>ntir_count || tree.ok==false || id>tree.node_count;
        if bad==false {
            let at:u64=(id-1)*12;
            let ast_head:u64=tree.node_words[at+8];
            bad=tree.node_words[at]!=35 || tree.node_words[at+11]!=1 || ast_head==0
                || ast_head>tree.node_count
                || (tree.node_words[(ast_head-1)*12]!=90 && tree.node_words[(ast_head-1)*12]!=91);
        }
        if bad==false {
            let head:u64=nfirst(ntir_words,id);
            let at:u64=(id-1)*12;
            bad=ntir_words[nw(id)+6]!=35 || ntir_words[nw(id)+7]!=id
                || nstart(ntir_words,id)!=tree.node_words[at+6] || nend(ntir_words,id)!=tree.node_words[at+7]
                || head==0 || head>ntir_count
                || (nindex(ntir_words,head)!=47 && nindex(ntir_words,head)!=48);
        }
        if bad {
            report[0]=0;report[1]=0;report[2]=E_INPUT();report[3]=id;
            return E_INPUT();
        }
        i=i+1;
    }
    let code:u64=lower_core(source,ntir_words,ntir_count,out,capacity,report,calls,len(calls));
    if code!=0 { return code; }
    return apply_ast_exports(tree,ntir_words,ntir_count,out,report);
}

// The AST ids of every expression node the parser marked as a call (kind 35,
// aux 1). The caller frees the buffer.
export fn ast_call_marks(tree:ntasm_ast.Tree)->buf<u64> {
    let mut n:u64=0;
    let mut id:u64=1;
    while id<=tree.node_count {
        if tree.node_words[(id-1)*12]==35 && tree.node_words[(id-1)*12+11]==1 { n=n+1; }
        id=id+1;
    }
    let marks:buf<u64>=alloc(runtime(),n);
    let mut k:u64=0;
    id=1;
    while id<=tree.node_count {
        if tree.node_words[(id-1)*12]==35 && tree.node_words[(id-1)*12+11]==1 { marks[k]=id; k=k+1; }
        id=id+1;
    }
    return marks;
}

fn builder_create(out:buf<u64>,limit:u64,calls:buf<u64>,call_count:u64)->Builder {
    let mut types:buf<u64>=alloc(runtime(),(limit*2+64)*TYPE_WORDS());
    let mut binds:buf<u64>=alloc(runtime(),(limit+64)*BIND_WORDS());
    // FOUR WORDS PER ENTRY, not three: the record, the FIELD to patch, the span
    // start and the span end. The field is what lets one table carry both a
    // `mir_jump`'s target in `arg_a` and a `mir_branch`'s TAKEN EDGE in `arg_b`,
    // which are different words of different records and were two tables
    // before this was one. The allocation is widened with the entry, because an
    // entry stride and an allocation stride that disagree overflow silently at
    // the last entry rather than at the first.
    let mut pend:buf<u64>=alloc(runtime(),(limit+64)*4);
    let mut rev:buf<u64>=alloc(runtime(),(limit+64)*3);
    let mut ops:buf<u64>=alloc(runtime(),16);
    let b:Builder=Builder{out:out,records:0,values:0,capacity:len(out),parent:0,
        c0:0,c1:0,c2:0,c3:0,depth:0,block:0,term:0,func:0,blocks:0,loops:0,pend_hits:0,sp_jump:0,sp_label:0,fixed_jumps:0,
        types:types,type_count:0,binds:binds,bind_count:0,
        pend:pend,pend_count:0,ops:ops,rev:rev,rev_count:0,code:0,line:0,column:0,node:0,
        stamp:0,stamp_line:0,pred:0,want_width:0,want_signed:2,
        calls:calls,call_count:call_count,native_mode:false};
    return b;
}

fn builder_release_scratch(b:Builder)->u64 {
    let ops:buf<u64>=b.ops;let pend:buf<u64>=b.pend;let binds:buf<u64>=b.binds;
    let types:buf<u64>=b.types;let rev:buf<u64>=b.rev;
    rt_free(runtime(),ops);rt_free(runtime(),pend);rt_free(runtime(),binds);
    rt_free(runtime(),types);rt_free(runtime(),rev);return 0;
}
fn lower_core(source:buf<u8>,ntir_words:buf<u64>,ntir_count:u64,
        out:buf<u64>,capacity:u64,report:buf<u64>,calls:buf<u64>,call_count:u64)->u64 {
    if len(report)<4 { return 800; }
    if ntir_count==0 { report[2]=E_NTIR(); return E_NTIR(); }
    if len(ntir_words)<ntir.HEADER_WORDS()+ntir_count*ntir.NODE_WORDS() {
        report[2]=E_NTIR();
        return E_NTIR();
    }
    if ntir_words[3]!=ntir_count { report[2]=E_NTIR(); return E_NTIR(); }
    // ONCE. ntir.verify allocates two scratch buffers per call, so calling it
    // per node or per function would allocate per call; the answer is a
    // property of the image and is asked for once.
    let mut check:buf<u64>=alloc(runtime(),8);
    let mut verdict:u64=ntir.verify(ntir_words,ntir_count,check);
    if verdict!=0 {
        report[0]=check[0];report[1]=check[1];report[2]=check[2];report[3]=check[3];
        rt_free(runtime(),check);
        return verdict;
    }
    rt_free(runtime(),check);
    let mut needed:u64=HEADER_WORDS()+(ntir_count*8+64)*NODE_WORDS();
    if capacity<needed || len(out)<needed {
        report[2]=E_HEADER();
        return E_HEADER();
    }
    let b:Builder=builder_create(out,ntir_count,calls,call_count);
    let mut code:u64=unit(b,ntir_words,ntir_count,source,1);
    if code==0 { finalize(b,ntir_words,ntir_count); }
    report[0]=b.line;
    report[1]=b.column;
    report[2]=b.code;
    report[3]=b.node;
    // W170 INSTRUMENT: the stamp is published as report[4] and report[5] on the
    // refusal path only. An ABSENT datum is written as 0 and never as the code
    // it would otherwise be confused with, so a reader can tell "this record
    // raised nothing" from "this record raised the code in report[2]".
    if len(report)>=6 { report[4]=b.stamp; report[5]=b.stamp_line; }
    // THE LOOP COUNT, KEPT BECAUSE UNTIL NOW IT WAS THROWN AWAY.  `finalize`
    // called loop_headers and discarded its return, so the number of loop
    // headers in an image was computed and published NOWHERE: no change to
    // that pass could be tested.  report[0..5] are taken above, so 6 is the
    // first free word, and nothing about the IMAGE changes -- this is a
    // report word, not a record field.
    if b.code!=0 {
        builder_release_scratch(b);
        return b.code;
    }
    let mut o:buf<u64>=out;
    // THE THREE NUMBERS, and the first two of them are the point.  report[6] is
    // loop headers, report[7] is how many pending targets RESOLVED, and
    // report[8] is how many were REGISTERED.  hits alone cannot tell "the two
    // spans differ" from "the jump never registered"; registered against
    // resolved separates them, and  already existed and was
    // published nowhere.
    if len(report)>=9 { report[6]=b.loops; report[7]=b.pend_hits; report[8]=b.pend_count; }
    if len(report)>=12 { report[11]=b.fixed_jumps; }
    if len(report)>=11 { report[9]=b.sp_jump; report[10]=b.sp_label; }
    report[0]=o[3];
    report[1]=o[6];
    report[2]=o[7];
    // report[3] IS THE REFUSAL'S NODE, AND NOTHING ELSE.  The entry's own
    // contract (machine-ir-entry.nova, "mode 0 ... report[3]=0. A refusal
    // returns its code and writes report[0]=line, [1]=column, [2]=code,
    // [3]=node") says a success publishes ZERO here, and this line used to
    // publish `root` -- a variable named for the root record that was never
    // assigned anything else and therefore held `ntir_count`, the NUMBER OF
    // NTIR NODES.  So one word carried an NTIR node id on the refusal path
    // and an NTIR node COUNT on the success path, and both are plausible
    // inside the NTIR's own id range, so a reader could not tell them apart
    // by looking.  That is not hypothetical: this gate's depth-cap case read
    // report[3] as a node id after a run that DID NOT REFUSE, took the count
    // 345 for a node id, and found a node whose span is "rax" -- so the check
    // "the refusal names the `rax` operand" was GREEN on a run that lowered
    // the whole source and refused nothing.
    //
    // `b.node` is 0 on this path for the same reason report[2] is: the walk
    // reached the end without a `refuse`, so there is no node to name.  The
    // NTIR node count is NOT lost by this -- it is `ntir_words[3]`, the
    // header word every caller already reads, and publishing it under a name
    // that says `root` was the defect rather than the feature.
    report[3]=b.node;
    builder_release_scratch(b);
    return 0;
}

// Native body construction shares the NTASM declaration/ABI/type writer.
// The declaration NTIR is real, verified input; native operations are synthetic
// descendants anchored at its function declaration. Coordinates remain those
// of that real declaration NTIR; Nova body diagnostics are a separate domain.
export fn native_writer(out:buf<u64>,capacity:u64,limit:u64)->Builder {
    let none:buf<u64>=alloc(runtime(),0);
    let b:Builder=builder_create(out,limit,none,0);
    b.native_mode=true;b.capacity=capacity;
    if capacity>len(out) || capacity<HEADER_WORDS() { b.code=E_HEADER(); }
    return b;
}
export fn native_declarations(b:Builder,source:buf<u8>,words:buf<u64>,count:u64)->u64 {
    if b.code!=0 { return b.code; }
    let check:buf<u64>=alloc(runtime(),8);
    b.code=ntir.verify(words,count,check);
    if b.code==0 { unit(b,words,count,source,1); }
    rt_free(runtime(),check);return b.code;
}
export fn native_callable(b:Builder,source:buf<u8>,words:buf<u64>,count:u64,id:u64)->u64 {
    // A BUILDER THAT ALREADY REFUSED KEEPS ITS CODE. Asking for one more
    // function when the image is full is not a NEW mistake: the image was
    // full, and the code that says so is the answer. Overwriting it with
    // E_INPUT named a mistake that was not made -- the caller asked for a
    // function, and the builder said it had no room, which is E_HEADER.
    if b.code!=0 { return 0; }
    if id==0 || id>count || nindex(words,id)!=18 { b.code=E_INPUT(); return 0; }
    b.type_count=0;b.bind_count=0;
    callable(b,words,count,source,id,1);
    return b.func;
}
export fn native_record(b:Builder,words:buf<u64>,origin:u64,kind:u64)->u64 {
    return emit(b,kind,0,origin,words);
}
export fn native_put(b:Builder,r:u64,field:u64,value:u64)->u64 {
    // THE FIRST CODE IS KEPT, for the same reason `native_callable` keeps it:
    // a shape complaint raised on top of a refusal that already happened
    // replaces the answer with a worse one.
    if field>=NODE_WORDS() { if b.code==0 { b.code=E_SHAPE(); } return 0; }
    return wput(b,r,field,value);
}
export fn native_get(b:Builder,r:u64,field:u64)->u64 {
    if field>=NODE_WORDS() { if b.code==0 { b.code=E_SHAPE(); } return 0; }
    return get(b,r,field);
}
export fn native_value(b:Builder)->u64 { return new_value(b); }
export fn native_block(b:Builder,words:buf<u64>,count:u64,origin:u64)->u64 {
    if b.code!=0 { return 0; }
    b.parent=b.func;b.depth=2;
    return new_block(b,words,count,origin,0);
}
export fn native_term(b:Builder,r:u64)->u64 { return set_term(b,r); }
export fn native_finish(b:Builder,words:buf<u64>,count:u64)->u64 {
    if b.code!=0 { return b.code; }
    wput(b,1,14,b.values);
    return finalize(b,words,count);
}
export fn native_release(b:Builder)->u64 {
    let calls:buf<u64>=b.calls;rt_free(runtime(),calls);builder_release_scratch(b);rt_free(runtime(),b);
    return 0;
}
// ---- the per-kind admissibility tables -----------------------------------
//
// WHAT AN ARGUMENT IS: 0 it must be zero, 1 a machine value, 2 a basic block,
// 3 a number that is NOT a reference: a link (a span or a symbol record), or a
// constant's magnitude. The verifier checks every argument slot against this
// table, which is what makes "a dangling child" and "a value nobody defines"
// two different refusals instead of one.
//
// WHY 3 IS WORDED AS "NOT A REFERENCE" AND NOT ONLY AS "A LINK", and the third
// case is a defect this file carried until it was measured rather than read.
// The rule `3` exists to serve is the verifier's: a LIVE slot holding 0 means
// "no value" for every kind whose slots are value references, so it is
// malformed. That reading is wrong for a slot that is not a reference at all.
//
// `mir_const` was MISSING FROM THIS TABLE, so arg_is returned its 0 default
// for it, and the magnitude of a constant was read as a value reference: a
// live slot holding 0 was then refused with 934. So `return 0` -- a legal
// program, and the exact source the PE gate byte-compares against codegen.c
// -- lowered to a correct nine-record image and machine_ir.verify then
// refused that image. Measured, stage by stage, on both constants:
//
//     ntir.build        accepts  21 records
//     machine_ir.lower  accepts   9 records, 1 value, 1 block
//     machine_ir.verify REFUSES  934 for the zero, accepts the one
//
// and the two lowered images differ in EXACTLY ONE WORD, the magnitude: 0
// against 1. `read_magnitude` returns value+1 -- a one-based encoding -- and
// `literal` subtracts the one back before writing the field
// (literal(), :1103-1113), so the field holds the true magnitude and the
// constant zero is a legitimate 0. The corpus this module is gated on carries
// `add rax, 1` and no zero, so nothing reached the case and the gate was green
// over it. tests_ntasm_machine_ir.c's CASE 0 is the regression: it asserts
// the parity between the two constants, not a count, because a count is
// satisfied by the wrong image.
//
// WHAT THIS DOES NOT CHANGE: a non-zero magnitude behaves exactly as before.
// Answer 3 is read by the verifier in three places -- the zero rule, the
// value-range rule and the block rule -- and 3 skips the last two, which a 0
// already skipped. The single behaviour that moves is "a live magnitude of
// zero is no longer a shape error", and that is the whole repair.
// ANSWER 4, ADDED FOR THE IMPORT, AND IT IS NOT ANSWER 3. A function's
// `arg_a` is its ENTRY BLOCK -- a link, answer 2 -- and answer 2 refuses a
// live zero, because a `mir_jump` or a `mir_phi` whose target is still zero is
// an unresolved edge and 933 is the right answer for it. But a function
// declared WITHOUT A BODY has no entry block, and zero is how that absence is
// spelled, so answer 2 refused every import: measured on
// `import api.echo as ext: fn()->u64`, `lower` produces a correct image and
// `verify` answers 934 E_SHAPE on the import's own `mir_function`, whose
// `arg_a` is 0 and whose `arg_count` is 3, so the slot is live and empty.
//
// ANSWER 3 IS NOT THE REPAIR, and this is why. Answer 3 skips the value-range
// rule AND the block rule, so promoting the slot to 3 would stop the verifier
// checking that a function's entry block names a `k_block` at all -- the one
// check that catches a function pointing into a subtree it does not own.
// Answer 4 keeps both halves: zero is legal, and a NON-zero is still held to
// naming a `mir_block` exactly as answer 2 holds it. The one behaviour that
// moves is "a live entry link of zero is no longer a shape error", and that is
// the whole repair.
fn arg_is(kind:u64,slot:u64)->u64 {
    if kind==k_local_cell() { if slot==0 { return 1; } return 0; }
    if kind==k_const() { if slot==0 { return 3; } return 0; }
    if kind==k_copy() { if slot==0 { return 1; } return 0; }
    if kind==k_binary() { if slot<=1 { return 1; } return 0; }
    if kind==k_unary() { if slot==0 { return 1; } return 0; }
    if kind==k_select() { if slot<=1 { return 1; } return 0; }
    if kind==k_convert() { if slot==0 { return 1; } return 0; }
    if kind==k_extend() { if slot==0 { return 1; } return 0; }
    if kind==k_truncate() { if slot==0 { return 1; } return 0; }
    if kind==k_load() { if slot==0 { return 1; } return 0; }
    if kind==k_store() { if slot<=1 { return 1; } return 0; }
    // ANSWER 5, FOR A VALUE WHOSE ABSENCE IS SPELLED ZERO, AND IT IS NOT
    // ANSWER 3. A `mir_address`'s base and index are BOTH optional: an address
    // with no base writes 0, an address with no index writes 0, and an address
    // whose base is a SYMBOL writes 0 here and names the symbol in `arg_c`
    // instead. So zero in either slot is a real answer and answer 1 -- "a value,
    // and a live zero here is malformed" -- refused all three. That is what
    // answered 934 on `load rax,[counter]:ptr<user,u64>`: raising
    // `arg_count` to 3 to make the symbol slot live made the base and index
    // slots live too, and they are zero because there is no base register and
    // no index register.
    //
    // ANSWER 3 IS NOT THE REPAIR HERE, and the difference is the range check:
    // 3 skips it, so promoting these slots to 3 would stop the verifier
    // checking that a non-zero base is a value somebody defined. Answer 5 keeps
    // every check a non-zero gets and adds exactly one thing: zero is allowed.
    if kind==k_address() { if slot<=1 { return 5; } return 0; }
    if kind==k_asm() { if slot<=2 { return 1; } return 0; }
    if kind==k_type_decl() { if slot<=2 { return 3; }return 0; }
    if kind==k_contract_expr() { if slot<=2 { return 3; }return 0; }
    if kind==k_call_arg() { if slot==0 { return 1; }if slot==1 { return 3; }return 0; }
    if call_kind(kind) {
        if slot==0 { if kind==k_call_indirect() { return 1; }return 3; }
        if slot<=2 { return 1; }
        return 0;
    }
    if kind==k_return() { if slot==0 { return 1; } return 0; }
    if kind==k_align() { if slot==0 { return 1; } return 0; }
    if kind==k_bind() { if slot==0 { return 1; } return 0; }
    if kind==k_jump() { if slot==0 { return 2; } return 0; }
    if kind==k_branch() {
        if slot==0 { return 1; }
        if slot<=2 { return 2; }
        return 0;
    }
    if kind==k_phi() { if slot<=1 { return 2; } return 0; }
    if kind==k_function() { if slot==0 { return 4; } return 0; }
    if kind==k_effect() { if slot==0 { return 3; } return 0; }
    // MIR/0.3: arg_a is the initializer's value or 0 (no initializer), and
    // arg_b/arg_c are the name span -- the shape `mir_function` already has.
    if kind==k_data() { if slot==0 { return 5; } if slot<=2 { return 3; } return 0; }
    // MIR/0.3: arg_a is the oracle's clobber mask, a set and not an operand.
    if kind==k_clobber() { if slot==0 { return 3; } return 0; }
    if kind==k_target() { if slot<=1 { return 3; } return 0; }
    if kind==k_symbol() { if slot<=1 { return 3; } return 0; }
    if kind==k_string() { if slot<=1 { return 3; } return 0; }
    // `k_space` HAS NO ENTRY IN THIS TABLE, AND THAT WAS A HOLE. A `mir_space`
    // names a space in word 11 and a class in word 12 and nothing else --
    // `space_record` writes exactly those two plus the flags -- so every answer
    // in 1..4 would be a claim about a slot this kind does not have. Answer 0
    // is "neither a value nor a link, and a live zero here is a shape error",
    // and that is what refused `load rax,[counter]:ptr<user,u64>` at 934
    // E_SHAPE: the element type's `mir_space` came back from `verify` with 934 on
    // the producer's own image. Answer 3 is "this slot is not an operand and
    // zero is the absence", which is what the kind is -- the same hole
    // `mir_const` had above, on a second kind, found the same way.
    if kind==k_space() { return 3; }
    return 0;
}
// A KIND THAT CARRIES A WIDTH, and a kind that must therefore not claim one.
// The set is the set of kinds whose records are values, read off the layout
// comment at the top of this file rather than off a wish.
fn width_admissible(kind:u64)->bool {
    if kind==k_local_cell() { return true; }
    if kind==k_type_decl() || kind==k_contract_expr() || kind==k_function() { return true; }
    if kind==k_const() { return true; }
    if kind==k_copy() { return true; }
    if kind==k_binary() { return true; }
    if kind==k_unary() { return true; }
    if kind==k_select() { return true; }
    if kind==k_convert() { return true; }
    if kind==k_extend() { return true; }
    if kind==k_truncate() { return true; }
    if kind==k_load() { return true; }
    if kind==k_store() { return true; }
    if kind==k_address() { return true; }
    if kind==k_asm() { return true; }
    if call_kind(kind) { return true; }
    if kind==k_return() { return true; }
    if kind==k_align() { return true; }
    if kind==k_bind() { return true; }
    if kind==k_vreg() { return true; }
    if kind==k_param() { return true; }
    // `k_space` IS HERE FOR THE SAME REASON `class_admissible` HAS IT, and
    // its absence was the whole of E_TYPED 938 on valid code. `verify` asks
    // the space question on a record as `space!=0 && width_admissible(kind)`
    // and then the width question as `width!=0 && width_admissible(kind)`;
    // `space_record` above writes a nonzero space onto every k_space record,
    // so a k_space record always reached the FIRST line and always failed it.
    // The result was that every module declaring a `ptr<space,T>` parameter
    // was refused at 938 whatever the predicate said, and a u64 parameter,
    // which emits no k_space record at all, was accepted.
    //
    // THIS NARROWS NOTHING ELSE. Every other kind that can write a space --
    // k_load, k_store, k_address, k_call, k_return, k_param, k_vreg, k_data
    // -- was already answering true here, so adding this kind cannot move the
    // verdict of any record but a k_space record's. And it silences exactly
    // the space line: `space_record` never writes field 9, so a k_space
    // record's width is 0 and only the space line was ever reachable on it.
    // The width rule still stands, untouched, for every kind that carries one.
    if kind==k_space() { return true; }
    return kind==k_data();
}
// The class a kind may carry. This is the check that makes TARGET
// INDEPENDENCE structural rather than editorial: an ntir register family is a
// number in 1..16 and no kind here admits any class outside 0..4, so a
// physical family has nowhere to go.
fn class_admissible(kind:u64,class:u64)->bool {
    if class==CLASS_NONE() { return true; }
    if class==CLASS_ADDRESS() {
        if kind==k_local_cell() { return true; }
        if kind==k_address() { return true; }
        if kind==k_store() { return true; }
        return kind==k_space();
    }
    if class==CLASS_PREDICATE() {
        if kind==k_branch() { return true; }
        return kind==k_binary() || kind==k_asm() || kind==k_copy();
    }
    if class==CLASS_CONSTANT() {
        // A `k_copy` IS a copy of an inner value, and the inner value carries
        // the class: `expression()` writes `wput(b,record,12,inner.class)` at
        // its one-child arm, so a bare parenthesised CONSTANT lowers to a
        // k_copy whose class is CLASS_CONSTANT. The arm below used to name
        // only the three kinds that MATERIALIZE a constant, which is not the
        // same question: the question here is which kinds may CARRY a class,
        // and a copy of a constant carries it. This list is the only place
        // `k_copy` was refused on CLASS_CONSTANT, and it refused the two
        // `splice` rows whose record is kind 2069 with class 4 -- refused at
        // the class_admissible line below, ret=938 E_TYPED.
        if kind==k_const() { return true; }
        if kind==k_string() { return true; }
        if kind==k_copy() { return true; }
        return kind==k_data();
    }
    if class==CLASS_VALUE() {
        if kind==k_asm() { return true; }
        if kind==k_align() { return true; }
        if kind==k_binary() { return true; }
        if kind==k_bind() { return true; }
        if call_kind(kind) { return true; }
        if kind==k_const() { return true; }
        if kind==k_convert() { return true; }
        if kind==k_copy() { return true; }
        if kind==k_extend() { return true; }
        if kind==k_load() { return true; }
        if kind==k_param() { return true; }
        if kind==k_return() { return true; }
        if kind==k_select() { return true; }
        if kind==k_truncate() { return true; }
        if kind==k_unary() { return true; }
        return kind==k_vreg();
    }
    return false;
}

// ---- the verifier --------------------------------------------------------
//
// IT RUNS ON THE IMAGE AND KNOWS NOTHING ABOUT THE SOURCE. A verifier that
// re-reads the tree proves the TREE is well formed, not that the IMAGE is.
// Every refusal writes the line, the column, the code and the record id, so a
// caller gets a position and not a bare number.
//
// A STRUCTURE WORTH NAMING: the records are a preorder forest. The record
// after a record is either its first child or its next sibling, which is a
// relation on two integers that a damaged image cannot satisfy by accident.
// That single rule is what turns a cycle, a shared parent and an orphan into
// three refusals with three different codes, and it is why the walk needs no
// allocation at all.
//
// "THE RECORD AFTER A RECORD" IS A RELATION ON THE ARRAY, and reading it that
// way is what this check used to do, and the two are not the same thing. A
// record's NEXT SIBLING is not the next record in the array unless every older
// sibling has no children of its own; the moment one does, the next array
// element is that child's, and the sibling that follows it is further along.
// The old rule therefore said a record is either the first child of the record
// immediately before it, or the immediately following sibling of the record
// immediately before it -- which admits a tree in which NO SIBLING BUT THE
// FIRST MAY HAVE ANY CHILDREN. A function with one basic block satisfies that;
// a function with two does not, whatever the order and whatever the ordinals.
// Measured, not argued: over all 24 record orders and all 16 ordinal
// labellings of the smallest two-block function, and over all 720 orders and
// 32 labellings of the same function with two operations per block, 46464
// structurally valid images and not one accepted, every refusal at one of the
// four forest sites here. So this check was not narrower than the language,
// it could not express it, and every `if` in the language was refused at 936
// for it.
//
// THE RULE BELOW IS THE TREE RELATION, read off the fields themselves: the
// parent must be ON THE OPEN ANCESTOR CHAIN of the previous record, and the
// ordinal must be the next index inside that parent. `ch0..ch3` is the chain
// and `n0..n3` the children each chain entry has been given so far; four slots
// because field 19 says depth is 0 unit, 1 function, 2 block, 3 operation, and
// no emitter-reachable image is deeper than that. A record whose parent is not
// on the chain is the shared-parent case E_SHARED already named: it belongs to
// a tree that has been closed, or to no tree at all.
fn place(out:buf<u64>,words:buf<u64>,record:u64,code:u64)->u64 {
    let mut at_r:u64=HEADER_WORDS()+(record-1)*NODE_WORDS();
    out[0]=words[at_r+2];
    out[1]=words[at_r+3];
    out[2]=code;
    out[3]=record;
    return code;
}
// Must-defined flags over reachable CFG edges. This is independent of the
// runtime flags bits: a clobber permits changes, but does not prove a value
// usable by a jcc. Logical bits: CF1 PF2 AF4 ZF8 SF16 OF32.
fn flags_required(condition:u64)->u64 {
    if condition==1 || condition==2 { return 8; }
    if condition==3 || condition==6 { return 9; }
    if condition==4 || condition==5 { return 1; }
    if condition==7 || condition==10 { return 56; }
    if condition==8 || condition==9 { return 48; }
    if condition==11 || condition==12 { return 16; }
    return 0;
}
fn literal_count(words:buf<u64>,count:u64,value:u64,depth:u64)->u64 {
    if depth>64 { return 0; }
    let mut r:u64=1;
    while r<=count {
        if words[at(r)+4]==value {
            if words[at(r)]==k_const() && words[at(r)+5]<=255 { return words[at(r)+5]+1; }
            if words[at(r)]==k_copy() { return literal_count(words,count,words[at(r)+5],depth+1); }
        }
        r=r+1;
    }
    return 0;
}
fn flags_after(words:buf<u64>,count:u64,block:u64,incoming:u64)->u64 {
    let mut flags:u64=incoming; let mut r:u64=block+1;
    while r<=count && words[at(r)+19]>2 {
        if call_kind(words[at(r)]) && (words[at(r)+23]&131072)!=0 { flags=0; }
        if words[at(r)]==k_asm() && (words[at(r)+22]&4)!=0 {
            let op:u64=words[at(r)+14];
            if op==OP_MUL() || op==OP_UMUL() { flags=33; }
            else if op==OP_AND() || op==OP_OR() || op==OP_XOR() || op==OP_TEST() { flags=59; }
            else if op==OP_SHL() || op==OP_SHR() || op==OP_SAR() {
                let n:u64=literal_count(words,count,words[at(r)+6],0);
                if n==0 { flags=0; }
                else {
                    let mut amount:u64=(n-1)&31;
                    if words[at(r)+9]==64 { amount=(n-1)&63; }
                    if amount!=0 {
                        flags=26;
                        if amount<=words[at(r)+9] { flags=flags|1; }
                        if amount==1 { flags=flags|32; }
                    }
                }
            } else { flags=63; }
        }
        r=r+1;
    }
    return flags;
}
fn verify_flags(words:buf<u64>,count:u64,report:buf<u64>)->u64 {
    let states:buf<u64>=alloc(runtime(),count+1);
    let reachable:buf<u64>=alloc(runtime(),count+1);
    let mut r:u64=0;
    while r<=count { states[r]=63; reachable[r]=0; r=r+1; }
    r=1;
    while r<=count {
        if words[at(r)]==k_function() && words[at(r)+5]!=0 {
            let entry:u64=words[at(r)+5]; states[entry]=0; reachable[entry]=1;
        }
        r=r+1;
    }
    let mut changed:bool=true; let mut pass:u64=0;
    while changed && pass<count*8+1 {
        changed=false; pass=pass+1; r=1;
        while r<=count {
            if words[at(r)]==k_block() && reachable[r]!=0 {
                let flags:u64=flags_after(words,count,r,states[r]);
                let term:u64=words[at(r)+14]; let kind:u64=words[at(term)];
                let mut slot:u64=0; let mut edges:u64=0;
                if kind==k_jump() { edges=1; }
                if kind==k_branch() { slot=1; edges=3; }
                while slot<edges {
                    let target:u64=words[at(term)+5+slot];
                    if target!=0 && target<=count {
                        let next:u64=states[target]&flags;
                        if reachable[target]==0 || next!=states[target] { changed=true; }
                        reachable[target]=1; states[target]=next;
                    }
                    slot=slot+1;
                }
            }
            r=r+1;
        }
    }
    let mut code:u64=0; r=1;
    while r<=count && code==0 {
        if words[at(r)]==k_block() && reachable[r]!=0 {
            let term:u64=words[at(r)+14];
            if words[at(term)]==k_branch() && words[at(term)+22]==8 {
                let need:u64=flags_required(words[at(term)+15]);
                let have:u64=flags_after(words,count,r,states[r]);
                if (have&need)!=need { code=place(report,words,term,E_INPUT()); }
            }
        }
        r=r+1;
    }
    rt_free(runtime(),reachable); rt_free(runtime(),states);
    return code;
}

// MIR/1.1 additional arguments retain value links, not opaque bytes.
export fn call_argument(words:buf<u64>,count:u64,call:u64,index:u64)->u64 {
    if call==0 || call>count || call_kind(words[at(call)])==false || index>=words[at(call)+14] { return 0; }
    if index<2 { return words[at(call)+6+index]; }
    let mut found:u64=0;let mut r:u64=1;
    while r<=count {
        if words[at(r)]==k_call_arg() && words[at(r)+6]==call && words[at(r)+14]==index {
            if found!=0 { return 0; }found=words[at(r)+5];
        }
        r=r+1;
    }
    return found;
}
fn value_record(words:buf<u64>,count:u64,value:u64)->u64 {
    let mut r:u64=1;
    while r<=count { if words[at(r)+4]==value { return r; }r=r+1; }
    return 0;
}
// A definition block dominates a use iff no path from the function entry
// reaches the use while omitting that definition block. O(count) scratch;
// visited blocks are queued once, no unbounded recursion or quadratic table.
fn block_dominates(words:buf<u64>,count:u64,f:u64,definition:u64,use:u64)->bool {
    if definition==use { return true; }
    let entry:u64=words[at(f)+5];
    if entry==definition { return true; }
    if entry==0 || entry>count { return false; }
    let queue:buf<u64>=alloc(runtime(),count+1);let seen:buf<u64>=alloc(runtime(),count+1);
    let mut z:u64=0;while z<=count { seen[z]=0;z=z+1; }
    let mut head:u64=0;let mut tail:u64=1;queue[0]=entry;seen[entry]=1;let mut yes:bool=true;
    while head<tail && yes {
        let block:u64=queue[head];head=head+1;
        if block==use { yes=false; }
        else if block!=definition {
            let term:u64=words[at(block)+14];
            if term!=0 && term<=count {
                let kind:u64=words[at(term)];let mut first:u64=0;let mut end:u64=0;
                if kind==k_jump() { end=1; }
                else if kind==k_branch() { first=1;end=3; }
                while first<end {
                    let target:u64=words[at(term)+5+first];first=first+1;
                    if target!=0 && target<=count && seen[target]==0 {
                        if words[at(target)]!=k_block() || words[at(target)+16]!=f { yes=false; }
                        else { seen[target]=1;queue[tail]=target;tail=tail+1; }
                    }
                }
            }
        }
    }
    rt_free(runtime(),queue);rt_free(runtime(),seen);return yes;
}
fn argument_available(words:buf<u64>,count:u64,call:u64,value:u64)->bool {
    if value==0 || value>words[6] { return false; }
    let d:u64=value_record(words,count,value);
    // Metadata placement never makes a future definition available at call.
    if d==0 || d>=call { return false; }
    let block:u64=words[at(call)+16];
    if block==0 || block>count || words[at(block)]!=k_block() { return false; }
    let f:u64=words[at(block)+16];
    if f==0 || f>count || words[at(f)]!=k_function() { return false; }
    if words[at(d)]==k_const() { return true; }
    let owner:u64=words[at(d)+16];
    if words[at(d)]==k_param() { return owner==f; }
    if owner==block { return true; }
    if owner==0 || owner>count || words[at(owner)]!=k_block() || words[at(owner)+16]!=f { return false; }
    return block_dominates(words,count,f,owner,block);
}
fn verify_signature_types(words:buf<u64>,count:u64,out:buf<u64>)->u64 {
    let mut r:u64=1;
    while r<=count {
        if words[at(r)]==k_type_decl() {
            let owner:u64=words[at(r)+5];let child:u64=words[at(r)+6];let name:u64=words[at(r)+7];
            let form:u64=words[at(r)+14];let parent:u64=words[at(r)+16];
            if owner==0 || owner>=r || parent==0 || parent>count || words[at(parent)]!=k_function()
                || words[at(r)+4]!=0 || words[at(r)+8]!=3 || words[at(r)+12]!=CLASS_NONE()
                || form>2 || (words[at(r)+13]&(FLAG_PURE()+FLAG_NAMED()))!=words[at(r)+13] { return place(out,words,r,E_SHAPE()); }
            if words[at(owner)]!=k_param() && words[at(owner)]!=k_function() { return place(out,words,r,E_LINK()); }
            if (words[at(owner)]==k_param() && words[at(owner)+16]!=parent) || (words[at(owner)]==k_function() && owner!=parent) { return place(out,words,r,E_LINK()); }
            if form==0 {
                if child!=0 || words[at(r)+11]!=0 || words[at(r)+15]!=0 { return place(out,words,r,E_TYPED()); }
            } else {
                if child<=r || child>count || words[at(child)]!=k_type_decl() || words[at(child)+5]!=owner
                    || words[at(child)+16]!=parent || (words[at(child)+13]&FLAG_NAMED())!=0 { return place(out,words,r,E_LINK()); }
                if form==1 && (words[at(r)+9]!=64 || words[at(r)+11]==0 || words[at(r)+15]!=0) { return place(out,words,r,E_TYPED()); }
                if form==2 && (words[at(r)+15]==0 || words[at(r)+9]!=words[at(child)+9] || words[at(r)+10]!=words[at(child)+10] || words[at(r)+11]!=words[at(child)+11]) { return place(out,words,r,E_TYPED()); }
            }
            let mut cursor:u64=r;let mut levels:u64=0;
            while cursor!=0 {
                if cursor>count || words[at(cursor)]!=k_type_decl() { return place(out,words,r,E_LINK()); }
                if levels>64 { return place(out,words,r,E_TYPED()); }
                levels=levels+1;cursor=words[at(cursor)+6];
            }
            if (words[at(r)+13]&FLAG_NAMED())==0 {
                let mut incoming:u64=0;let mut q:u64=1;
                while q<r { if words[at(q)]==k_type_decl() && words[at(q)+6]==r { incoming=incoming+1; }q=q+1; }
                if incoming!=1 { return place(out,words,r,E_UNREACHED()); }
            }
            if name!=0 && (name>count || words[at(name)]!=k_symbol() || words[at(name)+16]!=parent) { return place(out,words,r,E_LINK()); }
            if (words[at(r)+13]&FLAG_NAMED())!=0 {
                let mut width:u64=words[at(owner)+9];if words[at(owner)]==k_function() { width=words[at(owner)+15]; }
                if words[at(r)+9]!=width || words[at(r)+10]!=words[at(owner)+10] || words[at(r)+11]!=words[at(owner)+11] { return place(out,words,r,E_TYPED()); }
                if words[at(owner)]==k_param() && name==0 { return place(out,words,r,E_LINK()); }
                let mut q:u64=1;
                while q<r { if words[at(q)]==k_type_decl() && words[at(q)+5]==owner && (words[at(q)+13]&FLAG_NAMED())!=0 { return place(out,words,r,E_SHARED()); }q=q+1; }
            } else if name!=0 { return place(out,words,r,E_SHAPE()); }
        }
        r=r+1;
    }
    return 0;
}
export fn value_available_at(words:buf<u64>,count:u64,use_record:u64,value:u64)->bool {
    if use_record==0 || use_record>count { return false; }
    return argument_available(words,count,use_record,value);
}
fn verify_call_arguments(words:buf<u64>,count:u64,out:buf<u64>)->u64 {
    let mut r:u64=1;
    while r<=count {
        if words[at(r)]==k_call_arg() {
            let call:u64=words[at(r)+6];let ordinal:u64=words[at(r)+14];
            if call==0 || call>=r || call_kind(words[at(call)])==false || words[at(call)+16]!=words[at(r)+16]
                || words[at(r)+4]!=0 || words[at(r)+8]!=2 || words[at(r)+12]!=CLASS_NONE()
                || ordinal<2 || ordinal>=words[at(call)+14] || r!=call+ordinal-1 { return place(out,words,r,E_SHAPE()); }
        }
        if call_kind(words[at(r)]) {
            let argc:u64=words[at(r)+14];let mut inline_count:u64=argc+1;if inline_count>3 { inline_count=3; }
            if argc>64 || words[at(r)+8]!=inline_count { return place(out,words,r,E_ARITY()); }
            let mut expected:u64=2;let mut q:u64=r+1;
            while q<=count {
                if words[at(q)]==k_call_arg() && words[at(q)+6]==r {
                    if words[at(q)+14]!=expected { return place(out,words,q,E_ARITY()); }
                    expected=expected+1;
                }
                q=q+1;
            }
            if argc>2 && expected!=argc { return place(out,words,r,E_ARITY()); }
            if argc<=2 && expected!=2 { return place(out,words,r,E_ARITY()); }
            let mut i:u64=0;
            while i<argc {
                let value:u64=call_argument(words,count,r,i);
                if words[at(r)]==k_call() && argument_available(words,count,r,value)==false { return place(out,words,r,E_VALUE()); }
                if words[at(r)]==k_call_indirect() && computed_value_available(words,count,r,value)==false { return place(out,words,r,E_VALUE()); }
                i=i+1;
            }
        }
        r=r+1;
    }
    return 0;
}

// Private scalar cells expose an opaque address, never an ordinary pointer.
// Accesses are explicit snapshots/stores; the frame allocator owns all offsets.
fn local_cell_record(words:buf<u64>,count:u64,value:u64)->u64 {
    if value==0 { return 0; }
    let mut r:u64=1;
    while r<=count {
        if words[at(r)]==k_local_cell() && words[at(r)+4]==value { return r; }
        r=r+1;
    }
    return 0;
}
// A vreg declaration is not the computation that initializes its value.
// Match the emitter's definition lookup before checking private memory inputs.
fn computed_definition(words:buf<u64>,count:u64,value:u64)->u64 {
    if value==0 { return 0; }
    let mut r:u64=1;
    while r<=count {
        if words[at(r)+4]==value && (words[at(r)]!=k_vreg() || words[at(r)+22]==1) { return r; }
        r=r+1;
    }
    return 0;
}
fn computed_value_available(words:buf<u64>,count:u64,use_record:u64,value:u64)->bool {
    if value==0 || value>words[6] { return false; }
    let d:u64=computed_definition(words,count,value);
    if d==0 || d>=use_record { return false; }
    let block:u64=words[at(use_record)+16];
    if block==0 || block>count || words[at(block)]!=k_block() { return false; }
    let f:u64=words[at(block)+16];
    if f==0 || f>count || words[at(f)]!=k_function() { return false; }
    if words[at(d)]==k_const() { return true; }
    let owner:u64=words[at(d)+16];
    if words[at(d)]==k_param() { return owner==f; }
    if owner==block { return true; }
    if owner==0 || owner>count || words[at(owner)]!=k_block() || words[at(owner)+16]!=f { return false; }
    return block_dominates(words,count,f,owner,block);
}
fn local_scalar(words:buf<u64>,count:u64,value:u64,width:u64,sign:u64)->bool {
    let d:u64=computed_definition(words,count,value);
    if d==0 { return false; }
    let class:u64=words[at(d)+12];
    return words[at(d)+9]==width && words[at(d)+10]==sign && words[at(d)+11]==0
        && (class==CLASS_VALUE() || class==CLASS_CONSTANT());
}
// THE CELL INDEX, ONCE PER VERIFY.
//
// `local_cell_record` walked the WHOLE image for every operand of every
// record, and it walked it even when the operand's value was not a cell at
// all. The index below holds the local cells of the image BY VALUE ID, so the
// walk in the body becomes a read.
//
// THE RULES, and they are the rules of the scan it replaces:
//   * the table is bounded by count+1 and NOT by words[6], which is not
//     bounded;
//   * a value id of 0 is not a cell id: the scan answered 0 for it and the
//     index answers 0 for it too, so cells[0] stays 0;
//   * for a value id in 1..count, the FIRST cell that carries it wins, which
//     is the first one the scan found;
//   * a value id ABOVE count is not indexed -- the table cannot hold it -- and
//     such an id keeps the original scan, so a sparse image answers exactly
//     what it answered before and NO NEW REFUSAL appears;
//   * the index holds the cells of the WHOLE image, the ones after the
//     record being verified included, exactly like the scan did.
//
// The table holds one word per record, and `verify` has already checked that
// the image holds count records before this pass runs, so the allocation is
// bounded by the image that is already in memory.
//
// THE CARRIER INDEX: FIRST AND SECOND, OVER EVERY KIND OF RECORD.
//
// The uniqueness rule of a cell asks for the FIRST OTHER record that carries
// the cell's value id, and it asked for it by walking the whole image once
// per cell. `first` holds the first record that carries a value id and
// `second` the second one, in RECORD ORDER, so the walk in the body becomes
// a read. The rules are the rules of the walk they replace: the tables are
// bounded by count+1 and NOT by words[6]; a value id of 0 is never a carrier,
// so first[0] and second[0] stay 0; the answer is the first carrier, unless
// the record being verified IS the first carrier, and then the second one,
// which is the first carrier that is not it; a value id ABOVE count is not
// indexed -- the tables cannot hold it -- and keeps the original walk, so a
// sparse image answers exactly what it answered before and NO NEW REFUSAL
// appears; and the tables hold the carriers of the WHOLE image, the ones
// after the record being verified included, exactly like the walk did.
fn verify_local_cells(words:buf<u64>,count:u64,out:buf<u64>)->u64 {
    // THE PRESENCE TEST FIRST, AND NO ALLOCATION BEFORE IT: an image with no
    // local cell at all is answered 0, as it was, and it costs nothing.
    let mut found:u64=1;
    while found<=count && words[at(found)]!=k_local_cell() { found=found+1; }
    if found>count { return 0; }
    let cells:buf<u64>=alloc(runtime(),count+1);
    let first:buf<u64>=alloc(runtime(),count+1);
    let second:buf<u64>=alloc(runtime(),count+1);
    let mut z:u64=0;
    while z<=count { cells[z]=0;first[z]=0;second[z]=0; z=z+1; }
    // ONE PASS, THREE TABLES. The cell table takes the first LOCAL CELL that
    // carries a value id; the carrier tables take the first and the second
    // record of ANY kind that carries it. The two answers are different
    // questions and the walk they replace asked both of them.
    let mut i:u64=1;
    while i<=count {
        let vid:u64=words[at(i)+4];
        if vid!=0 && vid<=count {
            if words[at(i)]==k_local_cell() && cells[vid]==0 { cells[vid]=i; }
            if first[vid]==0 { first[vid]=i; }
            else if second[vid]==0 { second[vid]=i; }
        }
        i=i+1;
    }
    // The body keeps every refusal of the pass, and the tables are released
    // after it, so an early return inside it leaks nothing.
    let code:u64=verify_local_cells_body(words,count,out,cells,first,second);
    rt_free(runtime(),second);rt_free(runtime(),first);rt_free(runtime(),cells);
    return code;
}
fn verify_local_cells_body(words:buf<u64>,count:u64,out:buf<u64>,cells:buf<u64>,first:buf<u64>,second:buf<u64>)->u64 {
    let mut r:u64=1;
    while r<=count {
        let p:u64=at(r);let kind:u64=words[p];
        if kind==k_local_cell() {
            let width:u64=words[p+14];let sign:u64=words[p+15];
            if words[2]<2 { return place(out,words,r,E_TAG()); }
            if words[p+4]==0 || words[p+8]!=1 || words[p+9]!=64 || words[p+10]!=0
                || words[p+11]!=0 || words[p+12]!=CLASS_ADDRESS() || words[p+13]!=FLAG_SIDE_EFFECT()
                || words[p+19]!=3 || words[p+20]!=0 || words[p+21]!=0 || words[p+22]!=0 || words[p+23]!=0
                || (width!=8 && width!=16 && width!=32 && width!=64) || sign>1 { return place(out,words,r,E_TYPED()); }
            let owner:u64=words[p+16];
            if owner==0 || owner>count || words[at(owner)]!=k_block() { return place(out,words,r,E_LINK()); }
            if computed_value_available(words,count,r,words[p+5])==false { return place(out,words,r,E_VALUE()); }
            if local_scalar(words,count,words[p+5],width,sign)==false { return place(out,words,r,E_TYPED()); }
            // THE DUPLICATE VALUE, BY INDEX: the first OTHER record that
            // carries this value id. The index IS the walk it replaces -- the
            // first carrier, unless this record is it, and then the second
            // one, which is the first carrier that is not it.
            let cvid:u64=words[p+4];
            let mut dup:u64=0;
            if cvid!=0 && cvid<=count {
                dup=first[cvid];
                if dup==r { dup=second[cvid]; }
            } else {
                // THE ORIGINAL WALK, for a value id the index cannot hold.
                dup=1;
                while dup<=count {
                    if dup!=r && words[at(dup)+4]==cvid { break; }
                    dup=dup+1;
                }
                if dup>count { dup=0; }
            }
            if dup!=0 { return place(out,words,dup,E_VALUE()); }
        }
        let mut slot:u64=0;
        while slot<words[p+8] && slot<3 {
            let role:u64=arg_is(kind,slot);
            if role==1 || role==5 {
                // THE INDEX, or the scan for a value id the table cannot hold.
                // Both answer the same record: the first cell that carries
                // this value, the scan being the definition of the index.
                let vid:u64=words[p+5+slot];
                let mut cell:u64=0;
                if vid!=0 && vid<=count { cell=cells[vid]; }
                else { cell=local_cell_record(words,count,vid); }
                if cell!=0 {
                    if slot!=0 || (kind!=k_load() && kind!=k_store()) { return place(out,words,r,E_TYPED()); }
                    if argument_available(words,count,r,words[p+5])==false { return place(out,words,r,E_VALUE()); }
                    let cp:u64=at(cell);
                    if words[p+9]!=words[cp+14] || words[p+10]!=words[cp+15] || words[p+11]!=0 { return place(out,words,r,E_TYPED()); }
                    if kind==k_load() {
                        if words[p+4]==0 || words[p+8]!=1 || words[p+12]!=CLASS_VALUE() || words[p+14]!=OP_LOAD()
                            || words[p+13]!=0 || words[p+15]!=0 { return place(out,words,r,E_TYPED()); }
                    } else {
                        if words[p+4]!=0 || words[p+8]!=2 || words[p+12]!=CLASS_ADDRESS() || words[p+14]!=OP_STORE()
                            || words[p+13]!=FLAG_SIDE_EFFECT() || words[p+15]!=0 { return place(out,words,r,E_TYPED()); }
                        if computed_value_available(words,count,r,words[p+6])==false { return place(out,words,r,E_VALUE()); }
                        if local_scalar(words,count,words[p+6],words[p+9],words[p+10])==false { return place(out,words,r,E_TYPED()); }
                    }
                }
            }
            slot=slot+1;
        }
        r=r+1;
    }
    return 0;
}
fn indirect_formal(words:buf<u64>,count:u64,f:u64,ordinal:u64)->u64 {
    let mut r:u64=f+1;let mut found:u64=0;
    while r<=count && words[at(r)+19]>words[at(f)+19] {
        if words[at(r)]==k_param() && words[at(r)+16]==f && words[at(r)+14]==ordinal {
            if found!=0 { return 0; }found=r;
        }
        r=r+1;
    }
    return found;
}
fn indirect_type_root(words:buf<u64>,count:u64,owner:u64)->u64 {
    let mut r:u64=1;let mut found:u64=0;
    while r<=count {
        if words[at(r)]==k_type_decl() && words[at(r)+5]==owner && (words[at(r)+13]&FLAG_NAMED())!=0 {
            if found!=0 { return 0; }found=r;
        }
        r=r+1;
    }
    return found;
}
fn indirect_type_matches(words:buf<u64>,root:u64,width:u64,signed:u64,space:u64)->bool {
    if root==0 { return false; }
    return words[at(root)+9]==width && words[at(root)+10]==signed && words[at(root)+11]==space;
}
fn indirect_mask(words:buf<u64>,count:u64,f:u64)->u64 {
    let mut mask:u64=0;let mut p:u64=f+1;
    while p<=count && words[at(p)+19]>words[at(f)+19] {
        if words[at(p)]==k_clobber() && words[at(p)+16]==f { mask=mask|words[at(p)+5]; }
        if words[at(p)]==k_param() && words[at(p)+16]==f && (words[at(p)+13]&(FLAG_DIR_OUT()+FLAG_DIR_INOUT()))!=0 {
            let family:u64=words[at(p)+15];if family==0 || family>16 { return 18446744073709551615; }
            mask=mask|(1<<(family-1));
        }
        p=p+1;
    }
    if (words[at(f)+13]&FLAG_RESULT_TYPED())!=0 && words[at(f)+15]!=0 { mask=mask|1; }
    return mask;
}
fn verify_indirect_calls(words:buf<u64>,count:u64,out:buf<u64>)->u64 {
    let mut r:u64=1;
    while r<=count {
        if words[at(r)]==k_call_indirect() {
            let p:u64=at(r);let f:u64=words[p+15];let argc:u64=words[p+14];
            if words[2]<3 { return place(out,words,r,E_TAG()); }
            if f==0 || f>count || words[at(f)]!=k_function() { return place(out,words,r,E_LINK()); }
            if (words[at(f)+13]&FLAG_RESULT_TYPED())==0 { return place(out,words,r,E_TYPED()); }
            if words[p+9]!=words[at(f)+15] || words[p+10]!=words[at(f)+10] || words[p+11]!=words[at(f)+11]
                || (words[p+4]!=0 && (words[p+9]==0 || words[p+12]!=CLASS_VALUE()))
                || (words[p+4]==0 && words[p+12]!=CLASS_NONE() && words[p+12]!=CLASS_VALUE())
                || words[p+13]!=FLAG_SIDE_EFFECT()+FLAG_MAY_FAULT() { return place(out,words,r,E_TYPED()); }
            if indirect_type_matches(words,indirect_type_root(words,count,f),words[p+9],words[p+10],words[p+11])==false { return place(out,words,r,E_TYPED()); }
            if argc>64 || argc!=words[at(f)+14] { return place(out,words,r,E_ARITY()); }
            if computed_value_available(words,count,r,words[p+5])==false { return place(out,words,r,E_VALUE()); }
            let d:u64=computed_definition(words,count,words[p+5]);let class:u64=words[at(d)+12];
            if words[at(d)+9]!=64 || words[at(d)+10]!=0 || (class!=CLASS_VALUE() && class!=CLASS_ADDRESS() && class!=CLASS_CONSTANT()) { return place(out,words,r,E_TYPED()); }
            if words[p+23]!=indirect_mask(words,count,f) { return place(out,words,r,E_TYPED()); }
            let mut actual:u64=0;let mut q:u64=f+1;
            while q<=count && words[at(q)+19]>words[at(f)+19] { if words[at(q)]==k_param() && words[at(q)+16]==f { actual=actual+1; }q=q+1; }
            if actual!=argc { return place(out,words,r,E_ARITY()); }
            let mut i:u64=0;
            while i<argc {
                let formal:u64=indirect_formal(words,count,f,i);
                if formal==0 { return place(out,words,r,E_ARITY()); }
                if (words[at(formal)+13]&(FLAG_DIR_OUT()+FLAG_DIR_INOUT()+FLAG_DIR_UNREAD()))!=0 { return place(out,words,r,E_TYPED()); }
                let bits:u64=words[at(formal)+9];let sign:u64=words[at(formal)+10];let space:u64=words[at(formal)+11];
                if indirect_type_matches(words,indirect_type_root(words,count,formal),bits,sign,space)==false { return place(out,words,r,E_TYPED()); }
                let value:u64=call_argument(words,count,r,i);
                if computed_value_available(words,count,r,value)==false { return place(out,words,r,E_VALUE()); }
                let arg:u64=computed_definition(words,count,value);
                if words[at(arg)+9]!=bits || words[at(arg)+10]!=sign || words[at(arg)+12]==CLASS_NONE() { return place(out,words,r,E_TYPED()); }
                // A load carries its access space; an integer loaded from user
                // memory is still an integer argument to a scalar signature.
                if space!=0 && words[at(arg)+11]!=space { return place(out,words,r,E_TYPED()); }
                i=i+1;
            }
        }
        r=r+1;
    }
    return 0;
}
export fn verify(words:buf<u64>,count:u64,out:buf<u64>)->u64 {
    if len(out)<4 || count==0 { return 800; }
    if len(words)<HEADER_WORDS()+count*NODE_WORDS() { return 800; }
    if words[0]!=MIR_MAGIC() { return E_TAG(); }
    if words[1]!=FORMAT_MAJOR() || (words[2]!=1 && words[2]!=2 && words[2]!=FORMAT_MINOR()) { return E_TAG(); }
    if words[3]!=count || words[5]!=NODE_WORDS() { return E_HEADER(); }
    if words[4]!=1 { return E_HEADER(); }
    if words[8]!=DOMAIN_BIT() { return E_VERSION(); }
    let mut values:u64=words[6];
    let mut code:u64=0;
    let mut record:u64=1;
    // The open ancestor chain. Record 1 is the unit, it owns the whole image
    // and has no parent of its own, and `n0..n2` are the children each open
    // entry has been given so far.
    let mut ch0:u64=1;
    let mut ch1:u64=0;
    let mut ch2:u64=0;
    let mut n0:u64=0;
    let mut n1:u64=0;
    let mut n2:u64=0;
    while record<=count {
        let mut at_r:u64=HEADER_WORDS()+(record-1)*NODE_WORDS();
        let mut kind:u64=words[at_r];
        let mut node:u64=words[at_r+1];
        let mut origin:u64=words[at_r+18];
        let mut parent:u64=words[at_r+16];
        let mut ordinal:u64=words[at_r+17];
        let mut produced:u64=words[at_r+4];
        let mut taken:u64=words[at_r+8];
        // THE VERDICT IS CLEARED PER RECORD, AND UNTIL NOW IT WAS NOT. `code`
        // was declared once before the loop and never reset inside it, so the
        // FIRST record to fail set it and every record after that still saw it
        // set: the rule chain opened with `if kind_present(kind)==false` and
        // every later rule was guarded on `code==0`, so a single failure turned
        // the rest of the image into a second copy of the same refusal. The
        // damage is not that the walk wasted effort -- it is that `place()` runs
        // unconditionally on `code!=0` near the bottom of the body, so it was
        // called once per REMAINING record, each call overwriting the last, and
        // the refusal the caller read named whichever record the loop happened
        // to stop on rather than the one that failed.
        //
        // Measured on `load rax,[counter]:ptr<user,u64>`, where the whole point
        // of the exercise is to learn WHICH record is malformed: the walk
        // reported 934 on record 20, the `mir_space`, and every rule that names
        // that record passes -- its ordinal is 4 and its parent chain is open.
        // The record that actually failed was earlier, and this line is what
        // makes the verifier name it. A verifier that reports the wrong record
        // is worse than one that refuses, because the refusal is believed.
        code=0;
        if kind_present(kind)==false { code=E_KIND(); }
        else if (node==0)==(origin==0) { code=E_ORIGIN(); }
        // `node` and `origin` are NTIR node ids: they are PROVENANCE, not
        // links into this image, and an NTIR tree is routinely larger than the
        // Machine IR it produced. Bounding them by the record count refused a
        // correct image, which is a verifier narrower than the thing it
        // verifies.
        else if record==1 {
            if parent!=0 || ordinal!=0 { code=E_SHAPE(); }
        } else if parent==0 { code=E_UNREACHED(); }
        else if parent>=record { code=E_CYCLE(); }
        else if ordinal==0 { code=E_SHAPE(); }
        else {
            // THE PARENT MUST BE AN ANCESTOR THAT IS STILL OPEN. Record 1 is
            // the root and is on the chain from the start, so `parent==0` has
            // already been refused above and this record has somebody to be
            // found. Three slots, because field 19 says depth is 0 unit,
            // 1 function, 2 block, 3 operation: an operation is a leaf, so the
            // open ancestors are always the unit, the function and the block.
            // A parent that is none of them belongs to a subtree this position
            // has already left -- the shared-parent case E_SHARED names -- and
            // is refused rather than written past.
            let mut at_c:u64=3;
            if parent==ch0 { at_c=0; }
            if parent==ch1 { at_c=1; }
            if parent==ch2 { at_c=2; }
            if at_c>2 { code=E_SHARED(); }
            else {
                // THE ORDINAL IS THE INDEX INSIDE THAT PARENT, so it is the
                // number of children the parent has been given so far plus
                // one. That is the field's own definition at the top of this
                // file, and it is what the old comparison against the
                // immediately preceding record was reaching for without
                // saying so.
                let mut seen:u64=n0;
                if at_c==1 { seen=n1; }
                if at_c==2 { seen=n2; }
                if ordinal!=seen+1 { code=E_SHARED(); }
                if code==0 {
                    // THIS RECORD IS THE OPEN ONE NOW, and the chain is what
                    // stood above its parent plus itself. Everything below the
                    // parent is closed by this, so the slots under it are
                    // CLEARED rather than left holding a record that is no
                    // longer an ancestor -- a stale `ch2` would otherwise let a
                    // record claim a parent from a subtree the walk has already
                    // left, which is the very thing this check refuses.
                    if at_c==0 { n0=ordinal; ch1=record; n1=0; ch2=0; n2=0; }
                    if at_c==1 { n1=ordinal; ch2=record; n2=0; }
                    if at_c==2 { n2=ordinal; }
                }
            }
        }
        if code!=0 { place(out,words,record,code); record=count+1; continue; }
        let mut width:u64=words[at_r+9];
        let mut signed:u64=words[at_r+10];
        let mut space:u64=words[at_r+11];
        let mut class:u64=words[at_r+12];
        // space_counts stores a usage count here, not a number of operand slots.
        if kind==k_space() {
            if taken>count || words[at_r+5]!=0 || words[at_r+6]!=0 || words[at_r+7]!=0 { code=E_SHAPE(); }
            taken=0;
        }
        if taken>3 { code=E_SHAPE(); }
        if code==0 && taken>0 {
            let mut slot:u64=0;
            while slot<3 {
                let mut value:u64=words[at_r+5+slot];
                let mut live:bool=slot<taken;
                if live==false && value!=0 { code=E_SHAPE(); }
                if live==true && value==0 && arg_is(kind,slot)!=3 && arg_is(kind,slot)!=4 && arg_is(kind,slot)!=5 {
                    if kind!=k_branch() || words[at_r+22]!=8 || slot!=0 { code=E_SHAPE(); }
                }
                if code==0 && live==true && (arg_is(kind,slot)==1 || arg_is(kind,slot)==5) && value>values {
                    code=E_VALUE();
                }
                if code==0 && live==true && (arg_is(kind,slot)==2 || arg_is(kind,slot)==4) {
                    if value>count { code=E_LINK(); }
                    // Optional block links (function declarations) use zero for no body.
                    else if value!=0 {
                        let mut there:u64=HEADER_WORDS()+(value-1)*NODE_WORDS();
                        if words[there]!=k_block() { code=E_LINK(); }
                    }
                }
                slot=slot+1;
            }
        }
        if code==0 && kind!=k_contract_expr() {
            let family:u64=words[at_r+20]; let offset:u64=words[at_r+21];
            let mode:u64=words[at_r+22]; let mask:u64=words[at_r+23];
            if mode>15 || family>16 || mask>1048575 { code=E_SHAPE(); }
            if code==0 && (mode&3)==0 {
                if family!=0 || (offset!=0 && kind!=k_param()) { code=E_SHAPE(); }
                if code==0 && kind==k_param() && offset!=0 && (offset!=8 || width!=8 || words[at_r+15]==0 || words[at_r+15]>4) { code=E_TYPED(); }
            }
            if code==0 && (mode&3)!=0 {
                if family==0 || (offset!=0 && offset!=8) { code=E_SHAPE(); }
                if width!=8 && width!=16 && width!=32 && width!=64 { code=E_TYPED(); }
                if offset==8 && (width!=8 || family>4) { code=E_TYPED(); }
                if (mode&3)==3 { code=E_SHAPE(); }
                if (mode&1)!=0 && (kind!=k_vreg() || produced==0 || taken!=0 || mode!=1) { code=E_SHAPE(); }
                if (mode&2)!=0 && (kind!=k_asm() || frame_family(family)) { code=E_SHAPE(); }
            }
            if code==0 && (mode&4)!=0 && (kind!=k_asm() || flags_writer(words[at_r+14])==false) { code=E_SHAPE(); }
            if code==0 && kind==k_asm() && flags_writer(words[at_r+14]) && (mode&4)==0 { code=E_SHAPE(); }
            if code==0 && (mode&8)!=0 && (kind!=k_branch() || words[at_r+15]==0 || mode!=8) { code=E_SHAPE(); }
            if code==0 && kind==k_branch() && words[at_r+15]!=0 && mode!=8 { code=E_SHAPE(); }
            if code==0 && mask!=0 && call_kind(kind)==false { code=E_SHAPE(); }
        }
        if code==0 && kind==k_param() && words[at_r+15]>16 { code=E_TARGET(); }
        if code==0 && produced>values { code=E_VALUE(); }
        if code==0 && class>CLASS_LIMIT() { code=E_TYPED(); }
        if code==0 && class_admissible(kind,class)==false { code=E_TYPED(); }
        if code==0 && signed>2 { code=E_TYPED(); }
        if code==0 && space!=0 && mir_space_known(space)==false { code=E_TYPED(); }
        if code==0 && space!=0 && width_admissible(kind)==false { code=E_TYPED(); }
        if code==0 && width!=0 && mir_width_known(width)==false { code=E_TYPED(); }
        if code==0 && width!=0 && width_admissible(kind)==false { code=E_TYPED(); }
        // Grouping may copy a predicate, but cannot manufacture one. Earlier
        // predicate copies have already passed this same check in record order.
        if code==0 && kind==k_copy() && class==CLASS_PREDICATE() {
            if produced==0 || taken!=1 || words[at_r+14]!=OP_COPY() || width!=1 {
                code=E_TYPED();
            }
            if code==0 && argument_available(words,count,record,words[at_r+5])==false { code=E_VALUE(); }
            if code==0 {
                let source_record:u64=value_record(words,count,words[at_r+5]);
                let source_at:u64=at(source_record);
                let source_kind:u64=words[source_at];
                let source_op:u64=words[source_at+14];
                if words[source_at+12]!=CLASS_PREDICATE() || words[source_at+9]!=width
                    || words[source_at+10]!=signed || words[source_at+11]!=space { code=E_TYPED(); }
                if code==0 && source_kind!=k_copy() {
                    if source_kind!=k_binary() || source_op<OP_EQ() || source_op>OP_GE_S() { code=E_TYPED(); }
                }
            }
        }
        if code==0 && kind==k_asm() {
            if words[at_r+14]==OP_UMUL() && (words[at_r+20]!=1 || words[at_r+21]!=0 || words[at_r+22]!=6 || produced!=0) { code=E_SHAPE(); }
            let mut op:u64=words[at_r+14];
            let mut decomposed:u64=words[at_r+15];
            if op>OP_LIMIT() { code=E_TYPED(); }
            if code==0 && decomposed==0 {
                let mut arity:u64=op_arity(op);
                if taken<arity/16 || taken>arity%16 { code=E_ARITY(); }
            }
            if code==0 && decomposed!=0 && taken!=0 { code=E_ARITY(); }
            if code==0 && op_produces(op)==false && produced!=0 { code=E_SHAPE(); }
            if code==0 && op_is_terminator(op)==true {
                if (words[at_r+13]&FLAG_TERMINATOR())==0 { code=E_SHAPE(); }
            }
        }
        // A PREDICATE IS A COMPARISON, OR IT IS NOTHING. `class_admissible`
        // above now lets a `k_asm` carry CLASS_PREDICATE so that `cmp` and
        // `test` can publish the flags they define; this is the other half of
        // that allowance, and without it any opcode could claim to be a
        // predicate and a conditional jump could consume one that is not a
        // comparison at all.
        if code==0 && kind==k_asm() && words[at_r+12]==CLASS_PREDICATE() && words[at_r+14]!=OP_CMP() && words[at_r+14]!=OP_TEST() {
            code=E_SHAPE();
        }
        if code==0 && kind==k_address() {
            let mut scale:u64=words[at_r+14];
            if scale!=1 && scale!=2 && scale!=4 && scale!=8 { code=E_SCALE(); }
        }
        if code==0 && kind==k_block() {
            if words[at_r+14]==0 || words[at_r+14]>count { code=E_SHAPE(); }
        }
        // THE DECLARED RESULT, AND THE THREE WAYS IT CAN BE A LIE. This is
        // the negative case the flag exists for: a field that is present and
        // zero has to be distinguishable from a field that is absent, or a
        // consumer reads "no result declared" out of an image that says
        // "result declared, width unknown" and picks a width for itself.
        if code==0 && kind==k_function() {
            let mut declared:bool=(words[at_r+13]&FLAG_RESULT_TYPED())!=0;
            let mut result_width:u64=words[at_r+15];
            // 1. THE FLAG WITHOUT A WIDTH. A declared result whose width this
            // level could not name is not a result of width zero; it is an
            // answer the emitter does not have. Refused, so that no consumer
            // is handed an image where "declared" and "zero" are one value.
            //
            // EXCEPT THE ONE WIDTH THAT IS A REAL ANSWER, and the exception is
            // read from a field the image already carries rather than from the
            // source text. `never` is a scalar whose width is zero BY
            // DEFINITION and not by ignorance: spec/ntasm/ntasm.md says `never`
            // means control does not return to the caller, so a `-> never`
            // function declares no value at all and a zero width is the whole
            // of what it declares. The reference agrees and is not guessing:
            // frontend.c's `type_bits` returns 0 for NTF_T_NEVER through its
            // `default`, and `ntir.nova`'s `scalar_of` answers
            // `Scalar{width:0,signed:SIGNED_NONE,known:true}` with the comment
            // that width 0 is "the answer for `never`, which is a real type and
            // not a missing one".
            //
            // SO THE DISCRIMINATOR IS THE SIGNEDNESS, which is word 10 on this
            // record and which `result_of` already wrote from the same type
            // child. A zero-width result that carries a signedness (0 unsigned
            // or 1 signed) is a type whose width this level could not name, and
            // is refused exactly as before; a zero-width result carrying
            // SIGNED_NONE is `never`, and refusing it refused every `-> never`
            // declaration in the language.
            //
            // WITHOUT THIS THE RULE CONTRADICTS ITS OWN NEIGHBOUR: check 3
            // below holds every width to `mir_width_known`, and
            // `mir_width_known(0)` returns TRUE -- the same is true of
            // `ntir.nova`'s `width_known(0)`. So zero was already a width this
            // level can name, and check 1 was the only place refusing it.
            let mut result_signed:u64=words[at_r+10];
            if declared==true && result_width==0 && result_signed!=SIGNED_NONE() {
                code=E_TYPED();
            }
            // 2. A WIDTH WITHOUT THE FLAG. `aux2` on a function is the result
            // width and nothing else, so a width with the flag clear is an
            // image whose two fields disagree about whether there is a
            // result. Same class of defect as setting `arg_a` with
            // `arg_count` zero, and refused as one.
            if code==0 && declared==false && result_width!=0 { code=E_SHAPE(); }
            // 3. A WIDTH THIS LEVEL CANNOT NAME. The same table every other
            // typed word is held to, so `-> u64` and a width no encoder has
            // are not both "a number in aux2".
            if code==0 && result_width!=0 && mir_width_known(result_width)==false {
                code=E_TYPED();
            }
        }
        if code==0 && kind!=k_function() {
            if (words[at_r+13]&FLAG_RESULT_TYPED())!=0 { code=E_SHAPE(); }
        }
        // MIR/0.3: THE DECLARATION BITS, each held to the kinds that may carry
        // it. `mir_symbol` is skipped because its flags word is a count (the
        // qualifier depth), not a bitmask.
        if code==0 && kind!=k_symbol() {
            let declared_bits:u64=words[at_r+13]&FLAG_DECLARED_MASK();
            if (declared_bits&FLAG_EXPORT())!=0 && kind!=k_function() && kind!=k_data() { code=E_SHAPE(); }
            if (declared_bits&(FLAG_RDATA()+FLAG_WDATA()))!=0 && kind!=k_data() { code=E_SHAPE(); }
            if (declared_bits&(FLAG_RDATA()+FLAG_WDATA()))==FLAG_RDATA()+FLAG_WDATA() { code=E_SHAPE(); }
            if (declared_bits&(FLAG_DIR_OUT()+FLAG_DIR_INOUT()+FLAG_DIR_UNREAD()))!=0 && kind!=k_param() { code=E_SHAPE(); }
            let directions:u64=declared_bits&(FLAG_DIR_OUT()+FLAG_DIR_INOUT()+FLAG_DIR_UNREAD());
            if directions!=0 && directions!=FLAG_DIR_OUT() && directions!=FLAG_DIR_INOUT() && directions!=FLAG_DIR_UNREAD() { code=E_SHAPE(); }
            if (declared_bits&FLAG_PREDICATED())!=0 && kind!=k_function() { code=E_SHAPE(); }
        }
        if code==0 && (words[at_r+13]&FLAG_TERMINATOR())!=0 {
            // A TERMINATOR IS THE LAST CHILD OF ITS BLOCK and its block must
            // name it. Anything else means two terminators or none.
            if parent>=record { code=E_SHAPE(); }
            else if words[HEADER_WORDS()+(parent-1)*NODE_WORDS()]!=k_block() { code=E_SHAPE(); }
            else if words[HEADER_WORDS()+(parent-1)*NODE_WORDS()+14]!=record {
                code=E_SHAPE();
            }
        }
        if code!=0 { return place(out,words,record,code); }
        record=record+1;
    }
    if code==0 { code=verify_local_cells(words,count,out); }
    if code==0 { code=verify_signature_types(words,count,out); }
    if code==0 { code=verify_contract_facts(words,count,out); }
    if code==0 { code=verify_call_arguments(words,count,out); }
    if code==0 { code=verify_indirect_calls(words,count,out); }
    if code==0 { return verify_flags(words,count,out); }
    return code;
}

// Resolve direction-dependent call effects after the ABI stage has filled
// every param flag. Reads MIR declaration facts and their exact name spans.
export fn resolve_call_effects(words:buf<u64>,count:u64,source:buf<u8>)->u64 {
    let mut r:u64=1;
    while r<=count {
        if words[at(r)]==k_call() {
            let symbol:u64=words[at(r)+5];
            if symbol==0 || symbol>count || words[at(symbol)]!=k_symbol() { return E_LINK(); }
            let mut f:u64=1; let mut found:u64=0;
            while f<=count && found==0 {
                if words[at(f)]==k_function() {
                    if same4(source,words[at(symbol)+5],words[at(symbol)+6],words[at(f)+6],words[at(f)+7]) { found=f; }
                    if words[at(f)+5]==0 && f<count && words[at(f+1)]==k_symbol() && words[at(f+1)+16]==f
                        && same4(source,words[at(symbol)+5],words[at(symbol)+6],words[at(f+1)+5],words[at(f+1)+6]) { found=f; }
                }
                f=f+1;
            }
            if found==0 { return E_LINK(); }
            let mut mask:u64=0; let mut p:u64=found+1;
            while p<=count && words[at(p)+19]>words[at(found)+19] {
                if words[at(p)]==k_clobber() && words[at(p)+16]==found { mask=mask|words[at(p)+5]; }
                if words[at(p)]==k_param() && words[at(p)+16]==found
                    && (words[at(p)+13]&(FLAG_DIR_OUT()+FLAG_DIR_INOUT()))!=0 {
                    let family:u64=words[at(p)+15];
                    if family==0 || family>16 { return E_TARGET(); }
                    mask=mask|(1<<(family-1));
                }
                p=p+1;
            }
            if (words[at(found)+13]&FLAG_RESULT_TYPED())!=0 && words[at(found)+15]!=0 { mask=mask|1; }
            words[at(r)+23]=mask;
        }
        r=r+1;
    }
    return 0;
}

// ---- the serialization ---------------------------------------------------
//
// One line per record, ascending id, fixed field order, decimal only, newline
// terminated. No hash, no address, no timestamp, no path and no locale,
// because a golden that moves when any of those does is not a golden of the
// IR.
//
// THE FIRST LINE IS THE FORMAT TAG, so a golden names the schema it was taken
// under. Changing the tag changes the first line of every fixture and the
// gate fails on the bytes.
fn byte_out(out:buf<u8>,cap:u64,at:u64,byte:u64)->u64 {
    if at>=cap { return 0; }
    out[at]=u8(byte);
    return at+1;
}
fn wput_text(out:buf<u8>,cap:u64,at:u64,text:buf<u8>)->u64 {
    let mut n:u64=len(text);
    if at+n>cap { return 0; }
    let mut i:u64=0;
    while i<n {
        if text[i]==0 || text[i]>=128 { return 0; }
        out[at+i]=text[i];
        i=i+1;
    }
    return at+n;
}
fn wput_decimal(out:buf<u8>,cap:u64,at:u64,value:u64)->u64 {
    if value==0 { return byte_out(out,cap,at,48); }
    let mut digits:u64=0;
    let mut rest:u64=value;
    while rest!=0 { rest=rest/10; digits=digits+1; }
    if at+digits>cap { return 0; }
    let mut i:u64=at+digits;
    rest=value;
    while rest!=0 { i=i-1; out[i]=u8(48+(rest%10)); rest=rest/10; }
    return at+digits;
}
// The twenty-four field labels of the text form, addressed by number so the
// serializer holds no buffer argument that is a literal. A Nova buffer
// argument must NAME a buffer, so a literal cannot reach wput_text directly.
fn wput_label(out:buf<u8>,cap:u64,at:u64,label:u64)->u64 {
    if label==0 { let mut a:buf<u8>=" records=";return wput_text(out,cap,at,a); }
    if label==1 { let mut a:buf<u8>=" values=";return wput_text(out,cap,at,a); }
    if label==2 { let mut a:buf<u8>=" blocks=";return wput_text(out,cap,at,a); }
    if label==3 { let mut a:buf<u8>=" domain=";return wput_text(out,cap,at,a); }
    if label==4 { let mut a:buf<u8>=" typed=";return wput_text(out,cap,at,a); }
    if label==5 { let mut a:buf<u8>=" kind=";return wput_text(out,cap,at,a); }
    if label==6 { let mut a:buf<u8>=" name=";return wput_text(out,cap,at,a); }
    if label==7 { let mut a:buf<u8>=" ntir=";return wput_text(out,cap,at,a); }
    if label==8 { let mut a:buf<u8>=" org=";return wput_text(out,cap,at,a); }
    if label==9 { let mut a:buf<u8>=" line=";return wput_text(out,cap,at,a); }
    if label==10 { let mut a:buf<u8>=" col=";return wput_text(out,cap,at,a); }
    if label==11 { let mut a:buf<u8>=" val=";return wput_text(out,cap,at,a); }
    if label==12 { let mut a:buf<u8>=" a=";return wput_text(out,cap,at,a); }
    if label==13 { let mut a:buf<u8>=" b=";return wput_text(out,cap,at,a); }
    if label==14 { let mut a:buf<u8>=" c=";return wput_text(out,cap,at,a); }
    if label==15 { let mut a:buf<u8>=" n=";return wput_text(out,cap,at,a); }
    if label==16 { let mut a:buf<u8>=" w=";return wput_text(out,cap,at,a); }
    if label==17 { let mut a:buf<u8>=" s=";return wput_text(out,cap,at,a); }
    if label==18 { let mut a:buf<u8>=" sp=";return wput_text(out,cap,at,a); }
    if label==19 { let mut a:buf<u8>=" cl=";return wput_text(out,cap,at,a); }
    if label==20 { let mut a:buf<u8>=" f=";return wput_text(out,cap,at,a); }
    if label==21 { let mut a:buf<u8>=" x=";return wput_text(out,cap,at,a); }
    if label==22 { let mut a:buf<u8>=" y=";return wput_text(out,cap,at,a); }
    if label==23 { let mut a:buf<u8>=" p=";return wput_text(out,cap,at,a); }
    if label==24 { let mut a:buf<u8>=" o=";return wput_text(out,cap,at,a); }
    if label==25 { let mut a:buf<u8>=" d=";return wput_text(out,cap,at,a); }
    if label==26 { let mut a:buf<u8>=" cf=";return wput_text(out,cap,at,a); }
    if label==27 { let mut a:buf<u8>=" co=";return wput_text(out,cap,at,a); }
    if label==28 { let mut a:buf<u8>=" cm=";return wput_text(out,cap,at,a); }
    if label==29 { let mut a:buf<u8>=" cc=";return wput_text(out,cap,at,a); }
    return 0;
}
// The first line of every serialization, and it moves WITH FORMAT_MINOR
// because a golden naming the old schema would be a golden of an image that
// does not carry the declared return type. The minor digit is the whole
// change: the record stride, the header width and every field's meaning are
// the ones the 0.1 images had, which is why 0 stays 0.
export fn header_text()->buf<u8> { return "MIR/1.3"; }
// The value of `versionné` for this output, in one place: a format tag, a
// major and a minor, and the `machine_ir` domain of the source's versions
// block. All four are read back by the gate, and a change to any of them is a
// change of the schema, not a cosmetic edit.
export fn version_pin()->u64 { return FORMAT_MAJOR()*100+FORMAT_MINOR(); }
export fn serialize(words:buf<u64>,count:u64,out:buf<u8>,length:buf<u64>)->u64 {
    if count==0 || len(length)<1 { return 800; }
    if len(words)<HEADER_WORDS()+count*NODE_WORDS() { return 800; }
    if words[0]!=MIR_MAGIC() { return E_TAG(); }
    if words[1]!=FORMAT_MAJOR() || (words[2]!=1 && words[2]!=2 && words[2]!=FORMAT_MINOR()) { return E_TAG(); }
    let mut cap:u64=len(out);
    let mut tag:buf<u8>=header_text();
    if words[2]==1 { tag="MIR/1.1"; }
    if words[2]==2 { tag="MIR/1.2"; }
    let mut at:u64=wput_text(out,cap,0,tag);
    if at==0 { return 800; }
    at=wput_label(out,cap,at,0); if at==0 { return 800; }
    at=wput_decimal(out,cap,at,words[3]); if at==0 { return 800; }
    at=wput_label(out,cap,at,1); if at==0 { return 800; }
    at=wput_decimal(out,cap,at,words[6]); if at==0 { return 800; }
    at=wput_label(out,cap,at,2); if at==0 { return 800; }
    at=wput_decimal(out,cap,at,words[7]); if at==0 { return 800; }
    at=wput_label(out,cap,at,3); if at==0 { return 800; }
    at=wput_decimal(out,cap,at,words[8]); if at==0 { return 800; }
    at=wput_label(out,cap,at,4); if at==0 { return 800; }
    at=wput_decimal(out,cap,at,words[9]); if at==0 { return 800; }
    at=byte_out(out,cap,at,10); if at==0 { return 800; }
    let mut id:u64=1;
    while id<=count {
        let mut at_r:u64=HEADER_WORDS()+(id-1)*NODE_WORDS();
        at=wput_decimal(out,cap,at,id); if at==0 { return 800; }
        at=wput_label(out,cap,at,5); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r]); if at==0 { return 800; }
        at=wput_label(out,cap,at,7); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+1]); if at==0 { return 800; }
        at=wput_label(out,cap,at,8); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+18]); if at==0 { return 800; }
        at=wput_label(out,cap,at,9); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+2]); if at==0 { return 800; }
        at=wput_label(out,cap,at,10); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+3]); if at==0 { return 800; }
        at=wput_label(out,cap,at,11); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+4]); if at==0 { return 800; }
        at=wput_label(out,cap,at,12); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+5]); if at==0 { return 800; }
        at=wput_label(out,cap,at,13); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+6]); if at==0 { return 800; }
        at=wput_label(out,cap,at,14); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+7]); if at==0 { return 800; }
        at=wput_label(out,cap,at,15); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+8]); if at==0 { return 800; }
        at=wput_label(out,cap,at,16); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+9]); if at==0 { return 800; }
        at=wput_label(out,cap,at,17); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+10]); if at==0 { return 800; }
        at=wput_label(out,cap,at,18); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+11]); if at==0 { return 800; }
        at=wput_label(out,cap,at,19); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+12]); if at==0 { return 800; }
        at=wput_label(out,cap,at,20); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+13]); if at==0 { return 800; }
        at=wput_label(out,cap,at,21); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+14]); if at==0 { return 800; }
        at=wput_label(out,cap,at,22); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+15]); if at==0 { return 800; }
        at=wput_label(out,cap,at,23); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+16]); if at==0 { return 800; }
        at=wput_label(out,cap,at,24); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+17]); if at==0 { return 800; }
        at=wput_label(out,cap,at,25); if at==0 { return 800; }
        at=wput_decimal(out,cap,at,words[at_r+19]); if at==0 { return 800; }
        let mut field:u64=20;
        while field<24 {
            at=wput_label(out,cap,at,field+6); if at==0 { return 800; }
            at=wput_decimal(out,cap,at,words[at_r+field]); if at==0 { return 800; }
            field=field+1;
        }
        at=byte_out(out,cap,at,10); if at==0 { return 800; }
        id=id+1;
    }
    length[0]=at;
    return 0;
}
