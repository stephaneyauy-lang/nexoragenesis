; Candidate native Nova ABI2 runtime. No C, libc, imports or final-product claim.
; Private entry returns NVRH0001 host descriptor. LoadImage + direct call only.
format pe64
abi efi_x64
entry nv_start
section .text rx
nv_start:
push rbx
push rbp
push rsi
push rdi
push r12
push r13
push r14
push r15
sub rsp, 56
; Private native entry: RCX=EFI_BS*,RDX=root EFI_FILE*,R8=ConOut*.
; Direct invocation after LoadImage, NEVER StartImage with this ABI.
mov r12, rcx
mov r13, rdx
mov r14, r8
lea rbx, [rip + nv_state]
load64 rax, [rbx + 120]
cmp rax, 0
jne nv_start_bad
cmp r12, 0
je nv_start_bad
mov rax, 0
mov rdi, rbx
mov rsi, 128
nv_start_zero:
store8 [rdi], rax
add rdi, 1
sub rsi, 1
jne nv_start_zero
store64 [rbx], r12
store64 [rbx + 8], r13
store64 [rbx + 16], r14
lea r12, [rip + nv_ctx]
mov rax, 2
store64 [r12], rax
mov rax, 48
store64 [r12 + 8], rax
mov rax, 0
store64 [r12 + 16], rax
store64 [r12 + 24], rax
store64 [r12 + 32], rax
lea rax, [rip + nv_table]
store64 [r12 + 40], rax
mov rcx, r12
mov rdx, 4194304
call nv_pool
cmp rax, 0
je nv_start_bad
store64 [rbx + 64], rax
mov rcx, r12
mov rdx, 4096
call nv_pool
cmp rax, 0
je nv_start_unwind
store64 [rbx + 72], rax
mov rax, 1
store64 [rbx + 120], rax
lea rax, [rip + nv_host]
jmp nv_start_ret
nv_start_unwind:
mov rcx, r12
load64 rdx, [rbx + 64]
call nv_unpool
mov rax, 0
store64 [rbx + 64], rax
nv_start_bad:
mov rax, 0
jmp nv_start_ret
nv_start_ret:
add rsp, 56
pop r15
pop r14
pop r13
pop r12
pop rdi
pop rsi
pop rbp
pop rbx
ret

nv_err:
load64 rax, [rcx + 16]
