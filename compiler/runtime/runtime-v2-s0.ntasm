mov r13, rdx
cmp r13, 134217713
jae nv_pool_bound
load64 rbx, [rcx + 40]
load64 rbx, [rbx + 112]
load64 r14, [rbx]
mov rax, 0
store64 [rsp + 32], rax
mov rcx, 2
lea rdx, [r13 + 16]
lea r8, [rsp + 32]
load64 rax, [r14 + 64]
call rax
mov rdx, 0x8000000000000000
cmp rax, rdx
jae nv_pool_bad
load64 rax, [rsp + 32]
cmp rax, 0
je nv_pool_bad
mov rdx, 0x4e564d454d303032
store64 [rax], rdx
store64 [rax + 8], r13
add rax, 16
mov rdi, rax
mov rsi, r13
mov rdx, 0
cmp rsi, 0
je nv_pool_count
; Payload zero: store64 words while >=8 bytes left, then 0..7 byte tail.
nv_pool_zero:
cmp rsi, 8
jae nv_pool_zero_word
cmp rsi, 0
je nv_pool_count
nv_pool_zero_tail:
store8 [rdi], rdx
add rdi, 1
sub rsi, 1
jne nv_pool_zero_tail
jmp nv_pool_count
nv_pool_zero_word:
store64 [rdi], rdx
add rdi, 8
sub rsi, 8
jmp nv_pool_zero
nv_pool_count:
load64 rdx, [rbx + 48]
add rdx, 1
store64 [rbx + 48], rdx
jmp nv_pool_ret
nv_pool_bound:
mov rcx, r12
mov rdx, 4
call nv_err
jmp nv_pool_ret
