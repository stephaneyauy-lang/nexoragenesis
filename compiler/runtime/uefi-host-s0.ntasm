je h_start_fail
store64 [rbx + 16], r13
; Disable the firmware watchdog before any long step: UEFI 2.10 sec 7.5.1
; SetWatchdogTimer(Timeout=0) stops it. Platform watchdog only; the host
; RAM/time guards are unchanged.
