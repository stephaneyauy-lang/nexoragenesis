; Candidate native UEFI loader and ABI2 selftest. No C or external linker.
; Production entry h_start. Test transport changes ONLY entry to h_test_entry.
; NVRUNTIME.EFI exposes NVRH0001; NOVACORE.EFI entry is Nova ABI2/no flat args.
format pe64
abi efi_x64
entry h_start
section .text rx
h_test_entry:
lea rax, [rip + h_state]
mov r9, 1
store64 [rax + 96], r9
jmp h_start

h_start:
