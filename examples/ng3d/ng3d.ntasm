mov rax, 65536
store [v8]:ptr<user,i64>,rax
mov rax, 0
store [nx]:ptr<user,i64>,rax
mov rax, 0
store [ny]:ptr<user,i64>,rax
mov rax, 65536
store [nz]:ptr<user,i64>,rax
mov rax, 208
store [cr]:ptr<user,i64>,rax
mov rax, 82
store [cg]:ptr<user,i64>,rax
mov rax, 74
store [cb]:ptr<user,i64>,rax
call draw(rbx)
mov rax, 65536
