module efi.go1
target x86_64-nexora-uefi
default_abi efi-x64-v0
section .text {
fn leaf(in p1:u64,in p2:u64,in p3:u64,in p4:u64,in p5:u64,in p6:u64,in p7:u64,in p8:u64)->u64
effects {}
