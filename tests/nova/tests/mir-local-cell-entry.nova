module mir_local_cell_entry;
import machine_pipeline;
import machine_ir;
export fn main(source:buf<u8>,mode:u64,index:u64,words:buf<u64>,words_count:u64,
               out:buf<u8>,out_count:u64,length:buf<u64>,report:buf<u64>)->u64 {
    if mode==0 {
        words[0]=machine_ir.HEADER_WORDS();words[1]=machine_ir.NODE_WORDS();
        words[2]=machine_ir.KIND_BASE();words[3]=machine_ir.KIND_COUNT();
        return 0;
    }
    if mode==3 { return machine_pipeline.lower(source,words,words_count,report); }
    if len(words)<machine_ir.HEADER_WORDS() { return 800; }
    let verdict:u64=machine_ir.verify(words,words[3],report);
    if mode==12 || verdict!=0 { return verdict; }
    if mode==5 { return machine_pipeline.build_pe_from_image(words,words[3],source,out,length,report); }
    return 800;
}
