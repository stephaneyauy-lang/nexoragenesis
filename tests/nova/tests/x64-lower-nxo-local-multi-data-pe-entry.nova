module x64_lower_nxo_local_multi_data_pe_entry;
import ntasm_ast;
import ntasm_parser;
import ntasm_nxo;
import ntasm_nxo_pe;
import ntasm_pe;
import x64_lower_nxo;
import x64_lower_nxo_pe;

export fn main(source:buf<u8>,out:buf<u8>)->u64 {
    if len(out)<8{return 827;}
    let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    if tree.ok==false{ntasm_ast.release(tree);return 800;}
    let result:ntasm_nxo_pe.ConvertResult=
        x64_lower_nxo_pe.build_local_helper_calls_with_scalar_data(source,tree,1,3);
    let pe:buf<u8>=result.bytes;
    if result.code!=0{rt_free(runtime(),pe);ntasm_ast.release(tree);return result.code;}
    ntasm_ast.release(tree);
    let pe_size:u64=len(pe);
    if pe_size>len(out)-8{rt_free(runtime(),pe);return 827;}
    ntasm_pe.put64(out,0,pe_size);ntasm_pe.copy(out,8,pe);
    rt_free(runtime(),pe);return 0;
}
