module x64_lower_nxo_pe_entry;
import ntasm_ast;import ntasm_parser;import ntasm_nxo;import ntasm_nxo_pe;import ntasm_pe;
import x64_lower_nxo;import x64_lower_nxo_pe;

// Gate entry for the NXO to PE adapters.
//   mode 0: x64_lower_nxo_pe.build, the definition driven legacy path.
//   mode 1: x64_lower_nxo_pe.build_function_bodies, self contained object to PE.
//   mode 2: x64_lower_nxo.build_function_bodies, the same NXO with no PE, so the
//           harness can hand the producer own bytes to the frozen C materializer
//           and the C PE writer.
//   mode 3: x64_lower_nxo_pe.build_function_bodies_and_write, the same PE
//           written to the path buffer, with no C driver in the middle.
//   mode 4: x64_lower_nxo_pe.build_function_bodies_linked, the cross producer
//           route: the same self contained object linked against the external
//           definition buffer, so the contract text comparison is exercised
//           instead of being avoided.
//   mode 5: x64_lower_nxo_pe.build_function_bodies_and_write_linked, mode 4 to
//           a file, so a refused link is shown to create nothing on disk.
//   mode 6: x64_lower_nxo_pe.build_function_bodies_and_write_sized, mode 3 plus
//           the byte count Nova itself computed, written at out[0].
// out = [size:u64][bytes] for modes 0, 1, 2 and 4, and [size:u64] for mode 6.
// Modes 3 and 5 write no output. Every result is transactional: on any failure
// the output buffer keeps its previous content and the code is non zero.
export fn main(source:buf<u8>,definition:buf<u8>,mode:u64,path:buf<u8>,out:buf<u8>)->u64 {
    if mode==3 {
        let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
        if tree.ok==false{ntasm_ast.release(tree);return 800;}
        let code:u64=x64_lower_nxo_pe.build_function_bodies_and_write(source,tree,1,3,path);
        ntasm_ast.release(tree);
        return code;
    }
    if mode==5 {
        let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
        if tree.ok==false{ntasm_ast.release(tree);return 800;}
        let code:u64=x64_lower_nxo_pe.build_function_bodies_and_write_linked(source,tree,1,3,definition,path);
        ntasm_ast.release(tree);
        return code;
    }
    if mode==6 {
        if len(out)<8{return 827;}
        let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
        if tree.ok==false{ntasm_ast.release(tree);return 800;}
        let code:u64=x64_lower_nxo_pe.build_function_bodies_and_write_sized(source,tree,1,3,path,out);
        ntasm_ast.release(tree);
        return code;
    }
    if len(out)<8{return 827;}
    let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    if tree.ok==false{ntasm_ast.release(tree);return 800;}
    if mode==0 {
        let result:ntasm_nxo_pe.ConvertResult=x64_lower_nxo_pe.build(source,tree,1,3,definition);
        ntasm_ast.release(tree);
        let bytes:buf<u8>=result.bytes;
        if result.code!=0{rt_free(runtime(),bytes);return result.code;}
        let size:u64=len(bytes);
        if size>len(out)-8{rt_free(runtime(),bytes);return 827;}
        ntasm_pe.copy(out,8,bytes);
        ntasm_pe.put64(out,0,size);
        rt_free(runtime(),bytes);return 0;
    }
    if mode==1 {
        let result:ntasm_nxo_pe.ConvertResult=x64_lower_nxo_pe.build_function_bodies(source,tree,1,3);
        ntasm_ast.release(tree);
        let bytes:buf<u8>=result.bytes;
        if result.code!=0{rt_free(runtime(),bytes);return result.code;}
        let size:u64=len(bytes);
        if size>len(out)-8{rt_free(runtime(),bytes);return 827;}
        ntasm_pe.copy(out,8,bytes);
        ntasm_pe.put64(out,0,size);
        rt_free(runtime(),bytes);return 0;
    }
    if mode==2 {
        let written:ntasm_nxo.WriteResult=x64_lower_nxo.build_function_bodies(source,tree,1,3);
        ntasm_ast.release(tree);
        let object_bytes:buf<u8>=written.bytes;
        if written.code!=0{rt_free(runtime(),object_bytes);return written.code;}
        let size:u64=len(object_bytes);
        if size>len(out)-8{rt_free(runtime(),object_bytes);return 827;}
        ntasm_pe.copy(out,8,object_bytes);
        ntasm_pe.put64(out,0,size);
        rt_free(runtime(),object_bytes);return 0;
    }
    if mode==4 {
        let result:ntasm_nxo_pe.ConvertResult=x64_lower_nxo_pe.build_function_bodies_linked(source,tree,1,3,definition);
        ntasm_ast.release(tree);
        let bytes:buf<u8>=result.bytes;
        if result.code!=0{rt_free(runtime(),bytes);return result.code;}
        let size:u64=len(bytes);
        if size>len(out)-8{rt_free(runtime(),bytes);return 827;}
        ntasm_pe.copy(out,8,bytes);
        ntasm_pe.put64(out,0,size);
        rt_free(runtime(),bytes);return 0;
    }
    ntasm_ast.release(tree);return 800;
}
