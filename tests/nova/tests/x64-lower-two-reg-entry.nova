// Gate entry for the two-register families reached through the AST lowerer:
// xchg, cmov*, bsf/bsr, movzx/movsx/movsxd and test, plus the one-operand
// forms the same lowerer owns. One entry, exactly like the other lowerer
// gates, so a case is the whole pipeline from source text to bytes.
module x64_lower_two_reg_entry;import ntasm_ast;import ntasm_parser;import x64_lower_fixed;
export fn main(source:buf<u8>,features:u64,cpl:u64,out:buf<u8>)->u64 {
    if len(out)<2{return 800;}let tree:ntasm_ast.Tree=ntasm_parser.parse(source,1);
    if tree.ok==false{ntasm_ast.release(tree);return 800;}
    let code:u64=x64_lower_fixed.lower(source,tree,features,cpl,out);
    ntasm_ast.release(tree);return code;
}
