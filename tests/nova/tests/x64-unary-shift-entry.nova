// The gate entry for the one-register and shift families.
//   mode 0 inc/dec/not/neg over a register, the plain group-2 spelling
//   mode 1 rol/ror/shl/shr/sar with a literal count
//   mode 2 bswap, which took a mode here rather than a module of its own: it
//          reads the same (name, operand_count, destination, width) that mode 0
//          reads and only ignores `amount`, so widening the entry would have
//          been a signature change for every caller that already passes one.
module x64_unary_shift_entry;
import x64_fixed;

export fn main(name:buf<u8>,operand_count:u64,destination:u64,width:u64,amount:u64,features:u64,cpl:u64,mode:u64,out:buf<u8>)->u64 {
    if mode==0{return x64_fixed.encode_unary(name,operand_count,destination,width,features,cpl,out);}
    if mode==1{return x64_fixed.encode_shift_imm(name,operand_count,destination,width,amount,features,cpl,out);}
    if mode==2{return x64_fixed.encode_bswap(name,operand_count,destination,width,features,cpl,out);}
    return 800;
}